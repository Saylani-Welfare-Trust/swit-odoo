<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- First, create the location -->
        <record id="livestock_slaughter_stock_location" model="stock.location">
            <field name="name">Slaughter Stock</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="usage">internal</field>
        </record>

        <!-- Then, create the operation type that references it -->
        <record id="livestock_slaughter_operation_type" model="stock.picking.type">
            <field name="name">Livestock Slaughter Transfer</field>
            <field name="code">internal</field>
            <field name="sequence_code">LST</field>
            <field name="default_location_src_id" ref="stock.stock_location_stock"/>
            <field name="default_location_dest_id" ref="livestock_slaughter_stock_location"/>
            <field name="use_create_lots">False</field>
            <field name="use_existing_lots">True</field>
        </record>

    </data>
</odoo>