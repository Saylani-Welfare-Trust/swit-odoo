<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Setup > Livestock Locations: one row per module livestock comes from
         (the location chosen on a row is kept on upgrade) -->
    <data noupdate="1">
        <record id="livestock_source_pos" model="livestock.source.location">
            <field name="sequence">10</field>
            <field name="source">pos</field>
        </record>
        <record id="livestock_source_dhs" model="livestock.source.location">
            <field name="sequence">15</field>
            <field name="source">dhs</field>
        </record>
        <record id="livestock_source_direct_deposit" model="livestock.source.location">
            <field name="sequence">20</field>
            <field name="source">direct_deposit</field>
        </record>
        <record id="livestock_source_donation" model="livestock.source.location">
            <field name="sequence">30</field>
            <field name="source">donation</field>
        </record>
        <record id="livestock_source_api_donation" model="livestock.source.location">
            <field name="sequence">40</field>
            <field name="source">api_donation</field>
        </record>
        <record id="livestock_source_advance_donation" model="livestock.source.location">
            <field name="sequence">50</field>
            <field name="source">advance_donation</field>
        </record>
    </data>
</odoo>
