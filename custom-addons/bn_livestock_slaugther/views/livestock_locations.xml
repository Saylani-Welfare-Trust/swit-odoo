<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Master Setup > Livestock Locations: where each warehouse's livestock lines that
         do not come from a POS (donation inflows) land, for the whole warehouse -->
    <record id="stock_warehouse_livestock_locations_tree" model="ir.ui.view">
        <field name="name">stock.warehouse.livestock.locations.tree</field>
        <field name="model">stock.warehouse</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0">
                <field name="name" readonly="1"/>
                <field name="code" readonly="1" optional="show"/>
                <field name="node_id" readonly="1" optional="show"/>
                <field name="livestock_inflow_location_id" required="1" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="action_livestock_locations" model="ir.actions.act_window">
        <field name="name">Livestock Locations</field>
        <field name="res_model">stock.warehouse</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="stock_warehouse_livestock_locations_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No warehouse yet.</p>
            <p>Set, per warehouse, where livestock from donation inflows (Import Donations, API Donations,
               Direct Deposits not made at a POS) lands and waits for slaughter.</p>
        </field>
    </record>

    <menuitem
        id="menu_livestock_warehouse_locations"
        name="Livestock Warehouse Locations"
        parent="bn_master_setup.master_setup_menu"
        action="action_livestock_locations"
        groups="stock.group_stock_manager"
        sequence="51"/>

    <!-- Master Setup > Livestock Locations: one row per module livestock comes from -->
    <record id="livestock_source_location_tree" model="ir.ui.view">
        <field name="name">livestock.source.location.tree</field>
        <field name="model">livestock.source.location</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0">
                <field name="sequence" widget="handle"/>
                <field name="source" readonly="1"/>
                <field name="default_location"/>
                <field name="location_id" options="{'no_create': True}" placeholder="Default location"/>
            </tree>
        </field>
    </record>

    <record id="action_livestock_source_locations" model="ir.actions.act_window">
        <field name="name">Livestock Locations</field>
        <field name="res_model">livestock.source.location</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p>Set, per module, where its livestock lands and waits for slaughter. Empty: the default location.</p>
        </field>
    </record>

    <menuitem
        id="menu_livestock_locations"
        name="Livestock Locations"
        parent="bn_master_setup.master_setup_menu"
        action="action_livestock_source_locations"
        groups="bn_livestock_slaugther.livestock_slaugther_admin_group,stock.group_stock_manager"
        sequence="50"/>
</odoo>
