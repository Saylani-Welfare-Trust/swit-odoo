<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="livestock_slaugther_view_form_pos_link" model="ir.ui.view">
        <field name="name">livestock.slaugther.form.pos.link</field>
        <field name="model">livestock.slaugther</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.livestock_slaugther_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Point of Sale" name="pos_link_info" invisible="not pos_session_id and not pos_order_id">
                    <group>
                        <field name="pos_config_id" options="{'no_create': True}"/>
                        <field name="pos_session_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="pos_order_id" options="{'no_create': True}"/>
                        <field name="pos_reference"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
