<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filters by status / date / archived and group-bys missing from the search views -->

    <record id="search_filters_livestock_slaugther" model="ir.ui.view">
        <field name="name">livestock.slaugther.search.filters</field>
        <field name="model">livestock.slaugther</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.search_livestock_slaugther"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="pos_session_id"/>
                <field name="pos_cashier_id"/>
                <field name="pos_employee_id"/>
                <field name="pos_analytic_account_id"/>
                <field name="transfer_picking_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_pos_session_id" string="POS Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="bn_groupby_pos_cashier_id" string="Cashier" context="{'group_by': 'pos_cashier_id'}"/>
                    <filter name="bn_groupby_pos_employee_id" string="Cashier (Employee)" context="{'group_by': 'pos_employee_id'}"/>
                    <filter name="bn_groupby_pos_analytic_account_id" string="Branch (Shop)" context="{'group_by': 'pos_analytic_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_distribution_center" model="ir.ui.view">
        <field name="name">distribution.center.search.filters</field>
        <field name="model">distribution.center</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.search_distribution_center"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="picking_id"/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_type" string="Type" context="{'group_by': 'type'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_livestock_cutting_material" model="ir.ui.view">
        <field name="name">livestock.cutting.material.search.filters</field>
        <field name="model">livestock.cutting.material</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.search_livestock_cutting_material"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <separator/>
                <group expand="0" string="Group By">
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_livestock_requisition" model="ir.ui.view">
        <field name="name">livestock.requisition.search.filters</field>
        <field name="model">livestock.requisition</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.search_livestock_requisition"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_type" string="Type" context="{'group_by': 'type'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
