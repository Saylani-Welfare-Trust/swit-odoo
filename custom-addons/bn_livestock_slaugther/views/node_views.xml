<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch / Site of the document (bn_stock_location node.document.mixin) -->

    <record id="search_distribution_center_search_node" model="ir.ui.view">
        <field name="name">distribution.center.search.node</field>
        <field name="model">distribution.center</field>
        <field name="inherit_id" ref="bn_livestock_slaugther.search_distribution_center"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="node_id"/>
                <filter name="group_by_node_id" string="Branch / Site" context="{'group_by': 'node_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="distribution_center_view_tree_tree_node" model="ir.ui.view">
        <field name="name">distribution.center.view.tree.node</field>
        <field name="model">distribution.center</field>
