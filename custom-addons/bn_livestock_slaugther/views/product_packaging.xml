<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_product_packaging_tree_inherit_on_hand" model="ir.ui.view">
        <field name="name">product.packaging.tree.on.hand</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view"/>
        <field name="arch" type="xml">
            <field name="qty" position="after">
                <field name="on_hand_qty" readonly="1"/>
                <!-- <field name="on_hand_packages" readonly="1"/> -->
            </field>
        </field>
    </record>

    <record id="view_product_packaging_form_inherit_on_hand" model="ir.ui.view">
        <field name="name">product.packaging.form.on.hand</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <field name="qty" position="after">
                <field name="on_hand_qty" readonly="1"/>
                <!-- <field name="on_hand_packages" readonly="1"/> -->
            </field>
        </field>
    </record>

    <menuitem
        id="custom_product_packaging_menu"
        name="Product Packaging"
        action="product.action_packaging_view"
        parent="bn_livestock_slaugther.livestock_menu"
        sequence="3"/>

</odoo>
