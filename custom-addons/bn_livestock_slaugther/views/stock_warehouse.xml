<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- each warehouse has its own livestock locations (made when first used) -->
    <record id="stock_view_warehouse_inherit_bn_livestock" model="ir.ui.view">
        <field name="name">stock.view.warehouse.inherit.bn.livestock</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="livestock_locations" string="Livestock Locations" groups="stock.group_stock_manager">
                    <p class="text-muted">
                        Where cutting and the departments of this warehouse keep the animals and meat. Slaughter locations are the locations marked Is Slaughter Location.
                        Left empty, the location of that name in this warehouse is used, or made when first needed.
                    </p>
                    <field name="view_location_id" invisible="1"/>
                    <group>
                        <group>
                            <field name="livestock_cutting_location_id" options="{'no_create': True}"
                                   domain="[('id', 'child_of', view_location_id), ('usage', 'in', ('internal', 'transit'))]"/>
                        </group>
                        <group>
                            <field name="livestock_meat_location_id" options="{'no_create': True}"
                                   domain="[('id', 'child_of', view_location_id), ('usage', 'in', ('internal', 'transit'))]"/>
                            <field name="livestock_goat_location_id" options="{'no_create': True}"
                                   domain="[('id', 'child_of', view_location_id), ('usage', 'in', ('internal', 'transit'))]"/>
                            <field name="livestock_chicken_location_id" options="{'no_create': True}"
                                   domain="[('id', 'child_of', view_location_id), ('usage', 'in', ('internal', 'transit'))]"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
