<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Branch / Site access (bn_stock_location), on the analytic accounts of the
        Location tree: livestock documents carry no analytic account of their own,
        so each gets its Branch / Site (node_id) from its locations (their
        warehouse's Branch / Site). A user sees the documents of their Branches /
        Sites (and everything under them) and the city-wide documents of the nodes
        above them; who created a document gives no access. Global (it narrows
        every other rule of the model); All Branches / Sites and portal users: no effect.
    -->
    <record id="node_rule_distribution_center" model="ir.rule">
        <field name="name">Distribution Center: Branch / Site</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_distribution_center"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('node_id', 'parent_of', user.allowed_node_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_livestock_cutting" model="ir.rule">
        <field name="name">Livestock Cutting: Branch / Site</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_cutting"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('node_id', 'parent_of', user.allowed_node_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_livestock_cutting_material" model="ir.rule">
        <field name="name">Livestock Cutting Material: Branch / Site</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_cutting_material"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('node_id', 'parent_of', user.allowed_node_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_livestock_meat_management" model="ir.rule">
        <field name="name">Livestock Meat Management: Branch / Site</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_meat_management"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('node_id', 'parent_of', user.allowed_node_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_livestock_requisition" model="ir.rule">
        <field name="name">Livestock Requisition: Branch / Site</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_requisition"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('node_id', 'parent_of', user.allowed_node_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <!-- Livestock Slaughter: the analytic account of the line's Destination Location
         (it starts as the Source Location, the POS location of the order line, and
         changes with the Bulk Transfer: the receiving location's users see it then);
         a location without an analytic account: its warehouse's Branch / Site. -->
    <record id="node_rule_livestock_slaugther" model="ir.rule">
        <field name="name">Livestock Slaugther: Destination Location analytic account</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_slaugther"/>
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.all_nodes) else ['|', ('transfer_location.analytic_account_id', 'in', user.node_scope_ids.ids), '&amp;', ('transfer_location.analytic_account_id', '=', False), ('transfer_location.warehouse_id.node_id', 'in', user.node_scope_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
