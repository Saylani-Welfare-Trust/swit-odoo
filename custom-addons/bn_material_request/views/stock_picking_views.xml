<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Internal transfer of a Material Request: requesting department and the request lines' descriptions -->
    <record id="view_picking_form_inherit_mr" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.material.request</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group/group/field[@name='origin']" position="after">
                <field name="requesting_department_id" invisible="not requesting_department_id"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']/tree/field[@name='description_picking']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Transfers created before the request was linked to them -->
    <function model="stock.picking" name="_backfill_material_request"/>

</odoo>
