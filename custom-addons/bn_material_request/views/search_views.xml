<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_material_request" model="ir.ui.view">
        <field name="name">material.request.search</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="bn_material_request.material_request_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="department_id"/>
                <field name="hod_approved_by"/>
                <field name="line_ids" string="Line Product" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_pending" string="Waiting for Delivery" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_state_purchase_request" string="Purchase Request" domain="[('state', '=', 'purchase_request')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="period_request_date" string="Request Date" date="request_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_department_id" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="groupby_source_location_id" string="Source Location" context="{'group_by': 'source_location_id'}"/>
                    <filter name="groupby_dest_location_id" string="Destination Location" context="{'group_by': 'dest_location_id'}"/>
                    <filter name="groupby_hod_approved_by" string="HOD Approved By" context="{'group_by': 'hod_approved_by'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_purchase_requisition_line_deletion_log" model="ir.ui.view">
        <field name="name">purchase.requisition.line.deletion.log.search</field>
        <field name="model">purchase.requisition.line.deletion.log</field>
        <field name="inherit_id" ref="bn_material_request.purchase_requisition_line_deletion_log_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_product_id" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
