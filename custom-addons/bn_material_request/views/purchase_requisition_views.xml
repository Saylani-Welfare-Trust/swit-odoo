<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Purchase Requisition Form to add vendor field and Create RFQs button -->
    <record id="view_purchase_requisition_form_inherit_vendor" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit.vendor</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="arch" type="xml">
            
            <!-- Add Create RFQs button in header -->
            <xpath expr="//header" position="inside">
                <button string="Create RFQs for Vendors" 
                        name="action_create_multi_vendor_rfqs" 
                        type="object"
                        class="btn-primary" 
                        icon="fa-clone"
                        invisible="state not in ['in_progress', 'open']"
                        help="Create multiple RFQs (Purchase Orders) for different vendors with same products"/>
            </xpath>

            <xpath expr="//header/button[2]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_material_request" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="not material_request_id">
                    <field name="material_request_id" widget="statinfo" string="Source MR"/>
                </button>
                <!-- The other Purchase Requests made for the same Material Request -->
                <button name="action_view_material_request_requisitions" type="object"
                        class="oe_stat_button" icon="fa-list"
                        invisible="material_request_requisition_count &lt; 2">
                    <field name="material_request_requisition_count" widget="statinfo" string="PRs on this MR"/>
                </button>
                <!-- Who deleted which of this PR's lines, and when -->
                <button name="action_view_deleted_lines" type="object"
                        class="oe_stat_button" icon="fa-trash"
                        invisible="deleted_line_count == 0">
                    <field name="deleted_line_count" widget="statinfo" string="Deleted Lines"/>
                </button>
            </xpath>

            <!-- Vendors are picked from the existing ones, never created from here -->
            <xpath expr="//field[@name='vendor_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <!-- Show how much of each line the consolidated-RFQ process has already
                 locked, and how much is still free for a future Vendor Selection
                 Wizard run. -->
            <xpath expr="//field[@name='line_ids']//field[@name='product_qty']" position="after">
                <field name="remaining_qty" readonly="1"/>
                <field name="is_locked" readonly="1" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

</odoo>
