<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_picking_form_inherit_on_hand" model="ir.ui.view">
        <field name="name">stock.picking.form.on.hand</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_line_ids_without_package']/list//field[@name='quantity']" position="before">
                <field name="on_hand_qty" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
