<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_purchase_order_form_inherit_mr" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.material.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='requisition_id']" position="after">
                <field name="material_request_id" readonly="1"/>
                <field name="requisition_ids" widget="many2many_tags" readonly="1"
                       invisible="not requisition_ids"
                       help="Every Purchase Request consolidated into this RFQ by the Vendor Selection Wizard."/>
            </xpath>

            <!-- Vendors are picked from the existing ones, never created from here -->
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'no_create': True}</attribute>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_tagged_requisitions" type="object"
                        class="oe_stat_button" icon="fa-list"
                        invisible="requisition_tag_count &lt; 2">
                    <field name="requisition_tag_count" widget="statinfo" string="Source PRs"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="view_purchase_order_tree_inherit_mr" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.material.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="material_request_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>