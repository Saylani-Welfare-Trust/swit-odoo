<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="purchase_requisition_line_deletion_log_view_tree" model="ir.ui.view">
        <field name="name">purchase.requisition.line.deletion.log.view.tree</field>
        <field name="model">purchase.requisition.line.deletion.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="deleted_date"/>
                <field name="deleted_by"/>
                <field name="requisition_name"/>
                <field name="requisition_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="product_uom_id"/>
                <field name="locked_qty"/>
            </tree>
        </field>
    </record>

    <!-- Form View (read-only, for drilling into one entry) -->
    <record id="purchase_requisition_line_deletion_log_view_form" model="ir.ui.view">
        <field name="name">purchase.requisition.line.deletion.log.view.form</field>
        <field name="model">purchase.requisition.line.deletion.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="deleted_by"/>
                            <field name="deleted_date"/>
                        </group>
                        <group>
                            <field name="requisition_id"/>
                            <field name="requisition_name"/>
                        </group>
                    </group>
                    <group>
                        <field name="product_id"/>
                        <field name="product_uom_id"/>
                        <field name="quantity"/>
                        <field name="locked_qty"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="purchase_requisition_line_deletion_log_view_search" model="ir.ui.view">
        <field name="name">purchase.requisition.line.deletion.log.view.search</field>
        <field name="model">purchase.requisition.line.deletion.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="requisition_name"/>
                <field name="product_id"/>
                <field name="deleted_by"/>
                <group expand="0" string="Group By">
                    <filter string="Deleted By" name="group_deleted_by" context="{'group_by': 'deleted_by'}"/>
                    <filter string="Purchase Request" name="group_requisition" context="{'group_by': 'requisition_name'}"/>
                    <filter string="Deletion Date" name="group_date" context="{'group_by': 'deleted_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="purchase_requisition_line_deletion_log_action" model="ir.actions.act_window">
        <field name="name">Deleted PR Lines</field>
        <field name="res_model">purchase.requisition.line.deletion.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Purchase Request lines have been deleted.
            </p>
            <p>
                Every time someone deletes a line from a Purchase Request, who did it
                and what the line was gets recorded here - nothing in this list can be
                edited or removed.
            </p>
        </field>
    </record>

    <!-- Menu: under the Material Requests root, next to the main list -->
    <menuitem
        id="purchase_requisition_line_deletion_log_menu"
        name="Deleted PR Lines"
        parent="material_request_menu_root"
        action="purchase_requisition_line_deletion_log_action"
        sequence="20"/>

</odoo>
