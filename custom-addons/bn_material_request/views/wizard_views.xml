<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vendor Selection Wizard Form View -->
    <record id="vendor_selection_wizard_view_form" model="ir.ui.view">
        <field name="name">vendor.selection.wizard.form</field>
        <field name="model">vendor.selection.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Vendors for RFQ Creation">
                <group>
                    <field name="source_requisition_id" invisible="1"/>
                    <field name="vendor_count" invisible="1"/>
                    <field name="has_selected_lines" invisible="1"/>
                </group>
                <group>
                    <field name="vendor_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"
                           placeholder="Select multiple vendors..."/>
                </group>
                <div class="alert alert-info" role="alert">
                    <i class="fa fa-info-circle"/>
                    One consolidated RFQ is created per selected vendor. Lines for the same
                    product, even from different Purchase Requests, are summed into a single
                    RFQ line. Every line you order here is locked and cannot be selected
                    again; a Purchase Request closes automatically once every one of its
                    lines has been fully ordered.
                </div>
                <notebook>
                    <page string="Source Purchase Request" name="source">
                        <field name="source_line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="requisition_line_id" column_invisible="1" force_save="1"/>
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="product_uom_id" readonly="1" force_save="1"/>
                                <field name="requested_qty" readonly="1"/>
                                <field name="remaining_qty" readonly="1"/>
                                <field name="qty_to_order"/>
                                <field name="selected" widget="boolean_toggle" options="{'autosave': False}"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Procurement Manager Approval" name="procurement_approval">
                        <field name="procurement_line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0">
                                <field name="requisition_line_id" column_invisible="1" force_save="1"/>
                                <field name="requisition_id" readonly="1" force_save="1"/>
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="product_uom_id" readonly="1" force_save="1"/>
                                <field name="requested_qty" readonly="1"/>
                                <field name="remaining_qty" readonly="1"/>
                                <field name="qty_to_order"/>
                                <field name="selected" widget="boolean_toggle" options="{'autosave': False}"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Other Purchase Requests" name="other">
                        <div class="alert alert-secondary" role="alert">
                            For reference only - these lines cannot be included in the
                            consolidated RFQ(s) from this page. Once a Purchase Request
                            reaches "Procurement Manager Approval", its lines become
                            selectable on that page instead.
                        </div>
                        <field name="other_line_ids" nolabel="1">
                            <tree create="0" edit="0" delete="0">
                                <field name="requisition_line_id" column_invisible="1" force_save="1"/>
                                <field name="requisition_id"/>
                                <field name="requisition_state"/>
                                <field name="product_id"/>
                                <field name="product_uom_id"/>
                                <field name="requested_qty"/>
                                <field name="remaining_qty"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button string="Create RFQ's" name="action_create_rfqs" type="object"
                            class="btn-primary" invisible="vendor_count == 0 or not has_selected_lines"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- RFQ Price Wizard Form View -->
    <record id="rfq_price_wizard_view_form" model="ir.ui.view">
        <field name="name">rfq.price.wizard.form</field>
        <field name="model">rfq.price.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk RFQ Price Entry">
                <group>
                    <group>
                        <field name="rfq_count" readonly="1"/>
                        <field name="total_lines" readonly="1"/>
                    </group>
                    <group>
                        <field name="rfq_ids" invisible="1"/>
                        <field name="selected_rfq_id" invisible="1"/>
                        <field name="selected_rfq_name" readonly="1" invisible="selected_rfq_name == False"/>
                    </group>
                </group>
                
                <group>
                    <field name="remarks" placeholder="Enter remarks to be posted on all RFQs (optional)..."/>
                </group>
                
                <div class="alert alert-success" role="alert" invisible="selected_rfq_name == False">
                    <strong>✓ Suggested RFQ:</strong> <field name="selected_rfq_name" readonly="1" nolabel="1" class="oe_inline"/> (Nearest Date + Minimum Total)
                </div>
                <div class="alert alert-info" role="alert" invisible="selected_rfq_name != False">
                    <strong>ℹ Info:</strong> No single RFQ has both Nearest Date and Minimum Total. Review dates and prices before confirming.
                </div>
                
                <div class="alert alert-warning" role="alert" style="margin: 10px;">
                    <strong>How to Confirm:</strong>
                    <ul style="margin-top: 5px; margin-bottom: 0;">
                        <li><b>Option 1:</b> In "Expected Delivery Dates" tab, check "Select to Confirm RFQ" to confirm the entire RFQ with all lines</li>
                        <li><b>Option 2:</b> In "Price Entry" tab, check individual "Select to Confirm" boxes to confirm only specific lines</li>
                        <li><b>Both:</b> You can mix both options - entire RFQs + specific lines from other RFQs</li>
                        <li><b>Remarks:</b> Any remarks entered above will be posted to all RFQs (both confirmed and updated)</li>
                    </ul>
                </div>
                
                <notebook>
                    <page string="Expected Delivery Dates" name="expected_dates">
                        <field name="rfq_line_ids" nolabel="1">
                            <tree editable="bottom" create="0" delete="0" decoration-success="is_selected" decoration-bf="is_selected">
                                <field name="wizard_id" column_invisible="1" force_save="1"/>
                                <field name="rfq_id" readonly="1" force_save="1"/>
                                <field name="rfq_name" readonly="1"/>
                                <field name="vendor_id" readonly="1" force_save="1"/>
                                <field name="expected_date" string="Expected Delivery Date"/>
                                <field name="total_amount" readonly="1" widget="monetary"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="is_nearest_date" string="✓ Nearest" widget="boolean" readonly="1"/>
                                <field name="is_minimum_total" string="✓ Min Total" widget="boolean" readonly="1"/>
                                <field name="is_selected" string="Suggested" widget="boolean" readonly="1"/>
                                <field name="select_for_confirm" string="Select to Confirm RFQ" widget="boolean"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Price Entry" name="prices">
                        <field name="line_ids" nolabel="1">
                            <tree editable="bottom" decoration-info="price_unit == 0" create="0" delete="0">
                                <field name="wizard_id" column_invisible="1" force_save="1"/>
                                <field name="rfq_line_id" column_invisible="1" force_save="1"/>
                                <field name="rfq_id" readonly="1" force_save="1"/>
                                <field name="rfq_name" readonly="1" optional="show"/>
                                <field name="vendor_id" readonly="1" force_save="1"/>
                                <field name="product_id" readonly="1" force_save="1"/>
                                <field name="product_qty" readonly="1"/>
                                <field name="product_uom_id" readonly="1" force_save="1"/>
                                <field name="price_unit" string="Unit Price"/>
                                <field name="to_confirm" string="Select to Confirm" widget="boolean"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                
                <footer>
                    <button string="Update Prices Only" name="action_update_prices" type="object" 
                            class="btn-secondary"/>
                    <button string="Confirm Selected Lines" name="action_confirm_selected" type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action for Vendor Selection Wizard -->
    <record id="action_vendor_selection_wizard" model="ir.actions.act_window">
        <field name="name">Select Vendors</field>
        <field name="res_model">vendor.selection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_material_request_id': active_id}</field>
    </record>

    <!-- Action for RFQ Price Wizard (called from Purchase Order list view) -->
    <record id="action_rfq_price_wizard" model="ir.actions.act_window">
        <field name="name">Bulk Price Entry</field>
        <field name="res_model">rfq.price.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
