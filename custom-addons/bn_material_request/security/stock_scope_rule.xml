<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml): only the warehouses / locations set on the user; a document without one yet stays visible. -->

    <record id="scope_material_request_rule" model="ir.rule">
        <field name="name">Material Request: allowed warehouses / locations</field>
        <field name="model_id" ref="bn_material_request.model_material_request"/>
        <field name="domain_force">['|', '|', ('dest_location_id', '=', False), ('dest_location_id', 'child_of', user.allowed_location_ids.ids), ('source_location_id', 'child_of', user.allowed_location_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_material_request_unrestricted_rule" model="ir.rule">
        <field name="name">Material Request: unrestricted</field>
        <field name="model_id" ref="bn_material_request.model_material_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
