<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_material_request" model="ir.module.category">
        <field name="name">Material Request</field>
        <field name="sequence">61</field>
    </record>
    
    <!-- Menu Group -->
    <record id="menu_group_user" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_material_request"/>
        <field name="comment">Basic user access to Member Approval module</field>
    </record>
    
    <record id="menu_group_material_request_cfo" model="res.groups">
        <field name="name">CFO Approval</field>
        <field name="category_id" ref="module_material_request"/>
        <field name="implied_ids" eval="[(4, ref('menu_group_user'))]"/>
    </record>
    
    
    <record id="menu_group_material_request_coo" model="res.groups">
        <field name="name">COO Approval</field>
        <field name="category_id" ref="module_material_request"/>
        <field name="implied_ids" eval="[(4, ref('menu_group_user'))]"/>
    </record>

