<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_material_request_revert_wizard_form" model="ir.ui.view">
        <field name="name">material.request.revert.wizard.form</field>
        <field name="model">material.request.revert.wizard</field>
        <field name="arch" type="xml">
            <form string="Revert Request">
                <group>
                    <field name="request_id"/>
                    <field name="current_state" invisible="1"/>
                    <!-- NEW: Target State Selection -->
                    <field name="target_state" widget="radio" 
                           invisible="current_state == 'hod_approval' and target_state != 'draft'"
                           options="{'horizontal': true}"/>
                </group>
                <group>
                    <field name="reason" placeholder="Explain why this request is being reverted..." />
                </group>
                <footer>
                    <button name="action_revert" string="Confirm Revert" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>