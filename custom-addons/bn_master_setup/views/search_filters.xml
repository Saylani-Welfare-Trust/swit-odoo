<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filters by status / date / archived and group-bys missing from the search views -->

    <record id="search_filters_area" model="ir.ui.view">
        <field name="name">area.search.filters</field>
        <field name="model">area</field>
        <field name="inherit_id" ref="bn_master_setup.search_area"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="area_code"/>
            </xpath>
        </field>
    </record>

</odoo>
