<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_area" model="ir.ui.view">
        <field name="name">area.search</field>
        <field name="model">area</field>
        <field name="arch" type="xml">
            <search string="Area">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_bank" model="ir.ui.view">
        <field name="name">bank.search</field>
        <field name="model">bank</field>
        <field name="arch" type="xml">
            <search string="Bank">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_city" model="ir.ui.view">
        <field name="name">city.search</field>
        <field name="model">city</field>
        <field name="arch" type="xml">
            <search string="City">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
