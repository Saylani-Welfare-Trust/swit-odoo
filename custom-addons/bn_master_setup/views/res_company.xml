<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The pages of the other modules' company settings (POS, Donation API,
         Welfare API ...) are added by those modules. -->
    <record id="base_view_company_form_inherit_bn_res_company" model="ir.ui.view">
        <field name="name">base.view.company.form.inherit.bn.master.setup</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group/group[2]" position="inside">
                <field name="max_file_size"/>
            </xpath>
        </field>
    </record>

</odoo>
