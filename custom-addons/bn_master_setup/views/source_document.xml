<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_view_picking_form_source" model="ir.ui.view">
        <field name="name">stock.picking.form.source.record</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="source_record_ref" invisible="not source_record_ref"/>
            </xpath>
        </field>
    </record>

    <record id="account_view_move_form_source" model="ir.ui.view">
        <field name="name">account.move.form.source.record</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="source_record_ref" invisible="not source_record_ref"/>
            </xpath>
        </field>
    </record>

</odoo>
