<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_master_setup" model="ir.module.category">
        <field name="name">Master Setup</field>
        <field name="sequence">50</field>
    </record>

    <record id="master_setup_user_group" model="res.groups">
        <field name="name">Master Setup / User</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="comment">Can look up City and Bank reference data. Cannot edit it.</field>
    </record>

    <record id="master_setup_manager_group" model="res.groups">
        <field name="name">Master Setup / Manager</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(4, ref('master_setup_user_group'))]"/>
        <field name="comment">Maintains the City and Bank lists: create and edit entries.</field>
    </record>

    <record id="master_setup_audit_group" model="res.groups">
        <field name="name">Master Setup / Audit</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="comment">Read-only oversight of Master Setup data for reporting.</field>
    </record>

    <record id="master_setup_admin_group" model="res.groups">
        <field name="name">Master Setup / Admin</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(4, ref('master_setup_manager_group')), (4, ref('master_setup_audit_group'))]"/>
        <field name="comment">Full control: everything Manager can do, plus deleting City/Bank entries.</field>
    </record>

</odoo>
