<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sole gate on the root app menu. No group implies it: assign it
         explicitly, together with the tier / role groups, to whoever should
         see the app; the tiers then decide what they can do once inside. -->
    <record id="master_setup_root_group" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Master Setup app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="master_setup_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Can look up City, Bank and Area reference data. Cannot edit it.</field>
    </record>
    
    <record id="master_setup_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(6, 0, [ref('master_setup_user_group')])]"/>
        <field name="comment">Maintains the City, Bank and Area lists: create and edit entries.</field>
    </record>

    <record id="master_setup_audit_group" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight of Master Setup data for reporting.</field>
    </record>

    <record id="master_setup_admin_group" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_master_setup"/>
        <field name="implied_ids" eval="[(6, 0, [ref('master_setup_manager_group'), ref('master_setup_audit_group')])]"/>
        <field name="comment">Full control: everything Manager can do, plus deleting City / Bank / Area entries.</field>
    </record>

</odoo>
