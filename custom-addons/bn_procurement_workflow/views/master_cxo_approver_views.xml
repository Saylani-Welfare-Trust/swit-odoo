<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_master_cxo_approver_tree" model="ir.ui.view">
        <field name="name">master.cxo.approver.tree</field>
        <field name="model">master.cxo.approver</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="user_id"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_master_cxo_approver" model="ir.actions.act_window">
        <field name="name">CXO Approvers</field>
        <field name="res_model">master.cxo.approver</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem
        id="menu_master_cxo_approver"
        name="CXO Approvers List"
        parent="bn_master_setup.master_setup_menu"
        action="action_master_cxo_approver"
        sequence="10"/>
</odoo>