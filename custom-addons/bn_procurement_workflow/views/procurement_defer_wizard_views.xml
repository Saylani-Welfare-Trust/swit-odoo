<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="procurement_defer_wizard_view_form" model="ir.ui.view">
        <field name="name">procurement.defer.wizard.view.form</field>
        <field name="model">procurement.defer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="requisition_id" invisible="1"/>
                <group>
                    <field name="defer_reason" placeholder="Reason for deferring this Purchase Requisition..."/>
                </group>
                <footer>
                    <button string="Defer" name="action_confirm_defer" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
