<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="email_template_cxo_approval_request" model="mail.template">
            <field name="name">CXO Approval Request - Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="render_engine">inline_template</field>
            
            <!-- Fallback for subject if name is '/' -->
            <field name="subject">Approval Required: {{ 'New RFQ' if object.name == '/' else object.name }} ({{ object.partner_id.name or 'No Vendor' }})</field>
            
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="email_to">{{ object.designated_cxo_approver_id.work_email }}</field>
            <field name="partner_to">{{ object.designated_cxo_approver_id.user_id.partner_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif;">
                    <p>Dear <t t-out="object.designated_cxo_approver_id.employee_id.name or ''"/>,</p>
                    
                    <p>A purchase order / RFQ has been assigned to you and needs your <strong>CXO approval</strong>.</p>
                    
                    <p>
                        <strong>PO / RFQ:</strong> <t t-out="object.name if object.name != '/' else 'New RFQ'"/><br/>
                        <strong>Vendor:</strong> <t t-out="object.partner_id.name or 'Not specified'"/><br/>
                        <strong>Amount:</strong> <t t-out="object.currency_id.symbol"/> <t t-out="'%.2f' % object.amount_total"/>
                    </p>
                    
                    <p>Please log in to review and approve this purchase.</p>
                    
                    <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
                </div>
            </field>
        </record>

    </data>
</odoo>