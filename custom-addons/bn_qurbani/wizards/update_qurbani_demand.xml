<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="update_qurbani_demand_view_form" model="ir.ui.view">
        <field name="name">update.qurbani.demand.view.form</field>
        <field name="model">update.qurbani.demand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="slaughter_slot_demand_id" invisible="1"/>
                        <field name="demand" required="1"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Update" name="update_demand" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
