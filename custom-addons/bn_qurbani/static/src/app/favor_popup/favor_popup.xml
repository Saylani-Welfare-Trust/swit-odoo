<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="bn_qurbani.FavorPopup">
        <div class="popup popup-selection">
            <div class="modal-header drag-handle">
                <h3 class="modal-title"><t t-esc="this.title" /></h3>
            </div>
            <main class="modal-body">
                <div class="row mb-2 text-start">
                    <div class="col-4 fw-semibold">Donor Name</div>
                    <div class="col-8">
                        <input type="text" class="form-control form-control-sm"
                            t-att-placeholder="placeholder"
                            t-att-value="state.record_number"
                            id="record_number"
                            name="record_number"
                            t-on-input="updateRecordNumber" required="1" />
                    </div>
                </div>
            </main>
            <footer class="footer modal-footer">
                <div class="button btn btn-lg btn-primary" t-on-click="confirm">Confirm</div>
                <div class="button cancel btn btn-lg btn-secondary" t-on-click="cancel">Cancel</div>
            </footer>
        </div>
    </t>

</templates>