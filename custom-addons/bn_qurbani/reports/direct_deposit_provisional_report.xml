<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="bn_qurbani.direct_deposit_receipt_template_provisional" inherit_id="bn_direct_deposit.direct_deposit_receipt_template_provisional">
        <xpath expr="//div[@name='donor_name']" position="replace">
            <div name="favor"><strong>Donor Name:</strong> <t t-esc="o.favor or o.donor_id.name or '-'"/></div>
        </xpath>
        <xpath expr="//div[@name='footer_donor_name']" position="replace">
            <div name="footer_favor"><strong>Donor Name:</strong> <t t-esc="o.favor or o.donor_id.name or '-'"/></div>
        </xpath>
    </template>

</odoo>
