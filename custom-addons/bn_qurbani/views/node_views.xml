    <record id="search_city_schedule_search_node" model="ir.ui.view">
        <field name="name">city.schedule.search.node</field>
        <field name="model">city.schedule</field>
        <field name="inherit_id" ref="bn_qurbani.search_city_schedule"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="node_id"/>
                <filter name="group_by_node_id" string="Branch / Site" context="{'group_by': 'node_id'}"/>
            </xpath>
        </field>
    </record>

