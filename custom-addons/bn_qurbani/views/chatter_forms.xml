                        <field name="pos_product_ids" widget="many2many_tags" domain="[('name', 'ilike', inventory_product_name), ('type', '=', 'product'), ('is_qurbani_inventory', '=', False), ('is_livestock', '=', True)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        <field name="slaughter_schedule_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="1"/>
                        <field name="slaughter_location_id" domain="[('is_slaughter_location', '=', True)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="1"/>
                        <field name="location_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
