<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_qurbani_day" model="ir.ui.view">
        <field name="name">qurbani.day.form</field>
        <field name="model">qurbani.day</field>
        <field name="arch" type="xml">
            <form string="Qurbani Day" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="web_qurbani_day"/>
                        <field name="date"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_qurbani_day" model="ir.ui.view">
        <field name="name">qurbani.day.tree.open.form</field>
        <field name="model">qurbani.day</field>
        <field name="inherit_id" ref="bn_qurbani.qurbani_day_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_qurbani.qurbani_day_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_chand_raat" model="ir.ui.view">
