    <record id="chatter_form_city_schedule" model="ir.ui.view">
        <field name="name">city.schedule.form</field>
        <field name="model">city.schedule</field>
        <field name="arch" type="xml">
            <form string="City Schedule">
                <sheet>
                    <group>
                        <field name="inventory_product_name" invisible="1"/>
                        <field name="day_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                        <field name="hijri_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                        <field name="inventory_product_id" domain="[('type', '=', 'product'), ('is_qurbani_inventory', '=', True), ('is_livestock', '=', True)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                        <field name="pos_product_ids" widget="many2many_tags" domain="[('name', 'ilike', inventory_product_name), ('type', '=', 'product'), ('is_pos_qurbani_inventory', '=', True), ('is_livestock', '=', True)]" required="1"/>
                        <field name="location_id" domain="[('location_option_id.name', '=', 'City')]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                        <field name="slaughter_location_id" domain="[('is_slaughter_location', '=', True)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                        <field name="distribution_location_ids" widget="many2many_tags" domain="[('is_distribution_location', '=', True)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

