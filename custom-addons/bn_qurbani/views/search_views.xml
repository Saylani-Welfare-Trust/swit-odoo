                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_location_id" string="City" context="{'group_by': 'location_id'}"/>
                    <filter name="groupby_inventory_product_id" string="Inventory Product" context="{'group_by': 'inventory_product_id'}"/>
                    <filter name="groupby_slaughter_location_id" string="Slaughter Location" context="{'group_by': 'slaughter_location_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

