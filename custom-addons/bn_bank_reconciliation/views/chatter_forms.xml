<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_bank_statement_header_type" model="ir.ui.view">
        <field name="name">bank.statement.header.type.form</field>
        <field name="model">bank.statement.header.type</field>
        <field name="arch" type="xml">
            <form string="Bank Statement Header Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_bank_statement_header_type" model="ir.ui.view">
        <field name="name">bank.statement.header.type.tree.open.form</field>
        <field name="model">bank.statement.header.type</field>
        <field name="inherit_id" ref="bn_bank_reconciliation.bank_statement_header_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_bank_reconciliation.bank_statement_header_type_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
