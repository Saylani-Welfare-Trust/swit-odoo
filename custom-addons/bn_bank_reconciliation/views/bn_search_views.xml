<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="bn_search_bank_reconciliation_master" model="ir.ui.view">
        <field name="name">bank.reconciliation.master.search.bn</field>
        <field name="model">bank.reconciliation.master</field>
        <field name="inherit_id" ref="bn_bank_reconciliation.view_bank_reconciliation_master_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="created_by"/>
                <field name="reconciled_by"/>
                <separator/>
                <filter name="bn_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="bn_filter_date" string="Statement Date" date="date"/>
                <group expand="0" string="Group By" name="bn_group_by">
                    <filter name="bn_group_reconciled_by" string="Reconciled By" context="{'group_by': 'reconciled_by'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="bn_search_bank_reconciliation_transaction" model="ir.ui.view">
        <field name="name">bank.reconciliation.transaction.search.bn</field>
        <field name="model">bank.reconciliation.transaction</field>
        <field name="inherit_id" ref="bn_bank_reconciliation.view_bank_reconciliation_transaction_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="reconciled_by"/>
                <field name="created_by"/>
                <separator/>
                <filter name="bn_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="bn_filter_date" string="Transaction Date" date="date"/>
                <group expand="0" string="Group By" name="bn_group_by">
                    <filter name="bn_group_reconciled_by" string="Reconciled By" context="{'group_by': 'reconciled_by'}"/>
                    <filter name="bn_group_created_by" string="Created By" context="{'group_by': 'created_by'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="bn_search_bank_statement_config" model="ir.ui.view">
        <field name="name">bank.statement.config.search.bn</field>
        <field name="model">bank.statement.config</field>
        <field name="arch" type="xml">
            <search string="Bank Statement Config">
                <field name="name"/>
                <separator/>
                <filter name="bn_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="bn_filter_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="bn_group_by">
                    <filter name="bn_group_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="bn_search_bank_statement_header_type" model="ir.ui.view">
        <field name="name">bank.statement.header.type.search.bn</field>
        <field name="model">bank.statement.header.type</field>
        <field name="arch" type="xml">
            <search string="Bank Statement Header Type">
                <field name="name"/>
                <separator/>
                <filter name="bn_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="bn_filter_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="bn_group_by">
                    <filter name="bn_group_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
