<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Journal Entries: show whether the entry is bank reconciled -->
    <record id="view_move_form_inherit_bank_reconciliation" model="ir.ui.view">
        <field name="name">account.move.form.inherit.bank.reconciliation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="is_bank_reconciled" widget="boolean_toggle" readonly="1" invisible="move_type != 'entry'"/>
                <field name="bank_reconciliation_id" readonly="1" invisible="not bank_reconciliation_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_tree_inherit_bank_reconciliation" model="ir.ui.view">
        <field name="name">account.move.tree.inherit.bank.reconciliation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="is_bank_reconciled" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="bank_reconciliation_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_filter_inherit_bank_reconciliation" model="ir.ui.view">
        <field name="name">account.move.filter.inherit.bank.reconciliation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="after">
                <separator/>
                <filter string="Bank Reconciled" name="bank_reconciled" domain="[('is_bank_reconciled', '=', True)]"/>
                <filter string="Not Bank Reconciled" name="not_bank_reconciled" domain="[('is_bank_reconciled', '=', False)]"/>
            </filter>
        </field>
    </record>

    <!-- Journal Items -->
    <record id="view_move_line_tree_inherit_bank_reconciliation" model="ir.ui.view">
        <field name="name">account.move.line.tree.inherit.bank.reconciliation</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="matching_number" position="after">
                <field name="is_bank_reconciled" widget="boolean_toggle" readonly="1" optional="show"/>
                <field name="bank_reconciliation_id" readonly="1" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_account_move_line_filter_inherit_bank_reconciliation" model="ir.ui.view">
        <field name="name">account.move.line.filter.inherit.bank.reconciliation</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_account_move_line_filter"/>
        <field name="arch" type="xml">
            <filter name="unreconciled" position="after">
                <separator/>
                <filter string="Bank Reconciled" name="bank_reconciled" domain="[('bank_reconciliation_id', '!=', False)]"/>
                <filter string="Not Bank Reconciled" name="not_bank_reconciled" domain="[('bank_reconciliation_id', '=', False)]"/>
            </filter>
        </field>
    </record>

</odoo>
