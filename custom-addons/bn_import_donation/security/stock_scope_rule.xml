<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml): only the warehouses / locations set on the user; a document without one yet stays visible. -->

    <record id="scope_import_donation_rule" model="ir.rule">
        <field name="name">Import Donation: allowed warehouses / locations</field>
        <field name="model_id" ref="bn_import_donation.model_import_donation"/>
        <field name="domain_force">['|', ('warehouse_id', '=', False), ('warehouse_id', 'in', user.allowed_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_import_donation_unrestricted_rule" model="ir.rule">
        <field name="name">Import Donation: unrestricted</field>
        <field name="model_id" ref="bn_import_donation.model_import_donation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
