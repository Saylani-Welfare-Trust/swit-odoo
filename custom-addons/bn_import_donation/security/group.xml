<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- One tier ladder for the whole module - covers both the manual Excel
         import flow and the automated API donation flow, instead of two
         separate, inconsistent group families. -->
    <record id="import_donation_user_group" model="res.groups">
        <field name="name">Import Donation / User</field>
        <field name="category_id" ref="module_import_donation"/>
        <field name="comment">Day-to-day staff: run imports and API syncs, view results. Cannot approve invalid rows, confirm batches, or touch configuration.</field>
    </record>

    <record id="import_donation_manager_group" model="res.groups">
        <field name="name">Import Donation / Manager</field>
        <field name="category_id" ref="module_import_donation"/>
        <field name="implied_ids" eval="[(4, ref('import_donation_user_group'))]"/>
        <field name="comment">Runs the operation: approves invalid rows, confirms/posts import batches, triggers manual API syncs, creates partners from API donations.</field>
    </record>

    <record id="import_donation_audit_group" model="res.groups">
        <field name="name">Import Donation / Audit</field>
        <field name="category_id" ref="module_import_donation"/>
        <field name="comment">Read-only oversight across the whole module (batches, donations, API syncs, fetch history and logs) for reporting - no create, write or delete anywhere.</field>
    </record>

    <record id="import_donation_admin_group" model="res.groups">
        <field name="name">Import Donation / Admin</field>
        <field name="category_id" ref="module_import_donation"/>
        <field name="implied_ids" eval="[(4, ref('import_donation_manager_group')), (4, ref('import_donation_audit_group'))]"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights and Gateway Config / Header Type configuration.</field>
    </record>

</odoo>
