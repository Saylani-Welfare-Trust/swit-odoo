<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fetch_log_view_tree" model="ir.ui.view">
        <field name="name">fetch.log.view.tree</field>
        <field name="model">fetch.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="status" />
                <field name="reason" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <record id="fetch_log_view_search" model="ir.ui.view">
        <field name="name">fetch.log.view.search</field>
        <field name="model">fetch.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="status" />
                <field name="reason" />
                <field name="fetch_history_id" />
                <separator />
                <filter string="Error" name="filter_error" domain="[('status', '=', 'Error')]" />
                <filter string="Processing" name="filter_processing" domain="[('status', '=', 'Processing')]" />
                <filter string="Skipped" name="filter_skipped" domain="[('status', '=', 'Skipped')]" />
                <separator />
                <filter string="Date" name="filter_create_date" date="create_date" />
                <group string="Group By">
                    <filter string="Status" name="group_status" domain="[]" context="{'group_by': 'status'}" />
                    <filter string="Fetch History" name="group_fetch_history" domain="[]" context="{'group_by': 'fetch_history_id'}" />
                    <filter string="Date" name="group_create_date" domain="[]" context="{'group_by': 'create_date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="fetch_all_log_action" model="ir.actions.act_window">
        <field name="name">Fetch All Logs</field>
        <field name="res_model">fetch.log</field>
        <field name="view_mode">tree</field>
        <field name="context">{
            'create': 0,
            'edit': 0,
            'delete': 0,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Waiting for Fetch Logs....
            </p>
        </field>
    </record>
    
    <record id="fetch_error_log_action" model="ir.actions.act_window">
        <field name="name">Fetch Error Logs</field>
        <field name="res_model">fetch.log</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('status', '=', 'Error')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Waiting for Fetch Logs....
            </p>
        </field>
    </record>

    <menuitem
        id="fetch_log_menu"
        name="Fetch Logs"
        parent="bn_import_donation.api_donation_menu"
        sequence="3"/>

    <menuitem
        id="fetch_all_log_menu"
        name="Fetch All Logs"
        groups="bn_import_donation.import_donation_audit_group"
        action="fetch_all_log_action"
        parent="fetch_log_menu"
        sequence="0"/>

    <menuitem
        id="fetch_error_log_menu"
        name="Fetch Error Logs"
        action="fetch_error_log_action"
        parent="fetch_log_menu"
        sequence="1"/>

</odoo>
