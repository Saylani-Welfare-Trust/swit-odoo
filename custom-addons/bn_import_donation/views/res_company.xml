<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base_view_company_form_inherit_bn_import_donation" model="ir.ui.view">
        <field name="name">base.view.company.form.inherit.bn.import.donation</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="donation_api_configuration" string="Donation API" groups="bn_import_donation.import_donation_admin_group,base.group_system">
                    <group string="Website Donation API">
                        <group name="donation_api_configuration_col_1">
                            <field name="url" widget="url" />
                        </group>
                        <group name="donation_api_configuration_col_2">
                            <field name="client_id" />
                            <field name="client_secret" password="True" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
