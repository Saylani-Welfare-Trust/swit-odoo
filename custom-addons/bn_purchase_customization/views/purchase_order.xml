<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_purchase_order_form_inherit_bn_purchase_customization" model="ir.ui.view">
        <field name="name">purchase.purchase.order.form.inherit.bn.purchase.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_open_comparative_analysis" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="not comparative_count">
                    <field name="comparative_count" string="Comparative Orders" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button string="CXO Approval" name="action_cxo_approve_po" type="object" class="oe_highlight"
                        groups="bn_purchase_customization.purchase_cxo_group"
                        invisible="cxo_approved or state not in ('draft', 'sent')"/>
                <button string="HOD Approval" name="action_hod_approve_po" type="object" class="oe_highlight"
                        groups="bn_purchase_customization.purchase_hod_group"
                        invisible="not cxo_approved or hod_approved or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <group string="Approval Status" invisible="state not in ('draft', 'sent')">
                    <group>
                        <field name="cxo_approved" widget="boolean_toggle" readonly="1"/>
                        <field name="cxo_approved_by" readonly="1"/>
                        <field name="cxo_approved_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="hod_approved" widget="boolean_toggle" readonly="1"/>
                        <field name="hod_approved_by" readonly="1"/>
                        <field name="hod_approved_date" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="before">
                <field name="on_hand_qty" readonly="1"/>
                <field name="last_purchase_amount" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="payment_status" widget="badge"
                       decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'draft'"
                       invisible="state not in ('purchase', 'done')"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Orders list -->
    <record id="purchase_order_view_tree_inherit_bn_purchase_customization" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.inherit.bn.purchase.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_status']" position="after">
                <field name="payment_status" widget="badge"
                       decoration-success="payment_status == 'paid'" decoration-warning="payment_status == 'draft'"
                       optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="purchase_order_view_search_inherit_bn_purchase_customization" model="ir.ui.view">
        <field name="name">purchase.order.view.search.inherit.bn.purchase.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <separator/>
                <filter name="payment_paid" string="Paid" domain="[('payment_status', '=', 'paid')]"/>
                <filter name="payment_draft" string="Payment Draft"
                        domain="[('payment_status', '=', 'draft'), ('state', 'in', ('purchase', 'done'))]"/>
            </xpath>
            <xpath expr="//filter[@name='vendor']" position="after">
                <filter string="Payment Status" name="group_payment_status" context="{'group_by': 'payment_status'}"/>
            </xpath>
        </field>
    </record>

</odoo>