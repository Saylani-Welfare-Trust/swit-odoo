<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="purchase_purchase_order_form_inherit_bn_purchase_customization" model="ir.ui.view">
        <field name="name">purchase.purchase.order.form.inherit.bn.purchase.customization</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_button_box']" position="inside">
                <button name="action_open_comparative_analysis" type="object" class="oe_stat_button" icon="fa-list-alt" invisible="not comparative_count">
                    <field name="comparative_count" string="Comparative Orders" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button string="CXO Approval" name="action_cxo_approve_po" type="object" class="oe_highlight"
                        groups="bn_purchase_customization.purchased_cxo_group"
                        invisible="cxo_approved or state not in ('draft', 'sent')"/>
                <button string="HOD Approval" name="action_hod_approve_po" type="object" class="oe_highlight"
                        groups="bn_purchase_customization.purchase_hod_group"
                        invisible="not cxo_approved or hod_approved or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="after">
                <group string="Approval Status" invisible="state not in ('draft', 'sent')">
                    <group>
                        <field name="cxo_approved" widget="boolean_toggle" readonly="1"/>
                        <field name="cxo_approved_by" readonly="1"/>
                        <field name="cxo_approved_date" readonly="1"/>
                    </group>
                    <group>
                        <field name="hod_approved" widget="boolean_toggle" readonly="1"/>
                        <field name="hod_approved_by" readonly="1"/>
                        <field name="hod_approved_date" readonly="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_qty']" position="before">
                <field name="on_hand_qty" readonly="1"/>
                <field name="last_purchase_amount" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
