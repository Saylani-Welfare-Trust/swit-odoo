<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inherit_on_hand_qty" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.on.hand.qty</field>
        <field name="model">stock.picking</field>
        <!-- Change the inherit_id here -->
        <field name="inherit_id" ref="purchase_stock.view_picking_form_inherit_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_create_invoice']" position="attributes">
                <attribute name="string">Confirm to Bill</attribute>
            </xpath>
        </field>
    </record>
</odoo>