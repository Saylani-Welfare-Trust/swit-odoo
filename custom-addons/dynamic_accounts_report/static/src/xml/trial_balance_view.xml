<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="trl_b_template_new" owl="1">
        <div class="container-fluid px-0">
                <!--  Filter View  -->
                <div class="card shadow-sm mb-3">
                    <div class="card-header">
                        <h1 class="h4 mb-0">
                            <t t-esc="props.action.name"/>
                        </h1>
                    </div>
                    <div class="card-body">
                        <div class="row align-items-start g-3">
                        <div class="col-12 col-xl-3">
                            <div class="d-flex flex-wrap gap-2">
                                <!-- Print (PDF) Button -->
                                <button type="button"
                                        class="btn btn-primary"
                                        t-on-click="printPdf">
                                    Print (PDF)
                                </button>
                                <!-- Export (XLSX) Button -->
                                <button type="button"
                                        class="btn btn-outline-primary"
                                        t-on-click="print_xlsx">
                                    Export (XLSX)
                                </button>
                            </div>
                        </div>
                        <div class="col-12 col-xl-9">
                            <div class="row g-2">
                            <!-- Account Filter -->
                            <div class="dropdown">
                                <a type="button" class="dropdown-toggle"
                                data-bs-toggle="dropdown" style="display: flex;
                                                                    text-wrap: wrap;
                                                                    flex-direction: row;
                                                                    align-items: center;
                                                                    justify-content: flex-start;
                                                                    min-width: 105px;">
                                    <span class="fa fa-list" title="Accounts" role="img"/>
                                    Accounts
                                    <t t-if="state.selected_analytic_account_rec.length">
                                        :
                                        <t t-foreach="state.selected_analytic_account_rec"
                                        t-as="acc"
                                        t-key="acc.id">
                                            <t t-esc="acc.code"/> <t t-esc="acc.name"/>
                                            <t t-if="acc_index != state.selected_analytic_account_rec.length - 1">,
                                            </t>
                                        </t>
                                    </t>
                                </a>
                                <div class="dropdown-menu w-100" role="menu"
                                    style="max-height: 420px; overflow-y: auto; min-width: 260px;">
                                    <div class="list-group">
                                        <t t-if="state.accounts and state.accounts.length">
                                            <t t-foreach="state.accounts"
                                            t-as="account"
                                            t-key="account.id">
                                                <button class="dropdown-item"
                                                        t-att-data-value="'account'"
                                                        t-att-data-id="account.id"
                                                        t-attf-class="dropdown-item #{state.selected_analytic.includes(account.id) ? 'active' : ''}"
                                                        type="button"
                                                        t-on-click="applyFilter">
                                                    <t t-esc="account.code"/> — <t t-esc="account.name"/>
                                                </button>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div class="text-muted px-3 py-2">
                                                No accounts
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- Time Range -->
                            <div class="dropdown">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <!-- Date Range Dropdown -->
                                    <span class="fa fa-calendar" title="Dates"
                                          role="img"
                                          aria-label="Dates"/>
                                    Date Range
                                </a>
                                <div class="dropdown-menu w-100" role="menu">
                                    <!-- Date Range Options -->
                                    <div class="list-group">
                                        <!-- This Month Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'month'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            This Month
                                        </button>
                                        <!-- This Quarter Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'quarter'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            This Quarter
                                        </button>
                                        <!-- This Year Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'year'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            This Year
                                        </button>
                                        <!-- Separator -->
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <!-- Last Month Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'last-month'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            Last month
                                        </button>
                                        <!-- Last Quarter Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'last-quarter'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            Last quarter
                                        </button>
                                        <!-- Last Year Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'last-year'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            Last year
                                        </button>
                                        <!-- Separator -->
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <!-- Start Date -->
                                        <label  for="date_from">Start
                                            Date :
                                        </label>
                                        <div class="input-group date"
                                             data-target-input="nearest">

                                            <input type="date" id="start_date" class="form-control" t-on-change="applyFilter" t-ref="date_from" name="start_date"/>
                                        </div>
                                        <!-- End Date -->
                                        <label  for="date_to">End Date
                                            :
                                        </label>
                                        <div class="input-group date"
                                             data-target-input="nearest">
                                            <input type="date" id="end_date" class="form-control" t-on-change="applyFilter" t-ref="date_to" name="end_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <span class="fa fa-signal"
                                          title="Comparison"
                                          role="img"
                                          aria-label="Comparison"/>
                                    Comparison
                                </a>
                                <div class="dropdown-menu w-100" role="menu">
                                    <div class="list-group">
                                        <button class="dropdown-item"
                                                t-att-data-value="'no comparison'"
                                                type="button"
                                                t-on-click="applyComparison">
                                            No Comparison
                                        </button>
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <label  for="periods"
                                               style="display: flex;padding: 4px 20px;color: #000;">
                                            Previous Period
                                            <br/>
                                            Number of Periods:
                                        </label>
                                        <div class="input-group"
                                             data-target-input="nearest">

                                            <input type="number" class="form-control" t-ref="periods" min="1" t-on-input="onPeriodChange" name="previous_period"/>
                                        </div>
                                        <button class="btn btn-primary"
                                                type="button"
                                                style="margin-left: 19px;margin-top: 4px;"
                                                t-on-click="applyComparisonPeriod">
                                            Apply
                                        </button>
                                        <div role="separator"
                                             class="dropdown-divider"/>
                                        <label  for="period_year"
                                               style="display: flex;padding: 4px 20px;color: #000;">
                                            Same Period Last Year
                                            <br/>
                                            Number of Periods:
                                        </label>
                                        <div class="input-group"
                                             data-target-input="nearest">
                                            <input type="number" class="form-control" t-ref="period_year" t-on-input="onPeriodYearChange" min="1" name="period_year"/>
                                        </div>
                                        <button class="btn btn-primary"
                                                type="button"
                                                style="margin-left: 19px;margin-top: 4px;"
                                                t-on-click="applyComparisonYear">
                                            Apply
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown" style="display: flex;
                                                                    text-wrap: wrap;
                                                                    flex-direction: row;
                                                                    align-items: center;
                                                                    justify-content: flex-start;
                                                                    min-width: 105px;">
                                    <span class="fa fa-book" title="Journals"
                                          role="img"/>
                                    Journals
                                    <t t-if="state.selected_journal_list">:
                                        <t t-foreach="state.selected_journal_list"
                                           t-as="Journal_key"
                                           t-key="Journal_key_index">
                                            <t t-foreach="state.journals"
                                               t-as="Journal"
                                               t-key="Journal_index">
                                                <t t-if="Journal['id'] == Journal_key">
                                                    <t t-esc="Journal['name']"/>
                                                </t>
                                            </t>
                                            <t t-if="Journal_key_index != Object.keys(state.selected_journal_list).length - 1">
                                                ,
                                            </t>
                                        </t>
                                    </t>
                                </a>
                                <div class="dropdown-menu w-100" role="menu">
                                    <div class="list-group">
                                        <t t-if="state.journals">
                                            <t t-foreach="state.journals"
                                               t-as="journal"
                                               t-key="journal.id">
                                                <button class="dropdown-item"
                                                        t-att-data-value="'journal'"
                                                        t-att-data-id="journal.id"
                                                        type="button"
                                                        t-on-click="applyFilter">
                                                    <t t-esc="journal.name"/>
                                                </button>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </div>
                            <!-- Options Dropdown -->
                            <div class="dropdown">
                                <a type="button" class="dropdown-toggle"
                                   data-bs-toggle="dropdown">
                                    <span class="fa fa-glass" title="Accounts"
                                          role="img"
                                          aria-label="Dates"/>
                                    Options : Posted Entries ,
                                    <t t-esc="Object.keys(state.method)[(Object.keys(state.method).length)-1]"/>
                                </a>
                                <div class="dropdown-menu w-100" role="menu">
                                    <div class="list-group">
                                        <!-- Include Draft Entries Button -->
                                        <button class="dropdown-item"
                                                t-att-data-value="'draft'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            Include Draft Entries
                                        </button>
                                        <button class="dropdown-item"
                                                t-att-data-value="'cash-basis'"
                                                type="button"
                                                t-on-click="applyFilter">
                                            Cash basis method
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                </div>
                </div>
            <div class="table-responsive border rounded shadow-sm" style="height: 650px; overflow-y: auto;">
                <div t-ref="table_view_gl">
                    <table class="table table-hover table-bordered table-sm align-middle mb-0" cellspacing="0" width="100%">
                                                                <thead>
                                    <tr class="table-light text-center align-middle">
                                        <th>Code</th>
                                        <th colspan="5">Account</th>
                                        <th>Initial Balance</th>
                                        <t t-if="state.date_viewed.length != 0">
                                            <t t-foreach="state.date_viewed"
                                               t-as="date_view"
                                               t-key="date_view_index">
                                                <th colspan="2">
                                                    <t t-esc="date_view"/>
                                                </th>
                                            </t>
                                        </t>
                                        <th>End Balance</th>
                                    </tr>
                                    <tr class="table-light text-center align-middle">
                                        <th colspan="6"/>
                                        <th/>                                   <!-- empty cell under Initial Balance -->
                                        <t t-if="state.apply_comparison == true">
                                            <t t-set="number_of_periods"
                                            t-value="comparison_number_range"/>
                                            <t t-foreach="number_of_periods"
                                            t-as="number" t-key="number">
                                                <th>Debit</th>
                                                <th>Credit</th>
                                            </t>
                                        </t>
                                        <th>Debit</th>                          <!-- current month -->
                                        <th>Credit</th>
                                        <th/>                                   <!-- empty cell under End Balance -->
                                    </tr>
                                </thead>
                                <tbody t-ref="tbody">
                                    <t t-if="state.data">
                                        <t t-set="current_internal_group" t-value="null"/>
                                        <t t-set="current_group" t-value="null"/>
                                        <t t-set="i" t-value="0"/>
                                        <t t-foreach="state.data" t-as="move_line" t-key="move_line_index">
                                            <t t-set="i" t-value="i + 1"/>

                                            <!-- New internal group: close out the previous one's sub-group + internal-group totals first -->
                                            <t t-if="(move_line.internal_group || 'Other') !== current_internal_group">
                                                <t t-if="current_group !== null">
                                                    <!-- close the last sub-group of the PREVIOUS internal group -->
                                                    <tr class="fw-bold border-top">
                                                        <th/>
                                                        <th colspan="5" class="text-start">Total</th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'initial_balance'))"/>
                                                        </th>
                                                        <t t-if="state.apply_comparison == true">
                                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                            <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                                <th class="text-center">
                                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_debit_' + nb))"/>
                                                                </th>
                                                                <th class="text-center">
                                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_credit_' + nb))"/>
                                                                </th>
                                                            </t>
                                                        </t>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_debit'))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_credit'))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'end_balance'))"/>
                                                        </th>
                                                    </tr>
                                                </t>
                                                <t t-if="current_internal_group !== null">
                                                    <!-- Internal-group grand subtotal (e.g. all of "Asset") -->
                                                    <tr class="fw-bold table-secondary border-top border-2">
                                                        <th/>
                                                        <th colspan="5" class="text-start">
                                                            <t t-esc="current_internal_group"/> Total
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'initial_balance'))"/>
                                                        </th>
                                                        <t t-if="state.apply_comparison == true">
                                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                            <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                                <th class="text-center">
                                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'dynamic_total_debit_' + nb))"/>
                                                                </th>
                                                                <th class="text-center">
                                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'dynamic_total_credit_' + nb))"/>
                                                                </th>
                                                            </t>
                                                        </t>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'total_debit'))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'total_credit'))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'end_balance'))"/>
                                                        </th>
                                                    </tr>
                                                </t>

                                                <!-- New internal-group header -->
                                                <tr class="table-secondary fw-bold" style="cursor:pointer;"
                                                    t-on-click="() => this.toggleInternalGroup(move_line.internal_group || 'Other')">
                                                    <th colspan="11" class="text-start" style="padding:10px 8px;letter-spacing:0.5px;">
                                                        <span class="me-2" style="margin-right:8px;font-size:14px;">
                                                            <i t-att-class="this.isInternalGroupCollapsed(move_line.internal_group || 'Other') ? 'fa fa-caret-right' : 'fa fa-caret-down'"/>
                                                        </span>
                                                        <t t-esc="(move_line.internal_group || 'Other').toUpperCase()"/>
                                                    </th>
                                                </tr>
                                                <t t-set="current_internal_group" t-value="move_line.internal_group || 'Other'"/>
                                                <t t-set="current_group" t-value="null"/>
                                            </t>

                                            <!-- Only render sub-group / account rows while the internal group is expanded -->
                                            <t t-if="!this.isInternalGroupCollapsed(current_internal_group)">

                                                <!-- New sub-group (account type) within this internal group -->
                                                <t t-if="(move_line.group_label || 'Other') !== current_group">
                                                    <t t-if="current_group !== null">
                                                        <!-- Subtotal for the PREVIOUS sub-group -->
                                                        <tr class="fw-bold border-top">
                                                            <th/>
                                                            <th colspan="5" class="text-start">Total</th>
                                                            <th class="text-center">
                                                                <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'initial_balance'))"/>
                                                            </th>
                                                            <t t-if="state.apply_comparison == true">
                                                                <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                                <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                                    <th class="text-center">
                                                                        <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_debit_' + nb))"/>
                                                                    </th>
                                                                    <th class="text-center">
                                                                        <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_credit_' + nb))"/>
                                                                    </th>
                                                                </t>
                                                            </t>
                                                            <th class="text-center">
                                                                <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_debit'))"/>
                                                            </th>
                                                            <th class="text-center">
                                                                <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_credit'))"/>
                                                            </th>
                                                            <th class="text-center">
                                                                <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'end_balance'))"/>
                                                            </th>
                                                        </tr>
                                                    </t>
                                                    <tr class="table-light fw-bold" style="cursor:pointer;"
                                                        t-on-click="() => this.toggleGroup(move_line.group_label || 'Other')">
                                                        <th colspan="11" class="text-start" style="padding:8px 8px 8px 28px;">
                                                            <span class="me-2" style="margin-right:8px;font-size:12px;">
                                                                <i t-att-class="this.isGroupCollapsed(move_line.group_label || 'Other') ? 'fa fa-caret-right' : 'fa fa-caret-down'"/>
                                                            </span>
                                                            <t t-esc="move_line.group_label || 'Other'"/>
                                                        </th>
                                                    </tr>
                                                    <t t-set="current_group" t-value="move_line.group_label || 'Other'"/>
                                                </t>

                                                <!-- Account row: hidden while its sub-group is collapsed -->
                                                <t t-if="!this.isGroupCollapsed(current_group)">
                                                    <tr class="border-bottom" style="border-spacing: 0 10px;">
                                                        <th class="text-start">
                                                            <t t-esc="move_line['account_code']"/>
                                                        </th>
                                                        <th colspan="5" class="text-start" style="padding-left:20px;">
                                                            <div class="dropdown">
                                                                <a class="dropdown-toggle" data-bs-toggle="dropdown" style="color: black;">
                                                                    <span><t t-esc="move_line['account_name']"/></span>
                                                                </a>
                                                                <div class="dropdown-menu">
                                                                    <a role="menuitem"
                                                                    t-att-data-account-id="move_line['account_id']"
                                                                    t-att-data-account-name="move_line['account']"
                                                                    t-on-click="show_gl"
                                                                    class="dropdown-item">
                                                                        General Ledger (this period)
                                                                    </a>
                                                                    <div role="separator" class="dropdown-divider"/>
                                                                    <a role="menuitem"
                                                                    t-att-data-id="move_line['account_id']"
                                                                    t-on-click="gotoJournalItem" class="dropdown-item">
                                                                        Journal Items
                                                                    </a>
                                                                </div>
                                                            </div>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(move_line.initial_balance)"/>
                                                        </th>
                                                        <t t-if="state.apply_comparison == true">
                                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                            <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                                <th class="text-center">
                                                                    <t t-if="move_line['dynamic_total_debit_' + num]"
                                                                    t-esc="this.formatAmount(move_line['dynamic_total_debit_' + num])"/>
                                                                </th>
                                                                <th class="text-center">
                                                                    <t t-if="move_line['dynamic_total_credit_' + num]"
                                                                    t-esc="this.formatAmount(move_line['dynamic_total_credit_' + num])"/>
                                                                </th>
                                                            </t>
                                                        </t>
                                                        <th class="text-center">
                                                            <t t-if="move_line['total_debit']"
                                                            t-esc="this.formatAmount(move_line['total_debit'])"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-if="move_line['total_credit']"
                                                            t-esc="this.formatAmount(move_line['total_credit'])"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(move_line['end_balance'])"/>
                                                        </th>
                                                    </tr>
                                                </t>
                                            </t>
                                        </t>

                                        <!-- Close out the very last sub-group + internal-group -->
                                        <t t-if="current_group !== null and !this.isInternalGroupCollapsed(current_internal_group)">
                                            <tr class="fw-bold border-top">
                                                <th/>
                                                <th colspan="5" class="text-start">Total</th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'initial_balance'))"/>
                                                </th>
                                                <t t-if="state.apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_debit_' + nb))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'dynamic_total_credit_' + nb))"/>
                                                        </th>
                                                    </t>
                                                </t>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_debit'))"/>
                                                </th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'total_credit'))"/>
                                                </th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.groupSumByKey(state.data, current_group, 'end_balance'))"/>
                                                </th>
                                            </tr>
                                        </t>
                                        <t t-if="current_internal_group !== null">
                                            <tr class="fw-bold table-secondary border-top border-2">
                                                <th/>
                                                <th colspan="5" class="text-start">
                                                    <t t-esc="current_internal_group"/> Total
                                                </th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'initial_balance'))"/>
                                                </th>
                                                <t t-if="state.apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'dynamic_total_debit_' + nb))"/>
                                                        </th>
                                                        <th class="text-center">
                                                            <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'dynamic_total_credit_' + nb))"/>
                                                        </th>
                                                    </t>
                                                </t>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'total_debit'))"/>
                                                </th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'total_credit'))"/>
                                                </th>
                                                <th class="text-center">
                                                    <t t-esc="this.formatAmount(this.internalGroupSumByKey(state.data, current_internal_group, 'end_balance'))"/>
                                                </th>
                                            </tr>
                                        </t>

                                        <!-- Grand total across everything -->
                                        <tr class="table-dark fw-bold fs-6 border-bottom">
                                            <th/>
                                            <th colspan="5" class="text-start">Grand Total</th>
                                            <th class="text-end">
                                                <t t-esc="this.formatAmount(sumByKey(state.data, 'initial_balance'))"/>
                                            </th>
                                            <t t-if="state.apply_comparison == true">
                                                <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                <t t-foreach="number_of_periods" t-as="nb" t-key="nb">
                                                    <th class="text-end">
                                                        <t t-esc="this.formatAmount(sumByKey(state.data, 'dynamic_total_debit_' + nb))"/>
                                                    </th>
                                                    <th class="text-end">
                                                        <t t-esc="this.formatAmount(sumByKey(state.data, 'dynamic_total_credit_' + nb))"/>
                                                    </th>
                                                </t>
                                            </t>
                                            <th class="text-end">
                                                <t t-esc="this.formatAmount(sumByKey(state.data, 'total_debit'))"/>
                                            </th>
                                            <th class="text-end">
                                                <t t-esc="this.formatAmount(sumByKey(state.data, 'total_credit'))"/>
                                            </th>
                                            <th class="text-end">
                                                <t t-esc="this.formatAmount(sumByKey(state.data, 'end_balance'))"/>
                                            </th>
                                        </tr>
                                    </t>
                                </tbody>
                    </table>
                </div>
            </div>
        </div>
    </t>
</templates>
