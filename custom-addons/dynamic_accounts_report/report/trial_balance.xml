<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="trial_balance">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="data_report_margin_top" t-value="12"/>
                <t t-set="data_report_header_spacing" t-value="9"/>
                <t t-set="data_report_dpi" t-value="110"/>
                <div class="page">

                    <!-- ============ TITLE ============ -->
                    <h2 style="text-align:center;font-weight:700;letter-spacing:0.5px;
                               margin-bottom:4px;">
                        <t t-esc="report_name"/>
                    </h2>
                    <div style="text-align:center;font-size:11px;color:#555;
                                margin-bottom:18px;">
                        Trial Balance Report
                    </div>

                    <!-- ============ TABLE 1: NET BALANCE ============ -->
                    <table class="table table-sm table-reports"
                           style="width:fit-content;font-size:11px;
                                  border-collapse:collapse;">
                        <thead>
                            <tr style="background:#3a3a3a;color:#fff;font-weight:700;
                                       font-size:12px;">
                                <th colspan="6" style="padding:8px;text-align:left;">
                                    Account
                                </th>
                                <th style="padding:8px;text-align:center;border-left:1px solid #fff;">
                                    Initial Balance
                                </th>
                                <t t-foreach="date_viewed" t-as="date_view" t-key="date_view_index">
                                    <th colspan="2"
                                        style="padding:8px;text-align:center;border-left:1px solid #fff;">
                                        <t t-esc="date_view"/>
                                    </th>
                                </t>
                                <th style="padding:8px;text-align:center;border-left:1px solid #fff;">
                                    End Balance
                                </th>
                            </tr>
                            <tr style="background:#5c5c5c;color:#fff;font-weight:700;
                                       text-align:center;font-size:11px;">
                                <th colspan="6" style="padding:6px;"/>
                                <th style="padding:6px;border-left:1px solid #fff;"/>
                                <t t-if="apply_comparison == true">
                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                    <t t-foreach="number_of_periods" t-as="number" t-key="number">
                                        <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                        <th style="padding:6px;">Credit</th>
                                    </t>
                                </t>
                                <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                <th style="padding:6px;">Credit</th>
                                <th style="padding:6px;border-left:1px solid #fff;"/>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="data">
                                <t t-set="current_internal_group" t-value="False"/>
                                <t t-set="current_group" t-value="False"/>
                                <t t-foreach="data" t-as="move_line" t-key="move_line_index">

                                    <!-- ===== INTERNAL GROUP boundary ===== -->
                                    <t t-if="(move_line.get('internal_group') or 'Other') != current_internal_group">
                                        <t t-if="current_group">
                                            <tr style="font-weight:700;font-size:13px;
                                                       border-top:2px solid #000;
                                                       background:#f4f4f4;">
                                                <th/>
                                                <th colspan="5" style="text-align:left;padding:6px;">
                                                    Total
                                                </th>
                                                <th style="text-align:right;padding:6px;">
                                                    <t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/>
                                                </th>
                                                <t t-if="apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                    </t>
                                                </t>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                            </tr>
                                        </t>
                                        <t t-if="current_internal_group">
                                            <tr style="font-weight:700;font-size:14px;
                                                       background:#DADADA;
                                                       border-top:3px double #000;">
                                                <th/>
                                                <th colspan="5" style="text-align:left;padding:8px;">
                                                    <t t-esc="current_internal_group"/> Total
                                                </th>
                                                <th style="text-align:right;padding:8px;">
                                                    <t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/>
                                                </th>
                                                <t t-if="apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                                    </t>
                                                </t>
                                                <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                                <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                                <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                            </tr>
                                        </t>
                                        <tr style="background:#CFCFCF;font-weight:700;font-size:15px;
                                                   letter-spacing:1px;border-top:2px solid #000;
                                                   border-bottom:1px solid #000;">
                                            <th colspan="12" style="text-align:left;padding:10px 12px;">
                                                <t t-esc="(move_line.get('internal_group') or 'Other').upper()"/>
                                            </th>
                                        </tr>
                                        <t t-set="current_internal_group" t-value="move_line.get('internal_group') or 'Other'"/>
                                        <t t-set="current_group" t-value="False"/>
                                    </t>

                                    <!-- ===== SUB-GROUP boundary ===== -->
                                    <t t-if="(move_line.get('group_label') or 'Other') != current_group">
                                        <t t-if="current_group">
                                            <tr style="font-weight:700;font-size:13px;
                                                       border-top:2px solid #000;
                                                       background:#f4f4f4;">
                                                <th/>
                                                <th colspan="5" style="text-align:left;padding:6px;">
                                                    Total
                                                </th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <t t-if="apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                    </t>
                                                </t>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                            </tr>
                                        </t>
                                        <tr style="background:#EAEAEA;font-weight:700;font-size:13px;
                                                   border-top:1px solid #aaa;">
                                            <th colspan="12" style="text-align:left;padding:8px 12px 8px 30px;">
                                                <t t-esc="move_line.get('group_label') or 'Other'"/>
                                            </th>
                                        </tr>
                                        <t t-set="current_group" t-value="move_line.get('group_label') or 'Other'"/>
                                    </t>

                                    <!-- ===== ACCOUNT ROW ===== -->
                                    <tr style="border-bottom:1px solid #eee;">
                                        <th colspan="6" style="text-align:left;padding:6px 8px;">
                                            <t t-esc="move_line['account']"/>
                                        </th>
                                        <th style="text-align:right;padding:6px 8px;">
                                            <t t-esc="'{:,.0f}'.format(move_line.get('initial_balance',0.0))"/>
                                        </th>
                                        <t t-if="apply_comparison == true">
                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                            <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                <th style="text-align:right;padding:6px 8px;"><t t-if="move_line.get('dynamic_total_debit_'+str(num))"  t-esc="'{:,.0f}'.format(move_line['dynamic_total_debit_'+str(num)])"/></th>
                                                <th style="text-align:right;padding:6px 8px;"><t t-if="move_line.get('dynamic_total_credit_'+str(num))" t-esc="'{:,.0f}'.format(move_line['dynamic_total_credit_'+str(num)])"/></th>
                                            </t>
                                        </t>
                                        <th style="text-align:right;padding:6px 8px;"><t t-if="move_line.get('total_debit')"  t-esc="'{:,.0f}'.format(move_line['total_debit'])"/></th>
                                        <th style="text-align:right;padding:6px 8px;"><t t-if="move_line.get('total_credit')" t-esc="'{:,.0f}'.format(move_line['total_credit'])"/></th>
                                        <th style="text-align:right;padding:6px 8px;"><t t-esc="'{:,.0f}'.format(move_line.get('end_balance',0.0))"/></th>
                                    </tr>
                                </t>

                                <!-- close last sub-group -->
                                <t t-if="current_group">
                                    <tr style="font-weight:700;font-size:13px;
                                               border-top:2px solid #000;background:#f4f4f4;">
                                        <th/>
                                        <th colspan="5" style="text-align:left;padding:6px;">Total</th>
                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                        <t t-if="apply_comparison == true">
                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                            <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                            </t>
                                        </t>
                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                        <th style="text-align:right;padding:6px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group))"/></th>
                                    </tr>
                                </t>
                                <!-- close last internal group -->
                                <t t-if="current_internal_group">
                                    <tr style="font-weight:700;font-size:14px;background:#DADADA;
                                               border-top:3px double #000;">
                                        <th/>
                                        <th colspan="5" style="text-align:left;padding:8px;"><t t-esc="current_internal_group"/> Total</th>
                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                        <t t-if="apply_comparison == true">
                                            <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                            <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                                <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                            </t>
                                        </t>
                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                        <th style="text-align:right;padding:8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group))"/></th>
                                    </tr>
                                </t>

                                <!-- ===== GRAND TOTAL ===== -->
                                <tr style="background:#3a3a3a;color:#fff;font-weight:700;
                                           font-size:14px;border-top:3px double #000;">
                                    <th/>
                                    <th colspan="5" style="text-align:left;color:#fff;padding:10px 12px;">
                                        GRAND TOTAL
                                    </th>
                                    <th style="text-align:right;color:#fff;padding:10px 8px;">
                                        <t t-esc="'{:,.0f}'.format(sum(m.get('initial_balance',0.0) for m in data))"/>
                                    </th>
                                    <t t-if="apply_comparison == true">
                                        <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                        <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                            <th style="text-align:right;color:#fff;padding:10px 8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_debit_'+str(num),0.0)  for m in data))"/></th>
                                            <th style="text-align:right;color:#fff;padding:10px 8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data))"/></th>
                                        </t>
                                    </t>
                                    <th style="text-align:right;color:#fff;padding:10px 8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_debit',0.0)  for m in data))"/></th>
                                    <th style="text-align:right;color:#fff;padding:10px 8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('total_credit',0.0) for m in data))"/></th>
                                    <th style="text-align:right;color:#fff;padding:10px 8px;"><t t-esc="'{:,.0f}'.format(sum(m.get('end_balance',0.0)  for m in data))"/></th>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <br/><br/>

                    <!-- ============ TABLE 2: DEBIT / CREDIT BREAKDOWN ============ -->
                    <div style="font-size:13px;font-weight:700;margin-bottom:6px;">
                        Debit / Credit Breakdown
                    </div>
                    <table class="table table-sm table-reports"
                           style="width:fit-content;font-size:11px;border-collapse:collapse;">
                        <thead>
                            <tr style="background:#3a3a3a;color:#fff;font-weight:700;font-size:12px;">
                                <th colspan="6" style="padding:8px;text-align:left;">Account</th>
                                <th colspan="2" style="padding:8px;text-align:center;border-left:1px solid #fff;">Initial Balance</th>
                                <t t-if="date_viewed">
                                    <t t-foreach="date_viewed" t-as="date_view" t-key="date_view_index">
                                        <th colspan="2" style="padding:8px;text-align:center;border-left:1px solid #fff;">
                                            <t t-esc="date_view"/>
                                        </th>
                                    </t>
                                </t>
                                <th colspan="2" style="padding:8px;text-align:center;border-left:1px solid #fff;">End Balance</th>
                            </tr>
                            <tr style="background:#5c5c5c;color:#fff;font-weight:700;text-align:center;font-size:11px;">
                                <th colspan="6" style="padding:6px;"/>
                                <th colspan="2" style="padding:6px;border-left:1px solid #fff;"/>
                                <t t-if="apply_comparison == true">
                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                    <t t-foreach="number_of_periods" t-as="number" t-key="number">
                                        <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                        <th style="padding:6px;">Credit</th>
                                    </t>
                                </t>
                                <th colspan="2" style="padding:6px;border-left:1px solid #fff;"/>
                            </tr>
                            <tr style="background:#7a7a7a;color:#fff;font-weight:700;text-align:center;font-size:11px;">
                                <th colspan="6" style="padding:6px;"/>
                                <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                <th style="padding:6px;">Credit</th>
                                <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                <th style="padding:6px;">Credit</th>
                                <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                <th style="padding:6px;">Credit</th>
                                <t t-if="apply_comparison == true">
                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                    <t t-foreach="number_of_periods" t-as="number" t-key="number">
                                        <th style="padding:6px;border-left:1px solid #fff;">Debit</th>
                                        <th style="padding:6px;">Credit</th>
                                    </t>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="data">
                                <t t-set="current_internal_group" t-value="False"/>
                                <t t-set="current_group" t-value="False"/>
                                <t t-foreach="data" t-as="move_line" t-key="move_line_index">

                                    <!-- Internal group boundary -->
                                    <t t-if="(move_line.get('internal_group') or 'Other') != current_internal_group">
                                        <t t-if="current_group">
                                            <tr style="font-weight:700;font-size:13px;border-top:2px solid #000;background:#f4f4f4;">
                                                <th/><th colspan="5" style="text-align:left;padding:6px;">Total</th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('initial_total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('initial_total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                <t t-if="apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="num" t-key="num">
                                                        <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('dynamic_total_debit_'+str(num),0.0)  for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                        <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('dynamic_total_credit_'+str(num),0.0) for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                    </t>
                                                </t>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('end_total_debit',0.0)  for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                                <th style="text-align:right;padding:6px;"><t t-esc="sum(m.get('end_total_credit',0.0) for m in data if (m.get('group_label') or 'Other')==current_group)"/></th>
                                            </tr>
                                        </t>
                                        <t t-if="current_internal_group">
                                            <tr style="font-weight:700;font-size:14px;background:#DADADA;border-top:3px double #000;">
                                                <th/><th colspan="5" style="text-align:left;padding:8px;"><t t-esc="current_internal_group"/> Total</th>
                                                <th style="text-align:right;padding:8px;"><t t-esc="sum(m.get('initial_total_debit',0.0)  for m in data if (m.get('internal_group') or 'Other')==current_internal_group)"/></th>
                                                <th style="text-align:right;padding:8px;"><t t-esc="sum(m.get('initial_total_credit',0.0) for m in data if (m.get('internal_group') or 'Other')==current_internal_group)"/></th>
                                                <t t-if="apply_comparison == true">
                                                    <t t-set="number_of_periods" t-value="comparison_number_range"/>
                                                    <t t-foreach="number_of_periods" t-as="num" t-key="num">
