<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_direct_deposit_account_setup" model="ir.ui.view">
        <field name="name">direct.deposit.account.setup.form</field>
        <field name="model">direct.deposit.account.setup</field>
        <field name="arch" type="xml">
            <form string="Direct Deposit Account Setup" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="name" string="Account Prefix"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_direct_deposit_account_setup" model="ir.ui.view">
        <field name="name">direct.deposit.account.setup.tree.open.form</field>
        <field name="model">direct.deposit.account.setup</field>
        <field name="inherit_id" ref="bn_direct_deposit.bn_master_setup_view_direct_deposit_account_setup_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_direct_deposit.bn_master_setup_action_direct_deposit_account_setup" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
