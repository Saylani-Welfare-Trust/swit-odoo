<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A cheque order's receipt stays provisional until treasury clears the cheque -->

    <!-- Print Receipt button on the POS orders list -->
    <template id="pos_donation_receipt_template_inherit_bn_pos_cheque" inherit_id="bn_pos_order.pos_donation_receipt_template">
        <xpath expr="//t[@t-set='payment_method']" position="after">
            <t t-set="is_provisional" t-value="order.pos_cheque_id and order.pos_cheque_id.state != 'clear'"/>
        </xpath>

        <xpath expr="//div[hasclass('watermark')]" position="replace">
            <div class="watermark"><t t-if="is_provisional">Provisional</t><t t-else="">Duplicate</t></div>
        </xpath>

        <xpath expr="//h1[@t-if='order.is_non_donation_receipt']" position="replace">
            <h1 t-if="is_provisional">Provisional Receipt</h1>
            <h1 t-elif="order.is_non_donation_receipt">Non Donation Receipt</h1>
            <h1 t-else="">Donation Receipt</h1>
        </xpath>
        <xpath expr="//h1[normalize-space()='Donation Receipt']" position="replace"/>
    </template>

    <!-- Same receipt without the Duplicate mark (Print menu, WhatsApp PDF) -->
    <template id="pos_whatsapp_donation_receipt_template_inherit_bn_pos_cheque" inherit_id="bn_pos_order.pos_whatsapp_donation_receipt_template">
        <xpath expr="//t[@t-set='payment_method']" position="after">
            <t t-set="is_provisional" t-value="order.pos_cheque_id and order.pos_cheque_id.state != 'clear'"/>
        </xpath>

        <xpath expr="//div[hasclass('page')]/div[hasclass('row')][1]" position="before">
            <div t-if="is_provisional" class="watermark">Provisional</div>
        </xpath>

        <xpath expr="//h1[@t-if='order.is_non_donation_receipt']" position="replace">
            <h1 t-if="is_provisional" style="font-size: 15px;font-weight: bold;">Provisional Receipt</h1>
            <h1 t-elif="order.is_non_donation_receipt" style="font-size: 15px;font-weight: bold;">Non Donation Receipt</h1>
            <h1 t-else="" style="font-size: 15px;font-weight: bold;">Donation Receipt</h1>
        </xpath>
        <xpath expr="//h1[normalize-space()='Donation Receipt']" position="replace"/>
    </template>

</odoo>
