<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_cheque_view_tree" model="ir.ui.view">
        <field name="name">pos.cheque.view.tree</field>
        <field name="model">pos.cheque</field>
        <field name="arch" type="xml">
            <tree create="0" edit="1" delete="0" editable="bottom">
                <field name="order_reference" readonly="1" />
                <field name="donor_id" readonly="1" />
                <field name="amount" readonly="1" />
                <field name="analytic_account_id" string="Branch" readonly="1" />
                <field name="bank_id" string="Deposit to Bank" readonly="state not in ('draft', 'bounce')" />
                <field name="create_uid" readonly="1" />
                <field name="create_date" readonly="1" />
                <field name="name" string="Cheque No." readonly="1" />
                <field name="bank_name" readonly="1" />
                <field name="date" readonly="1" />
                <field name="bounce_count" readonly="1" />
                <field name="move_id" readonly="1" optional="hide" />
                <field name="state" widget="badge" readonly="1" decoration-info="state == 'draft'" decoration-warning="state == 'bounce'" decoration-success="state == 'clear'" decoration-danger="state == 'cancel'" />

                <button string="Show Linked POS Order" name="action_show_pos_order" type="object" class="oe_highlight"/>

                <button string="Clear" name="action_clear" type="object" class="oe_highlight" invisible="state not in ('draft', 'bounce') or bounce_count &gt;= 4" confirm="Clear this cheque and post its deposit to the bank?" />
                <button string="Bounce" name="action_bounce" type="object" invisible="state != 'draft' or bounce_count &gt;= 4" confirm="Mark this cheque as bounced?" />
                <button string="Print Receipt" name="action_print_receipt" type="object" icon="fa-print" invisible="state != 'clear'" />
            </tree>
        </field>
    </record>

    <record id="pos_cheque_view_search" model="ir.ui.view">
        <field name="name">pos.cheque.view.search</field>
        <field name="model">pos.cheque</field>
        <field name="arch" type="xml">
            <search>
                <!-- Searchable Fields -->
                <field name="name" string="Cheque No."/>
                <field name="order_reference" string="Order Ref"/>
                <field name="donor_id" string="Donor"/>
                <field name="bank_id" string="Bank Journal"/>
                <field name="bank_name" string="Bank Name"/>
                <field name="analytic_account_id" string="Branch"/>
                <field name="amount"/>

                <!-- Quick Filters -->
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Cleared" name="filter_clear" domain="[('state', '=', 'clear')]"/>
                <filter string="Bounced" name="filter_bounce" domain="[('state', '=', 'bounce')]"/>
                <filter string="Cancelled" name="filter_cancel" domain="[('state', '=', 'cancel')]"/>
                
                <separator/>
                
                <!-- Date Filter -->
                <filter string="Cheque Date" name="filter_date" date="date"/>

                <!-- Group By Options -->
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Branch" name="group_analytic" context="{'group_by': 'analytic_account_id'}"/>
                    <filter string="Bank Journal" name="group_bank" context="{'group_by': 'bank_id'}"/>
                    <filter string="Donor" name="group_donor" context="{'group_by': 'donor_id'}"/>
                    <filter string="Creation Month" name="group_create_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="pos_cheque_action" model="ir.actions.act_window">
        <field name="name">Cheque</field>
        <field name="res_model">pos.cheque</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Waiting for new pos cheque/qr code....
            </p>
        </field>
    </record>

    <menuitem
        id="treasury_menu"
        name="Treasury"
        parent="account.menu_finance"
        sequence="6"/>
    
    <menuitem
        id="pos_cheque_menu"
        name="POS Cheque"
        action="pos_cheque_action"
        groups="pos_cheque_menu_group"
        parent="bn_pos_cheque.treasury_menu"
        sequence="1"/>

</odoo>
