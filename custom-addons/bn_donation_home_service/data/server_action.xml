<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
    
        <record id="donation_home_service_action_server" model="ir.actions.server">
            <field name="name">Update Donation Home Service Total Amount | BN</field>
            <field name="model_id" ref="model_donation_home_service"/>
            <field name="binding_model_id" ref="model_donation_home_service"/>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.calculate_amount()
                    record.calculate_service_charges()
            </field>
        </record>
        
        <record id="donation_home_service_remarks_action_server" model="ir.actions.server">
            <field name="name">Update Donation Home Service Remarks | BN</field>
            <field name="model_id" ref="model_donation_home_service"/>
            <field name="binding_model_id" ref="model_donation_home_service"/>
            <field name="state">code</field>
            <field name="code">
                for record in records:
                    record.set_remarks()
            </field>
        </record>
    
    </data>

    <!-- Noupdate above: a database installed with an earlier version keeps that
         version's code (without the service charges). Set again on every
         install / upgrade. -->
    <function model="ir.actions.server" name="write"
              eval="[[ref('bn_donation_home_service.donation_home_service_action_server')], {'code': 'for record in records:\n    record.calculate_amount()\n    record.calculate_service_charges()\n'}]"/>

</odoo>
