<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="bn_search_donation_home_service" model="ir.ui.view">
        <field name="name">donation.home.service.search.bn</field>
        <field name="model">donation.home.service</field>
        <field name="arch" type="xml">
            <search string="Donation Home Service">
                <field name="name"/>
                <field name="pos_reference"/>
                <field name="pos_config_id"/>
                <field name="donor_id"/>
                <field name="donation_home_service_line_ids" string="Line Product" filter_domain="[('donation_home_service_line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="bn_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="bn_state_gate_out" string="Gate Out" domain="[('state', '=', 'gate_out')]"/>
                <filter name="bn_state_gate_in" string="Gate In" domain="[('state', '=', 'gate_in')]"/>
                <filter name="bn_state_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="bn_state_slotter" string="Slotter" domain="[('state', '=', 'slotter')]"/>
                <filter name="bn_state_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="bn_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="bn_filter_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="bn_group_by">
                    <filter name="bn_group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="bn_group_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="bn_group_donor_id" string="Donor" context="{'group_by': 'donor_id'}"/>
                    <filter name="bn_group_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
