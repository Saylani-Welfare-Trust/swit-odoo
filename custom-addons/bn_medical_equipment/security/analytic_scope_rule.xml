<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location: these records are matched on the Branch of the POS shop
         they were made or paid at (pos.link.mixin), which must be the analytic account tagged on
         one of the user's locations in scope, or the user's own Branch
         (res.users.scope_analytic_account_ids). A record not made at a POS stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_medical_equipment_rule" model="ir.rule">
        <field name="name">Medical Equipment: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_medical_equipment.model_medical_equipment"/>
        <field name="domain_force">['|', ('pos_analytic_account_id', '=', False), ('pos_analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_medical_equipment_unrestricted_rule" model="ir.rule">
        <field name="name">Medical Equipment: unrestricted</field>
        <field name="model_id" ref="bn_medical_equipment.model_medical_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_medical_security_deposit_rule" model="ir.rule">
        <field name="name">Medical Security Deposit: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_medical_equipment.model_medical_security_deposit"/>
        <field name="domain_force">['|', ('pos_analytic_account_id', '=', False), ('pos_analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_medical_security_deposit_unrestricted_rule" model="ir.rule">
        <field name="name">Medical Security Deposit: unrestricted</field>
        <field name="model_id" ref="bn_medical_equipment.model_medical_security_deposit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
