<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filters by status / date / archived and group-bys missing from the search views -->

    <record id="search_filters_medical_equipment" model="ir.ui.view">
        <field name="name">medical.equipment.search.filters</field>
        <field name="model">medical.equipment</field>
        <field name="inherit_id" ref="bn_medical_equipment.medical_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="pos_session_id"/>
                <field name="pos_cashier_id"/>
                <field name="pos_employee_id"/>
                <field name="pos_analytic_account_id"/>
                <field name="picking_id"/>
                <field name="return_picking_id"/>
                <field name="recovery_picking_id"/>
                <field name="area"/>
                <field name="employee_id"/>
                <field name="move_id"/>
                <separator/>
                <filter name="bn_date_last_sync_date" string="Last Sync Date" date="last_sync_date"/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_pos_session_id" string="POS Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="bn_groupby_pos_cashier_id" string="Cashier" context="{'group_by': 'pos_cashier_id'}"/>
                    <filter name="bn_groupby_pos_employee_id" string="Cashier (Employee)" context="{'group_by': 'pos_employee_id'}"/>
                    <filter name="bn_groupby_pos_analytic_account_id" string="Branch (Shop)" context="{'group_by': 'pos_analytic_account_id'}"/>
                    <filter name="bn_groupby_area" string="Area" context="{'group_by': 'area'}"/>
                    <filter name="bn_groupby_employee_id" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="bn_groupby_portal_sync_status" string="Portal Sync Status" context="{'group_by': 'portal_sync_status'}"/>
                    <filter name="bn_groupby_last_sync_date_month" string="Last Sync Date (Month)" context="{'group_by': 'last_sync_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_medical_security_deposit" model="ir.ui.view">
        <field name="name">medical.security.deposit.search.filters</field>
        <field name="model">medical.security.deposit</field>
        <field name="inherit_id" ref="bn_medical_equipment.search_medical_security_deposit"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="pos_session_id"/>
                <field name="pos_cashier_id"/>
                <field name="pos_employee_id"/>
                <field name="pos_analytic_account_id"/>
                <field name="cheque_no"/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_pos_session_id" string="POS Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="bn_groupby_pos_cashier_id" string="Cashier" context="{'group_by': 'pos_cashier_id'}"/>
                    <filter name="bn_groupby_pos_employee_id" string="Cashier (Employee)" context="{'group_by': 'pos_employee_id'}"/>
                    <filter name="bn_groupby_pos_analytic_account_id" string="Branch (Shop)" context="{'group_by': 'pos_analytic_account_id'}"/>
                    <filter name="bn_groupby_payment_method" string="Payment Method" context="{'group_by': 'payment_method'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
