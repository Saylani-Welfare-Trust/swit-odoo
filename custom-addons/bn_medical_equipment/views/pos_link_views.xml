<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="medical_equipment_view_form_pos_link" model="ir.ui.view">
        <field name="name">medical.equipment.form.pos.link</field>
        <field name="model">medical.equipment</field>
        <field name="inherit_id" ref="bn_medical_equipment.medical_equipment_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Point of Sale" name="pos_link_info" invisible="not pos_session_id and not pos_order_id">
                    <group>
                        <field name="pos_config_id" options="{'no_create': True}"/>
                        <field name="pos_session_id" options="{'no_create': True}"/>
                        <field name="pos_analytic_account_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="pos_cashier_id" options="{'no_create': True}"/>
                        <field name="pos_employee_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="pos_order_id" options="{'no_create': True}"/>
                        <field name="pos_reference"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="medical_security_deposit_view_tree_pos_link" model="ir.ui.view">
        <field name="name">medical.security.deposit.tree.pos.link</field>
        <field name="model">medical.security.deposit</field>
        <field name="inherit_id" ref="bn_medical_equipment.medical_security_deposit_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="pos_config_id" optional="show"/>
                <field name="pos_session_id" optional="show"/>
                <field name="pos_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
