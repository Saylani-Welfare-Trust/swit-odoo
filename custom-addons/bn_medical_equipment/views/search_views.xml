<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_medical_equipment" model="ir.ui.view">
        <field name="name">medical.equipment.search</field>
        <field name="model">medical.equipment</field>
        <field name="inherit_id" ref="bn_medical_equipment.medical_equipment_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="pos_reference"/>
                <field name="pos_config_id"/>
                <field name="refund_approved_by_1"/>
                <field name="refund_approved_by_2"/>
                <field name="medical_equipment_line_ids" string="Line Product" filter_domain="['|', ('medical_equipment_line_ids.product_id', 'ilike', self), ('reference_line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_send_for_inquiry" string="Send for Inquiry" domain="[('state', '=', 'send_for_inquiry')]"/>
                <filter name="filter_state_inquiry" string="Inquiry Officer" domain="[('state', '=', 'inquiry')]"/>
                <filter name="filter_state_ceo_approval" string="CEO Approval" domain="[('state', '=', 'ceo_approval')]"/>
                <filter name="filter_state_cfo_approval" string="CFO Approval" domain="[('state', '=', 'cfo_approval')]"/>
                <filter name="filter_state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_state_sd_received" string="Security Received" domain="[('state', '=', 'sd_received')]"/>
                <filter name="filter_state_payment_received" string="Payment Received" domain="[('state', '=', 'payment_received')]"/>
                <filter name="filter_state_validate" string="Validate" domain="[('state', '=', 'validate')]"/>
                <filter name="filter_state_return" string="Return" domain="[('state', '=', 'return')]"/>
                <filter name="filter_state_refund_ceo_approval" string="Refund Approval (1)" domain="[('state', '=', 'refund_ceo_approval')]"/>
                <filter name="filter_state_refund_cfo_approval" string="Refund Approval (2)" domain="[('state', '=', 'refund_cfo_approval')]"/>
                <filter name="filter_state_refund" string="Refund" domain="[('state', '=', 'refund')]"/>
                <filter name="filter_state_payment_return" string="Payment Return" domain="[('state', '=', 'payment_return')]"/>
                <filter name="filter_state_donate" string="Donate" domain="[('state', '=', 'donate')]"/>
                <filter name="filter_state_waiting_for_inventory_approval" string="Waiting for Inventory Approval" domain="[('state', '=', 'waiting_for_inventory_approval')]"/>
                <filter name="filter_state_recovered" string="Recovered" domain="[('state', '=', 'recovered')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="groupby_refund_approved_by_1" string="Refund Approved By (1)" context="{'group_by': 'refund_approved_by_1'}"/>
                    <filter name="groupby_refund_approved_by_2" string="Refund Approved By (2)" context="{'group_by': 'refund_approved_by_2'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_medical_equipment_category" model="ir.ui.view">
        <field name="name">medical.equipment.category.search</field>
        <field name="model">medical.equipment.category</field>
        <field name="arch" type="xml">
            <search string="Medical Equipment Category">
                <field name="name"/>
                <field name="product_id"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_product_id" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_medical_equipment_reference" model="ir.ui.view">
        <field name="name">medical.equipment.reference.search</field>
        <field name="model">medical.equipment.reference</field>
        <field name="arch" type="xml">
            <search string="Medical Equipment Reference">
                <field name="name"/>
                <field name="contact_id"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_contact_id" string="Contact" context="{'group_by': 'contact_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_medical_security_deposit" model="ir.ui.view">
        <field name="name">medical.security.deposit.search</field>
        <field name="model">medical.security.deposit</field>
        <field name="arch" type="xml">
            <search string="Medical Security Deposit">
                <field name="name"/>
                <field name="cnic_no"/>
                <field name="pos_reference"/>
                <field name="pos_config_id"/>
                <field name="donee_id"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_state_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_state_bounced" string="Bounced" domain="[('state', '=', 'bounced')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_date" string="Date" date="date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="groupby_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="groupby_donee_id" string="Donee" context="{'group_by': 'donee_id'}"/>
                    <filter name="groupby_date_month" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
