<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Branch Name is defined by this module, so it is added to the user form from here.
         Typed straight into the base user form, it breaks the upgrade of every module loaded
         before this one as soon as that upgrade creates a group. -->
    <record id="base_view_users_form_inherit_bn_pos_customization" model="ir.ui.view">
        <field name="name">base.view.users.form.inherit.bn.pos.customization</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]/group/field[@name='partner_id']" position="after">
                <field name="branch_name"/>
            </xpath>
        </field>
    </record>

</odoo>
