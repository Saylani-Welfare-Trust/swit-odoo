<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base_view_company_form_inherit_bn_pos_customization" model="ir.ui.view">
        <field name="name">base.view.company.form.inherit.bn.pos.customization</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='branches']" position="after">
                <page name="pos" string="POS">
                    <group name="pos">
                        <field name="dn_image" filename="dn_name" widget="image" class="oe_avatar" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
