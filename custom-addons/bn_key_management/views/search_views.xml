<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_key" model="ir.ui.view">
        <field name="name">key.search</field>
        <field name="model">key</field>
        <field name="inherit_id" ref="bn_key_management.key_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="key_issuance_ids" string="Line Product" filter_domain="[('key_issuance_ids.product_id', 'ilike', self)]"/>
                <field name="key_issuance_ids" string="Line Lot / Serial Number" filter_domain="[('key_issuance_ids.lot_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_lot_id" string="Lot" context="{'group_by': 'lot_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_key_bunch" model="ir.ui.view">
        <field name="name">key.bunch.search</field>
        <field name="model">key.bunch</field>
        <field name="inherit_id" ref="bn_key_management.key_bunch_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="key_ids" string="Line Lot / Serial Number" filter_domain="[('key_ids.lot_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_key_issuance" model="ir.ui.view">
        <field name="name">key.issuance.search</field>
        <field name="model">key.issuance</field>
        <field name="inherit_id" ref="bn_key_management.key_issuance_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="name"/>
                <field name="product_id"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_installation_date" string="Installation Date" date="installation_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_donor_id" string="Donor" context="{'group_by': 'donor_id'}"/>
                    <filter name="groupby_lot_id" string="Box No." context="{'group_by': 'lot_id'}"/>
                    <filter name="groupby_city_id" string="City" context="{'group_by': 'city_id'}"/>
                    <filter name="groupby_zone_id" string="Zone" context="{'group_by': 'zone_id'}"/>
                    <filter name="groupby_product_id" string="Donation Box Category" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_installation_date_month" string="Installation Date" context="{'group_by': 'installation_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
