<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Branch / Site access (bn_stock_location, group "Branch / Site Access"):
        a switched user sees the documents of their Branches / Sites and the ones
        they created. Global (it narrows every other rule of the model); no effect
        for users not switched yet, or with All Branches / Sites.
    -->
    <record id="node_rule_key" model="ir.rule">
        <field name="name">Key: Branch / Site</field>
        <field name="model_id" ref="bn_key_management.model_key"/>
        <field name="domain_force">[(1, '=', 1)] if (not user.node_access or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_key_bunch" model="ir.rule">
        <field name="name">Key Bunch: Branch / Site</field>
        <field name="model_id" ref="bn_key_management.model_key_bunch"/>
        <field name="domain_force">[(1, '=', 1)] if (not user.node_access or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="node_rule_key_issuance" model="ir.rule">
        <field name="name">Key Issuance: Branch / Site</field>
        <field name="model_id" ref="bn_key_management.model_key_issuance"/>
        <field name="domain_force">[(1, '=', 1)] if (not user.node_access or user.all_nodes) else ['|', ('node_id', 'in', user.node_scope_ids.ids), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
