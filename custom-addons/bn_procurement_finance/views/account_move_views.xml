<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_view_form_inherit_bn_procurement_finance" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit.bn.procurement.finance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Vendor bills must go through Finance Confirm & Post instead of the native Confirm button -->
            <xpath expr="//button[@name='action_post'][2]" position="attributes">
                <attribute name="invisible">hide_post_button or move_type == 'entry' or display_inactive_currency_warning or move_type == 'in_invoice'</attribute>
            </xpath>

            <!-- Register Payment stays hidden for vendor bills until Treasury has the bill -->
            <xpath expr="//button[@id='account_invoice_payment_btn']" position="attributes">
                <attribute name="invisible">state != 'posted' or payment_state not in ('not_paid', 'partial') or move_type not in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') or (move_type == 'in_invoice' and not forwarded_to_treasury)</attribute>
            </xpath>

            <xpath expr="//button[@name='action_post'][2]" position="after">
                <button name="action_finance_confirm_and_post" string="Finance Confirm &amp; Post" type="object"
                        class="oe_highlight" groups="bn_procurement_finance.group_finance"
                        invisible="move_type != 'in_invoice' or finance_confirmed or state != 'draft'"/>
                <button name="action_forward_to_treasury" string="Forward to Treasury" type="object"
                        class="oe_highlight" groups="bn_procurement_finance.group_finance"
                        invisible="move_type != 'in_invoice' or not finance_confirmed or forwarded_to_treasury or state != 'posted'"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="finance_confirmed" invisible="1"/>
                <field name="forwarded_to_treasury" invisible="1"/>
            </xpath>

            <xpath expr="//page[@id='other_tab']" position="after">
                <page string="Finance &amp; Treasury" name="finance_treasury" invisible="move_type != 'in_invoice'">
                    <group>
                        <group string="Finance">
                            <field name="vendor_invoice_reference" readonly="finance_confirmed"/>
                            <field name="finance_match_remarks" readonly="finance_confirmed"/>
                            <field name="finance_confirmed" widget="boolean_toggle" readonly="1"/>
                            <field name="finance_confirmed_by" readonly="1"/>
                            <field name="finance_confirmed_date" readonly="1"/>
                        </group>
                        <group string="Treasury">
                            <field name="treasury_user_id"/>
                            <field name="forwarded_to_treasury" widget="boolean_toggle" readonly="1"/>
                            <field name="treasury_forwarded_by" readonly="1"/>
                            <field name="treasury_forwarded_date" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_account_moves_treasury_queue" model="ir.actions.act_window">
        <field name="name">Bills Awaiting Payment (Treasury)</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type', '=', 'in_invoice'), ('forwarded_to_treasury', '=', True), ('payment_state', 'not in', ('paid', 'in_payment', 'reversed'))]</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_treasury_bills_queue" name="Bills Awaiting Payment"
              parent="account.menu_finance_payables" action="action_account_moves_treasury_queue"
              groups="bn_procurement_finance.group_finance,bn_procurement_finance.group_treasury"
              sequence="20"/>
</odoo>
