<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bulk_bill_date_reference_wizard_form" model="ir.ui.view">
        <field name="name">bulk.bill.date.reference.wizard.form</field>
        <field name="model">bulk.bill.date.reference.wizard</field>
        <field name="arch" type="xml">
            <form string="Bulk Set Bill Date &amp; Reference">
                <group>
                    <field name="move_count" readonly="1"/>
                    <field name="invoice_date"/>
                    <field name="bill_reference"/>
                    <field name="set_custom_reference_too"
                           invisible="not bill_reference"/>
                </group>
                <footer>
                    <button name="action_apply" string="Apply"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>