<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="counterfeit_notes_view_search" model="ir.ui.view">
        <field name="name">counterfeit.notes.view.search</field>
        <field name="model">counterfeit.notes</field>
        <field name="arch" type="xml">
            <search>
                <field name="rider_id" />
                <field name="lot_id" string="Box No." />
                <separator />
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]" />
                <filter string="Payment Received" name="filter_payment_received" domain="[('state', '=', 'payment_received')]" />
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]" />
                <separator />
                <filter string="Submission Date" name="filter_submission_time" date="submission_time" />
                <group string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}" />
                    <filter string="Rider" name="group_rider" domain="[]" context="{'group_by': 'rider_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="counterfeit_notes_view_tree" model="ir.ui.view">
        <field name="name">counterfeit.notes.view.tree</field>
        <field name="model">counterfeit.notes</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <header>
                    <button name="action_open_counterfeit_wizard" type="object" string="Create CFB" class="oe_highlight"/>
                </header>
                <field name="rider_name" string="Rider" />
                <field name="lot_id" string="Box No." />
                <field name="submission_time" />
                <field name="amount" />
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'payment_received'" decoration-success="state == 'paid'" />
            </tree>
        </field>
    </record>

    <record id="counterfeit_notes_action" model="ir.actions.act_window">
        <field name="name">Counterfeit Notes</field>
        <field name="res_model">counterfeit.notes</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There are no counterfeit notes recorded...
            </p>
        </field>
    </record>

    <menuitem
        id="counterfeit_notes_menu"
        name="Counterfeit Notes"
        action="counterfeit_notes_action"
        parent="bn_rider_shift.rider_shift_root_menu"
        sequence="2"/>

</odoo>
