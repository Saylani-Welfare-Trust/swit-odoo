<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rider_shift_view_search" model="ir.ui.view">
        <field name="name">rider.shift.view.search</field>
        <field name="model">rider.shift</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="rider_id" />
                <separator />
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]" />
                <filter string="Done" name="filter_done" domain="[('state', '=', 'done')]" />
                <separator />
                <filter string="Start Date" name="filter_start_date" date="start_date" />
                <group string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}" />
                    <filter string="Rider" name="group_rider" domain="[]" context="{'group_by': 'rider_id'}" />
                    <filter string="Start Date" name="group_start_date" domain="[]" context="{'group_by': 'start_date'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="rider_shift_view_tree" model="ir.ui.view">
        <field name="name">rider.shift.view.tree</field>
        <field name="model">rider.shift</field>
        <field name="arch" type="xml">
            <tree>
                <field name="rider_id" string="Rider" />
                <field name="start_date" />
                <field name="end_date" />
            </tree>
        </field>
    </record>

    <record id="rider_shift_view_form" model="ir.ui.view">
        <field name="name">rider.shift.view.form</field>
        <field name="model">rider.shift</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Move to Done" name="action_mark_done" type="object" class="oe_highlight" invisible = "state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft, done"/>
                </header>

                <sheet>
                    <field name="employee_category_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="rider_id"/>
                        <h1><field name="rider_id" domain="[('category_ids', 'in', [employee_category_id])]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1" string="Rider" readonly = "state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group name="rider_shift_col_1">
                            <field name="start_date" required="1" readonly = "state != 'draft'"/>
                        </group>
                        <group name="rider_shift_col_2">
                            <field name="end_date" required="1" readonly = "state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="schedule_day" string="Schedule Days"  >
                            <field name="schedule_day_ids" readonly = "state != 'draft'">
                                <tree editable="bottom" delete="false">
                                    <field name="date" widget="date"/>
                                    <field name="city_id" string="City" domain="[('location_option_id.name', '=', 'City')]" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="zone_id" string="Zone" domain="[('parent_id', '=', city_id)]" required="1" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="sub_zone_id" string="Sub Zone" domain="[('analytic_account_id', '=', zone_id)]" required="1" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="key_bunch_id" domain="[('sub_zone_id', '=', sub_zone_id)]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" required="1" string="Bunch"/>
                                    <field name="key_count" string="No. of Keys" readonly="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rider_shift_action" model="ir.actions.act_window">
        <field name="name">Rider Shift</field>
        <field name="res_model">rider.shift</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Let's create a rider shift...
            </p>
        </field>
    </record>

    <menuitem
        id="rider_shift_root_menu"
        name="Rider"
        groups="bn_rider_shift.rider_shift_user_group,bn_rider_shift.rider_shift_audit_group"
        parent="bn_donation_box.donation_box_root_menu"
        sequence="3"/>
    
    <menuitem
        id="rider_shift_menu"
        name="Shift"
        action="rider_shift_action"
        groups="bn_rider_shift.rider_shift_user_group,bn_rider_shift.rider_shift_audit_group"
        parent="bn_rider_shift.rider_shift_root_menu"
        sequence="0"/>

</odoo>
