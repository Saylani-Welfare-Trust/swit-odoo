<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rider_collection_view_form_pos_link" model="ir.ui.view">
        <field name="name">rider.collection.form.pos.link</field>
        <field name="model">rider.collection</field>
        <field name="inherit_id" ref="bn_rider_shift.rider_collection_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Point of Sale" name="pos_link_info" invisible="not pos_session_id and not pos_order_id">
                    <group>
                        <field name="pos_config_id" options="{'no_create': True}"/>
                        <field name="pos_session_id" options="{'no_create': True}"/>
                        <field name="pos_cashier_id" options="{'no_create': True}"/>
                        <field name="pos_employee_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="pos_order_id" options="{'no_create': True}"/>
                        <field name="pos_reference"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="key_issuance_view_form_pos_link" model="ir.ui.view">
        <field name="name">key.issuance.form.pos.link</field>
        <field name="model">key.issuance</field>
        <field name="inherit_id" ref="bn_key_management.key_issuance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Point of Sale" name="pos_link_info" invisible="not pos_session_id and not pos_order_id">
                    <group>
                        <field name="pos_config_id" options="{'no_create': True}"/>
                        <field name="pos_session_id" options="{'no_create': True}"/>
                        <field name="pos_cashier_id" options="{'no_create': True}"/>
                        <field name="pos_employee_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="pos_order_id" options="{'no_create': True}"/>
                        <field name="pos_reference"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
