<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Filters by status / date / archived and group-bys missing from the search views -->

    <record id="search_filters_key_issuance_bn_rider_shift" model="ir.ui.view">
        <field name="name">key.issuance.search.filters.rider_shift</field>
        <field name="model">key.issuance</field>
        <field name="inherit_id" ref="bn_key_management.key_issuance_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="pos_session_id"/>
                <field name="pos_config_id"/>
                <field name="pos_reference"/>
                <field name="pos_cashier_id"/>
                <field name="pos_employee_id"/>
                <field name="pos_analytic_account_id"/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_pos_session_id" string="POS Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="bn_groupby_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="bn_groupby_pos_cashier_id" string="Cashier" context="{'group_by': 'pos_cashier_id'}"/>
                    <filter name="bn_groupby_pos_employee_id" string="Cashier (Employee)" context="{'group_by': 'pos_employee_id'}"/>
                    <filter name="bn_groupby_pos_analytic_account_id" string="Branch (Shop)" context="{'group_by': 'pos_analytic_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_counterfeit_notes" model="ir.ui.view">
        <field name="name">counterfeit.notes.search.filters</field>
        <field name="model">counterfeit.notes</field>
        <field name="inherit_id" ref="bn_rider_shift.counterfeit_notes_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_submission_time_month" string="Submission Date (Month)" context="{'group_by': 'submission_time:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_filters_rider_collection" model="ir.ui.view">
        <field name="name">rider.collection.search.filters</field>
        <field name="model">rider.collection</field>
        <field name="inherit_id" ref="bn_rider_shift.rider_collection_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="pos_session_id"/>
                <field name="pos_cashier_id"/>
                <field name="pos_employee_id"/>
                <field name="pos_analytic_account_id"/>
                <field name="contact_number"/>
                <field name="pos_receipt_number"/>
                <field name="dn_number"/>
                <group expand="0" string="Group By">
                    <filter name="bn_groupby_pos_session_id" string="POS Session" context="{'group_by': 'pos_session_id'}"/>
                    <filter name="bn_groupby_pos_cashier_id" string="Cashier" context="{'group_by': 'pos_cashier_id'}"/>
                    <filter name="bn_groupby_pos_employee_id" string="Cashier (Employee)" context="{'group_by': 'pos_employee_id'}"/>
                    <filter name="bn_groupby_pos_analytic_account_id" string="Branch (Shop)" context="{'group_by': 'pos_analytic_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
