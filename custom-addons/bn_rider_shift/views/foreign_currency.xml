<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="foreign_currency_view_search" model="ir.ui.view">
        <field name="name">foreign.currency.view.search</field>
        <field name="model">foreign.currency</field>
        <field name="arch" type="xml">
            <search>
                <field name="rider_id" />
                <field name="lot_id" string="Box No." />
                <field name="currency_id" />
                <field name="rider_collection_id" />
                <separator />
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]" />
                <filter string="Converted" name="filter_converted" domain="[('state', '=', 'converted')]" />
                <filter string="Payment Received" name="filter_payment_received" domain="[('state', '=', 'payment_received')]" />
                <filter string="Paid" name="filter_paid" domain="[('state', '=', 'paid')]" />
                <filter string="Rejected" name="filter_reject" domain="[('state', '=', 'reject')]" />
                <group string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}" />
                    <filter string="Rider" name="group_rider" domain="[]" context="{'group_by': 'rider_id'}" />
                    <filter string="Currency" name="group_currency" domain="[]" context="{'group_by': 'currency_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="foreign_currency_view_tree" model="ir.ui.view">
        <field name="name">foreign.currency.view.tree</field>
        <field name="model">foreign.currency</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" editable="bottom">
                <header>
                    <button name="action_create_pos_record" type="object" string="Create POS Order" class="oe_highlight"/>
                </header>
                <field name="currency_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                <field name="rider_log" />
                <field name="amount"  readonly="1" groups="!bn_rider_shift.group_foreign_currency_collection" string="Foreign Amount"  />
                <field name="amount"  groups="bn_rider_shift.group_foreign_currency_collection" string="Foreign Amount"  />
                <field name="conversion_rate" />
                <field name="foreign_notes" />
                <field name="exchanged_amount" string="PKR Amount"  readonly="1"/>
                <field name="rider_id" readonly="1" />
                <field name="lot_id" string="Box No." readonly="1" />
                <field name="state" widget="badge"
                   decoration-success="state == 'paid'"
                   decoration-info="state == 'payment_received'"
                   decoration-primary="state == 'converted'"
                   decoration-warning="state == 'draft'"
                   decoration-danger="state == 'reject'" readonly="1"/>
                <field name="attachment_ids" widget="many2many_binary" readonly="0"/>

                <button string="Convert" name="action_convert_amount" type="object" class="oe_highlight" invisible="state  in ['converted','reject']"/>
                <button string="Reject" name="action_reject" type="object" class="oe_highlight" invisible="state not in ['draft']"/>
                <button name="action_create_pos_record" 
                    type="object" 
                    string="Create POS Order" 
                    class="btn-success"
                    invisible="state not in ['converted']"/>
            </tree>
        </field>
    </record>

    <record id="foreign_currency_action" model="ir.actions.act_window">
        <field name="name">Foreign Currency</field>
        <field name="res_model">foreign.currency</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                There is no foreign currency records...
            </p>
        </field>
    </record>

    <menuitem
        id="foreign_currency_menu"
        name="Foreign Currency"
        action="foreign_currency_action"
        parent="bn_rider_shift.rider_shift_root_menu"
        sequence="3"/>

</odoo>
