<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sole gate on this module's section-root menu (nested under the
         Donation Box app icon). Also implies bn_donation_box's own root
         group, so a user with only Rider Shift access still sees the
         parent Donation Box app icon needed to reach this section at all. -->
    <record id="rider_shift_root_group" model="res.groups">
        <field name="name">Access Root Menu</field>
        <field name="category_id" ref="module_rider_shift"/>
        <field name="comment">Grants visibility of the Rider section (and the parent Donation Box app icon). Assigned automatically by every tier below - there is normally no need to assign it directly.</field>
    </record>

    <record id="group_edit_rider_collection" model="res.groups">
        <field name="name">Rider Collection / Edit Amount / Notes</field>
    </record>

    <record id="group_foreign_currency_collection" model="res.groups">
        <field name="name">Foreign Currency Collection</field>
    </record>

</odoo>
