<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- City access, see bn_donation_box/security/record_rule.xml. -->

    <!-- Rider Shift: city of a day of its schedule -->
    <record id="rider_shift_own_city_rule" model="ir.rule">
        <field name="name">Rider Shift: Own City</field>
        <field name="model_id" ref="bn_rider_shift.model_rider_shift"/>
        <field name="domain_force">[('schedule_day_ids.city_id', 'parent_of', user.employee_id.analytic_account_id.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="rider_shift_all_cities_rule" model="ir.rule">
        <field name="name">Rider Shift: All Cities</field>
        <field name="model_id" ref="bn_rider_shift.model_rider_shift"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.donation_box_manager_group'), ref('bn_donation_box.donation_box_audit_group'), ref('bn_key_management.key_management_manager_group'), ref('bn_key_management.key_management_audit_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

