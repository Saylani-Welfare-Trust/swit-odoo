<?xml version='1.0' encoding='utf-8'?>
<odoo>
    
    <record id="account_view_account_supplier_payment_tree_inherit_bn_payment_customization" model="ir.ui.view">
        <field name="name">account.view.account.supplier.payment.tree.inherit.bn.payment.customization</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_supplier_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_confirm_ibft" type="object" string="Confirm IBFT" class="btn-primary"/>
            </xpath>
            

            <xpath expr="//field[@name='state']" position="after">
                <field name="ibft_status" widget="badge" decoration-info="ibft_status == 'pending'" decoration-success="ibft_status == 'success'"/>
                <field name="ibft_batch_no" optional="show"/>

            </xpath>
        </field>
    </record>

        <record id="view_account_payment_search_inherit_ibft_batch" model="ir.ui.view">
        <field name="name">account.payment.search.inherit.ibft.batch</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="ibft_batch_no"/>
            </xpath>
            
        </field>
    </record>

</odoo>