<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_location_option" model="ir.ui.view">
        <field name="name">location.option.form</field>
        <field name="model">location.option</field>
        <field name="arch" type="xml">
            <form string="Location Option">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_location_option" model="ir.ui.view">
        <field name="name">location.option.tree.open.form</field>
        <field name="model">location.option</field>
        <field name="inherit_id" ref="bn_analytic_account_customization.location_option_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_analytic_account_customization.location_option_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_sub_zone" model="ir.ui.view">
        <field name="name">sub.zone.form</field>
        <field name="model">sub.zone</field>
        <field name="arch" type="xml">
            <form string="Sub Zone">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="analytic_account_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" domain="[('location_option_id.name', '=', 'Zone')]"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_sub_zone" model="ir.ui.view">
        <field name="name">sub.zone.tree.open.form</field>
        <field name="model">sub.zone</field>
        <field name="inherit_id" ref="bn_analytic_account_customization.sub_zone_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_analytic_account_customization.sub_zone_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
