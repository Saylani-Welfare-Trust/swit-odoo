<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_location_option" model="ir.ui.view">
        <field name="name">location.option.search</field>
        <field name="model">location.option</field>
        <field name="arch" type="xml">
            <search string="Location Option">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_sub_zone" model="ir.ui.view">
        <field name="name">sub.zone.search</field>
        <field name="model">sub.zone</field>
        <field name="arch" type="xml">
            <search string="Sub Zone">
                <field name="name"/>
                <field name="analytic_account_id"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_analytic_account_id" string="Zone" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
