<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_analytic_account_customization" model="ir.module.category">
        <field name="name">Analytical Account Enhancement</field>
        <field name="sequence">50</field>
    </record>

    <!-- Sole gate on the Analytical Accounting menu; assigned explicitly (no group implies it). -->
    <record id="analytic_account_customization_root_group" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_analytic_account_customization"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Shows Master Setup > Analytical Accounting. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="analytic_account_customization_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_analytic_account_customization"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Can look up Location Option and Sub Zone reference data. Cannot edit it.</field>
    </record>

    <record id="analytic_account_customization_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_analytic_account_customization"/>
        <field name="implied_ids" eval="[(6, 0, [ref('analytic_account_customization_user_group'), ref('bn_master_setup.master_setup_root_group')])]"/>
        <field name="comment">Maintains Location Option and Sub Zone: create and edit entries.</field>
    </record>

    <record id="analytic_account_customization_audit_group" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_analytic_account_customization"/>
        <field name="implied_ids" eval="[(6, 0, [ref('bn_master_setup.master_setup_root_group')])]"/>
        <field name="comment">Read-only oversight for reporting.</field>
    </record>

    <record id="analytic_account_customization_admin_group" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_analytic_account_customization"/>
        <field name="implied_ids" eval="[(6, 0, [ref('analytic_account_customization_manager_group'), ref('analytic_account_customization_audit_group')])]"/>
        <field name="comment">Full control, including deleting Location Option / Sub Zone entries.</field>
    </record>

</odoo>
