<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_disbursement_application_type" model="ir.ui.view">
        <field name="name">disbursement.application.type.search</field>
        <field name="model">disbursement.application.type</field>
        <field name="arch" type="xml">
            <search string="Disbursement Application Type">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_disbursement_category" model="ir.ui.view">
        <field name="name">disbursement.category.search</field>
        <field name="model">disbursement.category</field>
        <field name="arch" type="xml">
            <search string="Disbursement Category">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_welfare" model="ir.ui.view">
        <field name="name">welfare.search</field>
        <field name="model">welfare</field>
        <field name="arch" type="xml">
            <search string="Welfare">
                <field name="name"/>
                <field name="cnic_no"/>
                <field name="donee_id"/>
                <field name="welfare_line_ids" string="Line Product" filter_domain="['|', ('welfare_line_ids.product_id', 'ilike', self), ('welfare_recurring_line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="filter_state_form_sent" string="Form Sent" domain="[('state', '=', 'form_sent')]"/>
                <filter name="filter_state_form_filled" string="Form Filled" domain="[('state', '=', 'form_filled')]"/>
                <filter name="filter_state_send_for_inquiry" string="Send for Inquiry" domain="[('state', '=', 'send_for_inquiry')]"/>
                <filter name="filter_state_inquiry" string="Inquiry Officer" domain="[('state', '=', 'inquiry')]"/>
                <filter name="filter_state_committee_approval" string="Committee Approval" domain="[('state', '=', 'committee_approval')]"/>
                <filter name="filter_state_hod_approve" string="HOD Approval" domain="[('state', '=', 'hod_approve')]"/>
                <filter name="filter_state_mem_approve" string="Final Approval" domain="[('state', '=', 'mem_approve')]"/>
                <filter name="filter_state_approve" string="Approved" domain="[('state', '=', 'approve')]"/>
                <filter name="filter_state_recurring" string="Recurring" domain="[('state', '=', 'recurring')]"/>
                <filter name="filter_state_disbursed" string="Disbursed" domain="[('state', '=', 'disbursed')]"/>
                <filter name="filter_state_reject" string="Rejected" domain="[('state', '=', 'reject')]"/>
                <filter name="filter_state_return" string="Returned" domain="[('state', '=', 'return')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_date" string="Date" date="date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="groupby_donee_id" string="Donee" context="{'group_by': 'donee_id'}"/>
                    <filter name="groupby_date_month" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_welfare_approval_limit" model="ir.ui.view">
        <field name="name">welfare.approval.limit.search</field>
        <field name="model">welfare.approval.limit</field>
        <field name="arch" type="xml">
            <search string="Welfare Approval Limits">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_welfare_line" model="ir.ui.view">
        <field name="name">welfare.line.search</field>
        <field name="model">welfare.line</field>
        <field name="inherit_id" ref="bn_welfare.view_welfare_consolidated_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="pos_reference"/>
                <field name="pos_config_id"/>
                <field name="returned_by"/>
                <field name="product_id"/>
                <field name="analytic_account_id"/>
                <separator/>
                <filter name="filter_state_delivered" string="Delivery Created" domain="[('state', '=', 'delivered')]"/>
                <filter name="filter_state_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_state_collected" string="Collected" domain="[('state', '=', 'collected')]"/>
                <filter name="filter_state_return" string="Returned" domain="[('state', '=', 'return')]"/>
                <filter name="filter_state_cancel" string="Cancelled" domain="[('state', '=', 'cancel')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_collection_date" string="Collection Date" date="collection_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="groupby_returned_by" string="Returned By" context="{'group_by': 'returned_by'}"/>
                    <filter name="groupby_product_id" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_analytic_account_id" string="Branch" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="groupby_collection_date_month" string="Collection Date" context="{'group_by': 'collection_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
