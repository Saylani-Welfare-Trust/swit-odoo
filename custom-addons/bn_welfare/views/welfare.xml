<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="welfare_view_tree" model="ir.ui.view">
        <field name="name">welfare.view.tree</field>
        <field name="model">welfare</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button string="Send for Inquiry" name="action_send_for_inquiry" type="object" class="oe_highlight"   invisible=" not context.get('default_is_individual')"/>
                </header>
                <field name="name" />
                <field name="donee_id" />
                <field name="date" />
                <field name="is_individual" column_invisible="1"/>
                <field name="state" widget="badge" decoration-warning="state == 'draft'" decoration-info="state not in ['recurring_order', 'disbursed']" decoration-success="state in ['recurring_order', 'disbursed']" />
            </tree>
        </field>
    </record>
    <record id="view_welfare_document_image_form" model="ir.ui.view">
        <field name="name">welfare.document.image.form</field>
        <field name="model">welfare.document.image</field>
        <field name="arch" type="xml">
            <form string="Document Image">
                <sheet>
                    <group>
                        <field name="document_type"/>
                        <field name="image_filename" string="File Name"/>
                        <!-- <field name="source_url" string="Source URL"/> -->
                    </group>
                    <group string="Image">
                        <field name="image_data" 
                            widget="image"
                            string="Image"
                            options="{'size': [400, 400]}"
                            nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="welfare_view_form" model="ir.ui.view">
        <field name="name">welfare.view.form</field>
        <field name="model">welfare</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="mark as Completed" name="action_complete" type="object" class="oe_highlight" invisible="state != 'draft'" groups = "bn_welfare.group_bn_welfare_user" />
                    <button string="View Most Recent Disbursement" name="action_view_previous_disbursement" type="object" 
                            class="btn btn-sm btn-info"
                            invisible="state not in ['draft', 'hod_approve', 'mem_approve'] or not previous_disbursement_id"/>
                    <button name ="action_open_full_edit_wizard" string="Open View" type="object" class="btn-secondary" invisible="state not in ['committee_approval','hod_approve']" groups="bn_welfare.group_bn_welfare_committee, bn_welfare.group_welfare_hod"/>
                    <button string="Send for Inquiry" name="action_send_for_inquiry" type="object" class="oe_highlight" invisible="state != 'completed'" groups = "bn_welfare.group_bn_welfare_user"/>
                    <button string="Check Portal Status" name="action_check_portal_status" type="object" class="oe_highlight" invisible="state != 'send_for_inquiry'" groups = "bn_welfare.group_bn_welfare_user" />
                    <button string="Move to Committee Approval" name="action_committee_approval" type="object" class="oe_highlight" invisible="state != 'inquiry'" groups = "bn_welfare.group_bn_welfare_user"/>
                    <button string="Move to HOD" name="action_move_to_hod" type="object" class="oe_highlight" invisible="state != 'committee_approval'" groups = "bn_welfare.group_bn_welfare_committee" />
                    <button string="Move to Member" name="action_move_to_member" type="object" class="oe_highlight" invisible="state != 'hod_approve'" groups = "bn_welfare.group_welfare_hod" />
                    <button string="Approve" name="action_approve" type="object" class="oe_highlight" invisible="state != 'mem_approve'" groups = "bn_welfare.group_welfare_member" />
                    <button string="Create Recurring Orders" name="action_create_recurring_order" type="object" class="oe_highlight" invisible="state != 'approve' or order_type != 'recurring'" groups = "bn_welfare.group_bn_welfare_user"/>
                    <button string="Disburse" name="action_disburse" type="object" class="oe_highlight" invisible="1"  />
                    <button string="Revert" name="action_reverse_state" type="object" class="oe_highlight" invisible="state in ['draft','disbursed','reject','recurring','approve']"/>
                    <button string="Return" name="action_return_to_pos" type="object" class="oe_highlight"  invisible='1' groups = "bn_welfare.group_bn_welfare_user"/>
                    <button string="Reject and Close" name="action_reject" type="object" invisible="state in ['disbursed','draft']"/>
                    <button string="Print Info" name="action_print_info" type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft, completed, send_for_inquiry, inquiry, committee_approval, hod_approve, mem_approve, approve, disbursed" />
                </header>   

                <sheet>
                    <div class="alert alert-info" role="alert" invisible="not previous_disbursement_id or state != 'draft'">
                        <strong>Previous Record Available:</strong> This donee has previous disbursements.
                        <!-- <button string="View Most Recent Disbursement" name="action_view_previous_disbursement" type="object" 
                            class="btn btn-sm btn-info"
                            invisible="not previous_disbursement_id" /> -->
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Name"/>
                        <h1><field name="name" class="oe_inline" readonly="1" /></h1>
                    </div>
                    
                    <!-- Previous Disbursement Alert -->

                    <group>
                        <group name="welfare_col_1">
                            <field name="order_type" required="1" readonly=" state  in ['disbursed','recurring', 'disbursed']" />
                            <field name="employee_category_id" invisible="1" />
                            <field name="employee_category_id_officer" invisible="1" />
                            <field name="employee_domain" invisible="1"/>
                            <field name="is_synced" readonly="1" invisible="1" />
                            <field name="is_individual" widget="boolean_toggle" invisible="1"/>
                            <field name="donee_id" 
                                domain="[('category_id.name', '=', 'Donee'), ('category_id.name', '=', 'Welfare'), ('state', '=', 'register'),
                                ('category_id.name', '=', (is_individual and 'Individual' or 'Coorporate / Institute'))]"
                                options="{'no_create': True}"
                                readonly="state in ['recurring', 'disbursed']" required="1" />
                            <field name="previous_disbursement_id" invisible="1" />
                            <field name="previous_welfare_source_id" invisible="1"/>
                            <field name="employee_id" string="Inquiry Officer" domain="employee_domain" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="state in ['recurring', 'disbursed'] or state != 'draft'" />
                            <field name="cnic_no" readonly="state in ['recurring', 'disbursed']" />
                            <field name="cnic_expiration_date" readonly="state in ['recurring', 'disbursed']" />
                            <field name="father_name" readonly="state in ['recurring', 'disbursed']" />
                            <field name="father_cnic_no" readonly="state in ['recurring', 'disbursed']" />
                            <field name="portal_sync_status" options="{'horizontal': True}" widget="radio" readonly="1" invisible="not is_synced" />
                            <field name="committee_remarks" readonly="state != 'committee_approval'" required="state == 'committee_approval'"/>
                            <field name="hod_remarks" readonly="state != 'hod_approve'" required="state == 'hod_approve'"/>
                            <field name="member_remarks" readonly="state != 'mem_approve'" required="state == 'mem_approve'"/>
                            <field name="rejection_remarks" readonly="state == 'reject'"  />
                            <field name="show_disburse_button" invisible="1"  />

                        </group>
                        <group name="welfare_col_2">
                            <field name="is_individual" invisible="1"/>
                            <field name="application_form_name" invisible="1"/>
                            <field name="frc_name" invisible="1"/>
                            <!-- Electricity Bill -->
                            <field name="electricity_bill_name" invisible="1"/>
                            <!-- Gas Bill -->
                            <field name="gas_bill_name" invisible="1"/>
                            
                            <!-- Family CNIC -->
                            <field name="family_cnic_name" invisible="1"/>
                            <field name="old_system_id" readonly="state != 'draft'"/>
                            <field name="portal_application_id" readonly="1" invisible="is_individual"/>
                            <field name="portal_review_notes" readonly="1" />
                            <field name="inquiry_media" widget="html" readonly="1"/>

                            <field name="applicantLocationLink" readonly="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="welfare_line" string="Disbursement Items">
                            <field name="welfare_line_ids" readonly="state in ['approve','recurring','disbursed', 'rejected']" >
                                <tree editable="bottom">
                                    <field name="product_domain" column_invisible="1" />
                                    <field name="analytic_account_domain" column_invisible="1" />
                                    <field name="is_collection_point_readonly" column_invisible="1" />
                                    <field name="employee_category_id_officer" column_invisible="1" />

                                    <field name="recurring_duration" column_invisible="parent.order_type != 'recurring'" />
                                    <field name="disbursement_category_id" optional="hide" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="disbursement_application_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="product_id" domain="product_domain" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="is_hod" optional="hide" />
                                    <field name="payment_type" />
                                    <field name="assigned_officer_id" domain="[('category_ids', 'in', [employee_category_id_officer])]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" invisible="payment_type == 'self'" />
                                    <field name="collection_point" readonly="is_collection_point_readonly"/>
                                    <field name="analytic_account_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" domain="analytic_account_domain" invisible="collection_point == 'bank'" />
                                    <field name="collection_date" />
                                    <field name="marriage_date" optional="hide" invisible="disbursement_category_id.name != 'Marriage / Wedding'" />
                                    <field name="is_cash_category" column_invisible="1" />
                                    <field name="quantity" readonly="is_cash_category" force_save="1" />
                                    <field name="amount" readonly="1" optional="hide" />
                                    <field name="fixed_amount_check" column_invisible="1" />
                                    <field name="total_amount" readonly="fixed_amount_check" />
                                    <field name="advance_donation_amount" optional="hide" string="Advance Donation Amount" readonly="1"/>

                                    <field name="show_deliver_button" column_invisible="1"/>
                                    <!-- <button name="action_set_pending" string="Create New Record" type="object" class="btn-primary" invisible="state == 'pending'" /> -->
                                    <button name="action_return_to_draft" string="Return to Draft" type="object" class="btn-secondary" invisible="state != 'return'" />
    
                                    <button name="action_delivered" type="object" string="Create Delivery" class="oe_highlight" column_invisible="1"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'draft'"  decoration-success="state == 'disbursed'" string="State" />

                                </tree>
                            </field>
                        </page>
                        <page string="Documents" name="documents">
                            <field name="document_image_ids" nolabel="1" mode="tree">
                                <tree default_group_by="document_type">
                                    <field name="document_type" string="Document Type"/>
                                    <field name="image_filename" string="File Name"/>
                                    <field name="display_image" string="Preview" widget="html"/>
                                </tree>
                            </field>
                        </page>
                        <page name="recurring_line" string="Recurring Details" invisible="state not in ['recurring','return']">
                            <field name="welfare_recurring_line_ids" readonly="state not in ['return']" >
                                <tree>
                                    <field name="employee_category_id_officer" column_invisible="1" />
                                    <field name="disbursement_category_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="disbursement_application_type_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="payment_type" />
                                    <field name="assigned_officer_id" string="Assigned Officer(Marfat)" domain="[('category_ids', 'in', [employee_category_id_officer])]" options="{'no_create': True, 'no_edit': True, 'no_open': True}" readonly="state in ['recurring', 'disbursed'] or state != 'draft'" />
                                    <field name="collection_point" />
                                    <field name="analytic_account_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                                    <field name="collection_date" readonly="state != 'return'" />
                                    <field name='quantity' />
                                    <field name="amount" />
                                    <field name="show_deliver_button" column_invisible="1"/>
                                    <button name="action_return_to_draft" string="Return to Draft" type="object" class="btn-secondary" invisible="state != 'return'" />

                                    <button name="action_delivered" type="object" string="Create Delivery" class="oe_highlight" column_invisible="1"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'draft'"  decoration-success="state == 'disbursed'" string="State"/>
                                </tree>
                            </field>
                        </page>
                        <page name="portal_details" string="Portal Details" invisible="portal_sync_status != 'synced'">
                            <group>
                                <group name="portal_details_col_1">
                                    <field name="portal_application_id" readonly="1" />
                                    <field name="last_sync_date" readonly="1" />
                                    <field name="portal_last_sync_message" readonly="1" />
                                </group>
                                <group name="portal_details_col_2">
                                    <field name="portal_donee_id" readonly="1" />
                                </group>
                            </group>
                        </page>
                        <page string="Inquiry Committee Questions">
                            <group string="Inquiry Questions" name="inquiry_group">
                                <group name="inquiry_col_1">
                                    <field name="donee_house_status" 
                                        string="Residential Status" 
                                        required="state in ['inquiry']"
                                        placeholder="e.g., Own House, Rented House, Living with relatives"/>
                                    <field name="num_of_children" widget="welfare_count"
                                        string="Total Children" 
                                        required="state in ['inquiry']"

                                        placeholder="Enter total number"/>
                                    <field name="num_of_sons" widget="welfare_count"
                                        string="Sons" 
                                        required="state in ['inquiry']"
                                        placeholder="Enter number of sons"/>
                                </group>
                                <group name="inquiry_col_2">
                                    <field name="num_of_daughters" widget="welfare_count"
                                        string="Daughters" 
                                        required="state in ['inquiry']"                                        
                                        placeholder="Enter number of daughters"/>
                                    <field name="children_education" 
                                        string="Children's Education" 
                                        required="state in ['inquiry']"
                                        placeholder="e.g., School, College, University, or Multiple"/>
                                    <field name="donee_issues" 
                                        string="Issues/Concerns" 
                                        required="state in ['inquiry']"
                                        placeholder="Describe any issues or concerns related to the donee..."/>
                                </group>
                            </group>
                        </page>

                        <!-- Existing Individual Pages (Only show when is_individual=True) -->
                        <page name="employee_info" string="Employee Info." invisible="not is_individual">
                            <group>
                                <group name="employee_info_col_1">
                                    <field name="company_name" />
                                    <field name="company_phone" />
                                    <field name="company_address" />
                                </group>
                                <group name="employee_info_col_2">
                                    <field name="designation" />
                                    <field name="service_duration" />
                                    <field name="monthly_salary" />
                                </group>
                            </group>
                        </page>
                        <page name="education_info" string="Education Info." invisible="not is_individual">
                            <field name="educaiton_line_ids">
                                <tree editable="bottom">
                                    <field name="examination" />
                                    <field name="school_uni_center" />
                                    <field name="board" />
                                    <field name="percentage" />
                                    <field name="passing_year" />
                                </tree>
                            </field>
                        </page>
                        <page name="house_ownership_residency_detail" string="House Ownership / Residency Details" invisible="not is_individual">
                            <group>
                                <group name="house_ownership_residency_detail_col_1">
                                    <field name="residence_type" options="{'horizontal': True}" widget="radio" />
                                    <field name="home_phone_no" />
                                    <field name="rental_shared_duration" />
                                    <field name="electricity_bill" />
                                    <field name="gas_bill" />
                                </group>
                                <group name="house_ownership_residency_detail_col_2">
                                    <field name="landlord_name" />
                                    <field name="landlord_cnic_no" />
                                    <field name="landlord_mobile" />
                                    <field name="home_other_info" />
                                    <field name="per_month_rent" />
                                </group>
                            </group>
                        </page>
                        <page name="other_finance" string="Other Finance" invisible="not is_individual">
                            <group>
                                <group name="other_finance_col_1">
                                    <field name="monthly_income" />
                                    <field name="bank_account" options="{'horizontal': True}" widget="radio" />
                                    <field name="bank_name" invisible="bank_account == 'no'" />
                                    <field name="account_no" invisible="bank_account == 'no'" />
                                </group>
                                <group name="other_finance_col_2">
                                    <field name="monthly_household_expense" />
                                    <field name="other_loan" />
                                    <field name="institute_name" invisible="other_loan == 'no'" />
                                    <field name="outstanding_amount" invisible="other_loan == 'no'" />
                                </group>
                            </group>
                        </page>
                        <page name="other_information" string="Other Information" invisible="not is_individual">
                            <group>
                                <group name="other_information_col_1">
                                    <field name="aid_from_other_organization" />
                                    <field name="details_1" />
                                </group>
                                <group name="other_information_col_2">
                                    <field name="have_applied_swit" />
                                    <field name="details_2" />
                                </group>
                            </group>
                        </page>
                        <page name="request_details" string="Request Details" invisible="not is_individual">
                            <group>
                                <group name="request_details_col_1">
                                    <!-- <field name="loan_request_amount" /> -->
                                    <field name="loan_request_amount"/>
                                    <field name="security_offered" />
                                </group>
                                <group name="request_details_col_2">
                                    <field name="loan_tenure_expected" />
                                </group>
                            </group>
                        </page>
                        <page name="guarantor_information" string="Guarantor Information" invisible="not is_individual">
                            <field name="guarantor_line_ids">
                                <tree editable="bottom">
                                    <field name="name" />
                                    <field name="father_spouse_name" />
                                    <field name="cnic_no" />
                                    <field name="relation" />
                                    <field name="address" />
                                    <field name="mobile" />
                                    <field name="landline_no" />
                                </tree>
                            </field>
                        </page>
                        <page name="family_member" string="Family Details" invisible="not is_individual">
                            <group>
                                <group name="family_member_col_1">
                                    <field name="dependent_person" />
                                </group>
                                <group name="family_member_col_2">
                                    <field name="household_member" />
                                </group>
                            </group>
                            <field name="family_line_ids">
                                <tree editable="bottom">
                                    <field name="complete_name" />
                                    <field name="cnic_no" />
                                    <field name="age" />
                                    <field name="relation" />
                                    <field name="cnic_b_form_name" column_invisible="1"/>
                                    <field name="cnic_b_form" filename="cnic_b_form_name"/>
                                    <field name="education" />
                                    <field name="monthly_income" />
                                    <button name="action_view_disbursement_history" string="View History" type="object" class="btn-info" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Rest of your XML remains the same -->
    <record id="welfare_action_individual" model="ir.actions.act_window">
        <field name="name">Individual Disbursement</field>
        <field name="res_model">welfare</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[("is_individual", "=", True)]</field>
        <field name="context">{'default_is_individual': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Let's create an Individual Disbursement Request....
            </p>
        </field>
    </record>

    <menuitem
        id="welfare_menu"
        name="Welfare"
        web_icon="bn_welfare,static/description/icon.png"
        groups="bn_welfare.welfare_group"
        sequence="6"/>

    <!-- No app action: Odoo opens the first submenu the user can see, so users only get
         Individual Disbursement by default if their groups allow.
         menuitem never clears an action already in the database, hence these records.
         Folder menus are cleared too: old databases still point them at deleted actions
         (e.g. welfare_action), which the app would open instead ("No action with id"). -->
    <record id="welfare_menu" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem
        id="disbursement_request_menu"
        name="Disbursement Request"
        parent="welfare_menu"
        sequence="1"/>

    <record id="disbursement_request_menu" model="ir.ui.menu">
        <field name="action" eval="False"/>
    </record>

    <menuitem
        id="disbursement_request_menu_individual"
        name="Individual Disbursement"
        parent="disbursement_request_menu"
        groups="bn_welfare.group_individual_disbursement"
        action="welfare_action_individual"
        sequence="1"/>

    <!-- Institution Disbursement and Fetch Institution Applications live in their own app, see bn_sadqa_e_jariya -->
</odoo>