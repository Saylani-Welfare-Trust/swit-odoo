<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="welfare_line_view_tree_pos_link" model="ir.ui.view">
        <field name="name">welfare.line.tree.pos.link</field>
        <field name="model">welfare.line</field>
        <field name="inherit_id" ref="bn_welfare.view_welfare_consolidated_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="pos_config_id" optional="show"/>
                <field name="pos_session_id" optional="show"/>
                <field name="pos_analytic_account_id" optional="show"/>
                <field name="pos_cashier_id" optional="show"/>
                <field name="pos_employee_id" optional="hide"/>
                <field name="pos_order_id" optional="hide"/>
            </xpath>
        </field>
    </record>

</odoo>
