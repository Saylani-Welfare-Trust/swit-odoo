<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_welfare_line" model="ir.ui.view">
        <field name="name">welfare.line.form</field>
        <field name="model">welfare.line</field>
        <field name="arch" type="xml">
            <form string="Welfare Line" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="product_domain" invisible="1"/>
                        <field name="analytic_account_domain" invisible="1"/>
                        <field name="is_collection_point_readonly" invisible="1"/>
                        <field name="employee_category_id_officer" invisible="1"/>
                        <field name="recurring_duration"/>
                        <field name="disbursement_category_id"/>
                        <field name="disbursement_application_type_id"/>
                        <field name="product_id"/>
                        <field name="on_hand_qty"/>
                        <field name="payment_type"/>
                        <field name="assigned_officer_id"/>
                        <field name="collection_point"/>
                        <field name="analytic_account_id"/>
                        <field name="collection_date"/>
                        <field name="marriage_date"/>
                        <field name="quantity"/>
                        <field name="amount" readonly="1"/>
                        <field name="fixed_amount_check" invisible="1"/>
                        <field name="total_amount"/>
                        <field name="advance_donation_amount"/>
                        <field name="welfare_id"/>
                        <field name="state" widget="badge" string="State"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="bn_welfare.action_welfare_consolidated" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_disbursement_category" model="ir.ui.view">
        <field name="name">disbursement.category.form</field>
        <field name="model">disbursement.category</field>
        <field name="arch" type="xml">
            <form string="Disbursement Category">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_disbursement_category" model="ir.ui.view">
        <field name="name">disbursement.category.tree.open.form</field>
        <field name="model">disbursement.category</field>
        <field name="inherit_id" ref="bn_welfare.disbursement_category_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_welfare.disbursement_category_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_disbursement_application_type" model="ir.ui.view">
        <field name="name">disbursement.application.type.form</field>
        <field name="model">disbursement.application.type</field>
        <field name="arch" type="xml">
            <form string="Disbursement Application Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="order_type"/>
                        <field name="product_category_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        <field name="disbursement_category_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        <field name="analytic_account_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_disbursement_application_type" model="ir.ui.view">
        <field name="name">disbursement.application.type.tree.open.form</field>
        <field name="model">disbursement.application.type</field>
        <field name="inherit_id" ref="bn_welfare.disbursement_application_type_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_welfare.disbursement_application_type_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
