<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_template_only_form_view_inherit_bn_welfare" model="ir.ui.view">
        <field name="name">product.product.template.only.form.view.inherit.bn.welfare</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Welfare" name="welfare">
                    <group name="welfare">
                        <field name="is_hod"/>
                        <field name="is_welfare"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
