<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- HR -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id" eval="[
            (6, 0, [
                ref('hr.group_hr_manager'),
                ref('hr.group_hr_user')
            ])
        ]"/>
    </record>
    
