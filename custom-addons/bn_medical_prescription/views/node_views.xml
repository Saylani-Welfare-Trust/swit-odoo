<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch / Site of the document (bn_stock_location node.document.mixin) -->

    <record id="medical_prescription_view_search_search_node" model="ir.ui.view">
        <field name="name">medical.prescription.view.search.node</field>
        <field name="model">medical.prescription</field>
        <field name="inherit_id" ref="bn_medical_prescription.medical_prescription_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="node_id"/>
                <filter name="group_by_node_id" string="Branch / Site" context="{'group_by': 'node_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="medical_prescription_view_tree_tree_node" model="ir.ui.view">
        <field name="name">medical.prescription.view.tree.node</field>
        <field name="model">medical.prescription</field>
        <field name="inherit_id" ref="bn_medical_prescription.medical_prescription_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="inside">
                <field name="node_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="medical_prescription_view_form_form_node" model="ir.ui.view">
        <field name="name">medical.prescription.view.form.node</field>
        <field name="model">medical.prescription</field>
        <field name="inherit_id" ref="bn_medical_prescription.medical_prescription_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='patient']" position="inside">
                <field name="node_id"/>
            </xpath>
        </field>
    </record>

</odoo>
