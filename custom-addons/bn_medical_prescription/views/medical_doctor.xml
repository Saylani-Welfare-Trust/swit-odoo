<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="medical_doctor_view_tree" model="ir.ui.view">
        <field name="name">medical.doctor.view.tree</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <tree string="Doctors">
                <field name="name"/>
                <field name="product_ids" widget="many2many_tags"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="medical_doctor_view_form" model="ir.ui.view">
        <field name="name">medical.doctor.view.form</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Dr. Ahmed"/></h1>
                    </div>
                    <group>
                        <field name="product_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="medical_doctor_view_search" model="ir.ui.view">
        <field name="name">medical.doctor.view.search</field>
        <field name="model">medical.doctor</field>
        <field name="arch" type="xml">
            <search string="Doctors">
                <field name="name"/>
                <field name="product_ids"/>
                <field name="user_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="medical_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">medical.doctor</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="medical_doctor_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a doctor</p>
            <p>List the products of each doctor: the Medical &amp; Health counter offers the doctors of the selected product.</p>
        </field>
    </record>

    <menuitem id="medical_doctor_menu" name="Doctors" action="medical_doctor_action"
              parent="bn_master_setup.master_setup_menu" sequence="20"/>

</odoo>
