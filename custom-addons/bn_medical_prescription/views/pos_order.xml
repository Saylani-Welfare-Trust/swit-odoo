<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_order_view_form_inherit_bn_medical_prescription" model="ir.ui.view">
        <field name="name">pos.order.view.form.inherit.bn.medical.prescription</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_fields']" position="inside">
                <field name="medical_prescription_id" invisible="not medical_prescription_id"/>
            </xpath>
        </field>
    </record>

</odoo>
