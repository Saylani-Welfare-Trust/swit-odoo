<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location: these records are matched on the Branch of the POS shop
         they were made or paid at (pos.link.mixin), which must be the analytic account tagged on
         one of the user's locations in scope, or the user's own Branch
         (res.users.scope_analytic_account_ids). A record not made at a POS stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_medical_prescription_rule" model="ir.rule">
        <field name="name">Medical Prescription: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_medical_prescription.model_medical_prescription"/>
        <field name="domain_force">['|', ('pos_analytic_account_id', '=', False), ('pos_analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_medical_prescription_unrestricted_rule" model="ir.rule">
        <field name="name">Medical Prescription: unrestricted</field>
        <field name="model_id" ref="bn_medical_prescription.model_medical_prescription"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_medical_prescription_line_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_medical_prescription.model_medical_prescription_line"/>
        <field name="domain_force">['|', ('prescription_id', '=', False), ('prescription_id', 'any', ['|', ('pos_analytic_account_id', '=', False), ('pos_analytic_account_id', 'in', user.scope_analytic_account_ids.ids)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_medical_prescription_line_unrestricted_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: unrestricted</field>
        <field name="model_id" ref="bn_medical_prescription.model_medical_prescription_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
