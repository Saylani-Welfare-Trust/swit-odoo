<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="medical_prescription_company_rule" model="ir.rule">
        <field name="name">Medical Prescription: multi-company</field>
        <field name="model_id" ref="model_medical_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="medical_prescription_line_company_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: multi-company</field>
        <field name="model_id" ref="model_medical_prescription_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Global rules, so they apply on top of the branch rules (group rules only add up):
         a user works on the prescriptions of the doctors they are listed on in Master Setup -->
    <record id="medical_prescription_doctor_rule" model="ir.rule">
        <field name="name">Medical Prescription: the user's doctors</field>
        <field name="model_id" ref="model_medical_prescription"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('bn_medical_pos.group_medical_manager') or user.has_group('base.group_system') else [('doctor_id.user_ids', 'in', user.ids)]</field>
    </record>

    <record id="medical_prescription_line_doctor_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: the user's doctors</field>
        <field name="model_id" ref="model_medical_prescription_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('bn_medical_pos.group_medical_manager') or user.has_group('base.group_system') else [('prescription_id.doctor_id.user_ids', 'in', user.ids)]</field>
    </record>

</odoo>
