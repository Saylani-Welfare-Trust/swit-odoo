<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="medical_prescription_company_rule" model="ir.rule">
        <field name="name">Medical Prescription: multi-company</field>
        <field name="model_id" ref="model_medical_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="medical_prescription_line_company_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: multi-company</field>
        <field name="model_id" ref="model_medical_prescription_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Global rules, so they apply on top of the branch rules (group rules only add up):
         a user works on the prescriptions of the doctors they are listed on in Master Setup -->
    <record id="medical_prescription_doctor_rule" model="ir.rule">
        <field name="name">Medical Prescription: the user's doctors</field>
        <field name="model_id" ref="model_medical_prescription"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('bn_medical_pos.group_medical_manager') or user.has_group('base.group_system') else [('doctor_id.user_ids', 'in', user.ids)]</field>
    </record>

    <record id="medical_prescription_line_doctor_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: the user's doctors</field>
        <field name="model_id" ref="model_medical_prescription_line"/>
        <field name="domain_force">[(1, '=', 1)] if user.has_group('bn_medical_pos.group_medical_manager') or user.has_group('base.group_system') else [('prescription_id.doctor_id.user_ids', 'in', user.ids)]</field>
    </record>

    <!-- A doctor needs no branch: added to the branch rules, the global rules above still apply -->
    <record id="medical_prescription_doctor_group_rule" model="ir.rule">
        <field name="name">Medical Prescription: doctor</field>
        <field name="model_id" ref="model_medical_prescription"/>
        <field name="domain_force">[('doctor_id.user_ids', 'in', user.ids)]</field>
        <field name="groups" eval="[(4, ref('bn_medical_pos.group_medical_doctor'))]"/>
    </record>

    <record id="medical_prescription_line_doctor_group_rule" model="ir.rule">
        <field name="name">Medical Prescription Line: doctor</field>
        <field name="model_id" ref="model_medical_prescription_line"/>
        <field name="domain_force">[('prescription_id.doctor_id.user_ids', 'in', user.ids)]</field>
        <field name="groups" eval="[(4, ref('bn_medical_pos.group_medical_doctor'))]"/>
    </record>

    <!-- ... nor Allowed Categories: a doctor can prescribe the products of the Medical & Health categories -->
    <record id="medical_doctor_product_rule" model="ir.rule">
        <field name="name">Product Variant: Medical &amp; Health categories (doctor)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="domain_force">[('pos_categ_ids.mh_medical_scope', '=', True)]</field>
        <field name="groups" eval="[(4, ref('bn_medical_pos.group_medical_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="medical_doctor_product_template_rule" model="ir.rule">
        <field name="name">Product: Medical &amp; Health categories (doctor)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="domain_force">[('pos_categ_ids.mh_medical_scope', '=', True)]</field>
        <field name="groups" eval="[(4, ref('bn_medical_pos.group_medical_doctor'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
