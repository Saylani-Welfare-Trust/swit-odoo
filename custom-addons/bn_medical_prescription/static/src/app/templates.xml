<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- A new order is approved with its doctor first; the bill of a loaded prescription goes to the payment -->
    <t t-name="bn_medical_prescription.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-order-button')]//t[@t-esc='props.actionName']" position="replace">
            <t t-if="pos.isMedicalCounter and props.actionType === 'payment' and !pos.get_order()?.medical_prescription_id">Approve</t>
            <t t-else="" t-esc="props.actionName"/>
        </xpath>
    </t>

    <t t-name="bn_medical_prescription.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//li[hasclass('price-per-unit')]" position="after">
            <li t-if="line.medicalPrescription" class="text-success small">
                <i class="fa fa-medkit me-1"/>Prescribed
            </li>
        </xpath>
    </t>

    <!-- The till and the bill of a prescription are not donation receipts -->
    <t t-name="bn_medical_prescription.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-att-class">props.data.medical_receipt_title ? 'medical-bill' : ''</attribute>
        </xpath>
        <xpath expr="//div[hasclass('receipt_header')]" position="attributes">
            <attribute name="t-if">!order.medical_receipt_title</attribute>
        </xpath>
        <xpath expr="//div[hasclass('receipt_header')]" position="before">
            <div t-if="order.medical_receipt_title" class="row mb-2 medical-bill-header">
                <div class="col-6">
                    <h1 t-esc="order.medical_receipt_title"/>
                </div>
                <div class="col-6 text-end">
                    <h1 class="text-transform" style="font-size: 12px;">
                        <t t-if="company.name"><t t-esc="company.name"/></t>
                        <br/>
                        <t t-if="order.branch_name">(<t t-esc="order.branch_name"/>)</t>
                    </h1>
                </div>
            </div>
        </xpath>
        <!-- a patient, not a donor -->
        <xpath expr="//div[@name='custom-donor']" position="attributes">
            <attribute name="t-if">!order.medical_receipt_title</attribute>
        </xpath>
        <xpath expr="//div[@name='footer-custom-donor']" position="attributes">
            <attribute name="t-if">!order.medical_receipt_title</attribute>
        </xpath>
        <xpath expr="//div[@name='footer-custom-donor']" position="before">
            <div t-if="order.medical_receipt_title"><strong>Patient:</strong> <t t-esc="partner.name"/></div>
        </xpath>
        <xpath expr="//div[@name='custom-donor']" position="before">
            <t t-if="order.medical_receipt_title">
                <div t-if="order.medical_receipt_number"><strong>Prescription No.:</strong> <t t-esc="order.medical_receipt_number"/></div>
                <div><strong>Patient:</strong> <t t-esc="partner.name"/></div>
                <div t-if="order.medical_doctor_name"><strong>Doctor:</strong> <t t-esc="order.medical_doctor_name"/></div>
                <div t-if="partner.registration_id"><strong>Registration No.:</strong> <t t-esc="partner.registration_id"/></div>
            </t>
        </xpath>
    </t>

</templates>
