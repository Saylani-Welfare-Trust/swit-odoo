<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="seq_medical_prescription" model="ir.sequence">
            <field name="name">Medical Prescription</field>
            <field name="code">medical.prescription</field>
            <!-- restarts every day (one date range per day, see models/ir_sequence.py): RX/26112026/0001 -->
            <field name="prefix">RX/%(range_day)s%(range_month)s%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="use_date_range" eval="True"/>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>
