<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="pos_journal_transfer_cron" model="ir.cron">
            <field name="name">POS Journal Transfer</field>
            <field name="model_id" ref="model_journal_transfer"/>
            <field name="state">code</field>
            <field name="code">model._pull_pos_entries()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>

    <!-- The cron above is noupdate: a database installed with an earlier version
         keeps that version's code, which called a method since renamed
         (_cron_pull_pos_entries). Its code is set again on every install /
         upgrade; schedule and other settings are left as configured. -->
    <function model="ir.cron" name="write"
              eval="[[ref('bn_journal_transfer.pos_journal_transfer_cron')], {'code': 'model._pull_pos_entries()'}]"/>

</odoo>
