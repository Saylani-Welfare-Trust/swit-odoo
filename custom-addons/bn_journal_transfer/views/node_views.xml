<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Branch / Site of the document (bn_stock_location node.document.mixin) -->

    <record id="search_journal_transfer_search_node" model="ir.ui.view">
        <field name="name">journal.transfer.search.node</field>
        <field name="model">journal.transfer</field>
        <field name="inherit_id" ref="bn_journal_transfer.search_journal_transfer"/>
        <field name="arch" type="xml">
            <xpath expr="/search" position="inside">
                <field name="node_id"/>
                <filter name="group_by_node_id" string="Branch / Site" context="{'group_by': 'node_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="journal_transfer_view_tree_tree_node" model="ir.ui.view">
        <field name="name">journal.transfer.view.tree.node</field>
        <field name="model">journal.transfer</field>
        <field name="inherit_id" ref="bn_journal_transfer.journal_transfer_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="inside">
                <field name="node_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="journal_transfer_view_form_form_node" model="ir.ui.view">
        <field name="name">journal.transfer.view.form.node</field>
        <field name="model">journal.transfer</field>
        <field name="inherit_id" ref="bn_journal_transfer.journal_transfer_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='journal_transfer_col_1']" position="inside">
                <field name="node_id"/>
            </xpath>
        </field>
    </record>

</odoo>
