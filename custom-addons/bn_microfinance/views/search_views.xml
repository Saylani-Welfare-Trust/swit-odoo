<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_microfinance" model="ir.ui.view">
        <field name="name">microfinance.search</field>
        <field name="model">microfinance</field>
        <field name="arch" type="xml">
            <search string="Microfinance">
                <field name="name"/>
                <field name="donee_id"/>
                <field name="product_id"/>
                <field name="recovered_location_id"/>
                <field name="warehouse_location_id"/>
                <field name="microfinance_line_ids" string="Line Product" filter_domain="[('microfinance_line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_hod_approve" string="HOD Approval" domain="[('state', '=', 'hod_approve')]"/>
                <filter name="filter_state_mem_approve" string="Member Approval" domain="[('state', '=', 'mem_approve')]"/>
                <filter name="filter_state_approve" string="Approved" domain="[('state', '=', 'approve')]"/>
                <filter name="filter_state_wfd" string="Waiting For Delivery" domain="[('state', '=', 'wfd')]"/>
                <filter name="filter_state_treasury" string="Treasury" domain="[('state', '=', 'treasury')]"/>
                <filter name="filter_state_in_recovery" string="In Recovery" domain="[('state', '=', 'in_recovery')]"/>
                <filter name="filter_state_recover" string="Temp Recovered" domain="[('state', '=', 'recover')]"/>
                <filter name="filter_state_fully_recover" string="Fully Recovered" domain="[('state', '=', 'fully_recover')]"/>
                <filter name="filter_state_right_of_approval_1" string="Write Off Approval 1" domain="[('state', '=', 'right_of_approval_1')]"/>
                <filter name="filter_state_right_of_approval_2" string="Write Off Approval 2" domain="[('state', '=', 'right_of_approval_2')]"/>
                <filter name="filter_state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_state_right_granted" string="Right Granted" domain="[('state', '=', 'right_granted')]"/>
                <filter name="filter_state_close" string="Closed" domain="[('state', '=', 'close')]"/>
                <filter name="filter_state_reject" string="Rejected" domain="[('state', '=', 'reject')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="groupby_donee_id" string="Donee" context="{'group_by': 'donee_id'}"/>
                    <filter name="groupby_product_id" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="groupby_recovered_location_id" string="Recovery Location" context="{'group_by': 'recovered_location_id'}"/>
                    <filter name="groupby_warehouse_location_id" string="Warehouse Location" context="{'group_by': 'warehouse_location_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_microfinance_installment" model="ir.ui.view">
        <field name="name">microfinance.installment.search</field>
        <field name="model">microfinance.installment</field>
        <field name="arch" type="xml">
            <search string="Microfinance Installment">
                <field name="name"/>
                <field name="cnic_no"/>
                <field name="pos_reference"/>
                <field name="pos_config_id"/>
                <field name="donee_id"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_pending" string="Pending" domain="[('state', '=', 'pending')]"/>
                <filter name="filter_state_paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_state_bounced" string="Bounced" domain="[('state', '=', 'bounced')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_date" string="Date" date="date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="groupby_pos_config_id" string="Point of Sale" context="{'group_by': 'pos_config_id'}"/>
                    <filter name="groupby_donee_id" string="Donee" context="{'group_by': 'donee_id'}"/>
                    <filter name="groupby_date_month" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_microfinance_line" model="ir.ui.view">
        <field name="name">microfinance.line.search</field>
        <field name="model">microfinance.line</field>
        <field name="inherit_id" ref="bn_microfinance.view_microfinance_line_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="name"/>
                <field name="donee_id"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_cheque_date" string="Cheque Date" date="cheque_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_donee_id" string="Donee" context="{'group_by': 'donee_id'}"/>
                    <filter name="groupby_cheque_date_month" string="Cheque Date" context="{'group_by': 'cheque_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_microfinance_pdc_line" model="ir.ui.view">
        <field name="name">microfinance.pdc.line.search</field>
        <field name="model">microfinance.pdc.line</field>
        <field name="inherit_id" ref="bn_microfinance.view_microfinance_pdc_consolidated_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="created_by"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_cheque_date" string="Cheque Date" date="cheque_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_created_by" string="Created By" context="{'group_by': 'created_by'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_microfinance_scheme" model="ir.ui.view">
        <field name="name">microfinance.scheme.search</field>
        <field name="model">microfinance.scheme</field>
        <field name="arch" type="xml">
            <search string="Microfinance Scheme">
                <field name="name"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_security_offered" model="ir.ui.view">
        <field name="name">security.offered.search</field>
        <field name="model">security.offered</field>
        <field name="inherit_id" ref="bn_microfinance.security_offered_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
