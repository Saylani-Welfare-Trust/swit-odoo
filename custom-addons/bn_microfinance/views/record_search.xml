<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="microfinance_donee_action" model="ir.actions.act_window">
        <field name="name">Donee</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <!-- by tag id (a renamed tag keeps working) -->
        <field name="domain" eval="[('category_id', 'in', [ref('bn_profile_management.donee_partner_category')]), ('category_id', 'in', [ref('bn_profile_management.individual_partner_category')]), ('category_id', 'in', [ref('bn_profile_management.microfinance_partner_category')])]"/>
        <field name="context">{
            'create': 0,
            'delete': 0,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Waiting for Microfinance Donee's....
            </p>
        </field>
        <field name="view_ids"
            eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'kanban', 'view_id': ref('bn_profile_management.profile_management_view_kanban')}),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('bn_profile_management.profile_management_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('bn_profile_management.profile_management_view_form')})]"/>
    </record>

    <menuitem
        id="microfinance_profile_management_menu"
        name="Profile"
        parent="microfinance_menu"
        sequence="2"/>

    <menuitem
        id="record_search_menu"
        name="Record Search"
        action="bn_profile_management.record_search_microfinance_action"
        parent="microfinance_profile_management_menu"
        sequence="0"
        groups="bn_profile_management.profile_management_user_group"/>

    <menuitem
        id="microfinance_donee_menu"
        name="Donee"
        action="microfinance_donee_action"
        parent="microfinance_profile_management_menu"
        sequence="1"/>


    <!-- These menus follow the programme tag (Profile Management > Tags): hidden while
         the programme is disabled. Linked on every install / upgrade. -->
    <function model="res.partner.category" name="_link_program_menus"
              eval="['microfinance', ['bn_microfinance.microfinance_profile_management_menu']]"/>
</odoo>
