<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_microfinance_installment" model="ir.ui.view">
        <field name="name">microfinance.installment.form</field>
        <field name="model">microfinance.installment</field>
        <field name="arch" type="xml">
            <form string="Microfinance Installment" create="0" edit="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="payment_type"/>
                        <field name="payment_method"/>
                        <field name="donee_id"/>
                        <field name="cnic_no"/>
                        <field name="bank_name"/>
                        <field name="cheque_no"/>
                        <field name="cheque_date"/>
                        <field name="amount"/>
                        <field name="state" widget="badge"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="bn_microfinance.microfinance_installment_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="bn_microfinance.microfinance_security_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_microfinance_pdc_line" model="ir.ui.view">
        <field name="name">microfinance.pdc.line.form</field>
        <field name="model">microfinance.pdc.line</field>
        <field name="arch" type="xml">
            <form string="Microfinance PDC Line" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="microfinance_id" string="Application Number"/>
                        <field name="installment_number" string="Installment Number"/>
                        <field name="donee_id" string="Donee"/>
                        <field name="cheque_date" string="Cheque Date"/>
                        <field name="bank_name" string="Bank"/>
                        <field name="amount_total" string="Cheque Amount"/>
                        <field name="state_cheque" string="State" widget="badge"/>
                        <field name="is_deposit" widget="boolean"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="chatter_form_microfinance_line" model="ir.ui.view">
        <field name="name">microfinance.line.form</field>
        <field name="model">microfinance.line</field>
        <field name="arch" type="xml">
            <form string="Microfinance Line">
                <sheet>
                    <group>
                        <field name="installment_no"/>
                        <field name="product_id"/>
                        <field name="payment_type" string="Payment Type"/>
                        <field name="due_date"/>
                        <field name="amount"/>
                        <field name="paid_amount"/>
                        <field name="remaining_amount"/>
                        <field name="state" force_save="1" widget="badge"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
