<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="security_deposit_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">

                    <!-- Microfinance Container -->
                    <div class="mt-4 clearfix">

                        <!-- Header -->
                        <div class="text-center border-bottom border-3 pb-3 mb-4" style="border-color: black !important;">
                            <h2 class="fw-bold text-uppercase" style="color: black;">
                                Provisional Security Deposit Receipt
                            </h2>
                        </div>

                        <!-- Microfinance Info -->
                        <div class="bg-light p-3 border-start border-5 mb-4">
                            <div class="row">
                                <div class="col-md-6 mb-2">
                                    <t t-import="datetime"/>
                                    <span class="fw-bold">Date:</span>
                                    <span class="ms-2">
                                        <t t-esc="datetime.datetime.now().strftime('%d-%m-%Y')"/>
                                    </span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="fw-bold">Microfinance ID</span>
                                    <span class="ms-2">
                                        <t t-esc="o.name"/>
                                    </span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="fw-bold">Donee:</span>
                                    <span class="ms-2">
                                        <t t-esc="o.donee_id.name"/>
                                    </span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="fw-bold">Registration No.:</span>
                                    <span class="ms-2">
                                        <t t-esc="o.donee_id.primary_registration_id or '-'"/>
                                    </span>
                                </div>
                                <div class="col-md-6 mb-2">
                                    <span class="fw-bold">CNIC No.:</span>
                                    <span class="ms-2">
                                        <t t-esc="o.donee_id.cnic_no or '-'"/>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Amounts -->
                        <table class="table table-bordered" style="width:100%;">
                            <tbody>
                                <tr>
                                    <td class="fw-bold" style="width:60%;">Security Deposit (received)</td>
                                    <td class="text-end fw-bold"><t t-esc="o.security_deposit" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Total Loan Amount</td>
                                    <td class="text-end"><t t-esc="o.total_amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                                <tr>
                                    <td>Monthly Installment</td>
                                    <td class="text-end"><t t-esc="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="small"><strong>Amount in Words:</strong> <t t-esc="o.currency_id.amount_to_text(o.security_deposit)"/> Only</p>
                        <p class="small text-muted">This receipt is provisional until the security deposit is confirmed by Treasury.</p>

                        <!-- Signatures -->
                        <table style="width:100%; margin-top:60px;">
                            <tr>
                                <td style="width:50%;"><div style="width:180px; border-top:1px solid #333; padding-top:4px; text-align:center;">Donee Signature</div></td>
                                <td style="width:50%; text-align:right;"><div style="display:inline-block; width:180px; border-top:1px solid #333; padding-top:4px; text-align:center;">Authorized Signature</div></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="security_deposit_report_action" model="ir.actions.report">
        <field name="name">Microfinance Security Deposit</field>
        <field name="model">microfinance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bn_microfinance.security_deposit_template</field>
        <field name="report_file">bn_microfinance.security_deposit_template</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Security Deposit - %s' % (object.name)</field>
    </record>

</odoo>
