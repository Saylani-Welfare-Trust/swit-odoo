<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- WhatsApp receipt of a microfinance installment: outstanding balance after the payment -->
    <template id="pos_whatsapp_donation_receipt_microfinance_remaining"
              inherit_id="bn_pos_order.pos_whatsapp_donation_receipt_template">
        <xpath expr="//div[strong[text()='Total Amount:']]" position="after">
            <div t-if="order.has_microfinance_remaining">
                <strong>Remaining Amount:</strong>
                <t t-esc="'{:,}'.format(int(order.microfinance_remaining_amount) or 0)"/>
            </div>
        </xpath>
    </template>
</odoo>
