<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_microfinance_line_overdue" model="ir.cron">
            <field name="name">Microfinance: Mark Overdue Installments</field>
            <field name="model_id" ref="model_microfinance_line"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_overdue_state()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

    </data>

    <!-- Mark existing past-due lines as overdue on install/upgrade -->
    <function model="microfinance.line" name="_cron_update_overdue_state"/>
</odoo>
