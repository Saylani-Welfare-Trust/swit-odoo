<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="microfinance_application_wizard_form" model="ir.ui.view">
        <field name="name">microfinance.application.wizard.form</field>
        <field name="model">microfinance.application.wizard</field>
        <field name="arch" type="xml">
            <form string="Print Microfinance Application">
                <group>
                    <field name="partner_id" invisible="1"/>
                    <field name="microfinance_scheme_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button string="Print Application" name="action_print_application" groups="bn_microfinance.microfinance_user_group,bn_profile_management.profile_management_user_group" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
