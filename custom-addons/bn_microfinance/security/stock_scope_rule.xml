<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml). A microfinance application is matched on its Warehouse / Recovery Location;
         one without either stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_microfinance_rule" model="ir.rule">
        <field name="name">Microfinance: allowed locations</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance"/>
        <field name="domain_force">['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
