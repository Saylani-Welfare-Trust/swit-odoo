<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml). A microfinance application is matched on its Warehouse / Recovery Location
         (its lines, recovery lines, PDCs and installments through it; an installment also by the Branch of the shop it was paid at);
         one without either stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_microfinance_rule" model="ir.rule">
        <field name="name">Microfinance: allowed locations</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance"/>
        <field name="domain_force">['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_microfinance_line_rule" model="ir.rule">
        <field name="name">Microfinance Line: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_line"/>
        <field name="domain_force">['|', ('microfinance_id', '=', False), ('microfinance_id', 'any', ['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_line_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance Line: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_microfinance_recovery_line_rule" model="ir.rule">
        <field name="name">Microfinance Recovery Line: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_recovery_line"/>
        <field name="domain_force">['|', ('microfinance_id', '=', False), ('microfinance_id', 'any', ['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_recovery_line_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance Recovery Line: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_recovery_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_microfinance_pdc_line_rule" model="ir.rule">
        <field name="name">Microfinance PDC Line: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_pdc_line"/>
        <field name="domain_force">['|', ('microfinance_id', '=', False), ('microfinance_id', 'any', ['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_pdc_line_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance PDC Line: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_pdc_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_microfinance_installment_rule" model="ir.rule">
        <field name="name">Microfinance Installment: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_installment"/>
        <field name="domain_force">['|', ('pos_analytic_account_id', 'in', user.scope_analytic_account_ids.ids), '|', ('microfinance_id', '=', False), ('microfinance_id', 'any', ['|', '|', ('warehouse_location_id', 'child_of', user.scope_location_ids.ids), ('recovered_location_id', 'child_of', user.scope_location_ids.ids), '&amp;', ('warehouse_location_id', '=', False), ('recovered_location_id', '=', False)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_microfinance_installment_unrestricted_rule" model="ir.rule">
        <field name="name">Microfinance Installment: unrestricted</field>
        <field name="model_id" ref="bn_microfinance.model_microfinance_installment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
