    <record id="scope_sadqa_jariya_inquiry_report_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Inquiry Report: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_inquiry_report"/>
        <field name="domain_force">['|', ('application_id', '=', False), ('application_id', 'any', ['|', ('line_branch_ids', '=', False), ('line_branch_ids', 'in', user.scope_analytic_account_ids.ids)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_sadqa_jariya_inquiry_report_unrestricted_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Inquiry Report: unrestricted</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_inquiry_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_sadqa_jariya_committee_line_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Committee Line: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_committee_line"/>
        <field name="domain_force">['|', ('application_id', '=', False), ('application_id', 'any', ['|', ('line_branch_ids', '=', False), ('line_branch_ids', 'in', user.scope_analytic_account_ids.ids)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_sadqa_jariya_committee_line_unrestricted_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Committee Line: unrestricted</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_committee_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_sadqa_jariya_form_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Form: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_form"/>
        <field name="domain_force">['|', ('application_id', '=', False), ('application_id', 'any', ['|', ('line_branch_ids', '=', False), ('line_branch_ids', 'in', user.scope_analytic_account_ids.ids)])]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_sadqa_jariya_form_unrestricted_rule" model="ir.rule">
        <field name="name">Sadqa Jariya Form: unrestricted</field>
        <field name="model_id" ref="bn_sadqa_e_jariya.model_sadqa_jariya_form"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
