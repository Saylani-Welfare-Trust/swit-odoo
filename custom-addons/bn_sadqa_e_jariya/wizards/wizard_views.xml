<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sadqa_jariya_review_wizard_view_form" model="ir.ui.view">
        <field name="name">sadqa.jariya.review.wizard.view.form</field>
        <field name="model">sadqa.jariya.review.wizard</field>
        <field name="arch" type="xml">
            <form string="Review Application">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="application_id" readonly="1" options="{'no_open': True}"/></h1>
                    </div>
                    <group>
                        <group string="Institution">
                            <field name="donee_id"/>
                            <field name="institution_category"/>
                            <field name="subcategory"/>
                            <field name="institute_name"/>
                            <field name="address"/>
                        </group>
                        <group string="Request">
                            <field name="state"/>
                            <field name="order_type"/>
                            <field name="employee_id"/>
                            <field name="account_title"/>
                            <field name="account_number"/>
                        </group>
                    </group>
                    <separator string="Disbursement Items"/>
                    <field name="lines_html" nolabel="1"/>
                    <separator string="Inquiry Reports"/>
                    <field name="inquiry_reports_html" nolabel="1"/>
                    <separator string="Committee Members"/>
                    <field name="committee_members_html" nolabel="1"/>
                    <group string="Remarks">
                        <field name="hod_remarks" invisible="state != 'hod_approve'" required="state == 'hod_approve'"/>
                        <field name="committee_remarks" invisible="state != 'committee_approval'" required="state == 'committee_approval'"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="sadqa_jariya_officer_wizard_view_form" model="ir.ui.view">
        <field name="name">sadqa.jariya.officer.wizard.view.form</field>
        <field name="model">sadqa.jariya.officer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="mode" invisible="1"/>
                <field name="employee_category_id" invisible="1"/>
                <div class="text-muted mb-2" invisible="mode != 'reopen'">
                    The portal opens a new inquiry report for this officer; the completed one stays on the application.
                </div>
                <div class="text-muted mb-2" invisible="mode != 'change'">
                    The open inquiry moves to this officer, who completes the same report.
                </div>
                <group>
                    <field name="application_id"/>
                    <field name="employee_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
