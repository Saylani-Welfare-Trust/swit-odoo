<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_sadqa_jariya_line" model="ir.ui.view">
        <field name="name">sadqa.jariya.line.form</field>
        <field name="model">sadqa.jariya.line</field>
        <field name="arch" type="xml">
            <form string="Sadqa e Jariya Disbursement Line" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="application_id"/>
                        <field name="donee_id"/>
                        <field name="recurring_duration"/>
                        <field name="disbursement_category_id"/>
                        <field name="application_type_id"/>
                        <field name="product_id"/>
                        <field name="on_hand_qty"/>
                        <field name="collection_point"/>
                        <field name="analytic_account_id"/>
                        <field name="collection_date"/>
                        <field name="quantity"/>
                        <field name="amount"/>
                        <field name="total_amount"/>
                        <field name="state" widget="badge"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="bn_sadqa_e_jariya.sadqa_jariya_line_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_sadqa_jariya_recurring_line" model="ir.ui.view">
        <field name="name">sadqa.jariya.recurring.line.form</field>
        <field name="model">sadqa.jariya.recurring.line</field>
        <field name="arch" type="xml">
            <form string="Sadqa e Jariya Recurring Line" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="application_id"/>
                        <field name="donee_id"/>
                        <field name="disbursement_category_id"/>
                        <field name="product_id"/>
                        <field name="collection_point"/>
                        <field name="analytic_account_id"/>
                        <field name="collection_date"/>
                        <field name="quantity"/>
                        <field name="amount"/>
                        <field name="state" widget="badge"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="bn_sadqa_e_jariya.sadqa_jariya_recurring_line_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_sadqa_jariya_area" model="ir.ui.view">
        <field name="name">sadqa.jariya.area.form</field>
        <field name="model">sadqa.jariya.area</field>
        <field name="arch" type="xml">
            <form string="Sadqa e Jariya Area">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="description"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_sadqa_jariya_area" model="ir.ui.view">
        <field name="name">sadqa.jariya.area.tree.open.form</field>
        <field name="model">sadqa.jariya.area</field>
        <field name="inherit_id" ref="bn_sadqa_e_jariya.sadqa_jariya_area_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_sadqa_e_jariya.sadqa_jariya_area_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

    <record id="chatter_form_sadqa_jariya_committee_member" model="ir.ui.view">
        <field name="name">sadqa.jariya.committee.member.form</field>
        <field name="model">sadqa.jariya.committee.member</field>
        <field name="arch" type="xml">
            <form string="Sadqa e Jariya Committee Member">
                <sheet>
                    <group>
                        <field name="employee_id" options="{'no_create': True, 'no_edit': True}"/>
                        <field name="job_title"/>
                        <field name="department_id"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
