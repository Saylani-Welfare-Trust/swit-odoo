<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sadqa_e_jariya_record_search_action" model="ir.actions.act_window">
        <field name="name">Record Search</field>
        <field name="res_model">record.search</field>
        <field name="view_mode">form</field>
        <field name="context">{
            'default_registration_type': 'donee',
            'default_donee_registration_type': 'sadqa_e_jariya',
            'default_is_sadqa_e_jariya': True,
            'default_category': 'institution',
        }</field>
        <field name="target">new</field>
    </record>

    <record id="sadqa_e_jariya_donee_action" model="ir.actions.act_window">
        <field name="name">Donee</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <!-- by tag record, not name: the tags can be renamed (Coorporate -> Corporate / Institute) -->
        <field name="domain" eval="str([('category_id', 'in', [ref('bn_profile_management.donee_partner_category')]),
                                        ('category_id', 'in', [ref('bn_profile_management.coorporate_institute_partner_category')]),
                                        ('category_id', 'in', [ref('sadqa_jariya_partner_category')])])"/>
        <field name="context">{
            'create': 0,
            'delete': 0,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Waiting for Sadqa e Jariya Donee's....
            </p>
        </field>
        <field name="view_ids"
            eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'kanban', 'view_id': ref('bn_profile_management.profile_management_view_kanban')}),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('bn_profile_management.profile_management_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('bn_profile_management.profile_management_view_form')})]"/>
    </record>

    <menuitem
        id="sadqa_e_jariya_menu"
        name="Sadqa e Jariya"
        web_icon="bn_sadqa_e_jariya,static/description/icon.png"
        groups="bn_sadqa_e_jariya.group_institutional_disbursement,bn_sadqa_e_jariya.group_fetch_institution,bn_sadqa_e_jariya.group_sadqa_jariya_marfat_officer,bn_sadqa_e_jariya.group_sadqa_jariya_all_lines"
        sequence="7"/>

    <menuitem
        id="sadqa_e_jariya_institution_disbursement_menu"
        name="Institution Disbursement"
        action="sadqa_jariya_action"
        groups="bn_sadqa_e_jariya.group_institutional_disbursement"
        parent="sadqa_e_jariya_menu"
        sequence="1"/>

    <menuitem
        id="sadqa_e_jariya_profile_menu"
        name="Profile"
        groups="bn_sadqa_e_jariya.group_institutional_disbursement"
        parent="sadqa_e_jariya_menu"
        sequence="2"/>

    <menuitem
        id="sadqa_e_jariya_record_search_menu"
        name="Record Search"
        action="sadqa_e_jariya_record_search_action"
        parent="sadqa_e_jariya_profile_menu"
        sequence="0"/>

    <menuitem
        id="sadqa_e_jariya_donee_menu"
        name="Donee"
        action="sadqa_e_jariya_donee_action"
        parent="sadqa_e_jariya_profile_menu"
        sequence="1"/>

    <menuitem
        id="sadqa_jariya_lines_menu"
        name="All Lines"
        groups="bn_sadqa_e_jariya.group_sadqa_jariya_all_lines"
        parent="sadqa_e_jariya_menu"
        sequence="4"/>

    <menuitem
        id="sadqa_jariya_line_menu"
        name="All Disbursement Lines"
        action="sadqa_jariya_line_action"
        parent="sadqa_jariya_lines_menu"
        sequence="1"/>

    <menuitem
        id="sadqa_jariya_recurring_line_menu"
        name="All Recurring Lines"
        action="sadqa_jariya_recurring_line_action"
        parent="sadqa_jariya_lines_menu"
        sequence="2"/>

    <menuitem
        id="sadqa_jariya_marfat_shift_menu"
        name="Check Assigned Officer Shift"
        action="sadqa_jariya_marfat_shift_action"
        groups="bn_sadqa_e_jariya.group_sadqa_jariya_marfat_officer"
        parent="sadqa_e_jariya_menu"
        sequence="25"/>

    <menuitem
        id="menu_fetch_institution_applications"
        name="Portal Sync"
        groups="bn_sadqa_e_jariya.group_fetch_institution"
        parent="sadqa_e_jariya_menu"
        sequence="100"/>

    <menuitem
        id="fetch_institution_applications"
        name="Sync Now"
        parent="menu_fetch_institution_applications"
        action="action_fetch_institution_applications"
        sequence="100"/>

    <menuitem
        id="menu_sadqa_jariya_fetch_log"
        name="Logs"
        parent="menu_fetch_institution_applications"
        action="sadqa_jariya_fetch_log_action"
        sequence="99"/>

    <!-- Configuration lives in Master Setup, like Welfare's -->
    <menuitem
        id="sadqa_jariya_config_menu"
        name="Sadqa e Jariya"
        parent="bn_master_setup.master_setup_menu"
        sequence="5"/>

    <menuitem
        id="sadqa_jariya_area_menu"
        name="Areas"
        action="sadqa_jariya_area_action"
        parent="sadqa_jariya_config_menu"
        sequence="0"/>

    <menuitem
        id="sadqa_jariya_application_type_menu"
        name="Disbursement Application Types"
        action="sadqa_jariya_application_type_action"
        parent="sadqa_jariya_config_menu"
        sequence="1"/>

    <menuitem
        id="sadqa_jariya_disbursement_category_menu"
        name="Disbursement Categories"
        action="sadqa_jariya_disbursement_category_action"
        parent="sadqa_jariya_config_menu"
        sequence="2"/>

    <menuitem
        id="sadqa_jariya_approval_limit_menu"
        name="Approval Limits"
        action="sadqa_jariya_approval_limit_action"
        parent="sadqa_jariya_config_menu"
        sequence="3"/>

</odoo>
