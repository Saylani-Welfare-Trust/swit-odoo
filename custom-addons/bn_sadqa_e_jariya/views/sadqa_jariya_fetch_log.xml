<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sadqa_jariya_fetch_log_view_tree" model="ir.ui.view">
        <field name="name">sadqa.jariya.fetch.log.view.tree</field>
        <field name="model">sadqa.jariya.fetch.log</field>
        <field name="arch" type="xml">
            <tree decoration-danger="not sync">
                <field name="fetch_date"/>
                <field name="forms_imported"/>
                <field name="inquiries_imported"/>
                <field name="sync" widget="boolean_toggle" readonly="1"/>
                <field name="errors" optional="show"/>
                <button name="action_view_fetched_records" string="View Records" type="object"/>
            </tree>
        </field>
    </record>

    <record id="sadqa_jariya_fetch_log_view_form" model="ir.ui.view">
        <field name="name">sadqa.jariya.fetch.log.view.form</field>
        <field name="model">sadqa.jariya.fetch.log</field>
        <field name="arch" type="xml">
            <form string="Portal Sync" create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="fetch_date"/>
                            <field name="sync"/>
                        </group>
                        <group>
                            <field name="forms_imported"/>
                            <field name="inquiries_imported"/>
                        </group>
                    </group>
                    <separator string="Errors"/>
                    <field name="errors" nolabel="1"/>
                    <separator string="Applications"/>
                    <field name="record_ids" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sadqa_jariya_fetch_log_action" model="ir.actions.act_window">
        <field name="name">Portal Sync Logs</field>
        <field name="res_model">sadqa.jariya.fetch.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
