<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sadqa e Jariya donees (institutions) are their own programme, apart
         from Welfare: Record Search adds this tag, so a contact shows every
         programme it applied to. -->
    <data noupdate="1">
        <record id="sadqa_e_jariya_partner_category" model="res.partner.category">
            <field name="name">Sadqa e Jariya</field>
            <field name="registration_program_code">sadqa_e_jariya</field>
            <field name="registration_role">donee</field>
            <field name="registration_kind">institution</field>
        </record>
    </data>
    <!-- every install / upgrade: contacts already used in Sadqa e Jariya get its tag -->
    <function model="res.partner" name="_setup_sadqa_e_jariya_donees"/>
</odoo>
