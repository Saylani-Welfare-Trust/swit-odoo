<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Automatically checks for submitted forms and completed inquiries, then imports and acknowledges them -->
    <record id="ir_cron_sadqa_jariya_portal_sync" model="ir.cron">
        <field name="name">Sadqa e Jariya: Auto Check Portal Status</field>
        <field name="model_id" ref="model_sadqa_jariya"/>
        <field name="state">code</field>
        <field name="code">model._sync_portal(from_cron=True)</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_auto_deliver_sadqa_jariya_line" model="ir.cron">
        <field name="name">Sadqa e Jariya: Auto Deliver Lines</field>
        <field name="model_id" ref="model_sadqa_jariya_line"/>
        <field name="state">code</field>
        <field name="code">model._auto_mark_as_delivered_today()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_auto_deliver_sadqa_jariya_recurring_line" model="ir.cron">
        <field name="name">Sadqa e Jariya: Auto Deliver Recurring Lines</field>
        <field name="model_id" ref="model_sadqa_jariya_recurring_line"/>
        <field name="state">code</field>
        <field name="code">model._auto_mark_as_delivered_today()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_auto_create_bills_sadqa_jariya_line" model="ir.cron">
        <field name="name">Sadqa e Jariya: Auto Create Bills for Bank Lines</field>
        <field name="model_id" ref="model_sadqa_jariya_line"/>
        <field name="state">code</field>
        <field name="code">model._auto_create_bank_bills()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

    <record id="ir_cron_auto_create_bills_sadqa_jariya_recurring_line" model="ir.cron">
        <field name="name">Sadqa e Jariya: Auto Create Bills for Recurring Bank Lines</field>
        <field name="model_id" ref="model_sadqa_jariya_recurring_line"/>
        <field name="state">code</field>
        <field name="code">model._auto_create_bank_bills()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
    </record>

</odoo>
