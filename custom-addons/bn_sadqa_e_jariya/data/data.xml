<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Third tag of a Sadqa e Jariya donee, with Donee and Corporate / Institute -->
        <record id="sadqa_jariya_partner_category" model="res.partner.category">
            <field name="name">Sadqa-e-Jaria</field>
        </record>

        <!-- Inquiry officers are matched by their employee tag -->
        <record id="inquiry_officer_hr_employee_category" model="hr.employee.category">
            <field name="name">Sadqa e Jariya Inquiry Officer</field>
        </record>

        <!-- Bank lines are paid through Accounting, In Kind lines are delivered from stock -->
        <record id="disbursement_category_cash" model="sadqa.jariya.disbursement.category">
            <field name="name">Bank</field>
        </record>
        <record id="disbursement_category_in_kind" model="sadqa.jariya.disbursement.category">
            <field name="name">In Kind</field>
        </record>

    </data>

</odoo>
