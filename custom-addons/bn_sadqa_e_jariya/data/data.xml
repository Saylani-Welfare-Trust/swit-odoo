<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">

        <!-- Employees with these tags can be picked as Inquiry Officer / Assigned Officer (Marfat) -->
        <record id="inquiry_officer_hr_employee_category" model="hr.employee.category">
            <field name="name">Sadqa e Jariya Inquiry Officer</field>
        </record>
        <record id="assigned_officer_hr_employee_category" model="hr.employee.category">
            <field name="name">Sadqa e Jariya Assigned Officer (Marfat)</field>
        </record>

        <!-- Cash lines are paid at POS (branch) or by bill (bank), In Kind lines are delivered from stock -->
        <record id="disbursement_category_cash" model="sadqa.jariya.disbursement.category">
            <field name="name">Cash</field>
        </record>
        <record id="disbursement_category_in_kind" model="sadqa.jariya.disbursement.category">
            <field name="name">In Kind</field>
        </record>

    </data>

</odoo>
