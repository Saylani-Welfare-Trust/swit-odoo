<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Donor receipts the POS screen did not ask for (screen closed, offline) -->
        <record id="cron_send_missing_donor_receipts" model="ir.cron">
            <field name="name">Donations: send missing donor receipts (WhatsApp / SMS)</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_missing_donor_receipts()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
