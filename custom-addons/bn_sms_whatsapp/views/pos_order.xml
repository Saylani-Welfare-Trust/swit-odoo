<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_inherit_bn_sms_whatsapp" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.bn.sms.whatsapp</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="donor_receipt_state" invisible="not partner_id"/>
                <field name="donor_receipt_result" invisible="not donor_receipt_state"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_order_tree_inherit_bn_sms_whatsapp" model="ir.ui.view">
        <field name="name">pos.order.tree.inherit.bn.sms.whatsapp</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="donor_receipt_state" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
