<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base_view_users_form_inherit_bn_stock_location" model="ir.ui.view">
        <field name="name">base.view.users.form.inherit.bn.stock.location</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page name="inventory" string="Inventory">
                    <div class="text-muted mb-2">
                        The user sees and uses the warehouses, locations, operation types and program documents of
                        their Branches / Sites (a province, city or zone gives everything under it), plus the documents
                        they created; All Branches / Sites sees everything. Product categories limit the products.
                    </div>
                    <group>
                        <group name="node_access" string="Branches / Sites">
                            <field name="all_nodes"/>
                            <field name="allowed_node_ids" widget="many2many_tags" invisible="all_nodes"
                                   domain="[('plan_id.name', '=', 'Location')]"
                                   options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                            <field name="allowed_product_category_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                        </group>
                        <group name="inventory_scope" string="In scope (what the rules use)">
                            <field name="scope_warehouse_ids" widget="many2many_tags" readonly="1"/>
                            <field name="scope_location_ids" widget="many2many_tags" readonly="1"/>
                            <field name="scope_analytic_account_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
