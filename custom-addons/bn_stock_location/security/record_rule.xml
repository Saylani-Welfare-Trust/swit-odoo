        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="custom_product_product_rule" model="ir.rule">
        <field name="name">Product Variant: allowed categories</field>
        <field name="model_id" ref="product.model_product_product"/>
