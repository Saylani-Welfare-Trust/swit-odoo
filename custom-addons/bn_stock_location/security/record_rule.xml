<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        System-wide scope: every internal user only sees and uses the
        warehouses, internal locations, operation types and product
        categories set on his user (Settings > Users > Inventory tab).
        Nothing is set = no access.

        Not restricted:
        - Settings administrators and "Stock Location / Unrestricted Access"
          (rules for those groups grant everything: group rules add up);
        - locations that are not internal (vendors, customers, inventory
          adjustment, scrap, transit, views ...), needed by every move;
        - scheduled actions and server code run as superuser.

        A location gives access to its sub-locations, a category to its
        sub-categories (their parents can be read, not their stock / products).
    -->

    <!-- Warehouse -->
    <record id="custom_warehouse_rule" model="ir.rule">
        <field name="name">Warehouse: allowed warehouses</field>
        <field name="model_id" ref="stock.model_stock_warehouse"/>
        <field name="domain_force">[('id', 'in', user.allowed_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Location -->
    <record id="custom_location_rule" model="ir.rule">
        <field name="name">Location: allowed internal locations</field>
        <field name="model_id" ref="stock.model_stock_location"/>
        <!-- parents too (Odoo reads them for names / putaway); their stock stays hidden -->
        <field name="domain_force">['|', '|', ('usage', '!=', 'internal'), ('id', 'child_of', user.allowed_location_ids.ids), ('id', 'parent_of', user.allowed_location_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Operation Type -->
    <record id="custom_stock_picking_type_rule" model="ir.rule">
        <field name="name">Operation Type: allowed warehouses</field>
        <field name="model_id" ref="stock.model_stock_picking_type"/>
        <field name="domain_force">['|', ('warehouse_id', '=', False), ('warehouse_id', 'in', user.allowed_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <!-- Product Category / Products -->
    <record id="custom_product_category_rule" model="ir.rule">
        <field name="name">Product Category: allowed categories</field>
        <field name="model_id" ref="product.model_product_category"/>
        <!-- parents too: Odoo reads them (routes, accounts); their products stay hidden -->
        <field name="domain_force">['|', ('id', 'child_of', user.allowed_product_category_ids.ids), ('id', 'parent_of', user.allowed_product_category_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="custom_product_template_rule" model="ir.rule">
        <field name="name">Product: allowed categories</field>
        <field name="model_id" ref="product.model_product_template"/>
