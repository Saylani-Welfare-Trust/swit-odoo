<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml): only the warehouses / locations set on the user; a document without one yet stays visible. -->

    <record id="scope_purchase_order_rule" model="ir.rule">
        <field name="name">Purchase Order: allowed warehouses / locations</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">['|', ('picking_type_id', '=', False), ('picking_type_id.warehouse_id', 'in', user.allowed_warehouse_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_purchase_order_unrestricted_rule" model="ir.rule">
        <field name="name">Purchase Order: unrestricted</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_purchase_requisition_rule" model="ir.rule">
        <field name="name">Purchase Agreement: allowed warehouses / locations</field>
        <field name="model_id" ref="purchase_requisition.model_purchase_requisition"/>
