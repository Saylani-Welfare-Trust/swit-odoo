<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_treasury_wizard_form" model="ir.ui.view">
        <field name="name">pos.treasury.wizard.form</field>
        <field name="model">pos.treasury.wizard</field>
        <field name="arch" type="xml">
            <form string="Treasury Analysis">
                <p class="text-muted">Select filters to view linked POS Orders for Treasury entities.</p>
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="config_id"/>
                    </group>
                </group>
                <footer>
                    <button name="action_view_cheques" string="View Cheques" type="object" class="btn-info" icon="fa-money"/>
                    <button name="action_view_deposits" string="View Deposits" type="object" class="btn-warning" icon="fa-exchange"/>
                    <button name="action_view_transfers" string="View Transfers" type="object" class="btn-success" icon="fa-random"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>