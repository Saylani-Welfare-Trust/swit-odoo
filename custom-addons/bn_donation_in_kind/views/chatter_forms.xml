<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Forms with the chatter for records that only had a list -->

    <record id="chatter_form_donation_in_kind_config" model="ir.ui.view">
        <field name="name">donation.in.kind.config.form</field>
        <field name="model">donation.in.kind.config</field>
        <field name="arch" type="xml">
            <form string="Donation In Kind Config" create="0" delete="0">
                <sheet>
                    <group>
                        <field name="location_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                        <field name="journal_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- the list is edited in place: a button on each row opens the form (chatter) -->
    <record id="chatter_open_form_donation_in_kind_config" model="ir.ui.view">
        <field name="name">donation.in.kind.config.tree.open.form</field>
        <field name="model">donation.in.kind.config</field>
        <field name="inherit_id" ref="bn_donation_in_kind.donation_in_kind_config_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="/tree" position="attributes">
                <attribute name="open_form_view">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="bn_donation_in_kind.donation_in_kind_config_action" model="ir.actions.act_window">
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
