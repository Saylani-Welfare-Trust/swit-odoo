<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location (security/record_rule.xml): only the warehouses / locations set on the user; a document without one yet stays visible. -->

    <record id="scope_donation_in_kind_rule" model="ir.rule">
        <field name="name">Donation In Kind: allowed warehouses / locations</field>
        <field name="model_id" ref="bn_donation_in_kind.model_donation_in_kind"/>
        <field name="domain_force">['|', ('location_id', '=', False), ('location_id', 'child_of', user.scope_location_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_donation_in_kind_unrestricted_rule" model="ir.rule">
        <field name="name">Donation In Kind: unrestricted</field>
        <field name="model_id" ref="bn_donation_in_kind.model_donation_in_kind"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_donation_in_kind_line_rule" model="ir.rule">
        <field name="name">Donation In Kind Line: allowed locations</field>
        <field name="model_id" ref="bn_donation_in_kind.model_donation_in_kind_line"/>
        <field name="domain_force">['|', ('location_id', 'child_of', user.scope_location_ids.ids), ('donation_in_kind_id.location_id', 'child_of', user.scope_location_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_donation_in_kind_line_unrestricted_rule" model="ir.rule">
        <field name="name">Donation In Kind Line: unrestricted</field>
        <field name="model_id" ref="bn_donation_in_kind.model_donation_in_kind_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_valuation_committee_line_rule" model="ir.rule">
        <field name="name">Valuation Committee Line: allowed locations</field>
        <field name="model_id" ref="bn_donation_in_kind.model_valuation_committee_line"/>
        <field name="domain_force">['|', ('location_id', 'child_of', user.scope_location_ids.ids), ('donation_in_kind_id.location_id', 'child_of', user.scope_location_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_valuation_committee_line_unrestricted_rule" model="ir.rule">
        <field name="name">Valuation Committee Line: unrestricted</field>
        <field name="model_id" ref="bn_donation_in_kind.model_valuation_committee_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
