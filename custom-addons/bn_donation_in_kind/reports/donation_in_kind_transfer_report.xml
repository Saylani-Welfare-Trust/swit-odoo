<odoo>
    <template id="donation_in_kind_transfer_report">
        <t t-call="web.html_container">
            <t t-if="len(docs) > 1">
                <div class="page">
                    <h2>Donation In Kind Transfer Report</h2>
                    <p><strong>Saylani Welfare International Trust</strong></p>
                    <p><strong>Transferred Records:</strong></p>
                    <table class="table table-sm table-bordered" style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">#</th>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">Donation In Kind Name</th>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">Truck Number</th>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">Location</th>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">Warehouse</th>
                                <th style="padding:6px; text-align:left; border:1px solid #ddd;">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="counter" t-value="1"/>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="counter"/></td>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="o.name or '-'"/></td>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="o.truk_number or '-'"/></td>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="o.location_id.display_name or '-'"/></td>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="o.warehouse_name or '-'"/></td>
                                    <td style="padding:6px; border:1px solid #ddd;"><t t-esc="(o.create_date + datetime.timedelta(hours=5)).strftime('%d-%m-%Y %H:%M') if o.create_date else '--'"/></td>
                                </tr>
                                <t t-set="counter" t-value="counter + 1"/>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
            <t t-else="">
                <t t-foreach="docs" t-as="o">
                    <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">
                        <div style="display:flex; justify-content:space-between; align-items:center; border-bottom:1px solid #999; padding-bottom:6px; margin-bottom:10px;">
                            <h4 style="margin:0; font-weight:bold;">Donation In Kind Transfer</h4>
                            <h5 style="margin:0; font-weight:bold;">Saylani Welfare International Trust</h5>
                        </div>
                        <table style="width:100%; border:1px solid #999; margin-bottom:12px;">
                            <tr>
                                <td style="width:50%; padding:8px; vertical-align:top;">
                                    <div><strong>DIK #:</strong> <t t-esc="o.name or '-'"/></div>
                                    <div><strong>Donor Name:</strong> <t t-esc="o.donor_id.name or '-'"/></div>
                                    <div><strong>Contact No.:</strong> <t t-esc="o.donor_id.mobile or '-'"/></div>
                                    <div><strong>Status:</strong> <span t-field="o.state"/></div>
                                </td>
                                <td style="width:50%; padding:8px; vertical-align:top;">
                                    <div><strong>Date &amp; Time:</strong> <t t-esc="(o.create_date + datetime.timedelta(hours=5)).strftime('%d-%m-%Y %H:%M') if o.create_date else '-'"/></div>
                                    <div><strong>Warehouse:</strong> <t t-esc="o.warehouse_name or '-'"/></div>
                                    <div><strong>Location:</strong> <t t-esc="o.location_id.display_name or '-'"/></div>
                                    <div><strong>Truck Number:</strong> <t t-esc="o.truk_number or '-'"/></div>
                                </td>
                            </tr>
                        </table>
                        <table class="table table-sm table-bordered" style="width:100%;">
                            <thead>
                                <tr style="background:#f2f2f2;">
                                    <th style="width:8%;" class="text-center">#</th>
                                    <th>Product</th>
                                    <th style="width:20%;" class="text-end">Quantity</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.donation_in_kind_line_ids" t-as="line">
                                    <td class="text-center"><t t-esc="line_index + 1"/></td>
                                    <td><t t-esc="line.product_id.display_name"/></td>
                                    <td class="text-end"><t t-esc="'{:,}'.format(int(line.quantity) or 0)"/></td>
                                </tr>
                                <tr>
                                    <td colspan="2" class="text-end"><strong>Total Quantity</strong></td>
                                    <td class="text-end"><strong t-esc="'{:,}'.format(int(sum(o.donation_in_kind_line_ids.mapped('quantity'))))"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <table style="width:100%; margin-top:40px;">
                            <tr>
                                <td style="width:50%;">Entered by: <strong t-esc="o.create_uid.name"/></td>
                                <td style="width:50%; text-align:right;"><div style="display:inline-block; width:180px; border-top:1px solid #333; text-align:center; padding-top:4px;">Received By (Store)</div></td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="report_donation_in_kind_transfer_paperformat" model="report.paperformat">
        <field name="name">A5 - Donation In Kind Report</field>
        <field name="format">A5</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_donation_in_kind_transfer" model="ir.actions.report">
        <field name="name">Donation In Kind Transfer Report</field>
        <field name="model">donation.in.kind</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bn_donation_in_kind.donation_in_kind_transfer_report</field>
        <field name="report_file">bn_donation_in_kind.donation_in_kind_transfer_report</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Donation In Kind Transfer - %s' % (object.name)</field>
    </record>
</odoo>