<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_approval_request" model="ir.ui.view">
        <field name="name">approval.request.search</field>
        <field name="model">approval.request</field>
        <field name="inherit_id" ref="bn_approval_cycle.view_approval_request_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_approval_role" model="ir.ui.view">
        <field name="name">approval.role.search</field>
        <field name="model">approval.role</field>
        <field name="inherit_id" ref="bn_approval_cycle.view_approval_role_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="search_approval_rule" model="ir.ui.view">
        <field name="name">approval.rule.search</field>
        <field name="model">approval.rule</field>
        <field name="inherit_id" ref="bn_approval_cycle.view_approval_rule_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
