<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_approval" model="ir.module.category">
        <field name="name">Approval Cycle</field>
        <field name="sequence">35</field>
    </record>
    <record id="group_approval_user" model="res.groups">
        <field name="name">Approval User</field>
        <field name="category_id" ref="module_category_approval"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>
    <record id="group_approval_manager" model="res.groups">
        <field name="name">Approval Manager</field>
        <field name="category_id" ref="module_category_approval"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_approval_user')])]"/>
    </record>

    <!-- Multi-company isolation -->
    <record id="rule_approval_request_company" model="ir.rule">
        <field name="name">Approval Request: multi-company</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_approval_rule_company" model="ir.rule">
        <field name="name">Approval Rule: multi-company</field>
        <field name="model_id" ref="model_approval_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_approval_role_company" model="ir.rule">
        <field name="name">Approval Role: multi-company</field>
        <field name="model_id" ref="model_approval_role"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Internal users see their own requests and the ones they must decide.
         When department-wise approval is on, they also see their department.
         Managers see all. The department clause is inside the user domain so it
         is not left on when the switch is off. -->
    <record id="rule_approval_request_user" model="ir.rule">
        <field name="name">Approval Request: own, assigned, and department</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">user._approval_request_domain()</field>
    </record>
    <record id="rule_approval_request_manager" model="ir.rule">
        <field name="name">Approval Request: manager all</field>
        <field name="model_id" ref="model_approval_request"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_approval_request_stage_user" model="ir.rule">
        <field name="name">Approval Stage: own, assigned, and department</field>
        <field name="model_id" ref="model_approval_request_stage"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">user._approval_request_stage_domain()</field>
    </record>
    <record id="rule_approval_request_stage_manager" model="ir.rule">
        <field name="name">Approval Stage: manager all</field>
        <field name="model_id" ref="model_approval_request_stage"/>
        <field name="groups" eval="[(4, ref('group_approval_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
