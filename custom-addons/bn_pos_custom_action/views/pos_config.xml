<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="point_of_sale_pos_config_view_form_inherit_bn_pos_custom_action" model="ir.ui.view">
        <field name="name">point.of.sale.pos.config.view.form.inherit.bn.pos.custom.action</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='restaurant_on_create']" position="after">
                <setting string="Branch" help="Sessions, orders, receipts and POS records of this shop are tagged with this branch.">
                        <field name="analytic_account_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                </setting>
                <setting>
                        <field name="user_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
                </setting>
            </xpath>
        </field>
    </record>

    <record id="pos_config_view_tree_branch" model="ir.ui.view">
        <field name="name">pos.config.tree.branch</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="analytic_account_id" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
