<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="receipt_reason_wizard_view_form" model="ir.ui.view">
        <field name="name">receipt.reason.wizard.form</field>
        <field name="model">receipt.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason">
                <group>
                    <field name="reason_type" invisible="1"/>
                    <field name="picking_ids" widget="many2many_tags"/>
                    <field name="reason" required="1" placeholder="Why is this receipt being closed without a backorder / cancelled?"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
