<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="receive_by_weight_view_form" model="ir.ui.view">
        <field name="name">receive.by.weight.view.form</field>
        <field name="model">receive.by.weight</field>
        <field name="arch" type="xml">
            <form string="Receive by Weight">
                <p class="text-muted">
                    Enter a line per weight: the units of the livestock product that weighed that much. The product
                    variant comes from the weight bands of the product (its Livestock page). Units you do not enter
                    stay on the receipt (backorder).
                </p>
                <group>
                    <field name="picking_id" readonly="1" force_save="True"/>
                    <field name="is_received" invisible="1"/>
                    <field name="move_ids" invisible="1"/>
                    <field name="total_quantity" readonly="1"/>
                    <field name="total_weight" readonly="1"/>
                    <field name="bill_amount" readonly="1"/>
                </group>
                <field name="line_ids" readonly="is_received == True">
                    <tree editable="bottom">
                        <field name="s_no" readonly="1" force_save="1" optional="hide"/>
                        <field name="move_id" options="{'no_create': True, 'no_open': True}" required="1"/>
                        <field name="product_id" column_invisible="1"/>
                        <field name="weight" required="1"/>
                        <field name="quantity" sum="Units" required="1"/>
                        <field name="total_weight" sum="Total" optional="show"/>
                        <field name="received_product_id" readonly="1"/>
                        <field name="price_per_kg" readonly="1" optional="hide"/>
                        <field name="amount" sum="Total" readonly="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_receive" type="object" string="Receive" class="btn-primary" invisible="is_received == True"/>
                    <button name="action_save_only"
                            type="object"
                            string="Save"
                            class="btn-secondary" invisible="is_received == True"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
