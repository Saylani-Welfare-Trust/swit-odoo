<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Must stay the first data file. bn_live_stock_grn was an older copy of
         the Receive by Weight of this module: its views, actions and access
         rights are handed over and, not being declared here, removed (no more
         duplicate buttons on the receipts). Its records stay in the database. -->
    <function model="ir.module.module" name="_bn_absorb_modules">
        <value>bn_inventory_customization</value>
        <value eval="['bn_live_stock_grn']"/>
    </function>
</odoo>
