<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inventory right between User and Administrator: User access plus the
         Reporting menu. Configuration stays Administrator only, and the Products
         menu is hidden for it in ir.ui.menu._visible_menu_ids -->
    <record id="group_stock_user_reporting" model="res.groups">
        <field name="name">User + Reporting</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Administrator includes it, so the user form keeps one Inventory dropdown -->
    <record id="stock.group_stock_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_stock_user_reporting'))]"/>
    </record>

    <record id="stock.menu_warehouse_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_stock_user_reporting'))]"/>
    </record>

</odoo>
