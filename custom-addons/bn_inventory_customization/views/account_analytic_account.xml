<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_analytic_account_form_inherit_bn_inventory_customization" model="ir.ui.view">
        <field name="name">account.analytic.account.form.inherit.bn.inventory.customization</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_view_products" icon="fa-cubes">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_text">Products</span>
                        <span class="o_stat_value">
                            <field name="product_template_count"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
