<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Livestock weight bands: a general product (Is Livestock Product) and the
         product variant each weight range of it is received as -->
    <record id="livestock_variant_line_tree_view" model="ir.ui.view">
        <field name="name">livestock.variant.line.tree</field>
        <field name="model">livestock.variant.line</field>
        <field name="arch" type="xml">
            <tree string="Livestock Weight Bands" editable="bottom">
                <field name="purchase_product_id" options="{'no_create': True}"/>
                <field name="from_kg"/>
                <field name="to_kg"/>
                <field name="product_id" options="{'no_create': True}"/>
            </tree>
        </field>
    </record>

    <record id="livestock_variant_line_search_view" model="ir.ui.view">
        <field name="name">livestock.variant.line.search</field>
        <field name="model">livestock.variant.line</field>
        <field name="arch" type="xml">
            <search string="Livestock Weight Bands">
                <field name="purchase_product_id"/>
                <field name="product_id"/>
                <group expand="0" string="Group By">
                    <filter name="group_purchase_product" string="Livestock Product"
                            context="{'group_by': 'purchase_product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_livestock_variant_line" model="ir.actions.act_window">
        <field name="name">Livestock Weight Bands</field>
        <field name="res_model">livestock.variant.line</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_group_purchase_product': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure your first weight band</p>
            <p>For a livestock product (e.g. Cow), each weight range and the product variant
               (e.g. Cow - 12) its units are received as.</p>
        </field>
    </record>

    <menuitem id="menu_livestock_variant_line" name="Livestock Weight Bands" parent="stock.menu_stock_config_settings"
              action="action_livestock_variant_line" sequence="100" groups="stock.group_stock_manager"/>

</odoo>
