<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_product_template_only_form_view_inherit_bn_inventory_customization" model="ir.ui.view">
        <field name="name">product.product.template.only.form.view.inherit.bn.inventory.customization</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-flex">
                    <field name="check_stock" on_change="1" field_id="check_stock"/>
                    <label for="check_stock"/>
                </span>
            </xpath>
            
            <!-- Livestock page: the weight bands this purchase product is received by -->
            <xpath expr="//notebook" position="inside">
                <page string="Livestock" name="livestock" invisible="not check_stock">
                    <p class="text-muted">
                        Bought by unit, each unit is weighed on its receipt and received as the product of
                        its livestock variant's weight band. The bands are also managed in
                        Inventory &gt; Configuration &gt; Livestock.
                    </p>
                    <field name="livestock_band_ids" context="{'default_purchase_product_id': product_variant_id}">
                        <tree editable="bottom">
                            <field name="variant_id" options="{'no_create': True}"/>
                            <field name="purchase_product_id" options="{'no_create': True}"/>
                            <field name="from_kg"/>
                            <field name="to_kg"/>
                            <field name="product_id" options="{'no_create': True}"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
