<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sole gate on the Shariah Law app menu. No group implies it: assign it explicitly,
         together with the tier / role groups, to whoever should see it. -->
    <record id="shariah_law_menu_group" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Shariah Law app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="shariah_law_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Shariah Law overview, daily balances, transfers and the sync log.</field>
    </record>

    <record id="shariah_law_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(6, 0, [ref('shariah_law_user_group')])]"/>
        <field name="comment">Everything User can do.</field>
    </record>

    <record id="shariah_law_audit_group" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight of Shariah balances and transfers, for reporting.</field>
    </record>

    <record id="shariah_law_admin_group" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(6, 0, [ref('shariah_law_manager_group'), ref('shariah_law_audit_group')])]"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights and the Shariah configuration (sync, segment rules, blockers, persons).</field>
    </record>

    <!-- Role groups: one responsibility each, on top of the tiers -->
    <record id="group_member_approval" model="res.groups">
        <field name="name">Member Approval</field>
        <field name="category_id" ref="module_shariah_law"/>
        <field name="implied_ids" eval="[(6, 0, [ref('shariah_law_user_group')])]"/>
        <field name="comment">Approves transfers of accounts that require member approval.</field>
    </record>

    <!-- Every internal user could work in Shariah Law before the tiers: on this
         first upgrade, the users of its menu become User. -->
    <function model="res.groups" name="_move_retired_group_users" eval="[{
        'bn_shariah_law.shariah_law_menu_group': 'bn_shariah_law.shariah_law_user_group',
    }, 'bn_shariah_law.tiers']"/>

</odoo>
