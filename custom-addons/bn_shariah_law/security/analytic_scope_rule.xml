<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location: these records have no location, so they are
         matched on their Analytic Account (Branch), which must be the analytic account
         tagged on one of the user's locations in scope, or the user's own Branch
         (res.users.scope_analytic_account_ids). A record without one stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_shariah_law_rule" model="ir.rule">
        <field name="name">Shariah Law: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_law"/>
        <field name="domain_force">['|', ('analytic_account_id', '=', False), ('analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_shariah_law_unrestricted_rule" model="ir.rule">
        <field name="name">Shariah Law: unrestricted</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_law"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_shariah_daily_balance_rule" model="ir.rule">
        <field name="name">Shariah Daily Balance: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_daily_balance"/>
        <field name="domain_force">['|', ('analytic_account_id', '=', False), ('analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_shariah_daily_balance_unrestricted_rule" model="ir.rule">
        <field name="name">Shariah Daily Balance: unrestricted</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_daily_balance"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

    <record id="scope_shariah_transfer_rule" model="ir.rule">
        <field name="name">Shariah Transfer: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_transfer"/>
        <field name="domain_force">['|', ('source_analytic_account_id', 'in', user.scope_analytic_account_ids.ids), ('destination_analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="scope_shariah_transfer_unrestricted_rule" model="ir.rule">
        <field name="name">Shariah Transfer: unrestricted</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_transfer"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system'), ref('bn_stock_location.stock_scope_unrestricted_group')])]"/>
    </record>

</odoo>
