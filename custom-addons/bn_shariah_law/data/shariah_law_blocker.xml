<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- noupdate: the toggles are set from the Shariah Law Blocker screen and must not be
         reset to these initial values every time the module is upgraded. -->
    <record id="module_shariah_law_blocker" model="shariah.law.blocker">
        <field name="enable_pos">False</field>
        <field name="enable_donations">False</field>
        <field name="enable_dik">False</field>
        <field name="enable_expense">False</field>
        <field name="enable_purchase">True</field>
        <field name="enable_welfare">False</field>
        <field name="enable_microfinance">False</field>
        <field name="enable_material_request">True</field>
    </record>

</odoo>
