<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_view_warehouse_inherit_bn_donation_box" model="ir.ui.view">
        <field name="name">stock.view.warehouse.inherit.bn.donation.box</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <label for="donation_box_picking_type_id" groups="stock.group_stock_manager"/>
                <div class="d-flex" groups="stock.group_stock_manager">
                    <field name="donation_box_picking_type_id" class="oe_inline" options="{'no_create': True}"/>
                    <button name="action_create_donation_box_picking_type" type="object" class="btn btn-link"
                            string="Create Donation Box Operation Type"
                            invisible="donation_box_picking_type_id or not id"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
