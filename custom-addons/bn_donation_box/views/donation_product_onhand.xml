<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The earlier search extension filtered on creator / creation date, which the
         on-hand view (a stock view) does not have: removed before the views are checked -->
    <delete model="ir.ui.view" search="[('name', '=', 'donation.product.onhand.search'), ('model', '=', 'donation.product.onhand')]"/>

    <!-- Donation Product On-hand Tree View -->
    <record id="donation_product_onhand_view_tree" model="ir.ui.view">
        <field name="name">donation.product.onhand.view.tree</field>
        <field name="model">donation.product.onhand</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="analytic_account_id" optional="show"/>
                <field name="on_hand_qty" sum="Total"/>
            </tree>
        </field>
    </record>

    <!-- Donation Product On-hand Search View -->
    <record id="donation_product_onhand_view_search" model="ir.ui.view">
        <field name="name">donation.product.onhand.view.search</field>
        <field name="model">donation.product.onhand</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="location_id"/>
                <field name="analytic_account_id"/>
                <separator/>
                <filter string="Low Stock" name="low_stock" domain="[('on_hand_qty', '&lt;', 10)]"/>
                <filter string="No Stock" name="no_stock" domain="[('on_hand_qty', '&lt;=', 0)]"/>
                <group expand="0" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="Branch" name="group_branch" context="{'group_by': 'analytic_account_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action for Donation Product On-hand -->
    <record id="donation_product_onhand_action" model="ir.actions.act_window">
        <field name="name">Donation Products On-Hand Quantity</field>
        <field name="res_model">donation.product.onhand</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                This view shows the on-hand quantity of donation products in your assigned locations.
            </p>
        </field>
    </record>

    <!-- Menu Item -->
    <menuitem id="donation_product_onhand_menu" name="Donation Products Inventory" action="donation_product_onhand_action" parent="donation_box_root_menu" sequence="20" groups="bn_donation_box.donation_box_manager_group,bn_donation_box.donation_box_audit_group" />

</odoo>
