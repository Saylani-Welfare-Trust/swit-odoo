<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sole gate on the root app menu. No group implies it: assign it
         explicitly, together with the tier / role groups, to whoever should
         see the app; the tiers then decide what they can do once inside.
         Key Management and Rider Shift menus sit under this app's icon: their
         users need this Menu group too. -->
    <record id="donation_box_root_group" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Donation Box app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="donation_box_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Day-to-day access: create and process Requests and Registrations. Cannot approve, resolve complaints, or change installations.</field>
    </record>

    <record id="donation_box_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="comment">Everything User can do, plus every area's approve/resolve/process action: Registration approval and change requests, Request approve/reject, Complain Center resolution, and the POS donation-box action.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('donation_box_user_group')])]"/>
    </record>

    <record id="donation_box_audit_group" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight across Requests, Registrations and Complaints, for reporting. No create, write or delete anywhere.</field>
    </record>

    <record id="donation_box_admin_group" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights and Installation Category / Donation Products configuration.</field>
        <field name="implied_ids" eval="[(6, 0, [ref('donation_box_manager_group'), ref('donation_box_audit_group')])]"/>
    </record>

    <record id="complain_center_admin_group" model="res.groups">
        <field name="name">Complain Center Admin</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>

    <record id="complain_center_process_complain_group" model="res.groups">
        <field name="name">Process Complain</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>
    
    <record id="complain_center_resolve_complain_group" model="res.groups">
        <field name="name">Resolve Complain</field>
        <field name="category_id" ref="module_donation_box"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
