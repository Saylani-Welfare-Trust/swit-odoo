<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Allowed-location access (everything except Requests).
         A user's cities are the analytic accounts of their Allowed Locations
         (Settings > Users > Inventory tab). Registrations and complaints are shown
         when their City is one of them; while the City is still empty (a draft made
         by the request approval) the analytic account of the request's source
         location stands in for it.
         Create is left out so the request approval can create registrations of
         any city. Admins see everything. Users without allowed locations see nothing.
         The Complain Center Admin/Process/Resolve rules below still grant every
         complaint to those groups. -->

    <!-- Registration -->
    <record id="donation_box_registration_allowed_location_rule" model="ir.rule">
        <field name="name">Registration: Allowed Locations</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_registration_installation"/>
        <field name="domain_force">['|',
            ('city_id', 'in', user.allowed_location_ids.analytic_account_id.ids),
            '&amp;',
                ('city_id', '=', False),
                ('donation_box_request_id.source_location_id.analytic_account_id', 'in', user.allowed_location_ids.analytic_account_id.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.donation_box_user_group'), ref('bn_donation_box.donation_box_audit_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="donation_box_registration_admin_rule" model="ir.rule">
        <field name="name">Registration: Admin (All Locations)</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_registration_installation"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.donation_box_admin_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Complain Center -->
    <record id="donation_box_complain_center_allowed_location_rule" model="ir.rule">
        <field name="name">Complain Center: Allowed Locations</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_complain_center"/>
        <field name="domain_force">['|',
            ('city_id', 'in', user.allowed_location_ids.analytic_account_id.ids),
            '&amp;',
                ('city_id', '=', False),
                ('donation_box_request_id.source_location_id.analytic_account_id', 'in', user.allowed_location_ids.analytic_account_id.ids)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.donation_box_user_group'), ref('bn_donation_box.donation_box_audit_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="donation_box_complain_center_admin_rule" model="ir.rule">
        <field name="name">Complain Center: Admin (All Locations)</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_complain_center"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.donation_box_admin_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="donation_box_complain_center_resolve_rule" model="ir.rule">
        <field name="name">Complain Center: Resolve</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_complain_center"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.complain_center_resolve_complain_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="complain_center_process_complain_rule" model="ir.rule">
        <field name="name">Complain Center: Process</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_complain_center"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.complain_center_process_complain_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="complain_center_admin_rule" model="ir.rule">
        <field name="name">Complain Center: Admin</field>
        <field name="model_id" ref="bn_donation_box.model_donation_box_complain_center"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('bn_donation_box.complain_center_admin_group')])]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

</odoo>
