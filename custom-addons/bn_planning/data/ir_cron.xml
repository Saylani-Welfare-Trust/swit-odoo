<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="ir_cron_monthly_planning_internal_transfer"
                model="ir.cron">
            <field name="name">Monthly Planning: Auto Internal Transfers</field>
            <field name="model_id" ref="model_monthly_planning"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_internal_transfers()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>

    </data>
</odoo>