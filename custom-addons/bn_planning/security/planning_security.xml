<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Create the Category -->
    <record id="module_category_planning" model="ir.module.category">
        <field name="name">Monthly Planning</field>
        <field name="description">Access to the specific Planning features</field>
        <field name="sequence">10</field>
    </record>

    <!-- 2. Create the Groups -->
    <record id="group_planning_user" model="res.groups">
        <field name="name">Monthly Planning / User</field>
        <field name="category_id" ref="module_category_planning"/>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Monthly Planning / Manager</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(4, ref('group_planning_user'))]"/>
    </record>

    <record id="group_planning_report_viewer" model="res.groups">
        <field name="name">Monthly Planning / Report Viewer</field>
        <field name="category_id" ref="module_category_planning"/>
    </record>
</odoo>