<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_planning" model="ir.module.category">
        <field name="name">Planning</field>
    </record>

    <!-- Sole gate on the Planning app menu. No group implies it: assign it explicitly,
         together with the tier / role groups, to whoever should see it. -->
    <record id="group_planning_root" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Planning app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="group_planning_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Prepare monthly plans and create purchase requests from them.</field>
    </record>

    <record id="group_planning_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_planning_user')])]"/>
        <field name="comment">Everything User can do, plus the Planning Types configuration.</field>
    </record>

    <record id="group_planning_audit" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight of monthly plans, for reporting.</field>
    </record>

    <record id="group_planning_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_planning_manager'), ref('group_planning_audit')])]"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights.</field>
    </record>

    <!-- Role groups: one responsibility each, on top of the tiers -->
    <record id="group_planning_report_viewer" model="res.groups">
        <field name="name">Planning Summary Report (Inventory)</field>
        <field name="category_id" ref="module_category_planning"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Inventory &gt; Reporting &gt; Planning Summary.</field>
    </record>

    <!-- "Monthly Planning" was also the menu: on this first upgrade its users get the Menu group. -->
    <function model="res.groups" name="_move_retired_group_users" eval="[{
        'bn_planning.group_planning_user': 'bn_planning.group_planning_root',
    }, 'bn_planning.tiers']"/>

</odoo>
