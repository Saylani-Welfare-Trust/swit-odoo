<odoo>

    <!-- ═══════════════════ TREE ═══════════════════ -->
    <record id="view_monthly_planning_tree" model="ir.ui.view">
        <field name="name">monthly.planning.tree</field>
        <field name="model">monthly.planning</field>
        <field name="arch" type="xml">
            <tree edit="not is_locked" delete="not is_locked">
                <field name="name"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="planning_type_id"/>
                <field name="enabled_tabs"/>
                <field name="location_dest_id"/>
                <field name="created_by"/>
                <field name="is_locked" invisible="1"/>
                <field name="state"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'draft'"
                       widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- ═══════════════════ SEARCH ═══════════════════ -->
    <record id="view_monthly_planning_search" model="ir.ui.view">
        <field name="name">monthly.planning.search</field>
        <field name="model">monthly.planning</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Reference"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="planning_type_id"/>
                <field name="location_dest_id"/>

                <filter name="filter_draft"  string="Draft"
                        domain="[('state','=','draft')]"/>
                <filter name="filter_active" string="Active"
                        domain="[('state','=','active')]"/>
                <filter name="filter_locked" string="Locked"
                        domain="[('is_locked','=',True)]"/>

                <separator/>

                <filter name="filter_this_year" string="This Year"
                        domain="[('from_date','&gt;=', context_today().strftime('%Y-01-01')),
                                 ('from_date','&lt;=', context_today().strftime('%Y-12-31'))]"/>
                <filter name="filter_this_month" string="This Month"
                        domain="[('from_date','&gt;=', context_today().strftime('%Y-%m-01')),
                                 ('from_date','&lt;=', context_today().strftime('%Y-%m-31'))]"/>

                <separator/>

                <group expand="0" string="Group By">
                    <filter name="group_state"     string="Status"
                            context="{'group_by':'state'}"/>
                    <filter name="group_type"      string="Planning Type"
                            context="{'group_by':'planning_type_id'}"/>
                    <filter name="group_dest"      string="Destination"
                            context="{'group_by':'location_dest_id'}"/>
                    <filter name="group_from_date" string="From Date"
                            context="{'group_by':'from_date'}"/>
                    <filter name="group_to_date"   string="To Date"
                            context="{'group_by':'to_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════ FORM ═══════════════════ -->
    <record id="view_monthly_planning_form" model="ir.ui.view">
        <field name="name">monthly.planning.form</field>
        <field name="model">monthly.planning</field>
        <field name="arch" type="xml">
            <form edit="not is_locked">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active"/>

                    <button string="Import from Excel"
                            name="action_open_import_wizard"
                            type="object"
                            class="oe_highlight"
                            invisible="state == 'active' or is_locked"
                            help="Import monthly planning lines from an Excel file"/>
                    <button string="Activate"
                            name="action_set_active"
                            type="object"
                            class="oe_highlight"
                            invisible="state == 'active' or is_locked"/>
                    <button string="Set to Draft"
                            name="action_set_draft"
                            type="object"
                            invisible="state == 'draft' or is_locked"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Locked"
                            bg_color="bg-danger"
                            invisible="not is_locked"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="e.g. January 2026 Planning"
                                   required="1"/>
                        </h1>
                    </div>

                    <field name="is_locked" invisible="1"/>

                    <group>
                        <group>
                            <field name="planning_type_id"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="from_date" required="1"/>
                            <field name="to_date" required="1"/>
                        </group>
                        <group>
                            <field name="created_by" readonly="1"/>
                            <field name="location_dest_id"
                                   options="{'no_create': True, 'no_open': True, 'no_create_edit': True}"
                                   required="1"
                                   placeholder="Select destination…"/>
                        </group>
                    </group>

                    <field name="show_kitchen"   invisible="1"/>
                    <field name="show_madaris"   invisible="1"/>
                    <field name="show_medical"   invisible="1"/>
                    <field name="show_livestock" invisible="1"/>
                    <field name="show_food"      invisible="1"/>
                    <field name="show_ration"    invisible="1"/>
                    <field name="show_meat"      invisible="1"/>

                    <notebook>

                        <page name="kitchen" string="Kitchen Planning"
                              invisible="not show_kitchen">
                            <field name="kitchen_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="madaris" string="Madaris Planning"
                              invisible="not show_madaris">
                            <field name="madaris_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="medical" string="Medical Planning"
                              invisible="not show_medical">
                            <field name="medical_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="livestock" string="Livestock Planning"
                              invisible="not show_livestock">
                            <field name="livestock_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="location_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="food" string="Food Planning"
                              invisible="not show_food">
                            <field name="food_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="ration" string="Ration Planning"
                              invisible="not show_ration">
                            <field name="ration_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>

                        <page name="meat" string="Meat Planning"
                              invisible="not show_meat">
                            <field name="meat_line_ids">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="product_id" options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
                                    <field name="on_hand_qty" readonly="1"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════ ACTIONS ═══════════════ -->
    <record id="action_monthly_planning" model="ir.actions.act_window">
        <field name="name">Monthly Planning</field>
        <field name="res_model">monthly.planning</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_monthly_planning_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a new monthly plan.</p>
        </field>
    </record>

    <!-- ═══════════════ READ-ONLY LINE VIEW (Reporting) ═══════════════ -->
    <record id="view_monthly_planning_reporting_form" model="ir.ui.view">
        <field name="name">monthly.planning.reporting.form</field>
        <field name="model">monthly.planning</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="planning_type_id" readonly="1"/>
                            <field name="created_by" readonly="1"/>
                            <field name="from_date" readonly="1"/>
                            <field name="to_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="location_dest_id" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>

                    <field name="show_kitchen"   invisible="1"/>
                    <field name="show_madaris"   invisible="1"/>
                    <field name="show_medical"   invisible="1"/>
                    <field name="show_livestock" invisible="1"/>
                    <field name="show_food"      invisible="1"/>
                    <field name="show_ration"    invisible="1"/>
                    <field name="show_meat"      invisible="1"/>

                    <notebook>
                        <page name="kitchen" string="Kitchen Planning"
                            invisible="not show_kitchen">
                            <field name="kitchen_line_ids" readonly="1">
                                <tree create="false" edit="false" delete="false">
                                    <field name="date"/>
                                    <field name="product_id"/>
                                    <field name="on_hand_qty"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                        <!-- repeat for the other tabs as in your original -->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════ MENUS ═══════════════════ -->
    <menuitem
        id="planning_root_menu"
        name="Planning"
        web_icon="bn_master_setup,static/description/icon.png"
        sequence="6"/>
    <menuitem
        id="menu_monthly_planning"
        name="Monthly Planning"
        action="action_monthly_planning"
        parent="planning_root_menu"
        sequence="1"/>

</odoo>