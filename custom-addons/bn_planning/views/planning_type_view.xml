<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="planning_type_view_tree" model="ir.ui.view">
        <field name="name">planning.type.tree</field>
        <field name="model">planning.type</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="kitchen"/>
                <field name="madaris"/>
                <field name="medical"/>
                <field name="livestock"/>
                <field name="food"/>
                <field name="ration"/>
                <field name="meat"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="planning_type_view_form" model="ir.ui.view">
        <field name="name">planning.type.form</field>
        <field name="model">planning.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Kitchen + Madaris"/></h1>
                    </div>
                    <group string="Enable Planning Tabs">
                        <group>
                            <field name="kitchen"/>
                            <field name="madaris"/>
                            <field name="medical"/>
                            <field name="livestock"/>
                        </group>
                        <group>
                            <field name="food"/>
                            <field name="ration"/>
                            <field name="meat"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="planning_type_action" model="ir.actions.act_window">
        <field name="name">Planning Type</field>
        <field name="res_model">planning.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Planning Type (choose which tabs to show).
            </p>
        </field>
    </record>

    <!-- Menu under Master Setup -->
    <menuitem
        id="planning_type_menu"
        name="Planning Type"
        action="planning_type_action"
        parent="bn_master_setup.master_setup_menu"
        sequence="200"/>

</odoo>