<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <!-- ═══════════════ GENERATE PR WIZARD ═══════════════ -->
    <record id="monthly_planning_pr_wizard_view_form" model="ir.ui.view">
        <field name="name">monthly.planning.pr.wizard.form</field>
        <field name="model">monthly.planning.pr.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Purchase Requisition">
                <group>
                    <field name="mode" widget="radio" readonly="1"/>
                    <field name="origin"/>
                </group>

                <div class="alert alert-info" role="alert"
                    invisible="mode != 'difference'">
                    <p class="mb-0">
                        <strong>Difference mode:</strong> quantities already covered by
                        prior PRs have been subtracted. Order Qty is the remaining
                        shortfall only.
                    </p>
                </div>

                <div class="alert alert-info" role="alert"
                    invisible="mode != 'full'">
                    <p class="mb-0">
                        Order Qty = Demand Qty − On Hand Qty. You can adjust any row
                        before generating the Purchase Requisition.
                    </p>
                </div>

                <field name="line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="product_id"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="uom_id"
                            options="{'no_create': True, 'no_open': True}"/>
                        <field name="demand_qty"/>
                        <field name="on_hand_qty"/>
                        <field name="order_qty"/>
                        <field name="date_required"/>
                        <field name="price_unit"/>
                        <field name="source_refs" column_invisible="1"/>
                    </tree>
                </field>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Generate PR"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
