<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="advance_donation" model="ir.module.category">
        <field name="name">Advance Donation</field>
    </record>

    <!-- Sole gate on the Advance Donation app menu. No group implies it: assign it explicitly,
         together with the tier / role groups, to whoever should see it. -->
    <record id="group_adv_don_root" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Advance Donation app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="group_adv_don_menu" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Create advance donations, compute the lines, send them for approval, add / cancel payments, record receipts.</field>
    </record>

    <record id="group_adv_don_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_adv_don_menu')])]"/>
        <field name="comment">Everything User can do; the approvals themselves belong to Approval 1 / Approval 2.</field>
    </record>

    <record id="group_adv_don_audit" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight of advance donations, receipts and statements, for reporting.</field>
    </record>

    <record id="group_adv_don_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_adv_don_manager'), ref('group_adv_don_audit')])]"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights and the Category configuration.</field>
    </record>

    <!-- Role groups: one responsibility each, on top of the tiers -->
    <record id="group_adv_don_approval_1" model="res.groups">
        <field name="name">Approval 1</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_adv_don_menu')])]"/>
        <field name="comment">First approval: approve, reject or revert to Draft.</field>
    </record>

    <record id="group_adv_don_approval_2" model="res.groups">
        <field name="name">Approval 2</field>
        <field name="category_id" ref="advance_donation"/>
        <field name="implied_ids" eval="[(6, 0, [ref('group_adv_don_menu')])]"/>
        <field name="comment">Final approval: approve, reject or revert to Approval 1.</field>
    </record>

    <!-- "User (Menu)" was also the app menu: on this first upgrade its users
         get the Menu group, so they keep seeing the app. -->
    <function model="res.groups" name="_move_retired_group_users" eval="[{
        'bn_advance_donation.group_adv_don_menu': 'bn_advance_donation.group_adv_don_root',
    }, 'bn_advance_donation.tiers']"/>

</odoo>
