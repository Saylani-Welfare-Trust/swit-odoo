<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tick-box right in Settings > Users > Access Rights -->
    <record id="module_category_adv_don_manager" model="ir.module.category">
        <field name="name">Advance Donation Manager</field>
        <field name="sequence">102</field>
    </record>

    <record id="group_adv_don_manager" model="res.groups">
        <field name="name">Delete Donation Lines</field>
        <field name="category_id" ref="module_category_adv_don_manager"/>
    </record>

    <!-- Everyone: lines can be deleted only while the donation is in Draft -->
    <record id="rule_adv_don_line_unlink_draft" model="ir.rule">
        <field name="name">Advance Donation Line: delete only in Draft</field>
        <field name="model_id" ref="model_advance_donation_lines"/>
        <field name="domain_force">[('advance_donation_id.state', '=', 'draft')]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <!-- Manager: no restriction on delete -->
    <record id="rule_adv_don_line_unlink_manager" model="ir.rule">
        <field name="name">Advance Donation Line: manager can always delete</field>
        <field name="model_id" ref="model_advance_donation_lines"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_adv_don_manager'))]"/>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>