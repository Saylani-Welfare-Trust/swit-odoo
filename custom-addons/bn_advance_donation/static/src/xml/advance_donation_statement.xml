<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="bn_advance_donation.AdvanceDonationStatement" owl="1">
        <div class="o_adv_donation_statement w-100">

            <!-- Filters bar (unchanged layout) -->
            <div class="d-flex flex-wrap align-items-end gap-3 p-3"
                 style="background:#f6f7fa;border-bottom:1px solid #e0e0e0;">
                <div>
                    <label class="d-block small text-muted">From</label>
                    <input type="date" class="form-control"
                           name="date_from"
                           t-att-value="state.date_from"
                           t-on-change="onDateChange"/>
                </div>
                <div>
                    <label class="d-block small text-muted">To</label>
                    <input type="date" class="form-control"
                           name="date_to"
                           t-att-value="state.date_to"
                           t-on-change="onDateChange"/>
                </div>
                <div style="min-width:260px;">
                    <label class="d-block small text-muted">Donor</label>
                    <select class="form-select"
                            t-on-change="onDonorChange">
                        <option value="">All donors</option>
                        <t t-foreach="state.donors" t-as="d" t-key="d.id">
                            <option t-att-value="d.id"
                                    t-att-selected="state.donor_id === d.id">
                                <t t-esc="d.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <!-- Search box (new) -->
                <div style="min-width:280px;">
                    <label class="d-block small text-muted">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="fa fa-search" aria-hidden="true"></i>
                        </span>
                        <input type="text"
                               class="form-control"
                               placeholder="Reference, purpose, beneficiary…"
                               t-att-value="state.search"
                               t-on-input="onSearchInput"
                               t-on-keydown="onSearchKeydown"/>
                        <button t-if="state.search"
                                type="button"
                                class="btn btn-outline-secondary"
                                t-on-click="clearSearch">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="d-flex gap-2 align-items-end">
                    <button type="button"
                            class="btn btn-info btn-report-print"
                            t-on-click="printPdf"
                            style="margin-right: 8px;">
                        <i class="fa fa-print me-1"/> Print (PDF)
                    </button>
                    <button type="button"
                            class="btn btn-info btn-report-print"
                            t-on-click="printXlsx">
                        <i class="fa fa-file-excel-o me-1"/> Export (XLSX)
                    </button>
                </div>

                <div class="ms-auto d-flex gap-2">
                    <div class="text-end">
                        <div class="small text-muted">Total In</div>
                        <div class="fw-bold text-success">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.in)"/>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Total Out</div>
                        <div class="fw-bold text-danger">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.out)"/>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Balance</div>
                        <div class="fw-bold">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.balance)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Result counter under the filter bar -->
            <div t-if="state.search and !state.loading and !state.error"
                 class="px-3 py-2 small text-muted"
                 style="background:#fff;border-bottom:1px solid #eee;">
                Showing
                <strong><t t-esc="filteredLines.length"/></strong>
                of
                <strong><t t-esc="state.lines.length"/></strong>
                movements
            </div>

            <!-- Error / Loading -->
            <t t-if="state.error">
                <div class="alert alert-danger m-3">
                    <t t-esc="state.error"/>
                </div>
            </t>
            <t t-if="state.loading">
                <div class="text-center p-4 text-muted">Loading…</div>
            </t>

            <!-- Same table layout as before -->
            <t t-if="!state.loading and !state.error">
                <div style="overflow:auto;max-height:70vh;">
                    <table class="table table-sm table-hover mb-0">
                        <thead style="position:sticky;top:0;background:#fff;z-index:1;">
                            <tr>
                                <th style="text-align:left;">Date</th>
                                <th style="text-align:left;">Reference</th>
                                <th style="text-align:left;">Donor</th>
                                <th style="text-align:left;">Type</th>
                                <th style="text-align:left;">Purpose</th>
                                <th style="text-align:left;">Beneficiary</th>
                                <th style="text-align:left;">Description</th>
                                <th style="text-align:right;">In</th>
                                <th style="text-align:right;">Out</th>
                                <th style="text-align:right;">Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="!filteredLines.length">
                                <tr>
                                    <td colspan="10" class="text-center text-muted p-4">
                                        <t t-if="state.search">No movements match your search.</t>
                                        <t t-else="">No movements in the selected range.</t>
                                    </td>
                                </tr>
                            </t>
                            <t t-foreach="filteredLines" t-as="l" t-key="l_index">
                                <tr t-att-class="l.direction === 'in' ? '' : 'table-light'">
                                    <td style="text-align:left;"><t t-esc="l.date"/></td>
                                    <td style="text-align:left;"><t t-esc="l.reference"/></td>
                                    <td style="text-align:left;"><t t-esc="l.partner"/></td>
                                    <td style="text-align:left;">
                                        <span t-att-class="l.direction === 'in'
                                              ? 'badge text-bg-success'
                                              : 'badge text-bg-warning'">
                                            <t t-esc="l.type"/>
                                        </span>
                                    </td>
                                    <td style="text-align:left;"><t t-esc="l.purpose"/></td>
                                    <td style="text-align:left;"><t t-esc="l.beneficiary"/></td>
                                    <td style="text-align:left;"><t t-esc="l.description"/></td>
                                    <td style="text-align:right;">
                                        <t t-if="l.amount_in">
                                            <t t-esc="formatAmount(l.amount_in)"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-if="l.amount_out">
                                            <t t-esc="formatAmount(l.amount_out)"/>
                                        </t>
                                    </td>
                                    <td style="text-align:right;">
                                        <t t-esc="formatAmount(l.balance)"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                        <tfoot style="position:sticky;bottom:0;background:#fff;">
                            <tr style="font-weight:bold;border-top:2px solid #ccc;">
                                <td colspan="7" class="text-end">Totals</td>
                                <td style="text-align:right;">
                                    <t t-esc="formatAmount(filteredTotals.in)"/>
                                </td>
                                <td style="text-align:right;">
                                    <t t-esc="formatAmount(filteredTotals.out)"/>
                                </td>
                                <td style="text-align:right;">
                                    <t t-esc="formatAmount(filteredTotals.balance)"/>
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </t>
        </div>
    </t>

</templates>