<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="bn_advance_donation.AdvanceDonationStatement" owl="1">
        <div class="o_adv_donation_statement w-100">

            <!-- Filters bar -->
            <div class="d-flex flex-wrap align-items-end gap-3 p-3"
                 style="background:#f6f7fa;border-bottom:1px solid #e0e0e0;">
                <div>
                    <label class="d-block small text-muted">From</label>
                    <input type="date" class="form-control"
                           name="date_from"
                           t-att-value="state.date_from"
                           t-on-change="onDateChange"/>
                </div>
                <div>
                    <label class="d-block small text-muted">To</label>
                    <input type="date" class="form-control"
                           name="date_to"
                           t-att-value="state.date_to"
                           t-on-change="onDateChange"/>
                </div>
                <div style="min-width:260px;">
                    <label class="d-block small text-muted">Donor</label>
                    <select class="form-select" t-on-change="onDonorChange">
                        <option value="">All donors</option>
                        <t t-foreach="state.donors" t-as="d" t-key="d.id">
                            <option t-att-value="d.id"
                                    t-att-selected="state.donor_id === d.id">
                                <t t-esc="d.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <div class="ms-auto d-flex gap-3">
                    <div class="text-end">
                        <div class="small text-muted">Total In</div>
                        <div class="fw-bold text-success">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.in)"/>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Total Out</div>
                        <div class="fw-bold text-danger">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.out)"/>
                        </div>
                    </div>
                    <div class="text-end">
                        <div class="small text-muted">Balance</div>
                        <div class="fw-bold">
                            <t t-esc="state.currency"/>
                            <t t-esc="formatAmount(filteredTotals.balance)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Search box -->
            <div class="p-3" style="background:#fff;border-bottom:1px solid #e0e0e0;">
                <div class="input-group">
                    <span class="input-group-text bg-white">
                        <i class="fa fa-search" aria-hidden="true"></i>
                    </span>
                    <input type="text"
                           class="form-control"
                           placeholder="Search by reference, donor, purpose, beneficiary, description…"
                           t-att-value="state.search"
                           t-on-input="onSearchInput"
                           t-on-keydown="onSearchKeydown"/>
                    <button t-if="state.search"
                            type="button"
                            class="btn btn-outline-secondary"
                            t-on-click="clearSearch">
                        Clear
                    </button>
                </div>
                <div t-if="state.search" class="small text-muted mt-2">
                    Showing
                    <strong><t t-esc="filteredLines.length"/></strong>
                    of
                    <strong><t t-esc="state.lines.length"/></strong>
                    movements
                </div>
            </div>

            <!-- Error / Loading -->
            <t t-if="state.error">
                <div class="alert alert-danger m-3"><t t-esc="state.error"/></div>
            </t>
            <t t-if="state.loading">
                <div class="text-center p-4 text-muted">Loading…</div>
            </t>

            <!-- Results (cards, no table / list view) -->
            <t t-if="!state.loading and !state.error">
                <div t-if="!filteredLines.length" class="text-center p-4 text-muted">
                    <t t-if="state.search">No movements match your search.</t>
                    <t t-else="">No movements in the selected range.</t>
                </div>

                <div t-else="" class="p-3 d-flex flex-column gap-2">
                    <t t-foreach="filteredLines" t-as="l" t-key="l_index">
                        <div class="border rounded p-3"
                             t-attf-style="border-left:4px solid {{ l.direction === 'in' ? '#28a745' : '#ffc107' }};">
                            <div class="d-flex justify-content-between align-items-start gap-3">
                                <div class="flex-grow-1">
                                    <div class="fw-bold">
                                        <t t-esc="l.reference"/>
                                        <span class="ms-2 badge"
                                              t-att-class="l.direction === 'in' ? 'text-bg-success' : 'text-bg-warning'">
                                            <t t-esc="l.type"/>
                                        </span>
                                    </div>
                                    <div class="small text-muted">
                                        <t t-esc="l.date"/>
                                        <t t-if="l.partner"> · <t t-esc="l.partner"/></t>
                                    </div>
                                    <div class="mt-2">
                                        <span t-if="l.purpose" class="me-3">
                                            <strong>Purpose:</strong> <t t-esc="l.purpose"/>
                                        </span>
                                        <span t-if="l.beneficiary" class="me-3">
                                            <strong>Beneficiary:</strong> <t t-esc="l.beneficiary"/>
                                        </span>
                                    </div>
                                    <div t-if="l.description" class="small text-muted mt-1">
                                        <t t-esc="l.description"/>
                                    </div>
                                </div>
                                <div class="text-end" style="min-width:140px;">
                                    <div t-if="l.amount_in" class="text-success fw-bold">
                                        + <t t-esc="state.currency"/>
                                        <t t-esc="formatAmount(l.amount_in)"/>
                                    </div>
                                    <div t-if="l.amount_out" class="text-danger fw-bold">
                                        − <t t-esc="state.currency"/>
                                        <t t-esc="formatAmount(l.amount_out)"/>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        Balance: <t t-esc="formatAmount(l.balance)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>