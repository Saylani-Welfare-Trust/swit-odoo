<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Client action that opens the advance-donation-only General Ledger.
         ``params`` is explicitly set to False because the JS subclass forces
         the advance_donation_only flag itself — no params are needed. -->
    <record id="action_advance_donation_gl" model="ir.actions.client">
        <field name="name">Advance Donation Ledger</field>
        <field name="tag">adv_donation_gl</field>
        <field name="params" eval="False"/>
    </record>

    <menuitem id="menu_advance_donation_gl"
              name="Advance Donation Ledger"
              parent="main_menu_advance_donation"
              action="action_advance_donation_gl"
              sequence="20"
              groups="bn_advance_donation.group_adv_don_menu"/>

</odoo>