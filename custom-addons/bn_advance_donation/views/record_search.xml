<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The "Donor Account" tag: the programme this Record Search registers donors for -->
    <function model="res.partner.category" name="_setup_donor_account_program"/>

    <!-- Search a donor by Registration ID / CNIC / Mobile: a contact found gets the
         Donor and Donor Account tags it does not have yet, else a new donor is made. -->
    <record id="record_search_advance_donation_action" model="ir.actions.act_window">
        <field name="name">Record Search</field>
        <field name="res_model">record.search</field>
        <field name="view_mode">form</field>
        <field name="context">{
            'default_registration_type': 'donor',
            'default_program_code': 'donor_account',
            'default_program_locked': True,
        }</field>
        <field name="target">new</field>
    </record>

    <!-- Searching and tagging contacts needs Profile Management / User (contact
         create / edit rights), as for the Welfare Record Search. -->
    <menuitem
        id="advance_donation_profile_menu"
        name="Profile"
        parent="main_menu_advance_donation"
        groups="bn_profile_management.profile_management_user_group"
        sequence="20"/>

    <menuitem
        id="advance_donation_record_search_menu"
        name="Record Search"
        action="record_search_advance_donation_action"
        parent="advance_donation_profile_menu"
        groups="bn_profile_management.profile_management_user_group"
        sequence="0"/>

    <!-- These menus follow the programme tag (Profile Management > Tags): hidden while
         the programme is disabled. Linked on every install / upgrade. -->
    <function model="res.partner.category" name="_link_program_menus"
              eval="['donor_account', ['bn_advance_donation.advance_donation_profile_menu']]"/>
</odoo>
