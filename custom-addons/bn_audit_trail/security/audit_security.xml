<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_audit_trail_viewer" model="res.groups">
        <field name="name">Audit Trail / Viewer</field>
        <field name="category_id" ref="base.module_category_administration"/>
        <field name="comment">Can view the audit log (read-only).</field>
    </record>

    <record id="group_audit_trail_manager" model="res.groups">
        <field name="name">Audit Trail / Manager</field>
        <field name="category_id" ref="base.module_category_administration"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_trail_viewer'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Can view the audit log and delete old entries (e.g. for archiving).</field>
    </record>
</odoo>
