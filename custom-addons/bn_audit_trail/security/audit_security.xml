<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_audit_trail" model="ir.module.category">
        <field name="name">Audit Trail</field>
        <field name="sequence">95</field>
    </record>

    <!-- Sole gate on the root app menu. Every tier below implies it. -->
    <record id="group_audit_trail_root" model="res.groups">
        <field name="name">Access Root Menu</field>
        <field name="category_id" ref="module_audit_trail"/>
        <field name="comment">Shows the Audit Trail app menu. Implied by every group below; no need to assign it directly.</field>
    </record>

    <record id="group_audit_trail_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_audit_trail"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_trail_root'))]"/>
        <field name="comment">Sees only his/her own activity in the log (read-only).</field>
    </record>

    <!-- Historical xml id kept (was "Viewer") so existing members keep their access. -->
    <record id="group_audit_trail_viewer" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_audit_trail"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_trail_root'))]"/>
        <field name="comment">Sees everybody's activity and the Excluded Models, read-only.</field>
    </record>

    <record id="group_audit_trail_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_audit_trail"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_trail_viewer'))]"/>
        <field name="comment">Audit + manages the Excluded Models (every change is logged).</field>
    </record>

    <record id="group_audit_trail_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_audit_trail"/>
        <field name="implied_ids" eval="[(4, ref('group_audit_trail_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Manager + deletes (purges) log entries. Every purge leaves a permanent entry.</field>
    </record>

    <!-- Users see only their own entries; Audit and above see all.
         Rules of different groups are OR-ed, so a member of both sees all. -->
    <record id="rule_audit_trail_log_own" model="ir.rule">
        <field name="name">Audit Trail: own entries</field>
        <field name="model_id" ref="model_audit_trail_log"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_audit_trail_user'))]"/>
    </record>

    <record id="rule_audit_trail_log_all" model="ir.rule">
        <field name="name">Audit Trail: all entries</field>
        <field name="model_id" ref="model_audit_trail_log"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_audit_trail_viewer'))]"/>
    </record>

    <record id="rule_audit_trail_log_line_own" model="ir.rule">
        <field name="name">Audit Trail: own field changes</field>
        <field name="model_id" ref="model_audit_trail_log_line"/>
        <field name="domain_force">[('log_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_audit_trail_user'))]"/>
    </record>

    <record id="rule_audit_trail_log_line_all" model="ir.rule">
        <field name="name">Audit Trail: all field changes</field>
        <field name="model_id" ref="model_audit_trail_log_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_audit_trail_viewer'))]"/>
    </record>
</odoo>
