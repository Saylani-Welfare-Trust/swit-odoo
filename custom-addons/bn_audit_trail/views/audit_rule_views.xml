<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_audit_trail_rule_tree" model="ir.ui.view">
        <field name="name">audit.trail.rule.tree</field>
        <field name="model">audit.trail.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="log_create"/>
                <field name="log_write"/>
                <field name="log_unlink"/>
                <field name="log_read"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_audit_trail_rule_form" model="ir.ui.view">
        <field name="name">audit.trail.rule.form</field>
        <field name="model">audit.trail.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Operations">
                        <field name="log_create"/>
                        <field name="log_write"/>
                        <field name="log_unlink"/>
                        <field name="log_read"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Every model is audited for Create/Update/Delete by
                        default. Untick an operation above to turn it OFF
                        for this model, or tick "Log View (Read)" to turn
                        View tracking ON for this model - View stays off
                        everywhere else unless you add it here.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_audit_trail_rule" model="ir.actions.act_window">
        <field name="name">Audit Exceptions</field>
        <field name="res_model">audit.trail.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Every model is audited by default - add an exception only
                if you need one
            </p>
            <p>
                Create/Update/Delete are logged for every standard and
                custom model automatically. Add a row here to turn OFF
                specific operations for a specific (usually high-volume,
                low-value) model, or to turn ON View/Read tracking for a
                model - View tracking is opt-in only and stays off
                everywhere else.
            </p>
        </field>
    </record>
</odoo>
