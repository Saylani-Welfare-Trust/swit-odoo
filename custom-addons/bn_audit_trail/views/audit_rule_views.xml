<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bn_audit_trial_rule_tree" model="ir.ui.view">
        <field name="name">audit.trail.rule.tree</field>
        <field name="model">audit.trail.rule</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="model_id"/>
                <field name="model_name"/>
                <field name="log_create"/>
                <field name="log_write"/>
                <field name="log_unlink"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_bn_audit_trial_rule_form" model="ir.ui.view">
        <field name="name">audit.trail.rule.form</field>
        <field name="model">audit.trail.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="model_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Operations to Track">
                        <field name="log_create"/>
                        <field name="log_write"/>
                        <field name="log_unlink"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bn_audit_trial_rule" model="ir.actions.act_window">
        <field name="name">Audit Rules</field>
        <field name="res_model">audit.trail.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a model to start auditing it
            </p>
            <p>
                Pick any model - standard (Contacts, Sales Orders, Invoices...)
                or custom - and choose which operations to log. Takes effect
                immediately, no restart needed.
            </p>
        </field>
    </record>
</odoo>
