<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bn_audit_trial_log_tree" model="ir.ui.view">
        <field name="name">audit.trail.log.tree</field>
        <field name="model">audit.trail.log</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false"
                  decoration-danger="method == 'unlink'"
                  decoration-success="method == 'create'"
                  decoration-info="method == 'write'">
                <field name="date"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="record_name"/>
                <field name="method"/>
                <field name="summary"/>
            </tree>
        </field>
    </record>

    <record id="view_bn_audit_trial_log_form" model="ir.ui.view">
        <field name="name">audit.trail.log.form</field>
        <field name="model">audit.trail.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="user_id"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="record_name"/>
                        </group>
                    </group>
                    <field name="summary"/>
                    <notebook>
                        <page string="Field Changes">
                            <field name="line_ids">
                                <tree create="false" edit="false" delete="false">
                                    <field name="field_description"/>
                                    <field name="old_value"/>
                                    <field name="new_value"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bn_audit_trial_log_search" model="ir.ui.view">
        <field name="name">audit.trail.log.search</field>
        <field name="model">audit.trail.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="model_name"/>
                <field name="res_id"/>
                <field name="record_name"/>
                <filter string="Create" name="filter_create" domain="[('method','=','create')]"/>
                <filter string="Update" name="filter_write" domain="[('method','=','write')]"/>
                <filter string="Delete" name="filter_unlink" domain="[('method','=','unlink')]"/>
                <separator/>
                <filter string="Today" name="filter_today"
                        domain="[('date','&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="groupby_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Model" name="groupby_model" context="{'group_by': 'model_name'}"/>
                    <filter string="Action" name="groupby_method" context="{'group_by': 'method'}"/>
                    <filter string="Date" name="groupby_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bn_audit_trial_log" model="ir.actions.act_window">
        <field name="name">Audit Logs</field>
        <field name="res_model">audit.trail.log</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_bn_audit_trial_log_search"/>
    </record>
</odoo>
