<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location: an expense is matched on its Branch (from its analytic
         distribution), which must be the analytic account tagged on one of the user's locations
         in scope, or the user's own Branch (res.users.scope_analytic_account_ids).
         Global rule: it narrows the Expense rules of hr_expense (own / team / all) instead of
         adding to them. The user's own expenses and expenses without a Branch stay visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_hr_expense_rule" model="ir.rule">
        <field name="name">Expense: allowed locations' analytic accounts</field>
        <field name="model_id" ref="hr_expense.model_hr_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[(1, '=', 1)] if (user.has_group('base.group_system') or user.has_group('bn_stock_location.stock_scope_unrestricted_group')) else ['|', ('analytic_branch_id', '=', False), ('analytic_branch_id', 'in', user.scope_analytic_account_ids.ids)]</field>
    </record>

</odoo>
