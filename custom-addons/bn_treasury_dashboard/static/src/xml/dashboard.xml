<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="treasury_dashboard.Dashboard">
        <div class="o_treasury_dashboard container-fluid p-3">
            
            <!-- Header -->
            <div class="row mb-3">
                <div class="col">
                    <h1 class="h3">Treasury Dashboard</h1>
                </div>
            </div>

            <!-- 🟢 DATE FILTER BAR -->
            <div class="row mb-4 align-items-end bg-light p-3 rounded shadow-sm mx-1">
                <div class="col-md-3">
                    <label class="form-label text-muted mb-1">From Date</label>
                    <input type="date" class="form-control" t-model="state.date_from"/>
                </div>
                <div class="col-md-3">
                    <label class="form-label text-muted mb-1">To Date</label>
                    <input type="date" class="form-control" t-model="state.date_to"/>
                </div>
                <div class="col-md-6 d-flex gap-2">
                    <button class="btn btn-primary" t-on-click="applyFilter">Apply Filter</button>
                    <button class="btn btn-outline-secondary" t-on-click="clearFilter">Clear</button>
                    
                    <div class="ms-auto d-flex gap-1">
                        <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('this_month')">This Month</button>
                        <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('last_month')">Last Month</button>
                        <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('this_year')">This Year</button>
                    </div>
                </div>
            </div>

            <!-- 🟢 CUSTOM TREASURY OPERATIONS SECTION -->
            <div class="row g-3">
                
                <!-- 1. Cheque Dashboard Card -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-info">
                        <div class="card-body d-flex flex-column justify-content-between pb-0">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-info mb-0">Cheques</h5>
                                <button class="btn btn-sm btn-info text-white" t-on-click="() => this.openCustomModel('pos.cheque')">View All</button>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">Total Cheques:</span>
                                    <span t-esc="state.cheques.count"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">Total Amount:</span>
                                    <span t-esc="formatCurrency(state.cheques.total_amount)"/>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <t t-foreach="state.cheques.states" t-as="state_name" t-key="state_name">
                                        <span class="badge rounded-pill bg-secondary">
                                            <t t-esc="state_name"/>: <t t-esc="state.cheques.states[state_name]"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="mt-auto" style="height: 40px; width: 100%;">
                                <canvas t-ref="chequeChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Bank Transfers / Direct Deposit Card -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-warning">
                        <div class="card-body d-flex flex-column justify-content-between pb-0">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-warning mb-0">Bank Transfers / Deposits</h5>
                                <button class="btn btn-sm btn-warning text-white" t-on-click="() => this.openCustomModel('direct.deposit')">View All</button>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">Total Transfers:</span>
                                    <span t-esc="state.deposits.count"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">Total Amount:</span>
                                    <span t-esc="formatCurrency(state.deposits.total_amount)"/>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <t t-foreach="state.deposits.states" t-as="state_name" t-key="state_name">
                                        <span class="badge rounded-pill bg-secondary">
                                            <t t-esc="state_name"/>: <t t-esc="state.deposits.states[state_name]"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="mt-auto" style="height: 40px; width: 100%;">
                                <canvas t-ref="depositChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Journal Transfer Card -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-success">
                        <div class="card-body d-flex flex-column justify-content-between pb-0">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-success mb-0">Journal Transfers</h5>
                                <button class="btn btn-sm btn-success" t-on-click="() => this.openCustomModel('journal.transfer')">View All</button>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="fw-bold">Total Transfers:</span>
                                    <span t-esc="state.transfers.count"/>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="fw-bold">Total Amount:</span>
                                    <span t-esc="formatCurrency(state.transfers.total_amount)"/>
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <t t-foreach="state.transfers.states" t-as="state_name" t-key="state_name">
                                        <span class="badge rounded-pill bg-secondary">
                                            <t t-esc="state_name"/>: <t t-esc="state.transfers.states[state_name]"/>
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <div class="mt-auto" style="height: 40px; width: 100%;">
                                <canvas t-ref="transferChart"></canvas>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </t>
</templates>