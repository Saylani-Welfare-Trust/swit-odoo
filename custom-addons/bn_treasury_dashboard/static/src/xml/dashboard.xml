<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="treasury_dashboard.Dashboard">
        <div class="o_treasury_dashboard container-fluid p-3">
            
            <!-- Header -->
            <div class="row mb-3">
                <div class="col">
                    <h1 class="h3">Treasury Dashboard</h1>
                </div>
            </div>

            <!-- 🟢 3 MENUS SECTION (Mimicking Accounting Dashboard) -->
            <div class="row g-3 mb-4">
                
                <!-- 1. Customer Invoices Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title text-primary">Customer Invoices</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <button class="btn btn-primary px-4" t-on-click="() => this.openAction('account.action_move_out_invoice_type')">
                                    New Invoice
                                </button>
                                <a href="#" class="text-decoration-none fw-bold" t-on-click.prevent="() => this.openAction('account.action_move_out_invoice_type')">
                                    View All
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Vendor Bills Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title text-danger">Vendor Bills</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <button class="btn btn-secondary px-4" t-on-click="() => this.openAction('account.action_move_in_invoice_type')">
                                    Create Bill
                                </button>
                                <a href="#" class="text-decoration-none fw-bold" t-on-click.prevent="() => this.openAction('account.action_move_in_invoice_type')">
                                    View All
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Miscellaneous Operations Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <h5 class="card-title text-dark">Miscellaneous Operations</h5>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <button class="btn btn-light border px-4" t-on-click="() => this.openAction('account.action_move_journal_line')">
                                    New Entry
                                </button>
                                <a href="#" class="text-decoration-none fw-bold" t-on-click.prevent="() => this.openAction('account.action_move_journal_line')">
                                    View All
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Existing KPI Cards -->
            <div class="row g-3 mb-4">
                <!-- Cash & Bank Card -->
                <div class="col-md-4">
                    <div class="card border-primary h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary">Cash &amp; Bank Balance</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_cash)"/>
                        </div>
                    </div>
                </div>

                <!-- Receivables Card -->
                <div class="col-md-4">
                    <div class="card border-success h-100">
                        <div class="card-body">
                            <h5 class="card-title text-success">Total Receivables</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_receivables)"/>
                        </div>
                    </div>
                </div>

                <!-- Payables Card -->
                <div class="col-md-4">
                    <div class="card border-danger h-100">
                        <div class="card-body">
                            <h5 class="card-title text-danger">Total Payables</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_payables)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart Section -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Receivables vs Payables (Monthly Trend)</h5>
                        </div>
                        <div class="card-body" style="height: 400px;">
                            <canvas t-ref="treasuryChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>