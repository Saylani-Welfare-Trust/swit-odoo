<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="treasury_dashboard.Dashboard">
        <div class="o_treasury_dashboard container-fluid p-3">
            
            <!-- Header -->
            <div class="row mb-3">
                <div class="col">
                    <h1 class="h3">Treasury Dashboard</h1>
                </div>
            </div>

            <!-- 🟢 3 MAIN MENUS SECTION -->
            <div class="row g-3 mb-4">
                
                <!-- 1. Customer Invoices Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-primary">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-primary mb-0">Customer Invoices</h5>
                                <button class="btn btn-sm btn-primary" t-on-click="() => this.openAction('account.action_move_out_invoice_type')">New Invoice</button>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between">
                                    <span t-esc="state.invoices.to_validate + ' Invoices to Validate'"/>
                                    <span class="fw-bold" t-esc="formatCurrency(state.invoices.to_validate_amt)"/>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span t-esc="state.invoices.unpaid + ' Unpaid Invoices'"/>
                                    <span class="fw-bold" t-esc="formatCurrency(state.invoices.unpaid_amt)"/>
                                </div>
                                <div class="d-flex justify-content-between text-danger">
                                    <span t-esc="state.invoices.late + ' Late Invoices'"/>
                                    <span class="fw-bold" t-esc="formatCurrency(state.invoices.late_amt)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Vendor Bills Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-danger">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-danger mb-0">Vendor Bills</h5>
                                <div>
                                    <button class="btn btn-sm btn-secondary me-1" t-on-click="() => this.openAction('account.action_move_in_invoice_type')">Upload</button>
                                    <button class="btn btn-sm btn-outline-secondary" t-on-click="() => this.openAction('account.action_move_in_invoice_type')">Create Manually</button>
                                </div>
                            </div>
                            <div class="mt-2 text-muted small">
                                <div class="d-flex justify-content-between">
                                    <span t-esc="state.bills.to_validate + ' Bills to Validate'"/>
                                    <span class="fw-bold" t-esc="formatCurrency(state.bills.to_validate_amt)"/>
                                </div>
                                <div class="d-flex justify-content-between text-danger">
                                    <span t-esc="state.bills.to_pay + ' Bills to Pay'"/>
                                    <span class="fw-bold" t-esc="formatCurrency(state.bills.to_pay_amt)"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Miscellaneous Operations Menu -->
                <div class="col-md-4">
                    <div class="card h-100 shadow-sm border-top border-4 border-dark">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title text-dark mb-0">Miscellaneous Operations</h5>
                                <button class="btn btn-sm btn-light border" t-on-click="() => this.openAction('account.action_move_journal_line')">New Entry</button>
                            </div>
                            <div class="mt-2 text-muted small">
                                <p class="text-muted">Use this to create manual journal entries, bank transfers, or expense records.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 🟢 BANK & CASH JOURNALS SECTION -->
            <div class="row g-3 mb-4">
                <t t-foreach="state.journals" t-as="journal" t-key="journal.id">
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h5 class="card-title mb-0" t-esc="journal.name"/>
                                    <button class="btn btn-sm btn-primary" t-on-click="() => this.openAction('account.action_account_journal_dashboard')">Connect</button>
                                </div>
                                <div class="mt-2 text-muted small">
                                    <div class="d-flex justify-content-between">
                                        <span>Payments</span>
                                        <span class="fw-bold" t-esc="formatCurrency(journal.balance)"/>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span>Misc. Operations</span>
                                        <span class="fw-bold" t-esc="formatCurrency(journal.balance)"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </div>

            <!-- Existing KPI Cards -->
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-primary h-100">
                        <div class="card-body">
                            <h5 class="card-title text-primary">Cash &amp; Bank Balance</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_cash)"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success h-100">
                        <div class="card-body">
                            <h5 class="card-title text-success">Total Receivables</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_receivables)"/>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-danger h-100">
                        <div class="card-body">
                            <h5 class="card-title text-danger">Total Payables</h5>
                            <h2 class="card-text fw-bold" t-esc="formatCurrency(state.kpis.total_payables)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Chart Section -->
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-header bg-white">
                            <h5 class="mb-0">Receivables vs Payables (Monthly Trend)</h5>
                        </div>
                        <div class="card-body" style="height: 400px;">
                            <canvas t-ref="treasuryChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>