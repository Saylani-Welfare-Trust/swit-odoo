<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_dynamic_cheque">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                
                <t t-set="cfg" t-value="o.env['bank.cheque.config'].browse(o.env.context.get('cheque_config_id'))"/>
                <t t-set="chq_date" t-value="o.date"/>

                <t t-set="d1" t-value="str(chq_date.day).zfill(2)[0] if chq_date else ''"/>
                <t t-set="d2" t-value="str(chq_date.day).zfill(2)[1] if chq_date else ''"/>
                <t t-set="m1" t-value="str(chq_date.month).zfill(2)[0] if chq_date else ''"/>
                <t t-set="m2" t-value="str(chq_date.month).zfill(2)[1] if chq_date else ''"/>
                <t t-set="y1" t-value="str(chq_date.year)[0] if chq_date else ''"/>
                <t t-set="y2" t-value="str(chq_date.year)[1] if chq_date else ''"/>
                <t t-set="y3" t-value="str(chq_date.year)[2] if chq_date else ''"/>
                <t t-set="y4" t-value="str(chq_date.year)[3] if chq_date else ''"/>

                <t t-set="amt_formatted" t-value="'{:,.2f}'.format(o.net_amount)"/>

                <div class="page" t-attf-style="
                    position: relative;
                    width: 297mm; /* Standard A4 width for safety */
                    height: 210mm;
                    margin: 0; padding: 0;
                    font-family: Arial, Helvetica, sans-serif;
                ">
                    <!-- CHEQUE BOX -->
                    <div class="cheque-box"
                         t-attf-style="
                            position: absolute;
                            left: {{ cfg.cheque_margin_left or 0 }}mm;
                            top: {{ cfg.cheque_margin_top or 0 }}mm;
                            width: {{ cfg.cheque_width or 100 }}mm;
                            height: {{ cfg.cheque_height or 50 }}mm;
                            border: 1px dashed #ccc; /* Remove this line once aligned */
                         ">

                        <!-- A/C Payee -->
                        <div t-attf-style="
                            position: absolute;
                            left: {{ cfg.ac_payee_margin_left or 0 }}mm;
                            top: {{ cfg.ac_payee_margin_top or 0 }}mm;
                            font-size: {{ cfg.ac_payee_font_size or 10 }}pt;
                            white-space: nowrap;
                        " t-if="o.cheque_print_mode == 'ac_payee_only'">
                            <span>A/C Payee Only</span>
                        </div>

                        <!-- DATE -->
                        <div t-attf-style="
                            position: absolute;
                            left: {{ cfg.date_margin_left or 0 }}mm;
                            top: {{ cfg.date_margin_top or 0 }}mm;
                            font-size: {{ cfg.date_font_size or 10 }}pt;
                            white-space: nowrap;
                        ">
                            <t t-foreach="[d1,d2,m1,m2,y1,y2,y3,y4]" t-as="c">
                                <span style="display: inline-block; width: 4mm; text-align: center; font-weight: bold;">
                                    <t t-esc="c"/>
                                </span>
                            </t>
                        </div>

                        <!-- PAYEE -->
                        <div t-attf-style="
                            position: absolute;
                            left: {{ cfg.payee_margin_left or 0 }}mm;
                            top: {{ cfg.payee_margin_top or 0 }}mm;
                            font-size: {{ cfg.payee_font_size or 10 }}pt;
                            white-space: nowrap;
                        ">
                            <t t-if="o.cheque_print_mode != 'cash'">
                                <t t-if="o.partner_id">
                                    <span t-field="o.partner_id.name"/>
                                </t>
                            </t>
                            <t t-else="">
                                Cash
                            </t>
                        </div>

                        <!-- WORDS -->
                        <div t-attf-style="
                            position: absolute;
                            left: {{ cfg.words_margin_left or 0 }}mm;
                            top: {{ cfg.words_margin_top or 0 }}mm;
                            font-size: {{ cfg.words_font_size or 10 }}pt;
                            width: {{ cfg.cheque_width - cfg.words_margin_left or 120 }}mm;
                            word-break: break-word;
                        ">  
                            <span t-esc="o.check_amount_in_words"/>
                        </div>

                        <!-- AMOUNT -->
                        <div t-attf-style="
                            position: absolute;
                            left: {{ cfg.amount_margin_left or 0 }}mm;
                            top: {{ cfg.amount_margin_top or 0 }}mm;
                            font-size: {{ cfg.amount_font_size or 10 }}pt;
                            font-weight: bold;
                            text-align: center;
                            width: 60mm;
                        ">
                            <t t-esc="amt_formatted"/>
                        </div>

                    </div>
                </div>

            </t>
        </t>
    </template>

    <record id="action_report_dynamic_cheque" model="ir.actions.report">
        <field name="name">Bank Cheque</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bn_custom_payment_check.report_dynamic_cheque</field>
        <field name="report_file">bn_custom_payment_check.report_dynamic_cheque</field>
        <field name="print_report_name">'Cheque-%s' % object.name</field>
        <field name="paperformat_id" ref="bn_custom_payment_check.paperformat_dynamic_cheque"/>
    </record>

</odoo>