<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- tree VIEW -->
    <record id="view_bank_cheque_config_tree" model="ir.ui.view">
        <field name="name">bank.cheque.config.tree</field>
        <field name="model">bank.cheque.config</field>
        <field name="arch" type="xml">

            <tree string="Bank Cheque Configurations"
                  decoration-muted="active == False">

                <field name="bank_name"/>

                <field name="active" column_invisible="1"/>

            </tree>

        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_bank_cheque_config_form" model="ir.ui.view">
        <field name="name">bank.cheque.config.form</field>
        <field name="model">bank.cheque.config</field>
        <field name="arch" type="xml">

            <form string="Bank Cheque Configuration">

                <sheet>

                    <div class="oe_title">
                        <h1>
                            <field name="bank_name" placeholder="e.g. Meezan Bank"/>
                        </h1>

                        <field name="journal_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True, 'no_edit': True}"/>
                    </div>

                    <!-- Cheque Position -->
                    <group string="Cheque Position">
                        <group>
                            <field name="cheque_width"/>
                            <field name="cheque_height"/>
                        </group>
                        <group>
                            <field name="cheque_margin_left"/>
                            <field name="cheque_margin_top"/>
                        </group>
                    </group>

                    <!-- Payee Only -->
                    <group string="Payee Only">
                        <group>
                            <field name="ac_payee_margin_left"/>
                            <field name="ac_payee_margin_top"/>
                        </group>
                        <group>
                            <field name="ac_payee_font_size"/>
                        </group>
                    </group>

                    <!-- DATE -->
                    <group string="Date Position">
                        <group>
                            <field name="date_margin_left"/>
                            <field name="date_margin_top"/>
                        </group>
                        <group>
                            <field name="date_font_size"/>
                        </group>
                    </group>

                    <!-- PAYEE -->
                    <group string="Payee Position">
                        <group>
                            <field name="payee_margin_left"/>
                            <field name="payee_margin_top"/>
                        </group>
                        <group>
                            <field name="payee_font_size"/>
                        </group>
                    </group>

                    <!-- AMOUNT IN WORDS -->
                    <group string="Amount in Words Position">
                        <group>
                            <field name="words_margin_left"/>
                            <field name="words_margin_top"/>
                        </group>
                        <group>
                            <field name="words_font_size"/>
                        </group>
                    </group>

                    <!-- AMOUNT -->
                    <group string="Amount Position">
                        <group>
                            <field name="amount_margin_left"/>
                            <field name="amount_margin_top"/>
                        </group>
                        <group>
                            <field name="amount_font_size"/>
                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <!-- ACTION -->
    <record id="action_bank_cheque_config" model="ir.actions.act_window">
        <field name="name">Bank Cheque Configurations</field>
        <field name="res_model">bank.cheque.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_bank_cheque_root"
              name="Bank Cheque Configurations"
              parent="account.menu_finance_configuration"
              action="action_bank_cheque_config"
              sequence="99"/>

</odoo>