<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bank_double_cheque_config_tree" model="ir.ui.view">
        <field name="name">bank.double.cheque.config.tree</field>
        <field name="model">bank.double.cheque.config</field>
        <field name="arch" type="xml">
            <tree><field name="bank_name"/></tree>
        </field>
    </record>

    <record id="view_bank_double_cheque_config_form" model="ir.ui.view">
        <field name="name">bank.double.cheque.config.form</field>
        <field name="model">bank.double.cheque.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="bank_name" placeholder="e.g. MCB Double Cheque"/></h1>
                        <field name="journal_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </div>
                    <group string="Double Cheque Specific Settings">
                        <field name="second_cheque_offset"/>
                    </group>
                    <group string="Cheque Position">
                        <group><field name="cheque_width"/><field name="cheque_height"/></group>
                        <group><field name="cheque_margin_left"/><field name="cheque_margin_top"/></group>
                    </group>
                    <group string="Payee Only">
                        <group><field name="ac_payee_margin_left"/><field name="ac_payee_margin_top"/></group>
                        <group><field name="ac_payee_font_size"/></group>
                    </group>
                    <group string="Date Position">
                        <group><field name="date_margin_left"/><field name="date_margin_top"/></group>
                        <group><field name="date_font_size"/></group>
                    </group>
                    <group string="Payee Position">
                        <group><field name="payee_margin_left"/><field name="payee_margin_top"/></group>
                        <group><field name="payee_font_size"/></group>
                    </group>
                    <group string="Amount in Words Position">
                        <group><field name="words_margin_left"/><field name="words_margin_top"/></group>
                        <group><field name="words_font_size"/></group>
                    </group>
                    <group string="Amount Position">
                        <group><field name="amount_margin_left"/><field name="amount_margin_top"/></group>
                        <group><field name="amount_font_size"/></group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bank_double_cheque_config" model="ir.actions.act_window">
        <field name="name">Bank Double Cheque Configurations</field>
        <field name="res_model">bank.double.cheque.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_bank_double_cheque_root"
              name="Bank Double Cheque Configurations"
              parent="account.menu_finance_configuration"
              action="action_bank_double_cheque_config"
              sequence="100"/>
</odoo>