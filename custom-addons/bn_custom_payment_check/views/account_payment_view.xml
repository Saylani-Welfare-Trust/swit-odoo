<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_inherit_check" model="ir.ui.view">
        <field name="name">account.payment.form.check.button</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">

            <header position="inside">

                <!-- Required for invisible condition -->
                <field name="show_double_cheque" invisible="1"/>

                <button name="action_print_check" type="object" string="Print Cheque" class="btn-primary"/>

                <button name="action_print_double_check" type="object" string="Print Double Cheque" class="btn-secondary" invisible="not show_double_cheque"/>

            </header>

            <xpath expr="//field[@name='payment_type']" position="after">
                <field name="cheque_print_mode" readonly="state != 'draft'"/>
            </xpath>

        </field>
    </record>

 
    <record id="view_cheque_reprint_wizard_form" model="ir.ui.view">
        <field name="name">cheque.reprint.wizard.form</field>
        <field name="model">cheque.reprint.wizard</field>
        <field name="arch" type="xml">
            <form string="Reprint Cheque">
                <group>
                    <field name="payment_id" invisible="1"/>
                    <field name="print_type" invisible="1"/>
                    <field name="reason" placeholder="Why is this cheque being reprinted?"/>
                </group>
                <footer>
                    <button string="Print" name="action_confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
    
</odoo>