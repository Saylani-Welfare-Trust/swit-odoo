<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="point_of_sale_view_pos_order_tree_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.order.tree.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                    <button name="%(pos_donation_receipt_report)d" string="Print Receipt" type="action" class="oe_stat_button" icon="fa-print" title="Print Donation Receipt"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="analytic_account_id" string="Branch" options="{'no_create': True, 'no_edit': True, 'no_open': True}" />
            </xpath>

            <!-- Source Document (bn_pos_custom_action) is only on the form: add it here so the
                 editable list below can make it read-only -->
            <xpath expr="//field[@name='pos_reference']" position="after">
                <field name="source_document" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Priority 20 so it applies after pos_hr, which turns the Cashier column into employee_id -->
    <record id="point_of_sale_view_pos_order_tree_customer_note_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.order.tree.customer.note.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <!-- Click a row's Customer Note to type in it; the arrow at the end of the row opens the order -->
            <xpath expr="//tree" position="attributes">
                <attribute name="editable">bottom</attribute>
                <attribute name="open_form_view">1</attribute>
            </xpath>

            <xpath expr="//field[@name='state']" position="before">
                <field name="customer_note" optional="show"/>
            </xpath>

            <!-- Customer Note is the only column meant to be edited from the list -->
            <xpath expr="//field[@name='session_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='config_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='pos_order_seq']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='source_document']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="point_of_sale_view_pos_pos_form_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.pos.form.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar" statusbar_visible="draft,refund_request,cfo_approval,paid,done,refund"/>
            </xpath>

            <xpath expr="//header/button[@type='action']" position="attributes">
                <attribute name="invisible">state != 'cfo_approval'</attribute>
            </xpath>

            <xpath expr="//button[@name='action_pos_order_invoice']" position="replace" />

            <xpath expr="//header" position="inside">
                <!-- <button string="Refund Request" name="action_refund_request" type="object" invisible="state not in ['paid', 'done'] or not has_refundable_lines" /> -->
                <button string="CFO Approval" name="action_cfo_approval" type="object" class="oe_highlight" invisible="state != 'draft'" groups="bn_pos_order.pos_order_cfo_approval_group" />
                <button string="Reject" name="action_reject" type="object" class="oe_highlight" invisible="state != 'draft'" groups="bn_pos_order.pos_order_cfo_approval_group" />
            </xpath>
        </field>
    </record>

    <record id="point_of_sale_view_pos_order_filter_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.order.filter.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mobile" />
            </xpath>
        </field>
    </record>

</odoo>