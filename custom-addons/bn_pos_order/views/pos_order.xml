<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================ TREE VIEW ============================ -->
    <record id="point_of_sale_view_pos_order_tree_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.order.tree.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <button name="%(pos_donation_receipt_report)d" string="Print Receipt" type="action"
                        class="oe_stat_button" icon="fa-print" title="Print Donation Receipt"/>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="analytic_account_id" string="Branch"
                       options="{'no_create': True, 'no_edit': True, 'no_open': True}"/>
            </xpath>
        </field>
    </record>

    <!-- ============================ FORM VIEW ============================ -->
    <record id="point_of_sale_view_pos_pos_form_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.pos.form.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,refund_request,cfo_approval,paid,done,refund"/>
            </xpath>

            <xpath expr="//header/button[@type='action']" position="attributes">
                <attribute name="invisible">state != 'cfo_approval'</attribute>
            </xpath>

            <xpath expr="//button[@name='action_pos_order_invoice']" position="replace"/>

            <xpath expr="//header" position="inside">
                <button string="CFO Approval" name="action_cfo_approval" type="object"
                        class="oe_highlight" invisible="state != 'draft'"
                        groups="bn_pos_order.pos_order_cfo_approval_group"/>
                <button string="Reject" name="action_reject" type="object"
                        class="oe_highlight" invisible="state != 'draft'"
                        groups="bn_pos_order.pos_order_cfo_approval_group"/>
            </xpath>
        </field>
    </record>

    <!-- ======================= SEARCH / FILTER VIEW ======================= -->
    <record id="point_of_sale_view_pos_order_filter_inherit_bn_pos_order" model="ir.ui.view">
        <field name="name">point.of.sale.view.pos.order.filter.inherit.bn.pos.order</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="mobile"/>
            </xpath>

            <xpath expr="//field[@name='config_id']" position="after">
                <field name="analytic_account_id" string="Branch"/>
                <field name="employee_id" string="Cashier"/>
                <field name="pos_order_seq"/>
                <!-- Product search: matches any order whose lines contain the product -->
                <field name="order_line" string="Product"
                       filter_domain="[('lines.product_id', 'ilike', self)]"/>
            </xpath>


            <xpath expr="//filter[@name='posted']" position="after">
                <filter string="By Branch" name="filter_branch"
                        domain="[('analytic_account_id', '!=', False)]"/>
                <filter string="By Cashier" name="filter_employee"
                        domain="[('employee_id', '!=', False)]"/>
                <separator/>
            </xpath>

            <xpath expr="//filter[@name='status']" position="after">
                <filter string="Branch" name="group_branch"
                        domain="[]" context="{'group_by': 'analytic_account_id'}"/>
                <filter string="Cashier" name="group_employee"
                        domain="[]" context="{'group_by': 'employee_id'}"/>
            </xpath>

            <!-- Group By Product -->
            <xpath expr="//filter[@name='order_month']" position="after">
                <filter string="Product" name="group_product"
                        domain="[]" context="{'group_by': 'lines.product_id'}"/>
            </xpath>

        </field>
    </record>

</odoo>