<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Orders and Products have no group of their own: they follow the Purchase menu.
         Configuration stays with the Purchase Administrator. -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_purchase_audit'))]"/>
    </record>

    <record id="purchase.purchase_report_main" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_purchase_audit'))]"/>
    </record>

    <record id="purchase.purchase_report" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_purchase_audit'))]"/>
    </record>

    <!-- Material Requests: the app and its Transfer Requests (read-only, see ir_rule.xml) -->
    <record id="bn_material_request.material_request_menu_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_purchase_audit'))]"/>
    </record>

    <!-- Accounting: the app, of which the auditor sees the Vendors menu only (bills,
         refunds, payments, PO advance payments, products, vendors). Customers has no group
         of its own, so it is given the groups that open Accounting otherwise
         (Billing / Show Accounting Features - Readonly); the other menus already have one. -->
    <record id="account.menu_finance" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('group_purchase_audit'))]"/>
    </record>

    <record id="account.menu_finance_receivables" model="ir.ui.menu">
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
    </record>

    <!-- Purchase > Orders > Receipts (GRN): all incoming transfers, read-only -->
    <menuitem id="menu_purchase_audit_receipts"
              name="Receipts (GRN)"
              parent="purchase.menu_procurement_management"
              action="action_purchase_audit_receipts"
              groups="group_purchase_audit"
              sequence="10"/>
</odoo>
