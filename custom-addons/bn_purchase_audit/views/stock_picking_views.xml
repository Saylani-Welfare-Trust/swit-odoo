<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipts (GRN): every incoming transfer, read-only. The auditor has no Inventory
         app, so this is the way to them other than a Purchase Order's Receipts button. -->
    <record id="action_purchase_audit_receipts" model="ir.actions.act_window">
        <field name="name">Receipts (GRN)</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('picking_type_code', '=', 'incoming')]</field>
        <field name="context">{'contact_display': 'partner_address', 'restricted_picking_type_code': 'incoming', 'create': False, 'edit': False, 'delete': False}</field>
        <field name="search_view_id" ref="stock.view_picking_internal_search"/>
    </record>
</odoo>
