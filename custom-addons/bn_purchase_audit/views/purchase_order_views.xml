<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The auditor is read-only: on the forms they open, the status-bar buttons
         (Confirm, Send by Email, Receive Products, Validate, Create Bill, Cancel...) are hidden.
         Set on the header, this also hides the buttons that other modules add to it. -->

    <!-- Purchase Order / RFQ: no header buttons for the auditor -->
    <record id="purchase_order_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">purchase.order.form.audit.no.buttons</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Receipt (GRN): no header buttons for the auditor -->
    <record id="stock_picking_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">stock.picking.form.audit.no.buttons</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Purchase Request / Blanket Order: no header buttons for the auditor -->
    <record id="purchase_requisition_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">purchase.requisition.form.audit.no.buttons</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="purchase_requisition.view_purchase_requisition_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vendor Bill: no header buttons for the auditor -->
    <record id="account_move_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">account.move.form.audit.no.buttons</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Payment: no header buttons for the auditor -->
    <record id="account_payment_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">account.payment.form.audit.no.buttons</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Material Request: no header buttons for the auditor -->
    <record id="material_request_view_form_audit_no_buttons" model="ir.ui.view">
        <field name="name">material.request.form.audit.no.buttons</field>
        <field name="model">material.request</field>
        <field name="inherit_id" ref="bn_material_request.material_request_view_form"/>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <xpath expr="/form/header" position="attributes">
                <attribute name="groups">!bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>

    <!-- Receipt (GRN) smart button of the Purchase Order: purchase_stock shows it to
         Inventory users only; the auditor sees it too (read access on stock.picking is
         given in ir.model.access.csv) -->
    <record id="purchase_order_view_form_audit" model="ir.ui.view">
        <field name="name">purchase.order.form.audit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]/button[@name='action_view_picking']" position="attributes">
                <attribute name="groups">stock.group_stock_user,bn_purchase_audit.group_purchase_audit</attribute>
            </xpath>
        </field>
    </record>
</odoo>
