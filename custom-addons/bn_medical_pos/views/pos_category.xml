<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mh_pos_category_view_tree" model="ir.ui.view">
        <field name="name">pos.category.view.tree.mh</field>
        <field name="model">pos.category</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <tree string="Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id" optional="show" options="{'no_create': True}"/>
                <field name="mh_medical" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="mh_pos_category_view_search" model="ir.ui.view">
        <field name="name">pos.category.view.search.mh</field>
        <field name="model">pos.category</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <search string="Categories">
                <field name="name"/>
                <filter name="filter_medical" string="Medical &amp; Health" domain="[('mh_medical', '=', True)]"/>
                <filter name="filter_not_medical" string="Other" domain="[('mh_medical', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mh_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">pos.category</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="mh_pos_category_view_tree"/>
        <field name="search_view_id" ref="mh_pos_category_view_search"/>
        <field name="context">{'default_mh_medical': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a product category</p>
            <p>Switch on "Medical &amp; Health" for the categories to show at the Medical &amp; Health counters.
               The open counters update automatically.</p>
        </field>
    </record>

</odoo>
