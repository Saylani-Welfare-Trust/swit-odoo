<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="mh_patient_register_wizard_view_form" model="ir.ui.view">
        <field name="name">mh.patient.register.wizard.view.form</field>
        <field name="model">mh.patient.register.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Patient">
                <div class="alert alert-info mb-3" role="alert">
                    <i class="fa fa-info-circle me-1" title="Info"/>
                    A person already registered with this CNIC (as a donor, donee ...) becomes the patient: no duplicate profile is made.
                </div>
                <group>
                    <group>
                        <field name="name" placeholder="Patient's full name"/>
                        <field name="date_of_birth" options="{'max_date': 'today'}" placeholder="DD/MM/YYYY"/>
                    </group>
                    <group>
                        <field name="cnic_no" placeholder="XXXXX-XXXXXXX-X"/>
                        <field name="mobile" placeholder="3001234567" widget="phone"/>
                    </group>
                </group>
                <footer>
                    <button name="action_register" type="object" string="Register" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mh_patient_register_wizard" model="ir.actions.act_window">
        <field name="name">Register Patient</field>
        <field name="res_model">mh.patient.register.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
