<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_kitchen" model="ir.module.category">
        <field name="name">Kitchen</field>
        <field name="sequence">54</field>
    </record>

    <!-- Sole gate on the Kitchen app menu. No group implies it: assign it explicitly,
         together with the tier / role groups, to whoever should see it. -->
    <record id="kitchen_group" model="res.groups">
        <field name="name">Menu</field>
        <field name="category_id" ref="module_kitchen"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Grants visibility of the Kitchen app menu. Assign it explicitly with the role groups: no group implies it.</field>
    </record>

    <record id="kitchen_user_group" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_kitchen"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Day-to-day access: branch kitchen requests and ration packing.</field>
    </record>

    <record id="kitchen_manager_group" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_kitchen"/>
        <field name="implied_ids" eval="[(6, 0, [ref('kitchen_user_group')])]"/>
        <field name="comment">Everything User can do.</field>
    </record>

    <record id="kitchen_audit_group" model="res.groups">
        <field name="name">Audit</field>
        <field name="category_id" ref="module_kitchen"/>
        <field name="implied_ids" eval="[(5, 0, 0)]"/>
        <field name="comment">Read-only oversight of kitchen requests and menus, for reporting.</field>
    </record>

    <record id="kitchen_admin_group" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="module_kitchen"/>
        <field name="implied_ids" eval="[(6, 0, [ref('kitchen_manager_group'), ref('kitchen_audit_group')])]"/>
        <field name="comment">Full control: everything Manager can do, plus delete rights and the kitchen menus configuration.</field>
    </record>

    <!-- Every internal user could work in Kitchen before the tiers: on this
         first upgrade, the users of its menu become User. -->
    <function model="res.groups" name="_move_retired_group_users" eval="[{
        'bn_kitchen.kitchen_group': 'bn_kitchen.kitchen_user_group',
    }, 'bn_kitchen.tiers']"/>

</odoo>
