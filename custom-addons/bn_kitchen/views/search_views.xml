<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search: references, donor / partner, user, product, lot, location; line
         search on products and lot numbers; status, my records, date filters;
         group by status, partner, user, product, location and month -->

    <record id="search_branch_kitchen_request" model="ir.ui.view">
        <field name="name">branch.kitchen.request.search</field>
        <field name="model">branch.kitchen.request</field>
        <field name="arch" type="xml">
            <search string="Branch Kitchen Request">
                <field name="branch_id"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_approve" string="Approve" domain="[('state', '=', 'approve')]"/>
                <filter name="filter_state_done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_date" string="Date" date="date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="groupby_branch_id" string="Branch" context="{'group_by': 'branch_id'}"/>
                    <filter name="groupby_date_month" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="search_kitchen_menu" model="ir.ui.view">
        <field name="name">kitchen.menu.search</field>
        <field name="model">kitchen.menu</field>
        <field name="arch" type="xml">
            <search string="Kitchen Menu">
                <field name="product_tmpl_id"/>
                <field name="kitchen_menu_line_ids" string="Line Product" filter_domain="[('kitchen_menu_line_ids.product_id', 'ilike', self)]"/>
                <separator/>
                <filter name="filter_state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_state_to_be_approved" string="To Be Approve" domain="[('state', '=', 'to_be_approved')]"/>
                <filter name="filter_state_approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_my_records" string="My Records" domain="[('create_uid', '=', uid)]"/>
                <separator/>
                <filter name="period_create_date" string="Created on" date="create_date"/>
                <group expand="0" string="Group By" name="group_by_options">
                    <filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="groupby_product_tmpl_id" string="Product" context="{'group_by': 'product_tmpl_id'}"/>
                    <filter name="groupby_create_date_month" string="Created on" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
