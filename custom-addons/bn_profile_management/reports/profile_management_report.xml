<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="user_profile_report" name="Donee Form">
        <t t-call="web.html_container">
           <t t-call="web.external_layout">
                <!-- Urdu instructions header (only when printed from Welfare) -->
                <t t-if="context.get('active_welfare_id')">
                    <style>
                        @font-face {
                            font-family: 'JameelNooriNastaleeq';
                            src: url('/bn_profile_management/static/src/fonts/JameelNooriNastaleeqRegular.ttf') format('truetype');
                        }
                        .welfare-urdu {
                            direction: rtl;
                            text-align: justify;
                            font-family: 'JameelNooriNastaleeq', 'Noto Naskh Arabic', sans-serif !important;
                            font-size: 14px;
                            line-height: 1.8;
                        }
                        .welfare-urdu p {
                            margin: 0 0 4px 0;
                        }
                        .welfare-urdu .urdu-banner {
                            background-color: #3b3591;
                            color: #ffffff;
                            text-align: center;
                            padding: 2px 10px;
                            margin: 4px 0;
                            font-size: 15px;
                        }
                        .welfare-urdu .urdu-label {
                            background-color: #3b3591;
                            color: #ffffff;
                            padding: 0 8px;
                            margin-left: 6px;
                        }
                        .welfare-urdu .urdu-check {
                            display: inline-block;
                            width: 12px;
                            height: 12px;
                            border: 1px solid #000000;
                            margin-left: 6px;
                            vertical-align: middle;
                        }
                    </style>
                    <section name="welfare_header" class="welfare-urdu">
                        <div class="urdu-banner">اہم ہدایات</div>
                        <p>
                            یاد رکھیں دینِ اسلام کے مالدار افراد کو زکوٰۃ خیرات کی رقم غریب افراد تک پہنچانے کا حکم دیا گیا ہے تاکہ مستحق افراد اس رقم سے اپنی ضرورتوں کو
                            پورا کر سکیں۔ سیلانی ویلفیئر بطورِ وکیل آپ تک یہ رقم امداد پہنچانے کا کام کر رہی ہے اگر آپ یہ سمجھتے ہیں کہ:
                        </p>
                        <div class="urdu-banner">آپ کی آمدنی اس قابل نہیں کہ جس سے آپ اپنے اخراجات پورے کر سکتے ہیں تو آپ یہ فارم بھر سکتے ہیں۔</div>
                        <p>
                            ہمارے پیارے آقا مصطفیٰ ﷺ کا ارشاد پاک ہے (مفہوم) کہ اگر کوئی شخص بلا ضرورت (یعنی اس کو ضرورت نہیں تھی) کسی کے آگے ہاتھ پھیلاتا ہے
                            اور مانگتا ہے۔۔۔۔ آپ نے قسم کھا کر ارشاد فرمایا کہ وہ زندگی بھر لوگوں کے سامنے ہاتھ پھیلاتا رہے گا پھر بھی اس کا پیٹ نہیں بھرے گا۔ (الامان والحفیظ)
                        </p>
                        <p>
                            <span class="urdu-label">محترم سائلین کرام توجہ فرمائیں</span>
                            اب آپ خود فیصلہ کر لیں کہ آپ اس رقم امداد کے حقدار ہیں یا کسی حقدار کا حق مار رہے ہیں۔ یقین جانیے اگر
                            آپ نے جانتے بوجھتے غلط طریقے سے جھوٹ بول کر یہ رقم امداد ادارے سے وصول کی اس کا نقصان آپ کو یہ ہو سکتا ہے۔ (مشاہدے کی بات ہے) کہ آپ
                            کسی بھی تکلیف میں مبتلا ہو سکتے ہیں، بیماری، ایکسیڈنٹ، پریشانی، جھگڑے، مالی تنگی یا کوئی بھی ایسی آفت جس کا آپ تصور نہیں کر سکتے، بلا کی طرح آپ پر نازل
                            ہو سکتی ہے اور جس سے آپ بے سکون ہو جائیں گے (الامان والحفیظ)۔ اللہ عزوجل ہم سب کی مدد فرمائے ہر مسلمان کی پریشانیاں دور کرے۔ (آمین)
                        </p>
                        <p>
                            سیلانی ویلفیئر ان شاء اللہ عزوجل آپ کی خدمت عزت و تعظیم کے ساتھ کرنے کے لئے موجود ہے، اللہ عزوجل سیلانی ویلفیئر کو بھی مستحقین تک ان کی امانتیں
                            فوری طور پر پہنچانے کی توفیق عطا فرمائے۔ ادارے کے کچھ قوانین ہیں جو آپ کی بہتری کے لئے بنائے گئے ہیں امید ہے کہ آپ ان پر عمل کریں گے اور ہمارے
                            اسٹاف کے ساتھ تعاون کریں گے۔
                        </p>
                    </section>
                    <br/>
                </t>
                <section name="Title">
                    <t t-if="'Microfinance' in docs.category_id.mapped('name')">
                        <center>
                            <h1>Microfinance Application</h1>
                        </center>
                    </t>
                    <t t-elif="'Welfare' in docs.category_id.mapped('name')">
                        <center>
                            <h1>Welfare Application</h1>
                        </center>
                    </t>
                    <t t-else="">
                        <center>
                            <h1>User Profile</h1>
                        </center>
                    </t>
                </section>
                <br/><br/>
                <section name="print_detail" style="width: 80%;">
                    <div class="row">
                        <div class="col-2">
                            <span>Date : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="datetime.date.today()"/>
                        </div>
                        <div class="col-2">
                            <span>Master Donee No. : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.primary_registration_id"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Name : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.name"/>
                        </div>
                        <div class="col-2">
                            <span>Mobile : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.mobile"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>CNIC No. : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.cnic_no"/>
                        </div>
                        <div class="col-2">
                            <span>City : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.city"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Branch : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.analytic_account_id.name"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Gender : </span>
                        </div>
                        <div class="col-4">
                            <t t-if="docs.gender" t-esc="docs.gender.title()"/>
                        </div>
                        <div class="col-2">
                            <span>DOB : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.date_of_birth"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Religion : </span>
                        </div>
                        <div class="col-4">
                            <t t-if="docs.religion" t-esc="docs.religion.title()"/>
                        </div>
                        <div class="col-2">
                            <span>Next Kin : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.next_kin"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Address : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.street"/>
                        </div>
                        <div class="col-2">
                            <span>Nearest Land Mark : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.nearest_land_mark"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Father Name : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.father_name"/>
                        </div>
                        <div class="col-2">
                            <span>Surname : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.surname"/>
                        </div>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Married Status : </span>
                        </div>
                        <div class="col-4">
                            <t t-if="docs.martial_status" t-esc="docs.martial_status.title()"/>
                        </div>
                        <t t-if="docs.martial_status == 'married'">
                            <div class="col-2">
                                <span>Spouse Name : </span>
                            </div>
                            <div class="col-4">
                                <t t-esc="docs.spouse_name"/>
                            </div>
                        </t>
                    </div>
                    <br/>
                    <div class="row">
                        <div class="col-2">
                            <span>Bank / Wallet Account : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.bank_wallet_account"/>
                        </div>
                        <div class="col-2">
                            <span>Details : </span>
                        </div>
                        <div class="col-4">
                            <t t-esc="docs.details"/>
                        </div>
                    </div>
                    <!-- Inquiry Officer Information (only when printed from Welfare) -->
                        <t t-if="context.get('active_welfare_id')">
                            <t t-set="welfare" t-value="env['welfare'].browse(context.get('active_welfare_id'))"/>
                            <br/>
                            <div class="row">
                                <div class="col-2">
                                    <span>Inquiry Officer : </span>
                                </div>
                                <div class="col-4">
                                    <t t-esc="welfare.employee_id.name if welfare.employee_id else ''"/>
                                </div>
                                <div class="col-2">
                                    <span>Officer Phone : </span>
                                </div>
                                <div class="col-4">
                                    <t t-esc="(welfare.employee_id.mobile_phone or welfare.employee_id.work_phone) if welfare.employee_id else ''"/>
                                </div>
                            </div>
                        </t>
                </section>
                <!-- Urdu declaration footer (only when printed from Welfare) -->
                <t t-if="context.get('active_welfare_id')">
                    <br/>
                    <section name="welfare_footer" class="welfare-urdu">
                        <div class="urdu-banner">برکتیں حاصل کرنے کے لئے کچھ روحانی ذرائع</div>
                        <p>
                            <span class="urdu-check"/>
                            نمازِ پنجگانہ اور قرآن کی تلاوت کا معمول ہے؟ (اگر نہیں تو فوری شروع کیجئے)
                        </p>
                        <p>
                            <span class="urdu-check"/>
                            کم از کم ہفتہ وار صلوٰۃ الحاجات اور روزانہ درود پاک پڑھنے کا معمول ہے۔ (اگر نہیں تو فوری شروع کیجئے)
                        </p>
                        <p>
                            <span class="urdu-check"/>
                            محترم / محترمہ ان حالات میں بھی جتنا ممکن ہو صدقہ و خیرات دے کر اللہ عزوجل سے مدد حاصل کرنے کا ذہن بنائیں تاکہ آپ کا ہاتھ بھی بانٹنے والا بن جائے۔
                        </p>
                        <p>
                            <span class="urdu-label">نوٹ:</span>
                            برائے کرم اس فارم کو بھرنے کے بعد علیحدہ سے ایک درخواست بھی لکھیں کہ آپ ادارے سے کیوں اور کیا مدد لینا چاہتے ہیں اور اس
                            سے پہلے آپ نے ادارے سے کب اور کتنی مدد لی ہے۔ یاد رکھیں آپ کی لکھی گئی باتوں کو ادارہ اپنی شرائط و ضوابط کے اعتبار سے انکوائری کرانے اور ہر
                            قسم کے فیصلے کا حق محفوظ رکھتا ہے۔
                        </p>
                        <p>
                            <span class="urdu-label">حلف نامہ:</span>
                            میں اللہ عزوجل کو سمیع و بصیر جان کر یہ اقرار کرتا / کرتی ہوں کہ میں زکوٰۃ کی / کا حقدار ہوں اور میں نے جو فارم پُر کیا ہے بالکل
                            درست اور ٹھیک پُر کیا ہے۔ یا اللہ عزوجل اگر میں جانتے بوجھتے اس میں غلط بیانی کی تو مجھے دنیا اور آخرت میں اس کی سزا دے۔ (الامان والحفیظ)
                        </p>
                    </section>
                </t>
           </t>
        </t>
    </template>

    <record id="action_profile_management_report" model="ir.actions.report">
        <field name="name">User Profile Report</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bn_profile_management.user_profile_report</field>
        <field name="report_file">bn_profile_management.user_profile_report</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" ref="model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

</odoo>