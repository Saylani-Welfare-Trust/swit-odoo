<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="microfinance_application_form">
            <t t-foreach="docs" t-as="o">
                    <t t-call="web.basic_layout">
                        <style>
                        @font-face {
                            font-family: 'JameelNooriNastaleeq';
                            src: url('/bn_profile_management/static/src/fonts/JameelNooriNastaleeqRegular.ttf') format('truetype');
                        }

                        html, body, #wrapwrap, .article, main {
                            margin: 0 !important;
                            padding: 0 !important;
                        }

                        body, .page {
                            font-family: 'JameelNooriNastaleeq' !important;
                            font-size: 13.5px;
                        }

                        .urdu {
                            direction: rtl;
                            text-align: right;
                            font-family: 'JameelNooriNastaleeq' !important;
                            line-height: 1.05;
                        }

                        table {
                            width: 100%;
                            border-collapse: collapse;
                            direction: rtl;
                        }

                        th, td {
                            border: 1px solid black;
                            padding: 4px;
                            text-align: right;
                            vertical-align: middle;
                            font-size: 13px;
                        }

                        h2, h3, h4 {
                            text-align: center;
                            margin: 6px 0 4px 0;
                        }

                        h2 {
                            font-size: 18px;
                        }

                        h3 {
                            font-size: 17px;
                        }

                        h4 {
                            font-size: 16px;
                        }

                        @page {
                            size: A4;
                            margin: 8mm;
                        }
                    </style>
                      <section name="print_detail">
                            <table style="width: 100%; border-collapse: collapse; direction: ltr; table-layout: fixed;">
                                <tr>
                                    <td style="width: 28%; vertical-align: top; border: none; padding: 0;">
                                        <div style="direction: ltr; font-size: 15px;">
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">Application No. :</span>
                                                <span style="word-break: break-word;">
                                                    <t t-if="o.microfinance_line_ids">
                                                        <t t-esc="o.microfinance_line_ids[-1].name"/>
                                                    </t>
                                                </span>
                                            </div>
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">Master Donee No. :</span>
                                                <span style="word-break: break-word;"><t t-esc="o.primary_registration_id"/></span>
                                            </div>
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">Donee Name :</span>
                                                <span style="word-break: break-word;"><t t-esc="o.name"/></span>
                                            </div>
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">Mobile Number :</span>
                                                <span style="word-break: break-word;"><t t-esc="o.country_code_id.name"/><t t-esc="o.mobile"/></span>
                                            </div>
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">CNIC No. :</span>
                                                <span style="word-break: break-word;"><t t-esc="o.cnic_no or 'N/A'"/></span>
                                            </div>
                                            <div style="display: flex;">
                                                <span style="white-space: nowrap; padding-right: 4px;">Address :</span>
                                                <span style="word-break: break-word;"><t t-esc="o.contact_address or 'N/A'"/></span>
                                            </div>
                                        </div>
                                    </td>
                                    <td style="width: 45%; vertical-align: top; border: none; text-align: center; direction: rtl; overflow: hidden;" class="urdu">
                                        <h1 style="display:inline-block; max-width: 100%; background:black; color:white; padding:7px 16px; border-radius:8px; font-size:28px; margin:0;">
                                            سیلانی مائیکرو فنانس فارم
                                        </h1>
                                        <p style="margin-top:6px; font-size:15px;">یہ فارم مستحق افراد کی مدد کے لیے ہے</p>
                                    </td>
                                    <td style="width: 27%; vertical-align: top; border: none; text-align: center;">
                                        <t t-if="o.image_1920">
                                            <img t-att-src="'/web/image/%s/%s/image_1920' % (o._name, o.id)" style="width: 150px; height: 150px; border: 1px solid #000; object-fit: cover;"/>
                                        </t>
                                        <t t-else="">
                                            <div style="width: 70px; height: 70px; border: 1px solid #000; display: inline-flex; align-items: center; justify-content: center;">
                                                <span>No Image</span>
                                            </div>
                                        </t>
                                    </td>
                                </tr>
                            </table>
                        </section>

                    <!-- ================= CONTENT ================= -->
                    <div class="page urdu" style="margin-top: 9px;">

                        <hr style="margin: 9px 0;"/>

                        <!-- Important Notes -->
                        <div style="border: 1px solid black; padding: 6px; margin-bottom: 8px; page-break-inside: avoid;">
                            <h4 style="text-align:right; background:black;color:white;padding:5px 10px;">
                                اہم ہدایات
                            </h4>

                            <p style="text-align:right; margin: 4px 0;">
                                یاد رہے! دین اسلام کے مال دار افراد کو زکوٰۃ و خیرات کے ذریعے مستحق افراد تک پہنچانے کا حکم دیا گیا ہے تاکہ مستحق افراد اس فرم سے اپنی ضروریات کو پورا کر سکیں۔ سلیانی ویلفیئر بغیر بطور فیس یہ مدد پہنچانے کا کام کر رہی ہے، اگر آپ بھی یہ نیکی کا کام کرنا چاہتے ہیں تو۔
                            </p>

                            <p style="text-align:right; border:1px solid black; padding:7px; border-radius:8px; background:#f8f8f8; margin: 5px 0;">
                                <strong style="font-size:15px;">نوٹ:</strong>
                                نام، دستخط دیے گئے تمام کالم ٹھیک طور پر مکمل کریں۔ ہماری انفارمی ٹیم تصدیق کرنے کے لیے آپ کے دیے گئے پتہ پر جائے گی۔ اگر فراہم کردہ معلومات میں کوئی بھی غلطی ہوئی تو ادارہ آپ کے خلاف قانونی کارروائی کرنے کا حق محفوظ رکھتا ہے۔
                            </p>
                        </div>

                        <div style="                             text-align:right;                             border:1px solid black;                             padding:7px;                             border-radius:8px;                             background:#f8f8f8;                             margin-bottom:7px;                         ">
                            <div style="text-align:right; margin-bottom:6px;">
                                <span style="display:inline-block; background:black; color:white; padding:5px 10px; font-size:15px; font-weight:bold; border-radius:5px; white-space:nowrap;">
                                    محترم سائلین کو اہم تنبیہ
                                </span>
                            </div>

                            <ul style="margin: 3px 0; padding-right: 18px; list-style-position: outside;">
                                <li style="text-align:justify; line-height:1.1; font-size:13px; margin-top:3px;">
                                    اب آپ خود فیصلہ کرلیں کہ آپ اس رقم / مدد کے حقدار ہیں یا کسی حقدار کا حق مار رہے ہیں۔ یقین جانیے اگر آپ نے جانتے بوجھتے غلط طریقے سے جھوٹ بول کر یہ رقم / مدد ادارے سے وصول کی تو اس کا نقصان آپ کو یہ ہو سکتا ہے۔
                                </li>
                                <li style="text-align:justify; line-height:1.1; font-size:13px; margin-top:3px;">
                                    (مشاہدے کی بات ہے) کہ آپ کسی بھی تکلیف میں مبتلا ہو سکتے ہیں، بیماری، ایکسیڈنٹ، پریشانی، جھگڑے، مالی تنگی یا کوئی بھی ایسی آفت جس کا آپ تصور نہیں کر سکتے۔
                                </li>
                                <li style="text-align:justify; line-height:1.1; font-size:13px; margin-top:3px;">
                                    بلا کی طرح آپ پر نازل ہو سکتی ہے اور جس سے آپ بے سکون ہو جائیں گے (الامان والحفیظ)۔ اللہ عزوجل ہم سب کی مدد فرمائے، ہر مسلمان کی پریشانیاں دور کرے (آمین)۔ سیلانی ویلفیئر ان شاء اللہ عزوجل آپ کی خدمت عزت و تعظیم کے ساتھ کرنے کے لیے موجود ہے۔
                                </li>
                                <li style="text-align:justify; line-height:1.1; font-size:13px; margin-top:3px;">
                                    اللہ عزوجل سیلانی ویلفیئر کو بھی مستحقین تک ان کی امانتیں فوری طور پر پہنچانے کی توفیق عطا فرمائے۔ ادارے کے کچھ قوانین ہیں جو آپ کی بہتری کے لیے بنائے گئے ہیں، امید ہے کہ آپ ان پر عمل کریں گے اور ہمارے اسٹاف کے ساتھ تعاون کریں گے۔
                                </li>
                            </ul>
                        </div>

                        <!-- Job / Business Info -->
                        <h4 style="text-align: right; padding-right: 3px; margin: 6px 0 4px 0;">ملازمت کی تفصیلات / کاروباری معلومات</h4>
                        <table style="width: 100%; border-collapse: collapse;">
                            <tr>
                                <th colspan="3" style="text-align: right; padding: 5px 8px;">کمپنی کا نام:</th>
