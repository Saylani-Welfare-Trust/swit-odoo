<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="base_view_company_form_inherit_bn_profile_management" model="ir.ui.view">
        <field name="name">base.view.company.form.inherit.bn.profile.management</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="welfare_api_auth_endpoints" string="Welfare API Auth / Endpoints">
                    <group>
                        <group name="welfare_api_auth_endpoints_col_1" string="Auth">
                            <field name="welfare_url" />
                            <field name="odoo_auth_key" password="True" />
                        </group>
                        <group name="welfare_api_auth_endpoints_col_2" string="Endpoints">
                            <field name="create_application_endpoint" />
                            <field name="search_endpoint" />
                            <field name="check_donee_endpoint" />
                            <field name="create_donee_endpoint" />
                            <field name="mark_application_endpoint" />
                            <field name="update_donee_mapping_endpoint" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
