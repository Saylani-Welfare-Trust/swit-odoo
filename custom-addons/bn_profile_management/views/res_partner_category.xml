<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_partner_category_view_tree_profile" model="ir.ui.view">
        <field name="name">res.partner.category.view.tree.profile</field>
        <field name="model">res.partner.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="is_profile_type" widget="boolean_toggle"/>
                <field name="profile_page_ids" widget="many2many_tags" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="res_partner_category_view_form_profile" model="ir.ui.view">
        <field name="name">res.partner.category.view.form.profile</field>
        <field name="model">res.partner.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Donor"/></h1>
                    </div>
                    <group>
                        <field name="parent_id" options="{'no_create': True}"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <group>
                        <field name="is_profile_type"/>
                    </group>
                    <div invisible="not is_profile_type">
                        <separator string="What contacts tagged with this show"/>
                        <p class="text-muted">
                            A contact can carry more than one enabled tag; it shows the
                            union of everything each of its tags configures here.
                        </p>
                        <group>
                            <field name="profile_page_ids" widget="many2many_tags"
                                   placeholder="e.g. General Information, Donation..."/>
                        </group>
                        <separator string="Fields and their position"/>
                        <p class="text-muted">
                            Add the fields each view shows and drag the handle to set their position.
                            List: columns from left to right. Search: order of the search suggestions.
                            Form: General Information page, down the left column then down the right one.
                        </p>
                        <notebook>
                            <page string="List View" name="profile_list">
                                <field name="profile_list_line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="field_name"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Search View" name="profile_search">
                                <field name="profile_search_line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="field_name"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Form View" name="profile_form">
                                <field name="profile_form_line_ids" nolabel="1">
                                    <tree editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="field_id" options="{'no_create': True, 'no_open': True}"/>
                                        <field name="field_name"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                        <separator string="Unique Registration ID"/>
                        <p class="text-muted">
                            Contacts get one ID per tag when they are registered. Tokens:
                            <code>{YY}</code> / <code>{YYYY}</code> registration year,
                            <code>{BY}</code> birth year, <code>{BY-}</code> birth year + "-" for Individuals only,
                            <code>{SEQ}</code> next number, <code>{CHECK}</code> check digit.
                        </p>
                        <group>
                            <group>
                                <field name="registration_pattern" placeholder="e.g. WEL-{YYYY}-{SEQ}"/>
                                <field name="registration_padding" invisible="not registration_pattern"/>
                                <field name="registration_check_digit" invisible="not registration_pattern"/>
                            </group>
                            <group>
                                <field name="registration_example" invisible="not registration_pattern"/>
                                <field name="registration_sequence_id" readonly="1" invisible="not registration_pattern"/>
                            </group>
                        </group>
                        <group>
                            <field name="profile_menu_id" readonly="1"/>
                            <field name="profile_action_id" readonly="1"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_category_action_profile" model="ir.actions.act_window">
        <field name="name">Profile Types (Tags)</field>
        <field name="res_model">res.partner.category</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('res_partner_category_view_tree_profile')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('res_partner_category_view_form_profile')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Let's set up a profile type...
            </p>
            <p>
                Any contact tag can be turned into a dedicated Profile Management screen -
                enable it and pick which fields and pages it should show.
            </p>
        </field>
    </record>

    <menuitem
        id="profile_management_config_menu"
        name="Profile Management"
        parent="bn_master_setup.master_setup_menu"
        groups="bn_profile_management.profile_management_manager_group,bn_profile_management.profile_management_audit_group"
        sequence="1"/>

    <menuitem
        id="res_partner_category_menu_profile"
        name="Profile Types (Tags)"
        action="res_partner_category_action_profile"
        parent="profile_management_config_menu"
        sequence="0"/>

</odoo>
