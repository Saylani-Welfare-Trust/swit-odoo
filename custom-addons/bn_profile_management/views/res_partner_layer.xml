<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="profile_management_view_kanban" model="ir.ui.view">
        <field name="name">profile.management.view.kanban</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="id"/>
                <field name="color"/>
                <field name="display_name"/>
                <field name="title"/>
                <field name="email"/>
                <field name="parent_id"/>
                <field name="is_company"/>
                <field name="function"/>
                <field name="phone"/>
                <field name="street"/>
                <field name="street2"/>
                <field name="zip"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="mobile"/>
                <field name="state_id"/>
                <field name="category_id"/>
                <field name="avatar_128"/>
                <field name="type"/>
                <field name="active"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban">
                            <t t-if="!record.is_company.raw_value">
                                <t t-set="avatar_image" t-value="kanban_image('res.partner', 'avatar_128', record.id.raw_value)"/>
                                <div class="o_kanban_image_fill_left d-none d-md-block">
                                    <img t-attf-src="#{avatar_image}" t-att-alt="record.id.value"/>
                                    <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'avatar_128', record.parent_id.raw_value)"/>
                                </div>
                                <div class="o_kanban_image d-md-none d-block">
                                    <img t-attf-src="#{avatar_image}" t-att-alt="record.id.value"/>
                                    <img class="o_kanban_image_inner_pic" t-if="record.parent_id.raw_value" t-att-alt="record.parent_id.value" t-att-src="kanban_image('res.partner', 'avatar_128', record.parent_id.raw_value)"/>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="o_kanban_image_fill_left d-none d-md-block o_kanban_image_full">
                                    <img t-attf-src="#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}" role="img" t-att-alt="record.id.value"/>
                                </div>
                                <div class="o_kanban_image d-md-none d-block o_kanban_image_full">
                                    <img t-attf-src="#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}" role="img" t-att-alt="record.id.value"/>
                                </div>
                            </t>
                            <div class="ribbon ribbon-top-right" invisible="active">
                                <span class="text-bg-danger">Archived</span>
                            </div>
                            <div class="ribbon ribbon-top-right" invisible="state != 'reject'">
                                <span class="text-bg-danger">Rejected</span>
                            </div>
                            <div class="oe_kanban_details d-flex flex-column justify-content-between">
                                <div>
                                    <strong class="o_kanban_record_title oe_partner_heading"><field name="display_name"/></strong>
                                    <div class="o_kanban_tags_section oe_kanban_partner_categories">
                                        <span class="oe_kanban_list_many2many">
                                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        </span>
                                    </div>
                                    <ul>
                                        <li t-if="record.parent_id.raw_value and !record.function.raw_value"><field name="parent_id"/></li>
                                        <li t-elif="!record.parent_id.raw_value and record.function.raw_value"><field name="function"/></li>
                                        <li t-elif="record.parent_id.raw_value and record.function.raw_value"><field name="function"/> at <field name="parent_id"/></li>
                                        <li t-if="record.city.raw_value or record.country_id.raw_value">
                                            <t t-if="record.city.raw_value"><field name="city"/><t t-if="record.country_id.raw_value">, </t></t>
                                            <t t-if="record.country_id.raw_value"><field name="country_id"/></t>
                                        </li>
                                        <li t-if="record.email.raw_value" class="o_text_overflow"><field name="email"/></li>
                                    </ul>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left"/>
                                    <div class="oe_kanban_bottom_right"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="profile_management_view_search" model="ir.ui.view">
        <field name="name">profile.management.view.search</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="complete_name" string="Name"/>
                <field name="primary_registration_id" invisible="not context.get('show_search_primary_registration_id')"/>
                <field name="secondary_registration_id" invisible="not context.get('show_search_secondary_registration_id')"/>
                <field name="old_system_id" invisible="not context.get('show_search_old_system_id')"/>
                <field name="cnic_no" invisible="not context.get('show_search_cnic_no')"/>
                <field name="mobile" invisible="not context.get('show_search_mobile')"/>
                <field name="email" invisible="not context.get('show_search_email')"/>
                <field name="city" invisible="not context.get('show_search_city')"/>
                <field name="area" invisible="not context.get('show_search_area')"/>
                <field name="analytic_account_id" invisible="not context.get('show_search_analytic_account_id')"/>
                <field name="father_name" invisible="not context.get('show_search_father_name')"/>
                <field name="category_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Registered" name="filter_register" domain="[('state', '=', 'register')]"/>
                <filter string="Rejected" name="filter_reject" domain="[('state', '=', 'reject')]"/>
                <group string="Group By">
                    <filter string="Status" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Gender" name="group_gender" domain="[]" context="{'group_by': 'gender'}"/>
                    <filter string="City" name="group_city" domain="[]" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="profile_management_view_tree" model="ir.ui.view">
        <field name="name">profile.management.view.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <header>
                    <button string="Register" name="action_bulk_register_donee" type="object" class="oe_highlight"/>
                </header>

                <!-- complete_name and state are always shown; every other column is
                     opt-in per tag via the action's context (see res.partner.category
                     "List View Fields") so this one view serves every profile type. -->
                <field name="complete_name" />
                <field name="primary_registration_id" string="Primary ID" column_invisible="not context.get('show_list_primary_registration_id')" />
                <field name="secondary_registration_id" string="Secondary ID" column_invisible="not context.get('show_list_secondary_registration_id')" />
                <field name="old_system_id" column_invisible="not context.get('show_list_old_system_id')" />
                <field name="gender" column_invisible="not context.get('show_list_gender')" />
                <field name="martial_status" column_invisible="not context.get('show_list_martial_status')" />
                <field name="street" string="Address" column_invisible="not context.get('show_list_street')" />
                <field name="country_code_id" column_invisible="not context.get('show_list_country_code_id')" />
                <field name="mobile" widget="phone" column_invisible="not context.get('show_list_mobile')" />
                <field name="email" column_invisible="not context.get('show_list_email')" />
                <field name="cnic_no" column_invisible="not context.get('show_list_cnic_no')" />
                <field name="date_of_birth" column_invisible="not context.get('show_list_date_of_birth')" />
                <field name="age" column_invisible="not context.get('show_list_age')" />
                <field name="city" column_invisible="not context.get('show_list_city')" />
                <field name="analytic_account_id" string="Branch" column_invisible="not context.get('show_list_analytic_account_id')" />
                <field name="father_name" column_invisible="not context.get('show_list_father_name')" />
                <field name="area" column_invisible="not context.get('show_list_area')" />

                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'validate'" decoration-success="state == 'register'" decoration-danger="state == 'reject'" />
            </tree>
        </field>
    </record>

    <record id="profile_management_view_form" model="ir.ui.view">
        <field name="name">profile.management.view.form</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Print Info" name="action_print_info" type="object" />
                    <button string="Register" name="action_register" type="object" class="oe_highlight" invisible="state != 'draft'" />
                    <button string="Change Request" name="action_change_request" type="object" class="oe_highlight" invisible="state != 'register'" />
                    
                    <button string="Print Microfinance Application" name="action_print_microfinance_application" type="object" class="oe_highlight" invisible="state != 'register' or is_donor" />
               
                    <field name="state" widget="statusbar" statusbar_visible="draft, register"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'reject'"/>

                    <field name="avatar_128" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" required="not is_donor" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}" />
                    <div class="oe_title mb24">
                        <field name="is_company" invisible="1"/>
                        <field name="welfare_donee_required_fields" invisible="1" />
                        <field name="welfare_donee_female_required" invisible="1" />
                        <field name="is_change_request" invisible="1" />
                        <field name="donee_required_fields" invisible="1" />
                        <field name="is_donor" invisible="1"/>
                        <field name="profile_visible_form_field_names" invisible="1"/>
                        <field name="profile_visible_page_names" invisible="1"/>
                        <field name="commercial_partner_id" invisible="1"/>
                        <field name="active" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="country_code" invisible="1"/>
                        <h1>
                            <field id="individual" options="{'line_breaks': False}" widget="text" class="text-break" name="name" default_focus="1" placeholder="e.g. Brandom Freeman" readonly="state == 'register'" required="1"/>
                        </h1>
                    </div>

                    <group>
                        <group name="profile_management_col_1">
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="country_id" invisible="1"/>
                                <field name="street" placeholder="Street..." class="o_address_street" readonly="state == 'register'"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street" readonly="state == 'register'"/>
                                <field name="city" placeholder="City" class="o_address_city" required="donee_required_fields" readonly="state == 'register'"/>
                                <field name="state_id" readonly="state == 'register'" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'country_id': country_code_id, 'default_country_id': country_code_id, 'zip': zip}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip" readonly="state == 'register'"/>
                            </div>
                            <field name="category_id" readonly="state == 'register'" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" placeholder="e.g. &quot;Donor&quot;, &quot;Donee&quot;, &quot;Rider&quot;, ..."/>
                        </group>
                        <group name="profile_management_col_2">
                            <label for="mobile"/>
                            <div style="display: flex;">
                                <field options="{'no_create': True, 'no_edit': True, 'no_open': True}" style="width: 30% !important;" required="1" name="country_code_id" nolabel="1" readonly="state == 'register'" /> 
                                <field style="width: 70% !important;" name="mobile" required="1" nolabel="1" readonly="state == 'register'" />
                            </div>
                            <field name="email" widget="email" context="{'gravatar_image': True}" readonly="state == 'register'" />
                        </group>
                    </group>

                    <notebook>
                        <page name="general_info" string="General Information">
                            <group>
                                <group name="general_info_col_1">
                                    <field name="surname" readonly="state == 'register'"  invisible="',surname,' not in profile_visible_form_field_names"/>
                                    <field name="area" readonly="state == 'register'" options="{'no_create': True, 'no_edit': True}" required="(donee_required_fields) and ',area,' in profile_visible_form_field_names"  invisible="',area,' not in profile_visible_form_field_names"/>
                                    <field name="gender" required="(donee_required_fields) and ',gender,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',gender,' not in profile_visible_form_field_names"/>
                                    <field name="religion" readonly="state == 'register'"  invisible="',religion,' not in profile_visible_form_field_names"/>
                                    <field name="martial_status" readonly="state == 'register'"  invisible="',martial_status,' not in profile_visible_form_field_names"/>
                                    <field name="spouse_name" invisible="(martial_status == 'un_married') or ',spouse_name,' not in profile_visible_form_field_names" required="(donee_required_fields and martial_status == 'married') and ',spouse_name,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="has_cnic" readonly="state == 'register'"  invisible="',has_cnic,' not in profile_visible_form_field_names"/>
                                    <field name="cnic_no" invisible="(has_cnic == 'no') or ',cnic_no,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'yes') and ',cnic_no,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="cnic_expiration" invisible="(has_cnic == 'no') or ',cnic_expiration,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'yes') and ',cnic_expiration,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="cnic_front_image" filename="cnic_front" invisible="(has_cnic == 'no') or ',cnic_front_image,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'yes') and ',cnic_front_image,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="cnic_back_image" filename="cnic_back" invisible="(has_cnic == 'no') or ',cnic_back_image,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'yes') and ',cnic_back_image,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="head_cnic_no" invisible="(has_cnic == 'yes') or ',head_cnic_no,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'no') and ',head_cnic_no,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="member_cnic_no" invisible="(has_cnic == 'yes') or ',member_cnic_no,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'no') and ',member_cnic_no,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="reference_letter_file" filename="reference_letter" invisible="(has_cnic == 'yes') or ',reference_letter_file,' not in profile_visible_form_field_names" required="(donee_required_fields and has_cnic == 'no') and ',reference_letter_file,' in profile_visible_form_field_names" readonly="state == 'register'" />
                                    <field name="approved_form_file" filename="approved_form" readonly="not is_change_request" required="(is_change_request) and ',approved_form_file,' in profile_visible_form_field_names"  invisible="',approved_form_file,' not in profile_visible_form_field_names"/>
                                </group>
                                <group name="general_info_col_2">
                                    <field name="date_of_birth" required="(donee_required_fields) and ',date_of_birth,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',date_of_birth,' not in profile_visible_form_field_names"/>
                                    <field name="age"  invisible="',age,' not in profile_visible_form_field_names"/>
                                    <field name="father_name" required="(donee_required_fields) and ',father_name,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',father_name,' not in profile_visible_form_field_names"/>
                                    <field name="father_cnic_no" required="(welfare_donee_required_fields) and ',father_cnic_no,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',father_cnic_no,' not in profile_visible_form_field_names"/>
                                    <field name="next_kin" required="(welfare_donee_required_fields) and ',next_kin,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',next_kin,' not in profile_visible_form_field_names"/>
                                    <field name="nearest_land_mark" required="(donee_required_fields) and ',nearest_land_mark,' in profile_visible_form_field_names" readonly="state == 'register'"  invisible="',nearest_land_mark,' not in profile_visible_form_field_names"/>
                                    <field name="reference_remarks" readonly="state == 'register'"  invisible="',reference_remarks,' not in profile_visible_form_field_names"/>
                                    <field name="bank_wallet_account" readonly="state == 'register'"  invisible="',bank_wallet_account,' not in profile_visible_form_field_names"/>
                                    <field name="primary_registration_id" string="Primary ID" readonly="1"  invisible="',primary_registration_id,' not in profile_visible_form_field_names"/>
                                    <field name="secondary_registration_id" string="Secondary ID" readonly="1"  invisible="',secondary_registration_id,' not in profile_visible_form_field_names"/>
                                    <field name="old_system_id" readonly="state == 'register'"  invisible="',old_system_id,' not in profile_visible_form_field_names"/>
                                    <field name="details" readonly="state == 'register'"  invisible="',details,' not in profile_visible_form_field_names"/>
                                </group>
                            </group>
                        </page>
                        <page name="donation" string="Donation" invisible="',donation,' not in profile_visible_page_names">
                            <notebook>
                                <page name="pos" string="POS Details">
                                    
                                </page>
                                <page name="box" string="Box Details">
                                    
                                </page>
                                <page name="home_service" string="Home Service Details">
                                    
                                </page>
                                <page name="import" string="Import Details">
                                    
                                </page>
                                <page name="online" string="Online Details">
                                    
                                </page>
                                <page name="donation_in_kind" string="Donation In Kind">
                                    
                                </page>
                            </notebook>
                        </page>
                        <page name="welfare" string="Welfare Details" invisible="',welfare,' not in profile_visible_page_names">
                            
                        </page>
                        <page name="microfinance" string="Microfinance Details" invisible="',microfinance,' not in profile_visible_page_names">
                            
                        </page>
                        <page name="medical" string="Medical Equipment" invisible="',medical,' not in profile_visible_page_names">

                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="donee_profile_management_action" model="ir.actions.act_window">
        <field name="name">Donee Profile</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('category_id.name', 'in', ['Donee'])]</field>
        <field name="context" eval="{
            'default_category_id': [(6, 0, [
                ref('bn_profile_management.donee_partner_category'),
                ref('bn_profile_management.individual_partner_category')
            ])],
            'default_country_code_id': 177
        }"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Let's create a new donee....
            </p>
        </field>
        <field name="search_view_id" ref="bn_profile_management.profile_management_view_search"/>
        <field name="view_ids"
            eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'kanban', 'view_id': ref('bn_profile_management.profile_management_view_kanban')}),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('bn_profile_management.profile_management_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('bn_profile_management.profile_management_view_form')})]"/>
    </record>
    
    <record id="donor_profile_management_action" model="ir.actions.act_window">
        <field name="name">Donor Profile</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('category_id.name', 'in', ['Donor'])]</field>
        <field name="context" eval="{
            'default_category_id': [(6, 0, [
                ref('bn_profile_management.donor_partner_category'),
                ref('bn_profile_management.individual_partner_category')
            ])],
            'default_country_code_id': 177
        }"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Let's create a new donor....
            </p>
        </field>
        <field name="search_view_id" ref="bn_profile_management.profile_management_view_search"/>
        <field name="view_ids"
            eval="[(5, 0, 0),
                    (0, 0, {'view_mode': 'kanban', 'view_id': ref('bn_profile_management.profile_management_view_kanban')}),
                    (0, 0, {'view_mode': 'tree', 'view_id': ref('bn_profile_management.profile_management_view_tree')}),
                    (0, 0, {'view_mode': 'form', 'view_id': ref('bn_profile_management.profile_management_view_form')})]"/>
    </record>

    <menuitem
        id="profile_management_menu"
        name="Profile Management"
        web_icon="bn_profile_management,static/description/icon.png"
        groups="bn_profile_management.profile_management_root_group"
        sequence="6"/>
    
    <menuitem
        id="donor_profile_management_menu"
        name="Donor"
        action="donor_profile_management_action"
        parent="profile_management_menu"
        sequence="0"/>

    <menuitem
        id="donee_profile_management_menu"
        name="Donee"
        action="donee_profile_management_action"
        parent="profile_management_menu"
        sequence="1"/>

</odoo>
