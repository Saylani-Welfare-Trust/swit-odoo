<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Row-level scope restriction (can only edit Donor-tagged contacts) -
         a genuinely different kind of group from the CRUD tiers below, so
         it stays separate rather than being folded into them. -->
    <record id="profile_management_edit_donor_access_group" model="res.groups">
        <field name="name">Profile Management / Edit Donor</field>
    </record>

    <record id="profile_management_user_group" model="res.groups">
        <field name="name">Profile Management / User</field>
        <field name="comment">Day-to-day access: create, edit and read contacts. Cannot delete, and cannot change which fields/pages a profile type shows.</field>
    </record>

    <record id="profile_management_manager_group" model="res.groups">
        <field name="name">Profile Management / Manager</field>
        <field name="comment">Everything User can do, plus configuring profile types: Area, and which fields/pages each tag shows (Configuration menu).</field>
        <field name="implied_ids" eval="[(4, ref('profile_management_user_group'))]"/>
    </record>

    <record id="profile_management_audit_group" model="res.groups">
        <field name="name">Profile Management / Audit</field>
        <field name="comment">Read-only oversight of contacts and profile-type configuration, for reporting. No create, write or delete anywhere.</field>
    </record>

    <record id="profile_management_admin_group" model="res.groups">
        <field name="name">Profile Management / Admin</field>
        <field name="comment">Full control, including delete, plus everything Manager can configure.</field>
        <field name="implied_ids" eval="[
            (4, ref('profile_management_manager_group')),
            (4, ref('profile_management_audit_group'))]"/>
    </record>

</odoo>
