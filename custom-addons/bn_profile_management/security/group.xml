<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="profile_management_group" model="res.groups">
        <field name="name">Profile Management / Menu</field>
    </record>

    <record id="profile_management_create_access_group" model="res.groups">
        <field name="name">Profile Management / Create Access</field>
    </record>
    
    <record id="profile_management_write_access_group" model="res.groups">
        <field name="name">Profile Management / Update Access</field>
    </record>
    
    <record id="profile_management_read_access_group" model="res.groups">
        <field name="name">Profile Management / Read Access</field>
    </record>
    
    <record id="profile_management_delete_access_group" model="res.groups">
        <field name="name">Profile Management / Delete Access</field>
    </record>
    
    <record id="profile_management_edit_donor_access_group" model="res.groups">
        <field name="name">Profile Management / Edit Donor</field>
    </record>

    <!-- Record Search programmes (e.g. Sadqa e Jariya) give their users this group:
         see and create / update contacts from Record Search. -->
    <record id="profile_management_user_group" model="res.groups">
        <field name="name">Profile Management / User</field>
        <field name="implied_ids" eval="[(6, 0, [ref('bn_profile_management.profile_management_group'), ref('bn_profile_management.profile_management_create_access_group'), ref('bn_profile_management.profile_management_write_access_group'), ref('bn_profile_management.profile_management_read_access_group')])]"/>
    </record>

</odoo>
