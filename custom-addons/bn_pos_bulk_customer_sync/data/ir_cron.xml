<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_pos_bulk_customer_snapshot" model="ir.cron">
        <field name="name">POS Bulk Customer Sync: regenerate snapshot</field>
        <field name="model_id" ref="model_pos_bulk_customer_sync"/>
        <field name="state">code</field>
        <field name="code">model.generate_snapshot()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <!-- Run overnight, off peak hours, well before shops open -->
        <field name="nextcall" eval="(DateTime.now() + timedelta(hours=3)).strftime('%Y-%m-%d 02:00:00')"/>
        <field name="active">True</field>
    </record>
</odoo>
