<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="treasury_dashboard.Dashboard">
        <div class="pos-dash-v2 o_treasury_dashboard">
            
            <!-- ==================== HEADER ==================== -->
            <div class="oh-page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><i class="fa fa-bank me-2 text-primary"/>Treasury Dashboard</h2>
                    <p>Overview of cheques, deposits, and journal transfers</p>
                </div>
            </div>

            <!-- ==================== FILTER BAR ==================== -->
            <div class="card oh-filter-card mb-4">
                <div class="card-body p-3">
                    <!-- Row 1: Date & Location -->
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">To Date</label>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Province</label>
                            <select class="form-select" t-model="state.province_id" t-on-change="onchange_province">
                                <option value="">All Provinces</option>
                                <t t-foreach="state.provinces" t-as="province" t-key="province.id">
                                    <option t-att-value="province.id" t-esc="province.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">City</label>
                            <select class="form-select" t-model="state.city_id" t-on-change="onchange_city">
                                <option value="">All Cities</option>
                                <t t-foreach="filteredCities" t-as="city" t-key="city.id">
                                    <option t-att-value="city.id" t-esc="city.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Zone</label>
                            <select class="form-select" t-model="state.zone_id" t-on-change="onchange_zone">
                                <option value="">All Zones</option>
                                <t t-foreach="filteredZones" t-as="zone" t-key="zone.id">
                                    <option t-att-value="zone.id" t-esc="zone.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Branch</label>
                            <select class="form-select" t-model="state.branch_id" t-on-change="applyFilter">
                                <option value="">All Branches</option>
                                <t t-foreach="filteredBranches" t-as="branch" t-key="branch.id">
                                    <option t-att-value="branch.id" t-esc="branch.name"/>
                                </t>
                            </select>
                        </div>
                    </div>

                    <!-- Row 2: Segments & Amount -->
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L1</label>
                            <select class="form-select" t-model="state.segment_l1" t-on-change="onchange_segment_l1">
                                <option value="">All</option>
                                <t t-foreach="state.segments_l1" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L2</label>
                            <select class="form-select" t-model="state.segment_l2" t-on-change="onchange_segment_l2" t-att-disabled="!state.segment_l1">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL2" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L3</label>
                            <select class="form-select" t-model="state.segment_l3" t-on-change="onchange_segment_l3" t-att-disabled="!state.segment_l2">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL3" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L4</label>
                            <select class="form-select" t-model="state.segment_l4" t-on-change="applyFilter" t-att-disabled="!state.segment_l3">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL4" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Min Amount</label>
                            <input type="number" step="0.01" min="0" class="form-control" t-model="state.amount_min" t-on-change="applyFilter" placeholder="0.00"/>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Max Amount</label>
                            <input type="number" step="0.01" min="0" class="form-control" t-model="state.amount_max" t-on-change="applyFilter" placeholder="0.00"/>
                        </div>
                    </div>
                    
                    <!-- Row 3: Buttons -->
                    <div class="row">
                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-2">
                                <!-- NEW: Refresh Button -->
                                <button class="btn btn-sm btn-primary" t-on-click="refresh">
                                    <i class="fa fa-refresh me-1"/>Refresh
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="clearFilter">
                                    <i class="fa fa-times me-1"/>Clear Filters
                                </button>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('this_month')">This Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('last_month')">Last Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickFilter('this_year')">This Year</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== CARDS SECTION ==================== -->
            <div class="row g-3">
                
                <!-- 1. Cheques Card -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-money me-2 text-info"/>Cheques</h4>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-info text-white" t-on-click="() => this.createCustomModel('pos.cheque')">New</button>
                                <button class="btn btn-sm btn-outline-info" t-on-click="() => this.openCustomModel('pos.cheque')">View All</button>
                            </div>
                        </div>
                        <div class="oh-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                                <div>
                                    <div class="oh-kpi-label text-muted mb-1">Total Cheques</div>
                                    <div class="fw-bold fs-5 text-dark"><t t-esc="state.cheques.count"/></div>
                                </div>
                                <div class="text-end">
                                    <div class="oh-kpi-label text-muted mb-1">Total Amount</div>
                                    <div class="fw-bold fs-5 text-info"><t t-esc="formatCurrency(state.cheques.total_amount)"/></div>
                                </div>
                            </div>
                            
                            <div style="max-height: 250px; overflow-y: auto;">
                                <table class="table oh-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>State</th>
                                            <th class="text-center">Count</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.cheques.states" t-as="state_name" t-key="state_name">
                                            <tr>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill {{ getStateColor(state_name) }} px-3 py-2">
                                                        <t t-esc="formatStateName(state_name)"/>
                                                    </span>
                                                </td>
                                                <td class="text-center fw-semibold"><t t-esc="state.cheques.states[state_name]"/></td>
                                                <td class="text-end fw-semibold"><t t-esc="formatCurrency((state.cheques.state_amounts || {})[state_name] || 0)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!Object.keys(state.cheques.states).length">
                                            <tr>
                                                <td colspan="3" class="oh-empty">
                                                    <i class="fa fa-folder-open"/>
                                                    No Cheques found
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Bank Transfers / Direct Deposits Card -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-exchange me-2 text-warning"/>Bank Transfers / Deposits</h4>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-warning text-white" t-on-click="() => this.createCustomModel('direct.deposit')">New</button>
                                <button class="btn btn-sm btn-outline-warning" t-on-click="() => this.openCustomModel('direct.deposit')">View All</button>
                            </div>
                        </div>
                        <div class="oh-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                                <div>
                                    <div class="oh-kpi-label text-muted mb-1">Total Transfers</div>
                                    <div class="fw-bold fs-5 text-dark"><t t-esc="state.deposits.count"/></div>
                                </div>
                                <div class="text-end">
                                    <div class="oh-kpi-label text-muted mb-1">Total Amount</div>
                                    <div class="fw-bold fs-5 text-warning"><t t-esc="formatCurrency(state.deposits.total_amount)"/></div>
                                </div>
                            </div>
                            
                            <div style="max-height: 250px; overflow-y: auto;">
                                <table class="table oh-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>State</th>
                                            <th class="text-center">Count</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.deposits.states" t-as="state_name" t-key="state_name">
                                            <tr>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill {{ getStateColor(state_name) }} px-3 py-2">
                                                        <t t-esc="formatStateName(state_name)"/>
                                                    </span>
                                                </td>
                                                <td class="text-center fw-semibold"><t t-esc="state.deposits.states[state_name]"/></td>
                                                <td class="text-end fw-semibold"><t t-esc="formatCurrency((state.deposits.state_amounts || {})[state_name] || 0)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!Object.keys(state.deposits.states).length">
                                            <tr>
                                                <td colspan="3" class="oh-empty">
                                                    <i class="fa fa-folder-open"/>
                                                    No Deposits found
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 3. Journal Transfers Card -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-random me-2 text-success"/>Journal Transfers</h4>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-success" t-on-click="() => this.createCustomModel('journal.transfer')">New</button>
                                <button class="btn btn-sm btn-outline-success" t-on-click="() => this.openCustomModel('journal.transfer')">View All</button>
                            </div>
                        </div>
                        <div class="oh-card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3 p-3 bg-light rounded">
                                <div>
                                    <div class="oh-kpi-label text-muted mb-1">Total Transfers</div>
                                    <div class="fw-bold fs-5 text-dark"><t t-esc="state.transfers.count"/></div>
                                </div>
                                <div class="text-end">
                                    <div class="oh-kpi-label text-muted mb-1">Total Amount</div>
                                    <div class="fw-bold fs-5 text-success"><t t-esc="formatCurrency(state.transfers.total_amount)"/></div>
                                </div>
                            </div>
                            
                            <div style="max-height: 250px; overflow-y: auto;">
                                <table class="table oh-table mb-0">
                                    <thead>
                                        <tr>
                                            <th>State</th>
                                            <th class="text-center">Count</th>
                                            <th class="text-end">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.transfers.states" t-as="state_name" t-key="state_name">
                                            <tr>
                                                <td>
                                                    <span t-attf-class="badge rounded-pill {{ getStateColor(state_name) }} px-3 py-2">
                                                        <t t-esc="formatStateName(state_name)"/>
                                                    </span>
                                                </td>
                                                <td class="text-center fw-semibold"><t t-esc="state.transfers.states[state_name]"/></td>
                                                <td class="text-end fw-semibold"><t t-esc="formatCurrency((state.transfers.state_amounts || {})[state_name] || 0)"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!Object.keys(state.transfers.states).length">
                                            <tr>
                                                <td colspan="3" class="oh-empty">
                                                    <i class="fa fa-folder-open"/>
                                                    No Transfers found
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
                        <!-- ==================== COMPARISON SECTION ==================== -->
            <div class="row g-3 mt-3">
                <div class="col-lg-12">
                    <div class="card oh-section-card shadow-sm">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-balance-scale me-2 text-primary"/>Comparison Analysis</h4>
                        </div>
                        <div class="oh-card-body p-4 bg-light">

                            <!-- Controls -->
                            <div class="row g-3 align-items-end mb-4">
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Compare By</label>
                                    <select class="form-select" t-model="state.comparison_mode" t-on-change="onchange_comparison_mode">
                                        <option value="month">Month</option>
                                        <option value="year">Year</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">
                                        Period 1 <span class="text-muted fw-normal">(Base)</span>
                                    </label>
                                    <input t-if="state.comparison_mode === 'month'" type="month" class="form-control"
                                           t-model="state.comparison_period1" t-on-change="fetchComparison"/>
                                    <input t-if="state.comparison_mode === 'year'" type="number" min="2000" max="2100" class="form-control"
                                           t-model="state.comparison_period1" t-on-change="fetchComparison" placeholder="2024"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">
                                        Period 2 <span class="text-muted fw-normal">(Compare to)</span>
                                    </label>
                                    <input t-if="state.comparison_mode === 'month'" type="month" class="form-control"
                                           t-model="state.comparison_period2" t-on-change="fetchComparison"/>
                                    <input t-if="state.comparison_mode === 'year'" type="number" min="2000" max="2100" class="form-control"
                                           t-model="state.comparison_period2" t-on-change="fetchComparison" placeholder="2025"/>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary w-100" t-on-click="fetchComparison">
                                        <i class="fa fa-refresh me-1"/> Compare
                                    </button>
                                </div>
                            </div>

                            <!-- Results per model -->
                            <div class="row g-4">
                                <!-- Cheques -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center p-3">
                                            <h5 class="mb-3"><i class="fa fa-money me-2 text-info"/>Cheques</h5>
                                            <div class="d-flex justify-content-around mb-3">
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 1</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.cheques || {}).p1_sum || 0)"/>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 2</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.cheques || {}).p2_sum || 0)"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div t-attf-class="p-2 rounded {{ (state.comparison_result.cheques || {}).is_positive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">
                                                <span class="fw-bold fs-6">
                                                    <t t-esc="formatCurrency((state.comparison_result.cheques || {}).diff || 0)"/>
                                                </span>
                                                <span class="ms-2">
                                                    (<t t-esc="((state.comparison_result.cheques || {}).pct || 0).toFixed(1)"/>%)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Deposits -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center p-3">
                                            <h5 class="mb-3"><i class="fa fa-exchange me-2 text-warning"/>Deposits</h5>
                                            <div class="d-flex justify-content-around mb-3">
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 1</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.deposits || {}).p1_sum || 0)"/>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 2</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.deposits || {}).p2_sum || 0)"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div t-attf-class="p-2 rounded {{ (state.comparison_result.deposits || {}).is_positive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">
                                                <span class="fw-bold fs-6">
                                                    <t t-esc="formatCurrency((state.comparison_result.deposits || {}).diff || 0)"/>
                                                </span>
                                                <span class="ms-2">
                                                    (<t t-esc="((state.comparison_result.deposits || {}).pct || 0).toFixed(1)"/>%)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Transfers -->
                                <div class="col-md-4">
                                    <div class="card border-0 shadow-sm h-100">
                                        <div class="card-body text-center p-3">
                                            <h5 class="mb-3"><i class="fa fa-random me-2 text-success"/>Transfers</h5>
                                            <div class="d-flex justify-content-around mb-3">
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 1</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.transfers || {}).p1_sum || 0)"/>
                                                    </div>
                                                </div>
                                                <div>
                                                    <div class="small text-muted fw-bold">PERIOD 2</div>
                                                    <div class="fs-5 fw-bold text-primary">
                                                        <t t-esc="formatCurrency((state.comparison_result.transfers || {}).p2_sum || 0)"/>
                                                    </div>
                                                </div>
                                            </div>
                                            <div t-attf-class="p-2 rounded {{ (state.comparison_result.transfers || {}).is_positive ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger' }}">
                                                <span class="fw-bold fs-6">
                                                    <t t-esc="formatCurrency((state.comparison_result.transfers || {}).diff || 0)"/>
                                                </span>
                                                <span class="ms-2">
                                                    (<t t-esc="((state.comparison_result.transfers || {}).pct || 0).toFixed(1)"/>%)
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>