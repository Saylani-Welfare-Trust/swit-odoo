<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="bn_livestock_slaugther.LivestockDashboardTemplate">
        <style>
            @media print {
                .o_livestock_dashboard { background: #fff !important; }
                .d-print-none { display: none !important; }
                .card { break-inside: avoid; }
            }
            .o_livestock_dashboard .o_ls_kpi { transition: transform .15s ease; }
            .o_livestock_dashboard .o_ls_kpi:hover { transform: translateY(-2px); }
            .o_livestock_dashboard .cursor-pointer { cursor: pointer; }
        </style>

        <div class="o_livestock_dashboard w-100 h-100 p-4"
             style="background-color: #f8f9fa; overflow-y: auto;">

            <!-- header -->
            <div class="d-flex justify-content-between align-items-center mb-3 d-print-none">
                <h2 class="m-0">Livestock Dashboard</h2>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="refresh">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" t-on-click="print">
                        <i class="fa fa-print"/> Print
                    </button>
                </div>
            </div>

            <!-- filters -->
            <div class="card shadow-sm border-0 mb-4 d-print-none">
                <div class="card-body py-2">
                    <!-- Row 1: Dates -->
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-2 pb-2 border-bottom">
                        <div class="btn-group btn-group-sm">
                            <button t-attf-class="btn #{state.active_preset === 'this_month' ? 'btn-primary' : 'btn-outline-primary'}"
                                    data-preset="this_month" t-on-click="applyPreset">This Month</button>
                            <button t-attf-class="btn #{state.active_preset === 'last_month' ? 'btn-primary' : 'btn-outline-primary'}"
                                    data-preset="last_month" t-on-click="applyPreset">Last Month</button>
                            <button t-attf-class="btn #{state.active_preset === 'this_quarter' ? 'btn-primary' : 'btn-outline-primary'}"
                                    data-preset="this_quarter" t-on-click="applyPreset">This Quarter</button>
                            <button t-attf-class="btn #{state.active_preset === 'ytd' ? 'btn-primary' : 'btn-outline-primary'}"
                                    data-preset="ytd" t-on-click="applyPreset">YTD</button>
                            <button t-attf-class="btn #{state.active_preset === 'all_time' ? 'btn-primary' : 'btn-outline-primary'}"
                                    data-preset="all_time" t-on-click="applyPreset">All Time</button>
                        </div>

                        <div class="ms-auto d-flex gap-2 align-items-center">
                            <label class="fw-bold m-0 small">From:</label>
                            <input type="date" class="form-control form-control-sm"
                                   name="date_from" t-model="state.date_from" t-on-change="applyFilter"/>
                            <label class="fw-bold m-0 small">To:</label>
                            <input type="date" class="form-control form-control-sm"
                                   name="date_to" t-model="state.date_to" t-on-change="applyFilter"/>
                        </div>
                    </div>

                    <!-- Row 2: Location and Department Filters -->
                    <div class="d-flex flex-wrap gap-2 align-items-center">
                        <label class="fw-bold m-0 small">Dept:</label>
                        <select class="form-select form-select-sm" style="width: auto;" name="department"
                                t-model="state.department" t-on-change="applyFilter">
                            <option value="">All</option>
                            <option value="meat">Meat</option>
                            <option value="goat">Goat</option>
                            <option value="chicken">Chicken</option>
                        </select>

                        <label class="fw-bold m-0 small ms-2">Province:</label>
                        <select class="form-select form-select-sm" style="width: auto;" name="province_id"
                                t-model="state.province_id" t-on-change="onchange_province">
                            <option value="">All</option>
                            <t t-foreach="state.provinces" t-as="p" t-key="p.id">
                                <option t-att-value="p.id" t-esc="p.name"/>
                            </t>
                        </select>

                        <label class="fw-bold m-0 small ms-2">City:</label>
                        <select class="form-select form-select-sm" style="width: auto;" name="city_id"
                                t-model="state.city_id" t-on-change="onchange_city">
                            <option value="">All</option>
                            <t t-foreach="filteredCities" t-as="c" t-key="c.id">
                                <option t-att-value="c.id" t-esc="c.name"/>
                            </t>
                        </select>

                        <label class="fw-bold m-0 small ms-2">Zone:</label>
                        <select class="form-select form-select-sm" style="width: auto;" name="zone_id"
                                t-model="state.zone_id" t-on-change="onchange_zone">
                            <option value="">All</option>
                            <t t-foreach="filteredZones" t-as="z" t-key="z.id">
                                <option t-att-value="z.id" t-esc="z.name"/>
                            </t>
                        </select>

                        <!-- Segments -->
                        <label class="fw-bold m-0 small ms-2">Segment L1:</label>
                        <select class="form-select form-select-sm" style="width: auto;" name="segment_l1"
                                t-model="state.segment_l1" t-on-change="onchange_segment_l1">
                            <option value="">All</option>
                            <t t-foreach="state.segments_l1" t-as="s" t-key="s.id">
                                <option t-att-value="s.id" t-esc="s.name"/>
                            </t>
                        </select>
                        
                        <t t-if="state.segment_l1">
                            <label class="fw-bold m-0 small ms-2">L2:</label>
                            <select class="form-select form-select-sm" style="width: auto;" name="segment_l2"
                                    t-model="state.segment_l2" t-on-change="onchange_segment_l2">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL2" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </t>
                        
                        <t t-if="state.segment_l2">
                            <label class="fw-bold m-0 small ms-2">L3:</label>
                            <select class="form-select form-select-sm" style="width: auto;" name="segment_l3"
                                    t-model="state.segment_l3" t-on-change="onchange_segment_l3">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL3" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </t>
                        
                        <t t-if="state.segment_l3">
                            <label class="fw-bold m-0 small ms-2">L4:</label>
                            <select class="form-select form-select-sm" style="width: auto;" name="segment_l4"
                                    t-model="state.segment_l4" t-on-change="applyFilter">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL4" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </t>
                    </div>
                </div>
            </div>

            <!-- loading -->
            <div t-if="state.loading" class="text-center mt-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2">Loading livestock data...</p>
            </div>

            <!-- content -->
            <t t-elif="state.data">
                
                <!-- KPI cards (Dynamic loop for each state) -->
                <div class="row g-3 mb-4">
                    <t t-foreach="state.data.state_chart" t-as="s" t-key="s.key">
                        <div class="col" style="min-width: 180px; flex: 1;">
                            <div class="card shadow-sm border-0 border-start border-4 o_ls_kpi h-100 cursor-pointer"
                                 t-attf-style="border-left-color: #{s.color} !important;"
                                 t-on-click="() => this.openStateList(s.key)">
                                <div class="card-body p-3">
                                    <h6 class="text-muted text-uppercase small mb-2" t-esc="s.label"/>
                                    <h3 class="m-0 fw-bold" t-attf-style="color: #{s.color};">
                                        <t t-esc="s.count"/>
                                    </h3>
                                    <small class="text-muted mt-1 d-block" style="font-size: 0.75rem;">
                                        Click to view list <i class="fa fa-arrow-right ms-1"/>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- trend + department -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Throughput (last 12 months)</div>
                            <div class="card-body" style="position: relative; height: 320px;">
                                <canvas t-ref="trendChart"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Department Split</div>
                            <div class="card-body" style="position: relative; height: 320px;">
                                <canvas t-ref="deptChart"/>
                                <div t-if="state.data.kpis.total === 0" class="text-center text-muted mt-5">
                                    No data for this range.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- state pipeline + source -->
                <div class="row g-3 mb-4">
                    <div class="col-lg-7">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Pipeline by State</div>
                            <div class="card-body" style="position: relative; height: 300px;">
                                <canvas t-ref="stateChart"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Source Breakdown</div>
                            <div class="card-body" style="position: relative; height: 300px;">
                                <canvas t-ref="sourceChart"/>
                                <div t-if="state.data.kpis.total === 0" class="text-center text-muted mt-5">
                                    No source data.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- pending actions -->
                <div class="row g-3 mb-4">
                    <div class="col-12">
                        <div class="card shadow-sm border-0">
                            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                                <span class="fw-bold">Needs Action</span>
                                <span class="text-muted small">
                                    <t t-esc="state.data.pending_list.length"/> item(s)
                                </span>
                            </div>
                            <div class="card-body p-0">
                                <div t-if="!state.data.pending_list.length" class="text-center text-muted p-4">
                                    Nothing waiting for action.
                                </div>
                                <table t-else="" class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Product</th>
                                            <th>Donee</th>
                                            <th>Department</th>
                                            <th>State</th>
                                            <th>Next Action</th>
                                            <th class="text-end">Price</th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.pending_list" t-as="item" t-key="item.id">
                                            <td class="fw-bold"><t t-esc="item.name"/></td>
                                            <td><t t-esc="item.product"/></td>
                                            <td><t t-esc="item.donee"/></td>
                                            <td>
                                                <span t-attf-class="badge #{deptBadgeClass(item.department)}">
                                                    <t t-esc="item.department"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span t-attf-class="badge #{stateBadgeClass(item.state_key)}">
                                                    <t t-esc="item.state"/>
                                                </span>
                                            </td>
                                            <td><t t-esc="item.next_action"/></td>
                                            <td class="text-end">Rs <t t-esc="formatCurrency(item.price)"/></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary"
                                                        t-on-click="() => this.openRecord(item.id)">
                                                    Open
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- recent slaughters + top donees -->
                <div class="row g-3">
                    <div class="col-lg-8">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Recent Slaughters</div>
                            <div class="card-body p-0">
                                <div t-if="!state.data.recent.length" class="text-center text-muted p-4">
                                    No records in this period.
                                </div>
                                <table t-else="" class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Date</th>
                                            <th>Name</th>
                                            <th>Product</th>
                                            <th>Donee</th>
                                            <th>Dept</th>
                                            <th>State</th>
                                            <th class="text-end">Price</th>
                                            <th/>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.data.recent" t-as="item" t-key="item.id">
                                            <td class="text-muted small"><t t-esc="item.date"/></td>
                                            <td class="fw-bold"><t t-esc="item.name"/></td>
                                            <td><t t-esc="item.product"/></td>
                                            <td><t t-esc="item.donee"/></td>
                                            <td>
                                                <span t-attf-class="badge #{deptBadgeClass(item.department)}">
                                                    <t t-esc="item.department"/>
                                                </span>
                                            </td>
                                            <td>
                                                <span t-attf-class="badge #{stateBadgeClass(item.state_key)}">
                                                    <t t-esc="item.state"/>
                                                </span>
                                            </td>
                                            <td class="text-end">Rs <t t-esc="formatCurrency(item.price)"/></td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-primary"
                                                        t-on-click="() => this.openRecord(item.id)">
                                                    Open
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-white fw-bold">Top Donees</div>
                            <div class="card-body p-0">
                                <div t-if="!state.data.top_donees.length" class="text-center text-muted p-4">
                                    No donees in this period.
                                </div>
                                <ul t-else="" class="list-group list-group-flush">
                                    <li t-foreach="state.data.top_donees" t-as="d" t-key="d.name"
                                        class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold"><t t-esc="d.name"/></div>
                                            <small class="text-muted">
                                                Rs <t t-esc="formatCurrency(d.value)"/>
                                            </small>
                                        </div>
                                        <span class="badge text-bg-primary"><t t-esc="d.count"/></span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>