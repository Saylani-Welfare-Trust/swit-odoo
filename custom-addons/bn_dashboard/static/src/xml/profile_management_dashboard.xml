<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ProfileManagementDashboard">
        <div class="pos-dash-v2">

            <!-- ==================== HEADER ==================== -->
            <div class="oh-page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><i class="fa fa-users me-2 text-primary"/>Profile Management Dashboard</h2>
                    <p>Overview of Donors, Donees, and Registrations</p>
                </div>
            </div>

            <!-- Filters -->
            <div class="card oh-filter-card mb-4 shadow-sm bg-white">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-xl-3 col-lg-3 col-md-4">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-4">
                            <label class="form-label">To Date</label>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-4 d-flex justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="clearFilter">
                                <i class="fa fa-times me-1"/>Clear
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="applyFilter">
                                <i class="fa fa-refresh me-1"/>Refresh
                            </button>
                            <div class="d-flex gap-1 ms-2">
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_month')">This Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('last_month')">Last Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_year')">This Year</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== KPI TILES ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-success text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'register']])">
                        <i class="fa fa-check-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Registered</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.registered"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-warning text-dark p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'draft']])">
                        <i class="fa fa-edit mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Drafts</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.draft"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-danger text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'reject']])">
                        <i class="fa fa-times-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Rejected</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.rejected"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-primary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Donor']])">
                        <i class="fa fa-heart mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Donors</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.donors"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-info text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Donee']])">
                        <i class="fa fa-hands-helping mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Donees</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.donees"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-secondary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Individual']])">
                        <i class="fa fa-user mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Individuals</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.individuals"/></div>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-bar-chart me-2 text-primary"/>Registrations by Month</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 300px;">
                                <canvas id="pm_chart_regs"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-pie-chart me-2 text-primary"/>Partners by Category</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 300px;">
                                <canvas id="pm_chart_cats"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== DONOR DETAILS TABS ==================== -->
            <div class="row g-3 mt-2">
                <div class="col-lg-12">
                    <div class="card oh-section-card shadow-sm bg-white border-top border-4 border-primary">
                        <div class="card-header bg-light border-bottom p-2">
                            <h5 class="mb-0 text-primary fw-bold"><i class="fa fa-heart me-2"/>Donor Details</h5>
                        </div>
                        <div class="card-header bg-white border-bottom p-0">
                            <ul class="nav nav-tabs border-0 flex-nowrap overflow-auto" style="white-space: nowrap;">
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'pos' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('pos')">POS Details</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'boxes' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('boxes')">Box Details</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'home' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('home')">Home Service Details</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'import' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('import')">Import Details</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'online' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('online')">Online Details</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'in_kind' ? 'active border-bottom border-primary border-3 text-primary' : 'text-muted' }}" t-on-click="() => this.setTab('in_kind')">Donation In Kind</button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <!-- 1. POS Details Tab -->
                            <t t-if="state.active_tab === 'pos'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.pos_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.pos_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 2. Box Details Tab -->
                            <t t-if="state.active_tab === 'boxes'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.box_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.box_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 3. Home Service Details Tab -->
                            <t t-if="state.active_tab === 'home'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.home_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.home_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 4. Import Details Tab -->
                            <t t-if="state.active_tab === 'import'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.import_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.import_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 5. Online Details Tab -->
                            <t t-if="state.active_tab === 'online'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.online_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.online_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 6. Donation In Kind Tab -->
                            <t t-if="state.active_tab === 'in_kind'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donor</th><th class="text-end">Transactions</th><th class="text-end">Total Estimated Value</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.in_kind_top_donors" t-as="donor" t-key="donor_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donor_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donor.name"/></td>
                                                <td class="text-end"><t t-esc="donor.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donor.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.in_kind_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== DONEE DETAILS TABS ==================== -->
            <div class="row g-3 mt-3">
                <div class="col-lg-12">
                    <div class="card oh-section-card shadow-sm bg-white border-top border-4 border-info">
                        <div class="card-header bg-light border-bottom p-2">
                            <h5 class="mb-0 text-info fw-bold"><i class="fa fa-hands-helping me-2"/>Donee Details</h5>
                        </div>
                        <div class="card-header bg-white border-bottom p-0">
                            <ul class="nav nav-tabs border-0 flex-nowrap overflow-auto" style="white-space: nowrap;">
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'welfare' ? 'active border-bottom border-info border-3 text-info' : 'text-muted' }}" t-on-click="() => this.setTab('welfare')">Welfare</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'microfinance' ? 'active border-bottom border-info border-3 text-info' : 'text-muted' }}" t-on-click="() => this.setTab('microfinance')">Microfinance</button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link py-3 px-4 fw-bold" t-attf-class="nav-link py-3 px-4 fw-bold {{ state.active_tab === 'medical' ? 'active border-bottom border-info border-3 text-info' : 'text-muted' }}" t-on-click="() => this.setTab('medical')">Medical Equipment</button>
                                </li>
                            </ul>
                        </div>

                        <div class="card-body p-0" style="max-height: 400px; overflow-y: auto;">
                            <!-- 7. Welfare Tab -->
                            <t t-if="state.active_tab === 'welfare'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donee</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.welfare_top_donees" t-as="donee" t-key="donee_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donee_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donee.name"/></td>
                                                <td class="text-end"><t t-esc="donee.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donee.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.welfare_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 8. Microfinance Tab -->
                            <t t-if="state.active_tab === 'microfinance'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donee</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.microfinance_top_donees" t-as="donee" t-key="donee_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donee_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donee.name"/></td>
                                                <td class="text-end"><t t-esc="donee.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donee.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.microfinance_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>

                            <!-- 9. Medical Equipment Tab -->
                            <t t-if="state.active_tab === 'medical'">
                                <table class="table table-hover oh-table mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width: 50px;">#</th><th>Donee</th><th class="text-end">Transactions</th><th class="text-end">Total Amount</th></tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.medical_top_donees" t-as="donee" t-key="donee_index">
                                            <tr>
                                                <td class="text-muted"><t t-esc="donee_index + 1"/></td>
                                                <td class="fw-bold"><t t-esc="donee.name"/></td>
                                                <td class="text-end"><t t-esc="donee.count"/></td>
                                                <td class="text-end fw-bold text-success"><t t-esc="(donee.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td>
                                            </tr>
                                        </t>
                                        <t t-if="!state.medical_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-4">No records found</td></tr></t>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>