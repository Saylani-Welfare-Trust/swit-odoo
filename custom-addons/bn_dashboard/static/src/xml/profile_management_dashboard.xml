<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ProfileManagementDashboard">
        <div class="pos-dash-v2">

            <!-- ==================== HEADER & FILTERS ==================== -->
            <div class="oh-page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><i class="fa fa-users me-2 text-primary"/>Profile Management Dashboard</h2>
                    <p>Overview of Donors, Donees, and Registrations</p>
                </div>
            </div>

            <div class="card oh-filter-card mb-4 shadow-sm bg-white">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end">
                        <div class="col-xl-3 col-lg-3 col-md-4">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-3 col-lg-3 col-md-4">
                            <label class="form-label">To Date</label>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-6 col-lg-6 col-md-4 d-flex justify-content-end gap-2">
                            <button class="btn btn-sm btn-outline-secondary" t-on-click="clearFilter">
                                <i class="fa fa-times me-1"/>Clear
                            </button>
                            <button class="btn btn-sm btn-primary" t-on-click="applyFilter">
                                <i class="fa fa-refresh me-1"/>Refresh
                            </button>
                            <div class="d-flex gap-1 ms-2">
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_month')">This Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('last_month')">Last Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_year')">This Year</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== KPI TILES & CHARTS ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-success text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'register']])">
                        <i class="fa fa-check-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Registered</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.registered"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-warning text-dark p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'draft']])">
                        <i class="fa fa-edit mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Drafts</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.draft"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-danger text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['state', '=', 'reject']])">
                        <i class="fa fa-times-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Rejected</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.rejected"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-primary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Donor']])">
                        <i class="fa fa-heart mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Donors</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.donors"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-info text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Donee']])">
                        <i class="fa fa-hands-helping mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Donees</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.donees"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-4 col-xl-2">
                    <div class="oh-kpi-card bg-secondary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('res.partner', [['category_id.name', 'ilike', 'Individual']])">
                        <i class="fa fa-user mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Individuals</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.individuals"/></div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-bar-chart me-2 text-primary"/>Registrations by Month</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 250px;">
                                <canvas id="pm_chart_regs"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-pie-chart me-2 text-primary"/>Partners by Category</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 250px;">
                                <canvas id="pm_chart_cats"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== DONOR DETAILS ==================== -->
            <div class="row mb-2">
                <div class="col-12">
                    <h3 class="text-primary fw-bold border-bottom pb-2"><i class="fa fa-heart me-2"/>Donor Details</h3>
                </div>
            </div>
            
            <div class="row g-3 mb-4">
                <!-- POS -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-shopping-cart me-2 text-primary"/>POS Donations</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.pos_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.pos_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Box -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-inbox me-2 text-primary"/>Box Donations</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.box_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.box_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Home Service -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-home me-2 text-primary"/>Home Service</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.home_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.home_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Import -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-upload me-2 text-primary"/>Import Details</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.import_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.import_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Online -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-globe me-2 text-primary"/>Online Details</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.online_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.online_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- In Kind -->
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-gift me-2 text-primary"/>Donation In Kind</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donor</th><th class="text-end">Qty</th><th class="text-end">Est. Value</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.in_kind_top_donors" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.in_kind_top_donors.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== DONEE DETAILS ==================== -->
            <div class="row mb-2 mt-4">
                <div class="col-12">
                    <h3 class="text-info fw-bold border-bottom pb-2"><i class="fa fa-hands-helping me-2"/>Donee Details</h3>
                </div>
            </div>
            
            <div class="row g-3">
                <!-- Welfare -->
                <div class="col-lg-4">
                    <div class="card oh-section-card shadow-sm bg-white h-100 border-top border-4 border-warning">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-hand-holding-heart me-2 text-warning"/>Welfare</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donee</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.welfare_top_donees" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.welfare_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Microfinance -->
                <div class="col-lg-4">
                    <div class="card oh-section-card shadow-sm bg-white h-100 border-top border-4 border-success">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-money me-2 text-success"/>Microfinance</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donee</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.microfinance_top_donees" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.microfinance_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Medical -->
                <div class="col-lg-4">
                    <div class="card oh-section-card shadow-sm bg-white h-100 border-top border-4 border-danger">
                        <div class="oh-card-header border-bottom pb-2 mb-0 bg-light rounded-top">
                            <h5 class="mb-0 fw-bold text-dark"><i class="fa fa-medkit me-2 text-danger"/>Medical Equipment</h5>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light"><tr><th>#</th><th>Donee</th><th class="text-end">Qty</th><th class="text-end">Amount</th></tr></thead>
                                <tbody>
                                    <t t-foreach="state.medical_top_donees" t-as="d" t-key="d_index">
                                        <tr><td class="text-muted"><t t-esc="d_index + 1"/></td><td class="fw-bold"><t t-esc="d.name"/></td><td class="text-end"><t t-esc="d.count"/></td><td class="text-end fw-bold text-success"><t t-esc="(d.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})"/></td></tr>
                                    </t>
                                    <t t-if="!state.medical_top_donees.length"><tr><td colspan="4" class="text-center text-muted py-3">No data</td></tr></t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>