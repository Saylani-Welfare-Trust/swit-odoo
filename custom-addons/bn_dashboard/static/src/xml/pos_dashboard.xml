<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PosDashboard">
        <div class="pos-dash-v2">

            <!-- ==================== HEADER ==================== -->
            <div class="oh-page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><i class="fa fa-bar-chart me-2 text-primary"/>POS Order Dashboard</h2>
                    <p>Overview of point of sale performance</p>
                </div>
            </div>

            <!-- ==================== FILTER BAR ==================== -->
            <div class="card oh-filter-card mb-4">
                <div class="card-body p-3">
                    
                    <!-- Row 1: Basic Filters & Location & Shop -->
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="onchange_filter"/>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">To Date</label>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="onchange_filter"/>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Province</label>
                            <select class="form-select" t-model="state.province_id" t-on-change="onchange_province">
                                <option value="">All Provinces</option>
                                <t t-foreach="state.provinces" t-as="province" t-key="province.id">
                                    <option t-att-value="province.id" t-esc="province.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">City</label>
                            <select class="form-select" t-model="state.city_id" t-on-change="onchange_city">
                                <option value="">All Cities</option>
                                <t t-foreach="filteredCities" t-as="city" t-key="city.id">
                                    <option t-att-value="city.id" t-esc="city.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Zone</label>
                            <select class="form-select" t-model="state.zone_id" t-on-change="onchange_zone">
                                <option value="">All Zones</option>
                                <t t-foreach="filteredZones" t-as="zone" t-key="zone.id">
                                    <option t-att-value="zone.id" t-esc="zone.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Shop</label>
                            <select class="form-select" t-model="state.config_id" t-on-change="onchange_filter">
                                <option value="">All Shops</option>
                                <t t-foreach="filteredShops" t-as="shop" t-key="shop.id">
                                    <option t-att-value="shop.id" t-esc="shop.name"/>
                                </t>
                            </select>
                        </div>
                    </div>

                    <!-- Row 2: Segments, Category & Amount -->
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment Type</label>
                            <select class="form-select" t-model="state.segment_type" t-on-change="onchange_filter">
                                <option value="">All Types</option>
                                <option value="N">Nafila (N)</option>
                                <option value="W">Wajiba (W)</option>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L1</label>
                            <select class="form-select" t-model="state.segment_l1" t-on-change="onchange_segment_l1">
                                <option value="">All</option>
                                <t t-foreach="state.segments_l1" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L2</label>
                            <select class="form-select" t-model="state.segment_l2" t-on-change="onchange_segment_l2" t-att-disabled="!state.segment_l1">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL2" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L3</label>
                            <select class="form-select" t-model="state.segment_l3" t-on-change="onchange_segment_l3" t-att-disabled="!state.segment_l2">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL3" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Segment L4</label>
                            <select class="form-select" t-model="state.segment_l4" t-on-change="onchange_filter" t-att-disabled="!state.segment_l3">
                                <option value="">All</option>
                                <t t-foreach="filteredSegmentsL4" t-as="s" t-key="s.id">
                                    <option t-att-value="s.id" t-esc="s.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-3 col-md-4">
                            <label class="form-label">Product Category</label>
                            <select class="form-select" t-model="state.category_id" t-on-change="onchange_filter">
                                <option value="">All Categories</option>
                                <t t-foreach="state.categories" t-as="cat" t-key="cat.id">
                                    <option t-att-value="cat.id" t-esc="cat.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-1 col-lg-1 col-md-2">
                            <label class="form-label">Min Amt</label>
                            <input type="number" step="0.01" min="0" class="form-control" t-model="state.amount_min" t-on-change="onchange_filter" placeholder="0"/>
                        </div>
                        <div class="col-xl-1 col-lg-1 col-md-2">
                            <label class="form-label">Max Amt</label>
                            <input type="number" step="0.01" min="0" class="form-control" t-model="state.amount_max" t-on-change="onchange_filter" placeholder="0"/>
                        </div>
                    </div>

                    <!-- Row 3: Buttons -->
                    <div class="row">
                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="clear_filter">
                                    <i class="fa fa-times me-1"/>Clear Filters
                                </button>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="oh-quick-btn" t-on-click="() => this.set_quick_date('today')">Today</button>
                                <button class="oh-quick-btn" t-on-click="() => this.set_quick_date('this_month')">This Month</button>
                                <button class="oh-quick-btn" t-on-click="() => this.set_quick_date('last_month')">Last Month</button>
                                <button class="oh-quick-btn" t-on-click="() => this.set_quick_date('this_year')">This Year</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== KPI TILES ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-blue" t-on-click="pos_order_today">
                        <i class="fa fa-calendar-check-o oh-kpi-icon"/>
                        <div class="oh-kpi-label">Today Orders</div>
                        <div class="oh-kpi-value"><t t-esc="state.today_sale"/></div>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-purple" t-on-click="pos_order">
                        <i class="fa fa-shopping-bag oh-kpi-icon"/>
                        <div class="oh-kpi-label">Total Orders</div>
                        <div class="oh-kpi-value"><t t-esc="state.total_order_count"/></div>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-green" t-on-click="pos_order">
                        <i class="fa fa-money oh-kpi-icon"/>
                        <div class="oh-kpi-label">Total Sales</div>
                        <div class="oh-kpi-value"><t t-esc="state.total_sale"/></div>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-orange" t-on-click="pos_session">
                        <i class="fa fa-signal oh-kpi-icon"/>
                        <div class="oh-kpi-label">Sessions</div>
                        <div class="oh-kpi-value"><t t-esc="state.total_session"/></div>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-amber" t-on-click="pos_refund_orders">
                        <i class="fa fa-minus-circle oh-kpi-icon"/>
                        <div class="oh-kpi-label">Total Refunds</div>
                        <div class="oh-kpi-value"><t t-esc="state.total_refund_count"/></div>
                    </div>
                </div>
                <div class="col-md-4 col-lg-2">
                    <div class="oh-kpi-card oh-kpi-red" t-on-click="pos_refund_today_orders">
                        <i class="fa fa-undo oh-kpi-icon"/>
                        <div class="oh-kpi-label">Today Refunds</div>
                        <div class="oh-kpi-value"><t t-esc="state.today_refund_total"/></div>
                    </div>
                </div>
            </div>

            <!-- ==================== CHART ROW 1 ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-line-chart me-2 text-primary"/>Sales Report</h4>
                            <select class="form-select form-select-sm"
                                    style="width:auto;"
                                    id="pos_sales"
                                    t-on-change="onclick_pos_sales">
                                <option value="pos_hourly_sales">Hourly</option>
                                <option value="pos_monthly_sales">Monthly</option>
                                <option value="pos_year_sales">Yearly</option>
                            </select>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap">
                                <canvas id="canvas_1"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-users me-2 text-primary"/>Top Customers</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap">
                                <canvas class="top_customer"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== CHART ROW 2 ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-cube me-2 text-primary"/>Top Products</h4>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.open_view_all('products')">
                                View All
                            </button>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap">
                                <canvas class="top_selling_product"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-tags me-2 text-primary"/>Top Product Categories</h4>
                            <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.open_view_all('categories')">
                                View All
                            </button>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap">
                                <canvas class="top_product_categories"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TOP PRODUCTS BY AMOUNT ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-lg-12">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-list-alt me-2 text-primary"/>Top Products by Amount</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table oh-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.top_products_amount" t-as="prod" t-key="prod_index">
                                        <tr>
                                            <td><t t-esc="prod['name']"/></td>
                                            <td class="text-end fw-semibold"><t t-esc="prod['amount']"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.top_products_amount.length">
                                        <tr>
                                            <td colspan="2" class="oh-empty">
                                                <i class="fa fa-box"/>
                                                No product data
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== PRODUCTS BY CATEGORY GROUP ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-lg-12">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-th-list me-2 text-primary"/>Products by Category Group (City Breakdown)</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 520px; overflow-y: auto; overflow-x: auto;">
                            <table class="table oh-table mb-0 text-nowrap">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-end">Amount</th>
                                        <!-- Dynamic City Columns -->
                                        <t t-foreach="state.products_by_category.cities" t-as="city" t-key="city_index">
                                            <th class="text-center">
                                                <t t-esc="city"/> <span class="text-muted">(qty)</span>
                                            </th>
                                        </t>
                                        <th class="text-end border-start">Total Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.products_by_category.groups" t-as="group" t-key="group_index">
                                        <!-- Category header -->
                                        <tr>
                                            <td t-attf-colspan="#{3 + (state.products_by_category.cities ? state.products_by_category.cities.length : 0)}" class="fw-bold" style="background-color:#e9ecef;">
                                                <i class="fa fa-folder-open me-2 text-primary"/>
                                                <t t-esc="group['group_name']"/>
                                            </td>
                                        </tr>
                                        <!-- Products inside the category -->
                                        <t t-foreach="group['products']" t-as="prod" t-key="prod_index">
                                            <tr>
                                                <td class="ps-4"><t t-esc="prod['product_name']"/></td>
                                                <td class="text-end"><t t-esc="prod['unit_price_fmt']"/></td>
                                                <!-- Dynamic City Quantities -->
                                                <t t-foreach="state.products_by_category.cities" t-as="city" t-key="city_index">
                                                    <td class="text-center">
                                                        <t t-if="prod['city_qty'].get(city)">
                                                            <span class="badge bg-primary rounded-pill"><t t-esc="prod['city_qty'][city]"/></span>
                                                        </t>
                                                        <t t-else="">
                                                            <span class="text-muted">-</span>
                                                        </t>
                                                    </td>
                                                </t>
                                                <td class="text-end fw-semibold border-start"><t t-esc="prod['total_amount_fmt']"/></td>
                                            </tr>
                                        </t>
                                    </t>
                                    <t t-if="!state.products_by_category.groups.length">
                                        <tr>
                                            <td t-attf-colspan="#{3 + (state.products_by_category.cities ? state.products_by_category.cities.length : 0)}" class="oh-empty">
                                                <i class="fa fa-th-list"/>
                                                No product data
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLES ==================== -->
            <div class="row g-3">
                <!-- Sale by Salesperson -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-user me-2 text-primary"/>Sale by Salesperson</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table oh-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th class="text-center">Orders</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.top_salesperson" t-as="sp" t-key="sp_index">
                                        <tr>
                                            <td><t t-esc="sp[0]"/></td>
                                            <td class="text-center"><t t-esc="sp[2]"/></td>
                                            <td class="text-end fw-semibold"><t t-esc="sp[1]"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.top_salesperson.length">
                                        <tr>
                                            <td colspan="3" class="oh-empty">
                                                <i class="fa fa-users"/>
                                                No salesperson data
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Payment Methods -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-credit-card me-2 text-primary"/>Payment Methods</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table oh-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Method</th>
                                        <th class="text-end">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.payment_details" t-as="pm" t-key="pm_index">
                                        <tr>
                                            <td><t t-esc="pm[0]"/></td>
                                            <td class="text-end fw-semibold"><t t-esc="pm[1]"/></td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.payment_details.length">
                                        <tr>
                                            <td colspan="2" class="oh-empty">
                                                <i class="fa fa-credit-card"/>
                                                No payment data
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Session Status -->
                <div class="col-lg-4">
                    <div class="card oh-section-card">
                        <div class="oh-card-header">
                            <h4><i class="fa fa-window-maximize me-2 text-primary"/>Session Status</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table oh-table mb-0">
                                <thead>
                                    <tr>
                                        <th>Session</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.selling_product" t-as="session" t-key="session_index">
                                        <tr>
                                            <td><t t-esc="session['session']"/></td>
                                            <td class="text-end">
                                                <span t-attf-class="oh-status-badge #{session['status'] === 'Opened' ? 'oh-status-opened' : (session['status'] === 'Opening Control' ? 'oh-status-control' : 'oh-status-closed')}">
                                                    <t t-esc="session['status']"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.selling_product.length">
                                        <tr>
                                            <td colspan="2" class="oh-empty">
                                                <i class="fa fa-window-maximize"/>
                                                No session data
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </t>
</templates>