<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="DonationBoxDashboard">
        <div class="pos-dash-v2">

            <!-- ==================== HEADER ==================== -->
            <div class="oh-page-header d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="mb-1"><i class="fa fa-inbox me-2 text-primary"/>Donation Box Dashboard</h2>
                    <p>Overview of Boxes, Installations and Complaints</p>
                </div>
            </div>

            <!-- Filters -->
            <div class="card oh-filter-card mb-4 shadow-sm bg-white">
                <div class="card-body p-3">
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">From Date</label>
                            <input type="date" class="form-control" t-model="state.date_from" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">To Date</label>
                            <input type="date" class="form-control" t-model="state.date_to" t-on-change="applyFilter"/>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">Province</label>
                            <select class="form-select" t-model="state.province_id" t-on-change="onchange_province">
                                <option value="">All Provinces</option>
                                <t t-foreach="state.provinces" t-as="province" t-key="province.id">
                                    <option t-att-value="province.id" t-esc="province.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">City</label>
                            <select class="form-select" t-model="state.city_id" t-on-change="onchange_city">
                                <option value="">All Cities</option>
                                <t t-foreach="filteredCities" t-as="city" t-key="city.id">
                                    <option t-att-value="city.id" t-esc="city.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">Zone / Subzone</label>
                            <select class="form-select" t-model="state.zone_id" t-on-change="onchange_zone">
                                <option value="">All Zones</option>
                                <t t-foreach="filteredZones" t-as="zone" t-key="zone.id">
                                    <option t-att-value="zone.id" t-esc="zone.name"/>
                                </t>
                            </select>
                        </div>
                        <div class="col-xl-2 col-lg-2 col-md-4">
                            <label class="form-label">Bunch</label>
                            <select class="form-select" t-model="state.bunch_id" t-on-change="applyFilter">
                                <option value="">All Bunches</option>
                                <t t-foreach="filteredBunches" t-as="bunch" t-key="bunch.id">
                                    <option t-att-value="bunch.id" t-esc="bunch.name"/>
                                </t>
                            </select>
                        </div>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-outline-secondary" t-on-click="clearFilter">
                                    <i class="fa fa-times me-1"/>Clear Filters
                                </button>
                                <button class="btn btn-sm btn-primary" t-on-click="applyFilter">
                                    <i class="fa fa-refresh me-1"/>Refresh
                                </button>
                            </div>
                            <div class="d-flex gap-1">
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_month')">This Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('last_month')">Last Month</button>
                                <button class="btn btn-sm btn-outline-primary" t-on-click="() => this.setQuickDate('this_year')">This Year</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== KPI TILES ==================== -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-success text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;">
                        <i class="fa fa-money mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Total Collection</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.total_collection"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-dark text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;">
                        <i class="fa fa-line-chart mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">3-Month Collection</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.collection_3m"/></div>
                        <div t-attf-class="small fw-bold {{ state.kpi.is_positive ? 'text-success' : 'text-danger' }}">
                            <t t-esc="state.kpi.collection_3m_diff"/> vs Prev 3M
                        </div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-danger text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('rider.collection', [['state', '=', 'donation_not_collected']])">
                        <i class="fa fa-exclamation-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Not Collected</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.not_collected_count"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-warning text-dark p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('rider.collection', [['state', '=', 'pending']])">
                        <i class="fa fa-clock-o mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Pending</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.pending_count"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-info text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('rider.collection', [['state', '=', 'paid']])">
                        <i class="fa fa-check-double mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Paid</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.paid_count"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-secondary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.registration.installation', [['status', '=', 'draft']])">
                        <i class="fa fa-file-text-o mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Draft Boxes</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.draft_boxes"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-primary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.registration.installation', [['status', '=', 'available']])">
                        <i class="fa fa-check-circle mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Available Boxes</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.available"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-dark text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.registration.installation', [['status', '=', 'installed']])">
                        <i class="fa fa-building mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Installed</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.installed"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-secondary text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.registration.installation', [['status', '=', 'close']])">
                        <i class="fa fa-archive mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Closed Boxes</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.closed"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-light text-dark border p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.complain.center', [['status', '=', 'draft']])">
                        <i class="fa fa-edit mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Draft Complaints</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.draft_complaints"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-warning text-dark p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.complain.center', [['status', '=', 'process']])">
                        <i class="fa fa-spinner mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Process Complaints</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.process_complaints"/></div>
                    </div>
                </div>
                <div class="col-md-6 col-lg-3 col-xl-2">
                    <div class="oh-kpi-card bg-success text-white p-3 rounded shadow-sm h-100" style="cursor: pointer;" t-on-click="() => this.openView('donation.box.complain.center', [['status', '=', 'resolved']])">
                        <i class="fa fa-check mb-2 fs-4"/>
                        <div class="small text-uppercase fw-bold opacity-75">Resolved Complaints</div>
                        <div class="fs-4 fw-bold mt-1"><t t-esc="state.kpi.resolved_complaints"/></div>
                    </div>
                </div>
            </div>

            <!-- Charts -->
            <div class="row g-3 mb-4">
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-pie-chart me-2 text-primary"/>Complaints by Box Status</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 300px;">
                                <canvas id="db_chart_complaints"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-3">
                            <h4 class="mb-0"><i class="fa fa-bar-chart me-2 text-primary"/>Installations (Last 6 Months)</h4>
                        </div>
                        <div class="oh-card-body">
                            <div class="oh-chart-wrap" style="height: 300px;">
                                <canvas id="db_chart_installs"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ==================== TABLES SECTION ==================== -->
            
            <!-- FULL WIDTH: Recent Registrations -->
            <div class="row g-3 mb-3">
                <div class="col-lg-12">
                    <div class="card oh-section-card shadow-sm bg-white">
                        <div class="oh-card-header border-bottom pb-2 mb-0">
                            <h4 class="mb-0"><i class="fa fa-list me-2 text-primary"/>Recent Registrations</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 400px; overflow-y: auto; overflow-x: auto;">
                            <table class="table table-hover oh-table mb-0" style="font-size: 0.85rem; white-space: nowrap;">
                                <thead class="table-light">
                                    <tr>
                                        <th>Donor</th>
                                        <th>Installer</th>
                                        <th>Registration No.</th>
                                        <th>Requested Location</th>
                                        <th>Contact Person</th>
                                        <th>Contact No.</th>
                                        <th>Box No.</th>
                                        <th>Lock No.</th>
                                        <th>Box Status</th>
                                        <th>Installation Date</th>
                                        <th class="text-end">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_registrations" t-as="reg" t-key="reg.id">
                                        <tr>
                                            <td><t t-esc="reg.donor_name"/></td>
                                            <td><t t-esc="reg.installer_name"/></td>
                                            <td><t t-esc="reg.reg_name"/></td>
                                            <td><t t-esc="reg.location"/></td>
                                            <td><t t-esc="reg.contact_person"/></td>
                                            <td><t t-esc="reg.contact_no"/></td>
                                            <td><t t-esc="reg.lot_name"/></td>
                                            <td><t t-esc="reg.lock_no"/></td>
                                            <td>
                                                <span t-attf-class="badge {{ getStateColor(reg.box_status) }}">
                                                    <t t-esc="formatStateName(reg.box_status)"/>
                                                </span>
                                            </td>
                                            <td><t t-esc="reg.installation_date"/></td>
                                            <td class="text-end">
                                                <span t-attf-class="badge {{ getStateColor(reg.status) }}">
                                                    <t t-esc="formatStateName(reg.status)"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.recent_registrations.length">
                                        <tr><td colspan="11" class="text-center text-muted py-3">No records found</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HALF WIDTH: Complaints & Collections -->
            <div class="row g-3 mb-3">
                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0">
                            <h4 class="mb-0"><i class="fa fa-wrench me-2 text-primary"/>Recent Complaints</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light">
                                    <tr><th>Shop Name</th><th>Box / Lot</th><th>Box Status</th><th class="text-end">Status</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_complaints" t-as="comp" t-key="comp.id">
                                        <tr>
                                            <td><t t-esc="comp.shop_name || '-'"/></td>
                                            <td><t t-esc="comp.lot_name"/></td>
                                            <td><t t-esc="formatStateName(comp.box_status)"/></td>
                                            <td class="text-end">
                                                <span t-attf-class="badge {{ getStateColor(comp.status) }}">
                                                    <t t-esc="formatStateName(comp.status)"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.recent_complaints.length">
                                        <tr><td colspan="4" class="text-center text-muted py-3">No records found</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card oh-section-card shadow-sm bg-white h-100">
                        <div class="oh-card-header border-bottom pb-2 mb-0">
                            <h4 class="mb-0"><i class="fa fa-money me-2 text-primary"/>Recent Collections</h4>
                        </div>
                        <div class="oh-card-body p-0" style="max-height: 340px; overflow-y: auto;">
                            <table class="table table-hover oh-table mb-0">
                                <thead class="table-light">
                                    <tr><th>Date</th><th>Shop Name</th><th>Rider</th><th>Box / Lot</th><th class="text-end">Amount</th><th class="text-end">Status</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="state.recent_collections" t-as="col" t-key="col.id">
                                        <tr>
                                            <td><t t-esc="col.date"/></td>
                                            <td><t t-esc="col.shop_name || '-'"/></td>
                                            <td><t t-esc="col.rider_name"/></td>
                                            <td><t t-esc="col.lot_name"/></td>
                                            <td class="text-end fw-semibold"><t t-esc="(col.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"/></td>
                                            <td class="text-end">
                                                <span t-attf-class="badge {{ getStateColor(col.state) }}">
                                                    <t t-esc="formatStateName(col.state)"/>
                                                </span>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-if="!state.recent_collections.length">
                                        <tr><td colspan="6" class="text-center text-muted py-3">No records found</td></tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FULL WIDTH: Comparison Analysis -->
            <div class="row g-3 mt-3">
                <div class="col-lg-12">
                    <div class="card oh-section-card shadow-sm">
                        <div class="oh-card-header border-bottom pb-2 mb-0">
                            <h4 class="mb-0"><i class="fa fa-balance-scale me-2 text-primary"/>Comparison Analysis</h4>
                        </div>
                        <div class="oh-card-body p-4 bg-light">

                            <!-- Controls -->
                            <div class="row g-3 align-items-end mb-4">
                                <div class="col-md-2">
                                    <label class="form-label fw-bold">Compare By</label>
                                    <select class="form-select" t-model="state.comparison_mode" t-on-change="onchange_comparison_mode">
                                        <option value="month">Month</option>
                                        <option value="year">Year</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">
                                        Period 1 <span class="text-muted fw-normal">(Base)</span>
                                    </label>
                                    <input t-if="state.comparison_mode === 'month'" type="month" class="form-control"
                                           t-model="state.comp_period1" t-on-change="fetch_comparison"/>
                                    <input t-if="state.comparison_mode === 'year'" type="number" min="2000" max="2100" class="form-control"
                                           t-model="state.comp_period1" t-on-change="fetch_comparison" placeholder="2024"/>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-bold">
                                        Period 2 <span class="text-muted fw-normal">(Compare to)</span>
                                    </label>
                                    <input t-if="state.comparison_mode === 'month'" type="month" class="form-control"
                                           t-model="state.comp_period2" t-on-change="fetch_comparison"/>
                                    <input t-if="state.comparison_mode === 'year'" type="number" min="2000" max="2100" class="form-control"
                                           t-model="state.comp_period2" t-on-change="fetch_comparison" placeholder="2025"/>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary w-100" t-on-click="fetch_comparison">
                                        <i class="fa fa-refresh me-1"/> Compare
                                    </button>
                                </div>
                            </div>

                            <!-- Results table -->
                            <div class="table-responsive">
                                <table class="table oh-table mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Metric</th>
                                            <th class="text-end">Period 1</th>
                                            <th class="text-end">Period 2</th>
                                            <th class="text-end">Difference</th>
                                            <th class="text-end">% Change</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="cmp" t-value="state.comparison_result"/>
                                        <t t-foreach="[
                                            ['collection_amount', 'Collection Amount', 'fa-money text-success'],
                                            ['collection_count', 'Collection Count', 'fa-list text-info'],
                                            ['installations', 'Installations', 'fa-building text-primary'],
                                            ['complaints', 'Complaints', 'fa-wrench text-warning']
                                        ]" t-as="row" t-key="row_index">
                                            <tr>
                                                <td class="fw-bold">
                                                    <i t-attf-class="fa {{ row[2] }} me-2"/>
                                                    <t t-esc="row[1]"/>
                                                </td>
                                                <td class="text-end fs-5 fw-semibold">
                                                    <t t-if="row[0] === 'collection_amount'">
                                                        <t t-esc="(((cmp.p1 || {})[row[0]] || 0)).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="(cmp.p1 || {})[row[0]] || 0"/>
                                                    </t>
                                                </td>
                                                <td class="text-end fs-5 fw-semibold">
                                                    <t t-if="row[0] === 'collection_amount'">
                                                        <t t-esc="(((cmp.p2 || {})[row[0]] || 0)).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="(cmp.p2 || {})[row[0]] || 0"/>
                                                    </t>
                                                </td>
                                                <td class="text-end fw-bold"
                                                    t-attf-class="text-end fw-bold {{ ((cmp.diffs || {})[row[0]] || {}).is_positive ? 'text-success' : 'text-danger' }}">
                                                    <t t-if="row[0] === 'collection_amount'">
                                                        <t t-esc="((cmp.diffs || {})[row[0]] || {}).diff > 0 ? '+' : ''"/>
                                                        <t t-esc="((((cmp.diffs || {})[row[0]] || {}).diff || 0)).toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})"/>
                                                    </t>
                                                    <t t-else="">
                                                        <t t-esc="((cmp.diffs || {})[row[0]] || {}).diff > 0 ? '+' : ''"/>
                                                        <t t-esc="((cmp.diffs || {})[row[0]] || {}).diff || 0"/>
                                                    </t>
                                                </td>
                                                <td class="text-end fw-bold"
                                                    t-attf-class="text-end fw-bold {{ ((cmp.diffs || {})[row[0]] || {}).is_positive ? 'text-success' : 'text-danger' }}">
                                                    <t t-esc="((cmp.diffs || {})[row[0]] || {}).pct > 0 ? '+' : ''"/>
                                                    <t t-esc="(((cmp.diffs || {})[row[0]] || {}).pct || 0).toFixed(1)"/>%
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            
        </div>
    </t>
</templates>