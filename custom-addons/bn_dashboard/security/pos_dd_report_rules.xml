<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SINGLE RESTRICTED ACCESS (No Manager Rule needed) -->
    <record id="rule_pos_dd_report_restricted" model="ir.rule">
        <field name="name">POS+DD Report: allowed locations only</field>
        <field name="model_id" ref="model_pos_dd_report"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_pos_dd_report_user'))]"/>
        <field name="domain_force">[
            '|', 
            ('analytic_account_id', 'child_of', user.pos_analytic_ids.ids), 
            ('analytic_account_id', 'child_of', user.treasury_analytic_ids.ids)
        ]</field>
    </record>

</odoo>