<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. RESTRICTED ACCESS (Regular Users) -->
    <!-- Controlled by the single "Dashboard / POS Order" tick -->
    <record id="rule_pos_dd_report_restricted" model="ir.rule">
        <field name="name">POS+DD Report: allowed locations only</field>
        <field name="model_id" ref="model_pos_dd_report"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_pos_order_dashboard_user'))]"/>
        <!-- This OR condition ensures they see BOTH their POS locations and Treasury locations -->
        <field name="domain_force">[
            '|', 
            ('analytic_account_id', 'child_of', user.pos_analytic_ids.ids), 
            ('analytic_account_id', 'child_of', user.treasury_analytic_ids.ids)
        ]</field>
    </record>

    <!-- Controlled by the single "Dashboard / POS Order (All Locations)" tick -->
    <record id="rule_pos_dd_report_all" model="ir.rule">
        <field name="name">POS+DD Report: all locations</field>
        <field name="model_id" ref="model_pos_dd_report"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_pos_order_dashboard_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>