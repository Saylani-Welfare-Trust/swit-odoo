<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ⚡ SINGLE GROUP FOR ALL CONFIGURATORS -->
    <!-- Now pointing to the existing Dashboard category so it appears under DASHBOARD -->
    <record id="group_dashboard_configurator_all" model="res.groups">
        <field name="name">Dashboard / Configurator</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="rule_dashboard_configurator_admin" model="ir.rule">
        <field name="name">Dashboard Configurator: Full (System)</field>
        <field name="model_id" ref="model_dashboard_configurator"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Single group: see & edit everything -->
    <record id="rule_dashboard_configurator_all" model="ir.rule">
        <field name="name">Dashboard Configurator: All Access</field>
        <field name="model_id" ref="model_dashboard_configurator"/>
        <field name="groups" eval="[(4, ref('group_dashboard_configurator_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>