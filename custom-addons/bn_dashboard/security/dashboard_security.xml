<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category (This creates the Header/Title in the user settings) -->
    <record id="module_category_bn_dashboard" model="ir.module.category">
        <field name="name">Dashboard</field>
        <field name="description">Access to the specific Dashboards</field>
        <field name="sequence">10</field>
    </record>

    <!-- ========================================== -->
    <!-- 1. BASE USER GROUPS                        -->
    <!-- ========================================== -->
    <record id="group_treasury_dashboard_user" model="res.groups">
        <field name="name">Dashboard / Treasury</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="group_pos_order_dashboard_user" model="res.groups">
        <field name="name">Dashboard / POS Order</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <!-- Single Access Right for Combined POS+DD Report -->
    <record id="group_pos_dd_report_user" model="res.groups">
        <field name="name">Dashboard / POS &amp; Direct Deposits</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="group_donation_box_dashboard_user" model="res.groups">
        <field name="name">Dashboard / Donation Box</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="group_profile_dashboard_user" model="res.groups">
        <field name="name">Dashboard / Profile Management</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="group_din_dashboard_user" model="res.groups">
        <field name="name">Dashboard / Donation In Kind</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <record id="group_donation_inflow_dashboard_user" model="res.groups">
        <field name="name">Dashboard / Donation Inflows</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
    </record>

    <!-- ========================================== -->
    <!-- 2. RECORD RULES: TREASURY                  -->
    <!-- ========================================== -->
    <record id="rule_cheque_restricted" model="ir.rule">
        <field name="name">Cheque: allowed locations only</field>
        <field name="model_id" ref="bn_pos_cheque.model_pos_cheque"/>
        <field name="groups" eval="[(4, ref('group_treasury_dashboard_user'))]"/>
        <field name="domain_force">[('analytic_account_id', 'child_of', user.treasury_analytic_ids.ids)]</field>
    </record>

    <record id="rule_deposit_restricted" model="ir.rule">
        <field name="name">Deposit: allowed locations only</field>
        <field name="model_id" ref="bn_direct_deposit.model_direct_deposit"/>
        <field name="groups" eval="[(4, ref('group_treasury_dashboard_user'))]"/>
        <field name="domain_force">[('analytic_account_id', 'child_of', user.treasury_analytic_ids.ids)]</field>
    </record>

    <record id="rule_transfer_restricted" model="ir.rule">
        <field name="name">Transfer: allowed locations only</field>
        <field name="model_id" ref="bn_journal_transfer.model_journal_transfer"/>
        <field name="groups" eval="[(4, ref('group_treasury_dashboard_user'))]"/>
        <field name="domain_force">[('analytic_account_id', 'child_of', user.treasury_analytic_ids.ids)]</field>
    </record>

    <!-- ========================================== -->
    <!-- 3. RECORD RULES: POS ORDER                 -->
    <!-- ========================================== -->
    <record id="rule_pos_order_restricted" model="ir.rule">
        <field name="name">POS Order: allowed locations only</field>
        <field name="model_id" ref="point_of_sale.model_pos_order"/>
        <field name="groups" eval="[(4, ref('group_pos_order_dashboard_user'))]"/>
        <field name="domain_force">['|', '|', ('config_id.analytic_account_id', 'child_of', user.pos_analytic_ids.ids), ('session_id.analytic_account_id', 'child_of', user.pos_analytic_ids.ids), ('user_id.employee_id.analytic_account_id', 'child_of', user.pos_analytic_ids.ids)]</field>
    </record>

    <record id="rule_pos_session_restricted" model="ir.rule">
        <field name="name">POS Session: allowed locations only</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="groups" eval="[(4, ref('group_pos_order_dashboard_user'))]"/>
        <field name="domain_force">['|', ('config_id.analytic_account_id', 'child_of', user.pos_analytic_ids.ids), ('user_id.employee_id.analytic_account_id', 'child_of', user.pos_analytic_ids.ids)]</field>
    </record>

    <record id="rule_pos_config_restricted" model="ir.rule">
        <field name="name">POS Config: allowed locations only</field>
        <field name="model_id" ref="point_of_sale.model_pos_config"/>
        <field name="groups" eval="[(4, ref('group_pos_order_dashboard_user'))]"/>
        <field name="domain_force">[('analytic_account_id', 'child_of', user.pos_analytic_ids.ids)]</field>
    </record>

    <!-- ========================================== -->
    <!-- 4. DASHBOARD CONFIGURATION                 -->
    <!-- ========================================== -->
    <record id="group_dashboard_configuration" model="res.groups">
        <field name="name">Dashboard / Configuration</field>
        <field name="category_id" ref="module_category_bn_dashboard"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>