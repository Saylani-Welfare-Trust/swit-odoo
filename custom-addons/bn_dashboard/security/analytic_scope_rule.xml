<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Same scope as bn_stock_location: these records have no location, so they are
         matched on their Analytic Account (Branch), which must be the analytic account
         tagged on one of the user's locations in scope, or the user's own Branch
         (res.users.scope_analytic_account_ids). A record without one stays visible.
         Settings administrators and "Unrestricted Access" see everything. -->

    <record id="scope_pos_dd_report_rule" model="ir.rule">
        <field name="name">POS + DD Report: allowed locations' analytic accounts</field>
        <field name="model_id" ref="bn_dashboard.model_pos_dd_report"/>
        <!-- global: it narrows the report's own rule (whose "nothing configured" means every branch) -->
        <field name="domain_force">[(1, '=', 1)] if (user.share or user.has_group('base.group_system') or user.has_group('bn_stock_location.stock_scope_unrestricted_group')) else ['|', ('user_id', '=', user.id), '|', ('analytic_account_id', '=', False), ('analytic_account_id', 'in', user.scope_analytic_account_ids.ids)]</field>
        <field name="groups" eval="[(5, 0, 0)]"/>
    </record>

    <record id="scope_pos_dd_report_unrestricted_rule" model="ir.rule">
        <field name="name">POS + DD Report: unrestricted</field>
        <field name="model_id" ref="bn_dashboard.model_pos_dd_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>

</odoo>
