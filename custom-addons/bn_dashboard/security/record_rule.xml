<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The Donation Box dashboard shows the boxes of the viewer's City
         (see bn_donation_box/security/record_rule.xml) -->
    <record id="bn_donation_box.donation_box_registration_city_rule" model="ir.rule">
        <field name="groups" eval="[(4, ref('bn_dashboard.group_donation_box_dashboard_user'))]"/>
    </record>

    <record id="rule_livestock_dashboard_slaughter_restricted" model="ir.rule">
        <field name="name">Livestock Dashboard: allowed locations only</field>
        <field name="model_id" ref="bn_livestock_slaugther.model_livestock_slaugther"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_livestock_dashboard_user'))]"/>
        <field name="domain_force">(
            [(1, '=', 1)]
            if not user.livestock_analytic_ids
            else [
                '|', '|', '|',
                ('pos_order_id.config_id.analytic_account_id', 'child_of', user.livestock_analytic_ids.ids),
                ('pos_order_id.session_id.analytic_account_id', 'child_of', user.livestock_analytic_ids.ids),
                ('direct_deposit_line_id.direct_deposit_id.analytic_account_id', 'child_of', user.livestock_analytic_ids.ids),
                '&amp;', ('pos_order_id', '=', False), ('direct_deposit_line_id', '=', False)
            ]
        )</field>
    </record>

    <record id="rule_shariah_dashboard_law_restricted" model="ir.rule">
        <field name="name">Shariah Dashboard: allowed segments only</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_law"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_shariah_dashboard_user'))]"/>
        <field name="domain_force">(
            [(1, '=', 1)]
            if not user.shariah_analytic_ids
            else [('analytic_account_id', 'child_of', user.shariah_analytic_ids.ids)]
        )</field>
    </record>

    <record id="rule_shariah_dashboard_transfer_restricted" model="ir.rule">
        <field name="name">Shariah Dashboard: Transfer allowed segments only</field>
        <field name="model_id" ref="bn_shariah_law.model_shariah_transfer"/>
        <field name="groups" eval="[(4, ref('bn_dashboard.group_shariah_dashboard_user'))]"/>
        <field name="domain_force">(
            [(1, '=', 1)]
            if not user.shariah_analytic_ids
            else [
                '|',
                ('source_analytic_account_id', 'child_of', user.shariah_analytic_ids.ids),
                ('destination_analytic_account_id', 'child_of', user.shariah_analytic_ids.ids)
            ]
        )</field>
    </record>

</odoo>
