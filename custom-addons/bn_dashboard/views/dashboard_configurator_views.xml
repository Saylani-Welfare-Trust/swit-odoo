<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dashboard_configurator_form" model="ir.ui.view">
        <field name="name">dashboard.configurator.form</field>
        <field name="model">dashboard.configurator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Karachi Treasury Users"/></h1>
                    </div>
                    <group>
                        <field name="dashboard_type"/>
                    </group>
                    <notebook>
                        <page string="Users / Groups">
                            <group>
                                <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Allowed Locations">
                            <group>
                                <group>
                                    <field name="allowed_province_ids" widget="many2many_tags"/>
                                    <field name="allowed_city_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="allowed_zone_ids" widget="many2many_tags"/>
                                    <field name="allowed_branch_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dashboard_configurator" model="ir.actions.act_window">
        <field name="name">Dashboard Configurator</field>
        <field name="res_model">dashboard.configurator</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Put it under Settings -> Technical for Admins -->
    <menuitem id="menu_dashboard_configurator"
              name="Dashboard Configurator"
              parent="base.menu_custom" 
              action="action_dashboard_configurator"
              groups="base.group_system"
              sequence="100"/>
</odoo>