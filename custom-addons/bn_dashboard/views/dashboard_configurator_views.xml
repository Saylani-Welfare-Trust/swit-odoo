<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dashboard_configurator_tree" model="ir.ui.view">
        <field name="name">dashboard.configurator.tree</field>
        <field name="model">dashboard.configurator</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="dashboard_type"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_dashboard_configurator_form" model="ir.ui.view">
        <field name="name">dashboard.configurator.form</field>
        <field name="model">dashboard.configurator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Karachi Users - Treasury"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="dashboard_type" invisible="context.get('default_dashboard_type') == 'treasury'"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Who (Users / Groups)" name="who">
                            <group>
                                <group>
                                    <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Location Filters" name="locations">
                            <group>
                                <group>
                                    <field name="allowed_province_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="allowed_city_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="allowed_zone_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="allowed_branch_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Segment Filters" name="segments">
                            <group>
                                <group>
                                    <field name="allowed_segment_l1_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="allowed_segment_l2_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_treasury_configurator" model="ir.actions.act_window">
        <field name="name">Treasury Configurator</field>
        <field name="res_model">dashboard.configurator</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('dashboard_type', 'in', ['treasury', 'all'])]</field>
        <field name="context">{'default_dashboard_type': 'treasury'}</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_dashboard_configurations"
              name="⚙️ Configurations"
              parent="menu_dashboard_root"
              sequence="90"
              groups="base.group_system"/>

    <menuitem id="menu_treasury_configurator"
              name="Treasury Configurator"
              parent="menu_dashboard_configurations"
              action="action_treasury_configurator"
              sequence="1"/>

    <record id="action_pos_order_configurator" model="ir.actions.act_window">
        <field name="name">POS Order Configurator</field>
        <field name="res_model">dashboard.configurator</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('dashboard_type', 'in', ['pos_order', 'all'])]</field>
        <field name="context">{'default_dashboard_type': 'pos_order'}</field>
    </record>

    <!-- POS Order Configurator Menu (under the ⚙️ Configurations folder) -->
    <menuitem id="menu_pos_order_configurator"
              name="POS Order Configurator"
              parent="menu_dashboard_configurations"
              action="action_pos_order_configurator"
              sequence="2"/>

</odoo>