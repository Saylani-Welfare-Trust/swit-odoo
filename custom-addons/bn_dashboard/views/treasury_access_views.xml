<odoo>
    <record id="view_treasury_access_list" model="ir.ui.view">
        <field name="name">treasury.access.config.tree</field>
        <field name="model">treasury.access.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id"/>
                <field name="full_access"/>
                <field name="province_ids" widget="many2many_tags"/>
                <field name="city_ids" widget="many2many_tags"/>
                <field name="zone_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_treasury_access_form" model="ir.ui.view">
        <field name="name">treasury.access.config.form</field>
        <field name="model">treasury.access.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="user_id"/>
                        <field name="full_access"/>
                    </group>
                    <group string="Allowed Locations" invisible="full_access">
                        <field name="province_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="city_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="zone_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="text-muted" invisible="full_access">
                        Selecting a province gives access to all its cities and zones.
                        Selecting a city gives access to all its zones and branches.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treasury_access" model="ir.actions.act_window">
        <field name="name">Treasury Access</field>
        <field name="res_model">treasury.access.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_treasury_access"
              name="Access Configuration"
              parent="bn_dashboard.menu_dashboard_root"
              action="action_treasury_access"
              groups="base.group_erp_manager"
              sequence="20"/>
</odoo>