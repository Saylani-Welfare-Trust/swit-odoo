<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_treasury_dashboard_configurator_form" model="ir.ui.view">
        <field name="name">treasury.dashboard.configurator.form</field>
        <field name="model">treasury.dashboard.configurator</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Karachi Treasury Users"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Allowed Locations">
                            <group>
                                <group>
                                    <field name="allowed_province_ids" widget="many2many_tags"/>
                                    <field name="allowed_city_ids" widget="many2many_tags"/>
                                </group>
                                <group>
                                    <field name="allowed_zone_ids" widget="many2many_tags"/>
                                    <field name="allowed_branch_ids" widget="many2many_tags"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_treasury_dashboard_configurator" model="ir.actions.act_window">
        <field name="name">Treasury Dashboard Configurator</field>
        <field name="res_model">treasury.dashboard.configurator</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_treasury_dashboard_configurator"
              name="Treasury Dashboard Configurator"
              parent="account.menu_finance_configuration"
              action="action_treasury_dashboard_configurator"
              groups="base.group_system"
              sequence="101"/>
</odoo>