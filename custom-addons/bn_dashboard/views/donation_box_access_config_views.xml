<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ⚡ FIX: Added a Tree View -->
    <record id="view_donation_box_access_config_tree" model="ir.ui.view">
        <field name="name">donation.box.access.config.tree</field>
        <field name="model">donation.box.access.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="analytic_ids" widget="many2many_tags"/>
                <field name="operation"/>
            </tree>
        </field>
    </record>

    <!-- Form View (Added the name field and the Apply button in the header) -->
    <record id="view_donation_box_access_config_form" model="ir.ui.view">
        <field name="name">donation.box.access.config.form</field>
        <field name="model">donation.box.access.config</field>
        <field name="arch" type="xml">
            <form string="Donation Box Access Configuration">
                <header>
                    <button name="action_apply" string="Apply Access" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Karachi Donation Box Users"/>
                        <field name="user_ids" widget="many2many_tags"/>
                        <field name="analytic_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="operation"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ⚡ FIX: Action changed to tree,form and target="current" -->
    <record id="action_donation_box_access_config" model="ir.actions.act_window">
        <field name="name">Donation Box Access Configuration</field>
        <field name="res_model">donation.box.access.config</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_donation_box_access_config" 
              name="Donation Box Access" 
              parent="bn_dashboard.menu_dashboard_root" 
              action="action_donation_box_access_config" 
              groups="base.group_erp_manager" 
              sequence="22"/>
</odoo>