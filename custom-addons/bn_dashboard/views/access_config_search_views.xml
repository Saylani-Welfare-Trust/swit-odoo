<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Dashboard access configurations: search by user and location, filter full access -->

    <record id="donation_box_access_config_view_search" model="ir.ui.view">
        <field name="name">donation.box.access.config.view.search</field>
        <field name="model">donation.box.access.config</field>
        <field name="arch" type="xml">
            <search string="Donation Box Access">
                <field name="user_id"/>
                <field name="province_ids"/>
                <field name="city_ids"/>
                <field name="zone_ids"/>
                <filter name="filter_full_access" string="All Locations" domain="[('full_access', '=', True)]"/>
                <filter name="filter_restricted" string="Restricted" domain="[('full_access', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_full_access" string="Access" context="{'group_by': 'full_access'}"/>
                </group>
            </search>
        </field>
    </record>

