<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ PIVOT ("Excel" view) ============ -->
    <record id="view_pos_dd_report_pivot" model="ir.ui.view">
        <field name="name">pos.dd.report.pivot</field>
        <field name="model">pos.dd.report</field>
        <field name="arch" type="xml">
            <pivot sample="1" display_quantity="true">
                <!-- Default rows -->
                <field name="source_model" type="row"/>
                
                <!-- Available-to-drag rows (hidden by default, drag them in) -->
                <field name="province_id" type="row" invisible="1"/>
                <field name="city_id" type="row" invisible="1"/>
                <field name="zone_id" type="row" invisible="1"/>
                <field name="category_id" type="row" invisible="1"/>
                <field name="product_id" type="row" invisible="1"/>
                <field name="config_id" type="row" invisible="1"/>
                <field name="bank_id" type="row" invisible="1"/>
                <field name="partner_id" type="row" invisible="1"/>
                <field name="state" type="row" invisible="1"/>
                <field name="user_id" type="row" invisible="1"/>

                <!-- Default column: date grouped by month -->
                <field name="date" type="col" interval="month"/>

                <!-- Measures -->
                <field name="amount" type="measure"/>
                <field name="amount_paid" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- ============ GRAPH ============ -->
    <record id="view_pos_dd_report_graph" model="ir.ui.view">
        <field name="name">pos.dd.report.graph</field>
        <field name="model">pos.dd.report</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="source_model"/>
                <field name="amount" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ============ FORM (read-only) ============ -->
    <record id="view_pos_dd_report_form" model="ir.ui.view">
        <field name="name">pos.dd.report.form</field>
        <field name="model">pos.dd.report</field>
        <field name="arch" type="xml">
            <form create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_source" type="object"
                                string="Open Source"
                                class="oe_stat_button" icon="fa-external-link"/>
                    </div>
                    <widget name="web_ribbon" title="Refund"
                            bg_color="bg-danger" invisible="not is_refund"/>
                    <group>
                        <group string="Transaction">
                            <field name="source_model"/>
                            <field name="reference"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                            <field name="user_id"/>
                            <field name="state"/>
                        </group>
                        <group string="Amounts">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount"/>
                            <field name="amount_paid"/>
                            <field name="is_refund"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location &gt; Branch">
                            <field name="province_id"/>
                            <field name="city_id"/>
                            <field name="zone_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group string="Product Info">
                            <field name="product_id"/>
                            <field name="category_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="Point of Sale Details">
                            <field name="config_id"/>
                            <field name="session_id"/>
                            <field name="payment_methods"/>
                        </group>
                        <group string="Direct Deposit Details">
                            <field name="bank_id"/>
                            <field name="payment_type"/>
                            <field name="transaction_ref"/>
                        </group>
                    </group>
                    <group>
                        <field name="remarks"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ SEARCH ============ -->
    <record id="view_pos_dd_report_search" model="ir.ui.view">
        <field name="name">pos.dd.report.search</field>
        <field name="model">pos.dd.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="transaction_ref"/>
                <field name="config_id"/>
                <field name="bank_id"/>
                
                <!-- New Filter Fields -->
                <field name="province_id"/>
                <field name="city_id"/>
                <field name="zone_id"/>
                <field name="product_id"/>
                <field name="category_id"/>

                <filter name="filter_pos" string="POS Orders Only" domain="[('source_model', '=', 'pos.order')]"/>
                <filter name="filter_dd" string="Direct Deposits Only" domain="[('source_model', '=', 'direct.deposit')]"/>
                <separator/>
                <filter name="filter_refund" string="Refunds Only" domain="[('is_refund', '=', True)]"/>
                <separator/>
                <filter name="filter_today" string="Today" domain="[('date', '>=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_this_month" string="This Month" domain="[('date', '>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter name="filter_this_year" string="This Year" domain="[('date', '>=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                
                <group expand="0" string="Group By">
                    <filter name="group_source" string="Source" context="{'group_by': 'source_model'}"/>
                    <filter name="group_province" string="Province" context="{'group_by': 'province_id'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city_id'}"/>
                    <filter name="group_zone" string="Zone" context="{'group_by': 'zone_id'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'analytic_account_id'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_category" string="Product Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_partner" string="Customer / Donor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                    <filter name="group_bank" string="Bank" context="{'group_by': 'bank_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_user" string="Cashier / User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
                <group expand="0" string="Measures">
                    <filter name="measure_amount" string="Amount" context="{'pivot_measures': ['amount']}"/>
                    <filter name="measure_amount_paid" string="Paid Amount" context="{'pivot_measures': ['amount_paid']}"/>
                    <filter name="measure_both" string="Amount + Paid" context="{'pivot_measures': ['amount', 'amount_paid']}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ ACTION ============ -->
    <record id="action_pos_dd_report" model="ir.actions.act_window">
        <field name="name">Reporting</field>
        <field name="res_model">pos.dd.report</field>
        <!-- List view removed, defaults to Pivot view -->
        <field name="view_mode">pivot,graph,form</field>
        <field name="search_view_id" ref="view_pos_dd_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No transactions yet</p>
            <p>All POS Orders and Direct Deposit entries appear here.</p>
        </field>
    </record>

    <!-- ============ MENU ============ -->
    <menuitem id="menu_pos_dd_reporting_root"
              name="Reporting"
              parent="bn_dashboard.menu_dashboard_root"
              groups="bn_dashboard.group_pos_order_dashboard_user,bn_dashboard.group_pos_order_dashboard_manager"
              sequence="15"/>

    <menuitem id="menu_pos_dd_report"
              name="POS &amp; Direct Deposits"
              parent="menu_pos_dd_reporting_root"
              action="action_pos_dd_report"
              groups="bn_dashboard.group_pos_order_dashboard_user,bn_dashboard.group_pos_order_dashboard_manager"
              sequence="10"/>

</odoo>