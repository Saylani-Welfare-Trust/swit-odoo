<odoo>
    <record id="view_livestock_access_list" model="ir.ui.view">
        <field name="name">livestock.access.config.tree</field>
        <field name="model">livestock.access.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="user_id"/>
                <field name="full_access"/>
                <field name="province_ids" widget="many2many_tags"/>
                <field name="city_ids" widget="many2many_tags"/>
                <field name="zone_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="view_livestock_access_form" model="ir.ui.view">
        <field name="name">livestock.access.config.form</field>
        <field name="model">livestock.access.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="alert alert-info" role="status">
                        Users in <b>Branch / Site Access</b> see this dashboard for their Allowed Branches / Sites
                        (All Branches / Sites: everything); this list applies to the other users only.
                    </div>
                    <group>
                        <field name="user_id"/>
                        <field name="full_access"/>
                    </group>
                    <group string="Allowed Locations" invisible="full_access">
                        <field name="province_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="city_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="zone_ids" widget="many2many_tags"
                               options="{'no_create': True}"/>
                    </group>
                    <div class="text-muted" invisible="full_access">
                        Selecting a province gives access to all its cities and zones.
                        Selecting a city gives access to all its zones and branches.
                    </div>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="livestock_access_config_view_search" model="ir.ui.view">
        <field name="name">livestock.access.config.view.search</field>
        <field name="model">livestock.access.config</field>
        <field name="arch" type="xml">
            <search string="Livestock Access">
                <field name="user_id"/>
                <field name="province_ids"/>
                <field name="city_ids"/>
                <field name="zone_ids"/>
                <filter name="filter_full_access" string="All Locations" domain="[('full_access', '=', True)]"/>
                <filter name="filter_restricted" string="Restricted" domain="[('full_access', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_full_access" string="Access" context="{'group_by': 'full_access'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_livestock_access" model="ir.actions.act_window">
        <field name="name">Livestock Access</field>
        <field name="res_model">livestock.access.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_livestock_access"
          name="Livestock Access"
          parent="bn_dashboard.menu_dashboard_configuration_root"
          action="action_livestock_access"
          groups="bn_dashboard.group_dashboard_configuration"
          sequence="40"/>
</odoo>